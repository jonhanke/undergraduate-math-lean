/-! # Judson–Beezer, chapter 12 (part 2): lattices, crystallographic restriction, isometries

Lattices generated by two independent vectors (Theorem 12.2.8 and basis change), the algebraic core
of the crystallographic restriction (order of an integer `2 × 2` matrix of finite order), isometries
of Euclidean space and the Euclidean group `E(n)`. -/

namespace UndergradKB.AbstractAlgebra

open Matrix

/-- Cayley–Hamilton for a 2x2 matrix. -/
lemma fin_two_sq (A : Matrix (Fin 2) (Fin 2) ℤ) :
    A * A = (A.trace : ℤ) • A - (A.det : ℤ) • (1 : Matrix (Fin 2) (Fin 2) ℤ) := by
  ext i j
  rw [Matrix.sub_apply, Matrix.smul_apply, Matrix.smul_apply, smul_eq_mul, smul_eq_mul]
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Matrix.trace_fin_two, Matrix.det_fin_two, Fin.sum_univ_two] <;> ring

lemma unipotent_eq_zero (N : Matrix (Fin 2) (Fin 2) ℤ) (hN : N * N = 0) (m : ℕ)
    (hm : m ≠ 0) (h : (1 + N) ^ m = 1) : N = 0 := by
  have key : ∀ k : ℕ, (1 + N) ^ k = 1 + k • N := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      have h0 : (k • N) * N = 0 := by rw [smul_mul_assoc, hN, smul_zero]
      rw [pow_succ, ih]
      simp only [add_mul, mul_add, one_mul, mul_one, h0, add_zero, add_smul, one_smul, add_assoc]
  rw [key] at h
  have h2 : m • N = 0 := by simpa using h
  ext i j
  have := congrFun (congrFun h2 i) j
  simp at this
  rcases this with h3 | h3
  · exact absurd h3 hm
  · simpa using h3

/-- Eigenvalue facts. -/
lemma exists_eigenvalue_of_pow_eq_one (A : Matrix (Fin 2) (Fin 2) ℤ) (m : ℕ) (hm : m ≠ 0)
    (hA : A ^ m = 1) :
    ∃ l : ℂ, ‖l‖ = 1 ∧ l ^ 2 - (A.trace : ℂ) * l + (A.det : ℂ) = 0 := by
  set M : Matrix (Fin 2) (Fin 2) ℂ := (Int.castRingHom ℂ).mapMatrix A with hM
  have hMm : M ^ m = 1 := by
    rw [hM, ← map_pow, hA, map_one]
  obtain ⟨l, hl⟩ := Module.End.exists_eigenvalue (Matrix.toLin' M)
  obtain ⟨v, hv⟩ := hl.exists_hasEigenvector
  have hv1 : M *ᵥ v = l • v := by simpa using hv.apply_eq_smul
  have hv0 : v ≠ 0 := hv.2
  have hpow : ∀ k : ℕ, (M ^ k) *ᵥ v = l ^ k • v := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ', ← Matrix.mulVec_mulVec, ih, Matrix.mulVec_smul, hv1, smul_smul, pow_succ]
  have h1 : l ^ m = 1 := by
    have := hpow m
    rw [hMm, Matrix.one_mulVec] at this
    have h' : (l ^ m - 1) • v = 0 := by rw [sub_smul, ← this]; simp
    rcases smul_eq_zero.mp h' with h | h
    · exact sub_eq_zero.mp h
    · exact absurd h hv0
  have hnorm : ‖l‖ = 1 := by
    have : ‖l‖ ^ m = 1 := by rw [← norm_pow, h1, norm_one]
    exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) hm).mp this
  refine ⟨l, hnorm, ?_⟩
  have hsq : M * M = (A.trace : ℂ) • M - (A.det : ℂ) • (1 : Matrix (Fin 2) (Fin 2) ℂ) := by
    ext i j
    rw [Matrix.sub_apply, Matrix.smul_apply, Matrix.smul_apply, smul_eq_mul, smul_eq_mul]
    fin_cases i <;> fin_cases j <;>
      simp [hM, Matrix.mul_apply, Matrix.trace_fin_two, Matrix.det_fin_two, Fin.sum_univ_two] <;>
      ring
  have := congrArg (fun B => B *ᵥ v) hsq
  simp only [← Matrix.mulVec_mulVec, hv1, Matrix.mulVec_smul, Matrix.sub_mulVec,
    Matrix.smul_mulVec, Matrix.one_mulVec, smul_smul] at this
  have h3 : (l ^ 2 - (A.trace : ℂ) * l + (A.det : ℂ)) • v = 0 := by
    rw [← sub_eq_zero] at this
    rw [← this]
    module
  rcases smul_eq_zero.mp h3 with h | h
  · exact h
  · exact absurd h hv0

lemma trace_det_bounds (A : Matrix (Fin 2) (Fin 2) ℤ) (m : ℕ) (hm : m ≠ 0) (hA : A ^ m = 1) :
    (A.det = 1 ∨ A.det = -1) ∧ A.trace ^ 2 ≤ 4 ∧ (A.det = -1 → A.trace = 0) := by
  have hd : A.det = 1 ∨ A.det = -1 := by
    have h1 : A.det ^ m = 1 := by rw [← Matrix.det_pow, hA, Matrix.det_one]
    exact Int.isUnit_iff.mp (IsUnit.of_pow_eq_one h1 hm)
  obtain ⟨l, hl, hq⟩ := exists_eigenvalue_of_pow_eq_one A m hm hA
  have hx : l.re ^ 2 + l.im ^ 2 = 1 := by
    have : ‖l‖ ^ 2 = 1 := by rw [hl]; norm_num
    rw [Complex.sq_norm, Complex.normSq_apply] at this
    nlinarith
  have hre := congrArg Complex.re hq
  have him := congrArg Complex.im hq
  simp [pow_two] at hre him
  set t : ℝ := (A.trace : ℝ) with ht
  set d : ℝ := (A.det : ℝ) with hdd
  have hd' : d = 1 ∨ d = -1 := by
    rcases hd with h | h
    · left; simp [hdd, h]
    · right; simp [hdd, h]
  have key : t ^ 2 ≤ 4 ∧ (d = -1 → t = 0) := by
    by_cases hy : l.im = 0
    · rw [hy] at hx hre
      have hx2 : l.re ^ 2 = 1 := by nlinarith
      have htx : t * l.re = 1 + d := by nlinarith
      have ht2 : t ^ 2 = (1 + d) ^ 2 := by
        have : (t * l.re) ^ 2 = (1 + d) ^ 2 := by rw [htx]
        nlinarith
      rcases hd' with h | h
      · rw [h] at ht2; refine ⟨by nlinarith, fun h' => by linarith⟩
      · rw [h] at ht2; refine ⟨by nlinarith, fun _ => by nlinarith⟩
    · have h2 : t = 2 * l.re := by
        have : l.im * (2 * l.re - t) = 0 := by linarith
        rcases mul_eq_zero.mp this with h | h
        · exact absurd h hy
        · linarith
      have hd1 : d = 1 := by rw [h2] at hre; nlinarith
      refine ⟨by rw [h2]; nlinarith, fun h => by rw [hd1] at h; norm_num at h⟩
  obtain ⟨k1, k2⟩ := key
  refine ⟨hd, ?_, ?_⟩
  · have k1' : ((A.trace : ℝ)) ^ 2 ≤ 4 := k1
    exact_mod_cast k1'
  · intro h
    have : d = -1 := by simp [hdd, h]
    have k2' : ((A.trace : ℝ)) = 0 := k2 this
    exact_mod_cast k2'

lemma dvd_cases (k n : ℕ) (h : k ∣ n) (hn : n = 2 ∨ n = 3 ∨ n = 4 ∨ n = 6) :
    k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 6 := by
  have hn0 : 0 < n := by omega
  have hk : k ≤ 6 := by have := Nat.le_of_dvd hn0 h; omega
  interval_cases k <;> omega

/-- AA-190. Crystallographic restriction (algebraic core of Theorem 12.2.9): an integer `2 × 2`
matrix of finite order has order 1, 2, 3, 4 or 6. -/
@[kb "judson2026" "Theorem 12.2.9, p. 170"]
theorem orderOf_int_matrix_two (A : Matrix (Fin 2) (Fin 2) ℤ) (m : ℕ) (hm : m ≠ 0)
    (hA : A ^ m = 1) : orderOf A = 1 ∨ orderOf A = 2 ∨ orderOf A = 3 ∨ orderOf A = 4 ∨
      orderOf A = 6 := by
  obtain ⟨hd, ht, hdt⟩ := trace_det_bounds A m hm hA
  have hsq := fin_two_sq A
  have hsq' : A * A = A.trace • A - A.det • (1 : Matrix (Fin 2) (Fin 2) ℤ) := hsq
  have ht' : -2 ≤ A.trace ∧ A.trace ≤ 2 := by constructor <;> nlinarith
  obtain ⟨h1, h2⟩ := ht'
  have go : ∀ n : ℕ, A ^ n = 1 → (n = 2 ∨ n = 3 ∨ n = 4 ∨ n = 6) →
      orderOf A = 1 ∨ orderOf A = 2 ∨ orderOf A = 3 ∨ orderOf A = 4 ∨ orderOf A = 6 :=
    fun n hn hn' => dvd_cases _ _ (orderOf_dvd_of_pow_eq_one hn) hn'
  rcases hd with hd | hd
  · rw [hd] at hsq'
    have : A.trace = -2 ∨ A.trace = -1 ∨ A.trace = 0 ∨ A.trace = 1 ∨ A.trace = 2 := by omega
    rcases this with h | h | h | h | h
    · rw [h] at hsq'
      have hN : (-A - 1) * (-A - 1) = 0 := by
        have e : (-A - 1) * (-A - 1) = A * A + 2 • A + 1 := by noncomm_ring
        rw [e, hsq']; module
      have hp : (1 + (-A - 1)) ^ (2 * m) = 1 := by
        rw [show 1 + (-A - 1) = -A by abel, Even.neg_pow (even_two_mul m), mul_comm, pow_mul, hA,
          one_pow]
      have h0 := unipotent_eq_zero _ hN (2 * m) (by omega) hp
      have hA1 : A = -1 := by
        have : A = -(-A - 1) - 1 := by abel
        rw [this, h0]; simp
      refine go 2 ?_ (by simp)
      rw [hA1]; simp
    · rw [h] at hsq'
      have h3 : A ^ 3 = 1 := by
        rw [pow_succ, pow_two, hsq']
        have : ((-1 : ℤ) • A - (1 : ℤ) • (1 : Matrix (Fin 2) (Fin 2) ℤ)) * A = -(A * A) - A := by
          simp [sub_mul]
        rw [this, hsq']; module
      exact go 3 h3 (by simp)
    · rw [h] at hsq'
      have h4 : A ^ 4 = 1 := by
        rw [show 4 = 2 + 2 by rfl, pow_add, pow_two, hsq']
        simp [sub_mul, mul_sub]
      exact go 4 h4 (by simp)
    · rw [h] at hsq'
      have h3 : A * A * A = -1 := by
        rw [hsq']
        have : ((1 : ℤ) • A - (1 : ℤ) • (1 : Matrix (Fin 2) (Fin 2) ℤ)) * A = A * A - A := by
          simp [sub_mul]
        rw [this, hsq']; module
      have h6 : A ^ 6 = 1 := by
        rw [show 6 = 3 + 3 by rfl, pow_add, show 3 = 2 + 1 by rfl, pow_add, pow_two, pow_one, h3]
        simp
      exact go 6 h6 (by simp)
    · rw [h] at hsq'
      have hN : (A - 1) * (A - 1) = 0 := by
        have e : (A - 1) * (A - 1) = A * A - 2 • A + 1 := by noncomm_ring
        rw [e, hsq']; module
      have hp : (1 + (A - 1)) ^ m = 1 := by
        rw [show 1 + (A - 1) = A by abel, hA]
      have h0 := unipotent_eq_zero _ hN m hm hp
      have hA1 : A = 1 := by
        have : A = (A - 1) + 1 := by abel
        rw [this, h0]; simp
      refine go 2 ?_ (by simp)
      rw [hA1]; simp
  · have := hdt hd
    rw [hd, this] at hsq'
    refine go 2 ?_ (by simp)
    rw [pow_two, hsq']; simp

section Lattice

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- AA-186. The lattice generated by `x` and `y`: all integer combinations `m x + n y`. -/
def lattice2 (x y : V) : Submodule ℤ V := Submodule.span ℤ {x, y}

omit [Module ℝ V] in
/-- AA-186. Membership in the lattice generated by `x`, `y`: `v = m x + n y` with `m n : ℤ`. -/
@[kb "judson2026" "Definition 12.2.1, p. 168"]
theorem mem_lattice2 (x y v : V) : v ∈ lattice2 x y ↔ ∃ m n : ℤ, m • x + n • y = v :=
  Submodule.mem_span_pair

lemma coeff_unique {x y : V} (hxy : LinearIndependent ℝ ![x, y]) {m n m' n' : ℤ}
    (h : m • x + n • y = m' • x + n' • y) : m = m' ∧ n = n' := by
  rw [LinearIndependent.pair_iff] at hxy
  have := hxy ((m - m' : ℤ) : ℝ) ((n - n' : ℤ) : ℝ) (by
    rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul, sub_smul, sub_smul]
    rw [sub_add_sub_comm, h, sub_self])
  obtain ⟨h1, h2⟩ := this
  have h1' := Int.cast_eq_zero.mp h1
  have h2' := Int.cast_eq_zero.mp h2
  constructor <;> omega

/-- The map `(m, n) ↦ m x + n y`. -/
def latticeMap (x y : V) : ℤ × ℤ →+ V where
  toFun p := p.1 • x + p.2 • y
  map_zero' := by simp
  map_add' p q := by simp [add_smul]; abel

/-- AA-189. Theorem 12.2.8 (lattice form): for linearly independent `x`, `y` the lattice they
generate is isomorphic to `ℤ × ℤ` as an additive group. -/
@[kb "judson2026" "Theorem 12.2.8, p. 170"]
theorem lattice2_addEquiv {x y : V} (hxy : LinearIndependent ℝ ![x, y]) :
    Nonempty ((ℤ × ℤ) ≃+ lattice2 x y) := by
  have hinj : Function.Injective (latticeMap x y) := by
    intro p q h
    have := coeff_unique hxy (m := p.1) (n := p.2) (m' := q.1) (n' := q.2) h
    exact Prod.ext this.1 this.2
  have hr : (latticeMap x y).range = (lattice2 x y).toAddSubgroup := by
    ext v
    simp only [AddMonoidHom.mem_range, Submodule.mem_toAddSubgroup, mem_lattice2]
    constructor
    · rintro ⟨p, rfl⟩; exact ⟨p.1, p.2, rfl⟩
    · rintro ⟨m, n, rfl⟩; exact ⟨(m, n), rfl⟩
  exact ⟨(AddMonoidHom.ofInjective hinj).trans (AddEquiv.addSubgroupCongr hr)⟩

/-- AA-187. Two bases `x, y` and `x', y'` of the same lattice differ by an integer matrix
`[[a, b], [c, d]]` of determinant `±1`. -/
@[kb "judson2026" "Definition 12.2.1, p. 169"]
theorem lattice2_basis_change {x y x' y' : V} (hxy : LinearIndependent ℝ ![x, y])
    (h : lattice2 x y = lattice2 x' y') :
    ∃ a b c d : ℤ, x' = a • x + b • y ∧ y' = c • x + d • y ∧
      (a * d - b * c = 1 ∨ a * d - b * c = -1) := by
  have hx' : x' ∈ lattice2 x y := h ▸ Submodule.subset_span (by simp)
  have hy' : y' ∈ lattice2 x y := h ▸ Submodule.subset_span (by simp)
  have hx : x ∈ lattice2 x' y' := h ▸ Submodule.subset_span (by simp)
  have hy : y ∈ lattice2 x' y' := h ▸ Submodule.subset_span (by simp)
  obtain ⟨a, b, hab⟩ := (mem_lattice2 _ _ _).mp hx'
  obtain ⟨c, d, hcd⟩ := (mem_lattice2 _ _ _).mp hy'
  obtain ⟨a', b', hab'⟩ := (mem_lattice2 _ _ _).mp hx
  obtain ⟨c', d', hcd'⟩ := (mem_lattice2 _ _ _).mp hy
  refine ⟨a, b, c, d, hab.symm, hcd.symm, ?_⟩
  have e1 : (a' * a + b' * c) • x + (a' * b + b' * d) • y = (1 : ℤ) • x + (0 : ℤ) • y :=
    calc (a' * a + b' * c) • x + (a' * b + b' * d) • y
        = a' • (a • x + b • y) + b' • (c • x + d • y) := by
          simp only [smul_add, smul_smul, add_smul]; abel
      _ = a' • x' + b' • y' := by rw [hab, hcd]
      _ = x := hab'
      _ = (1 : ℤ) • x + (0 : ℤ) • y := by simp
  have e2 : (c' * a + d' * c) • x + (c' * b + d' * d) • y = (0 : ℤ) • x + (1 : ℤ) • y :=
    calc (c' * a + d' * c) • x + (c' * b + d' * d) • y
        = c' • (a • x + b • y) + d' • (c • x + d • y) := by
          simp only [smul_add, smul_smul, add_smul]; abel
      _ = c' • x' + d' • y' := by rw [hab, hcd]
      _ = y := hcd'
      _ = (0 : ℤ) • x + (1 : ℤ) • y := by simp
  obtain ⟨p1, p2⟩ := coeff_unique hxy e1
  obtain ⟨q1, q2⟩ := coeff_unique hxy e2
  have hprod : (a * d - b * c) * (a' * d' - b' * c') = 1 := by
    have : (a * d - b * c) * (a' * d' - b' * c') =
        (a' * a + b' * c) * (c' * b + d' * d) - (a' * b + b' * d) * (c' * a + d' * c) := by ring
    rw [this, p1, p2, q1, q2]; norm_num
  exact Int.eq_one_or_neg_one_of_mul_eq_one hprod

/-- AA-190. Crystallographic restriction, geometric form (Theorem 12.2.9): a linear map of a real
plane that preserves the lattice generated by two independent vectors and has finite order has
order 1, 2, 3, 4 or 6. -/
@[kb "judson2026" "Theorem 12.2.9, p. 170"]
theorem crystallographic_restriction (hV : Module.finrank ℝ V = 2) {x y : V}
    (hxy : LinearIndependent ℝ ![x, y]) (T : V →ₗ[ℝ] V)
    (hT : ∀ v ∈ lattice2 x y, T v ∈ lattice2 x y) (m : ℕ) (hm : m ≠ 0) (hTm : T ^ m = 1) :
    orderOf T = 1 ∨ orderOf T = 2 ∨ orderOf T = 3 ∨ orderOf T = 4 ∨ orderOf T = 6 := by
  obtain ⟨a, b, hTx⟩ := (mem_lattice2 _ _ _).mp (hT x (Submodule.subset_span (by simp)))
  obtain ⟨c, d, hTy⟩ := (mem_lattice2 _ _ _).mp (hT y (Submodule.subset_span (by simp)))
  have hcard : Fintype.card (Fin 2) = Module.finrank ℝ V := by simp [hV]
  let B := basisOfLinearIndependentOfCardEqFinrank hxy hcard
  have hB0 : B 0 = x := by simp [B]
  have hB1 : B 1 = y := by simp [B]
  let Q : Matrix (Fin 2) (Fin 2) ℤ := !![a, c; b, d]
  have hTQ : LinearMap.toMatrixAlgEquiv B T = (Int.castRingHom ℝ).mapMatrix Q := by
    have hx : T x = (a : ℝ) • x + (b : ℝ) • y := by
      rw [← hTx]; simp [Int.cast_smul_eq_zsmul]
    have hy : T y = (c : ℝ) • x + (d : ℝ) • y := by
      rw [← hTy]; simp [Int.cast_smul_eq_zsmul]
    have hx' : T (B 0) = (a : ℝ) • B 0 + (b : ℝ) • B 1 := by rw [hB0, hB1]; exact hx
    have hy' : T (B 1) = (c : ℝ) • B 0 + (d : ℝ) • B 1 := by rw [hB0, hB1]; exact hy
    ext i j
    rw [LinearMap.toMatrixAlgEquiv_apply]
    fin_cases i <;> fin_cases j <;>
      simp [hx', hy', Q, Module.Basis.repr_self, Finsupp.single_apply]
  have hiff : ∀ k : ℕ, T ^ k = 1 ↔ Q ^ k = 1 := by
    intro k
    constructor
    · intro h
      have h1 := congrArg (LinearMap.toMatrixAlgEquiv B) h
      rw [map_pow, hTQ, map_one, ← map_pow] at h1
      exact (Matrix.map_injective (Int.cast_injective (α := ℝ))) (by simpa using h1)
    · intro h
      have h1 : LinearMap.toMatrixAlgEquiv B (T ^ k) = LinearMap.toMatrixAlgEquiv B 1 := by
        rw [map_pow, hTQ, ← map_pow, h]; simp
      exact (LinearMap.toMatrixAlgEquiv B).injective h1
  have hord : orderOf T = orderOf Q := orderOf_eq_orderOf_iff.mpr hiff
  rw [hord]
  exact orderOf_int_matrix_two Q m hm ((hiff m).mp hTm)

end Lattice

noncomputable section Isometries

variable {n : ℕ}

/-- AA-182. Lemma 12.2.2 (any dimension): an isometry of Euclidean space (not assumed
surjective) fixing the origin is the action of an orthogonal matrix. -/
@[kb "judson2026" "Lemma 12.2.2, p. 166"]
theorem isometry_fixing_zero_orthogonal (f : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hf : Isometry f) (h0 : f 0 = 0) :
    ∃ A ∈ Matrix.orthogonalGroup (Fin n) ℝ, ∀ x, f x = Matrix.toEuclideanLin A x := by
  let g := hf.affineIsometryOfStrictConvexSpace
  let b := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis
  let A := LinearMap.toMatrix b b g.linearIsometry.toLinearMap
  have hT : Matrix.toEuclideanLin A = g.linearIsometry.toLinearMap := by
    rw [Matrix.toEuclideanLin_eq_toLin_orthonormal, Matrix.toLin_toMatrix]
  have hg : ∀ p, g p = f p := fun p => rfl
  have hlin : ∀ x, g.linearIsometry.toLinearMap x = f x := by
    intro x
    have := g.toAffineMap.linear_apply_vsub x 0
    simpa [hg, h0] using this
  have hnorm : ∀ x, ‖f x‖ = ‖x‖ := fun x =>
    calc ‖f x‖ = dist (f x) (f 0) := by rw [h0, dist_zero_right]
      _ = dist x 0 := hf.dist_eq x 0
      _ = ‖x‖ := dist_zero_right x
  refine ⟨A, mem_orthogonalGroup_of_norm_map (fun x => ?_), fun x => ?_⟩
  · rw [hT, hlin, hnorm]
  · rw [hT, hlin]

/-- AA-182. Lemma 12.2.2 for the plane: an isometry of `ℝ²` fixing the origin is linear, given
by an element of `O(2)`. -/
@[kb "judson2026" "Lemma 12.2.2, p. 166"]
theorem isometry_fixing_zero_orthogonal_two
    (f : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)) (hf : Isometry f) (h0 : f 0 = 0) :
    ∃ A ∈ Matrix.orthogonalGroup (Fin 2) ℝ, ∀ x, f x = Matrix.toEuclideanLin A x :=
  isometry_fixing_zero_orthogonal f hf h0

/-- AA-183. Theorem 12.2.3 (any dimension): a map of Euclidean space is an isometry iff it has the
form `x ↦ A x + b` with `A` orthogonal. -/
@[kb "judson2026" "Theorem 12.2.3, p. 167"]
theorem isometry_iff_orthogonal_add (f : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)) :
    Isometry f ↔ ∃ A ∈ Matrix.orthogonalGroup (Fin n) ℝ, ∃ b : EuclideanSpace ℝ (Fin n),
      ∀ x, f x = Matrix.toEuclideanLin A x + b := by
  constructor
  · intro hf
    have hg : Isometry (fun x => f x - f 0) :=
      Isometry.of_dist_eq fun x y => by rw [dist_sub_right]; exact hf.dist_eq x y
    obtain ⟨A, hA, hAf⟩ := isometry_fixing_zero_orthogonal _ hg (by simp)
    exact ⟨A, hA, f 0, fun x => by rw [← hAf]; abel⟩
  · rintro ⟨A, hA, b, hf⟩
    refine Isometry.of_dist_eq fun x y => ?_
    rw [hf, hf, dist_add_right]
    exact dist_toEuclideanLin_of_mem hA x y

/-- AA-183. Theorem 12.2.3 for the plane: the isometries of `ℝ²` are exactly the maps
`x ↦ A x + b` with `A ∈ O(2)`. -/
@[kb "judson2026" "Theorem 12.2.3, p. 167"]
theorem isometry_two_iff (f : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)) :
    Isometry f ↔ ∃ A ∈ Matrix.orthogonalGroup (Fin 2) ℝ, ∃ b : EuclideanSpace ℝ (Fin 2),
      ∀ x, f x = Matrix.toEuclideanLin A x + b :=
  isometry_iff_orthogonal_add f

/-- The action of an orthogonal matrix on Euclidean space. -/
def orthoAct (A : Matrix.orthogonalGroup (Fin n) ℝ) (v : EuclideanSpace ℝ (Fin n)) :
    EuclideanSpace ℝ (Fin n) :=
  Matrix.toEuclideanLin (A : Matrix (Fin n) (Fin n) ℝ) v

lemma orthoAct_add (A : Matrix.orthogonalGroup (Fin n) ℝ) (v w : EuclideanSpace ℝ (Fin n)) :
    orthoAct A (v + w) = orthoAct A v + orthoAct A w := map_add _ _ _

lemma orthoAct_neg (A : Matrix.orthogonalGroup (Fin n) ℝ) (v : EuclideanSpace ℝ (Fin n)) :
    orthoAct A (-v) = -orthoAct A v := map_neg _ _

lemma orthoAct_sub (A : Matrix.orthogonalGroup (Fin n) ℝ) (v w : EuclideanSpace ℝ (Fin n)) :
    orthoAct A (v - w) = orthoAct A v - orthoAct A w := map_sub _ _ _

lemma orthoAct_mul (A B : Matrix.orthogonalGroup (Fin n) ℝ) (v : EuclideanSpace ℝ (Fin n)) :
    orthoAct (A * B) v = orthoAct A (orthoAct B v) := by
  simp [orthoAct, toEuclideanLin_apply_ofLp, Matrix.mulVec_mulVec]

lemma orthoAct_one (v : EuclideanSpace ℝ (Fin n)) :
    orthoAct (1 : Matrix.orthogonalGroup (Fin n) ℝ) v = v := by
  simp [orthoAct, toEuclideanLin_apply_ofLp]

lemma orthoAct_inv_self (A : Matrix.orthogonalGroup (Fin n) ℝ) (v : EuclideanSpace ℝ (Fin n)) :
    orthoAct A⁻¹ (orthoAct A v) = v := by
  rw [← orthoAct_mul, inv_mul_cancel, orthoAct_one]

lemma orthoAct_self_inv (A : Matrix.orthogonalGroup (Fin n) ℝ) (v : EuclideanSpace ℝ (Fin n)) :
    orthoAct A (orthoAct A⁻¹ v) = v := by
  rw [← orthoAct_mul, mul_inv_cancel, orthoAct_one]

/-- AA-180. The Euclidean group `E(n)`: pairs `(A, x)` with `A ∈ O(n)` and `x ∈ ℝⁿ`, with
`(A, x) (B, y) = (A B, A y + x)`. -/
@[ext]
structure EuclideanGroup (n : ℕ) where
  /-- The orthogonal part. -/
  rot : Matrix.orthogonalGroup (Fin n) ℝ
  /-- The translation part. -/
  trans : EuclideanSpace ℝ (Fin n)

namespace EuclideanGroup

instance : Mul (EuclideanGroup n) := ⟨fun a b => ⟨a.rot * b.rot, orthoAct a.rot b.trans + a.trans⟩⟩

instance : One (EuclideanGroup n) := ⟨⟨1, 0⟩⟩

instance : Inv (EuclideanGroup n) := ⟨fun a => ⟨a.rot⁻¹, -orthoAct a.rot⁻¹ a.trans⟩⟩

lemma mul_def (a b : EuclideanGroup n) :
    a * b = ⟨a.rot * b.rot, orthoAct a.rot b.trans + a.trans⟩ := rfl

/-- AA-180. `E(n)` is a group under the book's multiplication. -/
@[kb "judson2026" "Definition 12.1.4, p. 165"]
instance : Group (EuclideanGroup n) where
  mul_assoc a b c := by
    refine EuclideanGroup.ext (mul_assoc _ _ _) ?_
    show orthoAct (a.rot * b.rot) c.trans + (orthoAct a.rot b.trans + a.trans) =
      orthoAct a.rot (orthoAct b.rot c.trans + b.trans) + a.trans
    rw [orthoAct_mul, orthoAct_add, add_assoc]
  one_mul a := by
    refine EuclideanGroup.ext (one_mul _) ?_
    show orthoAct 1 a.trans + 0 = a.trans
    rw [orthoAct_one, add_zero]
  mul_one a := by
    refine EuclideanGroup.ext (mul_one _) ?_
    show orthoAct a.rot 0 + a.trans = a.trans
    rw [show orthoAct a.rot 0 = 0 from map_zero _, zero_add]
  inv_mul_cancel a := by
    refine EuclideanGroup.ext (inv_mul_cancel _) ?_
    show orthoAct a.rot⁻¹ a.trans + -orthoAct a.rot⁻¹ a.trans = 0
    rw [add_neg_cancel]

/-- The isometry `v ↦ A v + x` attached to `(A, x)`. -/
def toIsometryEquiv (g : EuclideanGroup n) :
    EuclideanSpace ℝ (Fin n) ≃ᵢ EuclideanSpace ℝ (Fin n) where
  toFun v := orthoAct g.rot v + g.trans
  invFun w := orthoAct g.rot⁻¹ (w - g.trans)
  left_inv v := by simp [orthoAct_inv_self]
  right_inv w := by simp [orthoAct_self_inv]
  isometry_toFun := Isometry.of_dist_eq fun x y => by
    rw [dist_add_right]
    exact dist_toEuclideanLin_of_mem g.rot.2 x y

/-- AA-180. The map `E(n) → Isom(ℝⁿ)`, `(A, x) ↦ (v ↦ A v + x)`, is a group homomorphism. -/
def toIsometryHom :
    EuclideanGroup n →* (EuclideanSpace ℝ (Fin n) ≃ᵢ EuclideanSpace ℝ (Fin n)) where
  toFun := toIsometryEquiv
  map_one' := IsometryEquiv.ext fun v => by
    show orthoAct 1 v + 0 = v
    rw [orthoAct_one, add_zero]
  map_mul' a b := IsometryEquiv.ext fun v => by
    show orthoAct (a.rot * b.rot) v + (orthoAct a.rot b.trans + a.trans) =
      orthoAct a.rot (orthoAct b.rot v + b.trans) + a.trans
    rw [orthoAct_mul, orthoAct_add, add_assoc]

/-- AA-180. The homomorphism `E(n) → Isom(ℝⁿ)` is injective. -/
theorem toIsometryHom_injective : Function.Injective (toIsometryHom (n := n)) := by
  intro a b h
  have h0 : a.trans = b.trans := by
    have := congrArg (fun f => f 0) h
    simpa [toIsometryHom, toIsometryEquiv, orthoAct] using this
  have hr : a.rot = b.rot := by
    apply Subtype.ext
    have hl : Matrix.toEuclideanLin (a.rot : Matrix (Fin n) (Fin n) ℝ) =
        Matrix.toEuclideanLin (b.rot : Matrix (Fin n) (Fin n) ℝ) := by
      refine LinearMap.ext fun v => ?_
      have := congrArg (fun f => f v) h
      simpa [toIsometryHom, toIsometryEquiv, orthoAct, h0] using this
    exact Matrix.toEuclideanLin.injective hl
  exact EuclideanGroup.ext hr h0

/-- AA-180, AA-183. Every isometry of Euclidean space is of the form `v ↦ A v + x`: the
homomorphism `E(n) → Isom(ℝⁿ)` is surjective. -/
theorem toIsometryHom_surjective : Function.Surjective (toIsometryHom (n := n)) := by
  intro f
  obtain ⟨A, hA, b, hf⟩ := (isometry_iff_orthogonal_add f).mp f.isometry
  refine ⟨⟨⟨A, hA⟩, b⟩, IsometryEquiv.ext fun x => ?_⟩
  exact (hf x).symm

/-- AA-180, AA-183. `E(n)` is isomorphic to the group of isometries of `ℝⁿ`. -/
@[kb "judson2026" "Theorem 12.2.3, p. 167"]
def mulEquivIsometry (n : ℕ) :
    EuclideanGroup n ≃* (EuclideanSpace ℝ (Fin n) ≃ᵢ EuclideanSpace ℝ (Fin n)) :=
  MulEquiv.ofBijective (toIsometryHom (n := n))
    ⟨toIsometryHom_injective, toIsometryHom_surjective⟩

/-- AA-188. The orthogonal part `(A, x) ↦ A` of `E(n)` is a group homomorphism. -/
def rotHom (n : ℕ) : EuclideanGroup n →* Matrix.orthogonalGroup (Fin n) ℝ where
  toFun g := g.rot
  map_one' := rfl
  map_mul' _ _ := rfl

/-- AA-188. The point group of a subgroup `G` of `E(n)`: the orthogonal parts of its elements. -/
def pointGroup {n : ℕ} (G : Subgroup (EuclideanGroup n)) :
    Subgroup (Matrix.orthogonalGroup (Fin n) ℝ) :=
  ((rotHom n).comp G.subtype).range

/-- AA-188. The translation subgroup of a subgroup `G` of `E(n)`: the elements of `G` of the form
`(1, x)`, as a subgroup of `G`. -/
def translationSubgroup {n : ℕ} (G : Subgroup (EuclideanGroup n)) : Subgroup G :=
  ((rotHom n).comp G.subtype).ker

instance translationSubgroup_normal {n : ℕ} (G : Subgroup (EuclideanGroup n)) :
    (translationSubgroup G).Normal :=
  MonoidHom.normal_ker _

/-- AA-188. An element of `G` lies in the translation subgroup iff its orthogonal part is `1`. -/
theorem mem_translationSubgroup_iff {n : ℕ} (G : Subgroup (EuclideanGroup n)) (g : G) :
    g ∈ translationSubgroup G ↔ (g : EuclideanGroup n).rot = 1 := Iff.rfl

/-- AA-188. The translation subgroup is normal in `G`, and `G / T ≅ G₀` (the point group). -/
@[kb "judson2026" "Definition 12.2.1, p. 170"]
noncomputable def quotientTranslationEquivPointGroup {n : ℕ} (G : Subgroup (EuclideanGroup n)) :
    (G ⧸ translationSubgroup G) ≃* pointGroup G :=
  QuotientGroup.quotientKerEquivRange ((rotHom n).comp G.subtype)

end EuclideanGroup

/-- AA-184. The symmetry group of a subset `X` of `ℝⁿ`: the isometries of `ℝⁿ` mapping `X`
onto itself. -/
@[kb "judson2026" "Definition 12.2, p. 167"]
def symmetryGroup (X : Set (EuclideanSpace ℝ (Fin n))) :
    Subgroup (EuclideanSpace ℝ (Fin n) ≃ᵢ EuclideanSpace ℝ (Fin n)) where
  carrier := {f | f '' X = X}
  mul_mem' {f g} hf hg := by
    have hf' : f '' X = X := hf
    have hg' : g '' X = X := hg
    show (f * g) '' X = X
    rw [IsometryEquiv.coe_mul, Set.image_comp, hg', hf']
  one_mem' := by
    show (1 : EuclideanSpace ℝ (Fin n) ≃ᵢ EuclideanSpace ℝ (Fin n)) '' X = X
    simp
  inv_mem' {f} hf := by
    have hf' : f '' X = X := hf
    show (f.symm : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)) '' X = X
    calc (f.symm : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)) '' X
        = f.symm '' (f '' X) := by rw [hf']
      _ = X := by
        rw [← Set.image_comp]
        have : ((f.symm : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)) ∘ f) = id :=
          funext f.symm_apply_apply
        rw [this]; simp

/-- AA-184. An isometry is a symmetry of `X` iff it maps `X` onto itself. -/
theorem mem_symmetryGroup_iff (X : Set (EuclideanSpace ℝ (Fin n)))
    (f : EuclideanSpace ℝ (Fin n) ≃ᵢ EuclideanSpace ℝ (Fin n)) :
    f ∈ symmetryGroup X ↔ f '' X = X := Iff.rfl

end Isometries

