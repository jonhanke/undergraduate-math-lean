/-! # Judson–Beezer, sections 21.1 and 21.2: algebraic and transcendental extensions

Towers of finite extensions, Kronecker's theorem, transcendental simple extensions, the field of
algebraic numbers is not finite over `ℚ`, finite extensions are finitely generated by algebraic
elements, and extension of isomorphisms to simple extensions and splitting fields.
-/

namespace UndergradKB.AbstractAlgebra

open Polynomial IntermediateField

section tower

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- AA-377. For a chain `A₀ ⊆ A₁ ⊆ ⋯ ⊆ A_n` of intermediate fields, the relative degree
`[A_n : A₀]` is the product of the successive degrees `[A_{i+1} : A_i]`
(`relfinrank A B` is `[B : A]` for `A ≤ B`). -/
@[kb "judson2026" "Corollary 21.1.18, p. 290"]
theorem relfinrank_chain (A : ℕ → IntermediateField F E) (hA : Monotone A) (n : ℕ) :
    (A 0).relfinrank (A n) = ∏ i ∈ Finset.range n, (A i).relfinrank (A (i + 1)) := by
  induction n with
  | zero => simp [IntermediateField.relfinrank_self]
  | succ n ih =>
    rw [Finset.prod_range_succ, ← ih,
      IntermediateField.relfinrank_mul_relfinrank (hA (Nat.zero_le n)) (hA (Nat.le_succ n))]

end tower

/-- AA-366 (Kronecker). Every nonconstant polynomial over a field `F` has a root in some extension
field `E` of `F`. -/
@[kb "judson2026" "Theorem 21.1.5, p. 285"]
theorem exists_extension_root.{u} {F : Type u} [Field F] (p : F[X]) (hp : 0 < p.natDegree) :
    ∃ (E : Type u) (_ : Field E) (_ : Algebra F E) (α : E), aeval α p = 0 := by
  have hnu : ¬ IsUnit p := fun h => by
    have := natDegree_eq_zero_of_isUnit h
    omega
  have hp0 : p ≠ 0 := by
    rintro rfl
    simp at hp
  obtain ⟨g, hg, hdvd⟩ := WfDvdMonoid.exists_irreducible_factor hnu hp0
  have := Fact.mk hg
  refine ⟨AdjoinRoot g, inferInstance, inferInstance, AdjoinRoot.root g, ?_⟩
  rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_eq_zero]
  exact hdvd

section transcendental

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- AA-369. An element `α` is transcendental over `F` iff `F(α)` is isomorphic over `F` to the field
of rational functions `F(x)`. -/
@[kb "judson2026" "Theorem 21.1.9, p. 287"]
theorem transcendental_iff_nonempty_algEquiv_ratFunc (α : E) :
    Transcendental F α ↔ Nonempty (RatFunc F ≃ₐ[F] F⟮α⟯) := by
  constructor
  · intro h
    exact ⟨RatFunc.algEquivOfTranscendental α h⟩
  · rintro ⟨e⟩ halg
    have hfin : FiniteDimensional F F⟮α⟯ := adjoin.finiteDimensional halg.isIntegral
    have hall : Algebra.IsAlgebraic F F⟮α⟯ := Algebra.IsAlgebraic.of_finite F _
    have hR : Algebra.IsAlgebraic F (RatFunc F) := (AlgEquiv.isAlgebraic_iff e).2 hall
    have hX' : IsAlgebraic F (RatFunc.X : RatFunc F) := hR.isAlgebraic _
    have : IsAlgebraic F (Polynomial.X : F[X]) := by
      have h2 : IsAlgebraic F (algebraMap F[X] (RatFunc F) Polynomial.X) := by
        simpa using hX'
      exact (isAlgebraic_algebraMap_iff (RatFunc.algebraMap_injective F)).1 h2
    exact Polynomial.transcendental_X F this

end transcendental

section algebraic

/-- `X ^ n - 2` is irreducible over `ℚ` (Eisenstein at the prime `2`, then Gauss' lemma). -/
lemma irreducible_X_pow_sub_two {n : ℕ} (hn : 0 < n) :
    Irreducible (X ^ n - C (2 : ℚ) : ℚ[X]) := by
  have hmon : (X ^ n - C (2 : ℤ) : ℤ[X]).Monic := monic_X_pow_sub_C _ hn.ne'
  have hdeg : (X ^ n - C (2 : ℤ) : ℤ[X]).natDegree = n :=
    natDegree_X_pow_sub_C (2 : ℤ)
  have hP : (Ideal.span {(2 : ℤ)}).IsPrime := by
    rw [Ideal.span_singleton_prime (by norm_num)]
    exact Int.prime_two
  have heis : (X ^ n - C (2 : ℤ) : ℤ[X]).IsEisensteinAt (Ideal.span {(2 : ℤ)}) := by
    refine ⟨?_, ?_, ?_⟩
    · rw [hmon.leadingCoeff, Ideal.mem_span_singleton]
      norm_num
    · intro m hm
      rw [hdeg] at hm
      simp only [coeff_sub, coeff_X_pow, coeff_C, Ideal.mem_span_singleton]
      by_cases h0 : m = 0
      · subst h0
        simp [hm.ne]
      · simp [h0, hm.ne]
    · rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      simp [coeff_X_pow, hn.ne]
  have hZ := heis.irreducible hP hmon.isPrimitive (by omega)
  have := (hmon.irreducible_iff_irreducible_map_fraction_map (K := ℚ)).1 hZ
  have e : (X ^ n - C (2 : ℤ) : ℤ[X]).map (algebraMap ℤ ℚ) = X ^ n - C (2 : ℚ) := by
    simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
    simp
  rwa [e] at this

lemma rpow_inv_pow {n : ℕ} (hn : 0 < n) : ((2 : ℝ) ^ ((1 : ℝ) / n)) ^ n = 2 := by
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
  have : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  rw [one_div, inv_mul_cancel₀ this, Real.rpow_one]

lemma aeval_rpow_two {n : ℕ} (hn : 0 < n) :
    aeval ((2 : ℝ) ^ ((1 : ℝ) / n)) (X ^ n - C (2 : ℚ) : ℚ[X]) = 0 := by
  simp only [map_sub, map_pow, aeval_X, aeval_C]
  rw [rpow_inv_pow hn]
  simp

/-- The real number `2 ^ (1/n)` has degree `n` over `ℚ`. -/
lemma finrank_rpow_two {n : ℕ} (hn : 0 < n) :
    Module.finrank ℚ (IntermediateField.adjoin ℚ {(2 : ℝ) ^ ((1 : ℝ) / n)}) = n := by
  have hm : (X ^ n - C (2 : ℚ) : ℚ[X]).Monic := monic_X_pow_sub_C _ hn.ne'
  have hint : IsIntegral ℚ ((2 : ℝ) ^ ((1 : ℝ) / n)) :=
    ⟨_, hm, by simpa [aeval_def] using aeval_rpow_two hn⟩
  rw [adjoin.finrank hint,
    ← minpoly.eq_of_irreducible_of_monic (irreducible_X_pow_sub_two hn) (aeval_rpow_two hn) hm]
  exact natDegree_X_pow_sub_C (2 : ℚ)

/-- AA-375. The real algebraic numbers form an algebraic but not finite extension of `ℚ`
(they contain `2 ^ (1/n)`, of degree `n`, for every `n`). -/
@[kb "judson2026" "Remark 21.1.16, p. 289"]
theorem algebraicClosure_rat_real_not_finite :
    Algebra.IsAlgebraic ℚ (algebraicClosure ℚ ℝ) ∧
      ¬ FiniteDimensional ℚ (algebraicClosure ℚ ℝ) := by
  refine ⟨inferInstance, fun hfin => ?_⟩
  set N := Module.finrank ℚ (algebraicClosure ℚ ℝ)
  have hn : 0 < N + 1 := Nat.succ_pos N
  have hm : (X ^ (N + 1) - C (2 : ℚ) : ℚ[X]).Monic := monic_X_pow_sub_C _ hn.ne'
  have hint : IsIntegral ℚ ((2 : ℝ) ^ ((1 : ℝ) / (N + 1 : ℕ))) :=
    ⟨_, hm, by simpa [aeval_def] using aeval_rpow_two hn⟩
  have hle : IntermediateField.adjoin ℚ {(2 : ℝ) ^ ((1 : ℝ) / (N + 1 : ℕ))} ≤
      algebraicClosure ℚ ℝ :=
    (IntermediateField.adjoin_simple_le_iff).2 hint
  have hdvd := IntermediateField.finrank_dvd_of_le_right hle
  rw [finrank_rpow_two hn] at hdvd
  have hpos : 0 < N := Module.finrank_pos
  have := Nat.le_of_dvd hpos hdvd
  omega

end algebraic

section finite

variable (F E : Type*) [Field F] [Field E] [Algebra F E]

lemma finiteDimensional_adjoin_tower (n : ℕ) (α : ℕ → E)
    (hα : ∀ i < n, IsIntegral (IntermediateField.adjoin F (α '' Set.Iio i)) (α i)) :
    FiniteDimensional F (IntermediateField.adjoin F (α '' Set.Iio n)) := by
  induction n with
  | zero =>
    have h0 : α '' Set.Iio 0 = ∅ := by ext; simp
    rw [h0, IntermediateField.adjoin_empty]
    infer_instance
  | succ n ih =>
    have ih := ih (fun i hi => hα i (by omega))
    set K := IntermediateField.adjoin F (α '' Set.Iio n) with hK
    have h1 : FiniteDimensional K (IntermediateField.adjoin K {α n}) :=
      adjoin.finiteDimensional (hα n (by omega))
    have h2 : IntermediateField.adjoin F (α '' Set.Iio (n + 1)) =
        (IntermediateField.adjoin K {α n}).restrictScalars F := by
      rw [IntermediateField.adjoin_adjoin_left]
      congr 1
      ext x
      simp only [Set.mem_image, Set.mem_Iio, Set.mem_union, Set.mem_singleton_iff]
      constructor
      · rintro ⟨j, hj, rfl⟩
        rcases Nat.lt_succ_iff_lt_or_eq.1 hj with h | h
        · exact Or.inl ⟨j, h, rfl⟩
        · exact Or.inr (by rw [h])
      · rintro (⟨j, hj, rfl⟩ | rfl)
        · exact ⟨j, by omega, rfl⟩
        · exact ⟨n, by omega, rfl⟩
    rw [h2]
    have : Module.Finite F (IntermediateField.adjoin K {α n}) := by
      have : Module.Finite F K := ih
      exact Module.Finite.trans K _
    exact this

/-- Part of Theorem 21.1.22: `E / F` is finite iff `E = F(α₁, …, α_n)` for finitely many algebraic
elements (conditions (1) and (2); see `finite_tfae_tower` for the full statement). -/
@[kb "judson2026" "Theorem 21.1.22, p. 291"]
theorem finiteDimensional_iff_adjoin_finset_algebraic :
    FiniteDimensional F E ↔
      ∃ s : Finset E, (∀ a ∈ s, IsAlgebraic F a) ∧ IntermediateField.adjoin F (s : Set E) = ⊤ := by
  constructor
  · intro h
    obtain ⟨t, ht⟩ := IntermediateField.fg_of_noetherian (⊤ : IntermediateField F E)
    exact ⟨t, fun a _ => Algebra.IsAlgebraic.isAlgebraic a, ht⟩
  · rintro ⟨s, hs, htop⟩
    have h1 : FiniteDimensional F (IntermediateField.adjoin F (s : Set E)) :=
      IntermediateField.finiteDimensional_adjoin (fun x hx => (hs x hx).isIntegral)
    rw [htop] at h1
    exact LinearEquiv.finiteDimensional (IntermediateField.topEquiv (F := F) (E := E)).toLinearEquiv

/-- AA-379. For an extension `E / F` the following are equivalent: (1) `E / F` is finite; (2)
`E = F(α₁, …, α_n)` with each `αᵢ` algebraic over `F`; (3) there are `α₀, …, α_{n-1} ∈ E` with
`F_i = F(α₀, …, α_{i-1})` (as intermediate fields), each `α_i` algebraic (integral) over `F_i` for
`i < n`, and `F_n = E`. -/
@[kb "judson2026" "Theorem 21.1.22, p. 291"]
theorem finite_tfae_tower :
    List.TFAE
      [FiniteDimensional F E,
       ∃ s : Finset E, (∀ a ∈ s, IsAlgebraic F a) ∧ IntermediateField.adjoin F (s : Set E) = ⊤,
       ∃ (n : ℕ) (α : ℕ → E),
         (∀ i < n, IsIntegral (IntermediateField.adjoin F (α '' Set.Iio i)) (α i)) ∧
           IntermediateField.adjoin F (α '' Set.Iio n) = ⊤] := by
  tfae_have 1 ↔ 2 := finiteDimensional_iff_adjoin_finset_algebraic F E
  tfae_have 2 → 3 := by
    rintro ⟨s, hs, htop⟩
    refine ⟨s.card, fun i => if h : i < s.card then (s.equivFin.symm ⟨i, h⟩ : E) else 0, ?_, ?_⟩
    · intro i hi
      simp only [hi, dite_true]
      exact ((hs _ (s.equivFin.symm ⟨i, hi⟩).2).isIntegral).tower_top
    · have himg : (fun i => if h : i < s.card then (s.equivFin.symm ⟨i, h⟩ : E) else 0) ''
          Set.Iio s.card = (s : Set E) := by
        ext x
        simp only [Set.mem_image, Set.mem_Iio, Finset.mem_coe]
        constructor
        · rintro ⟨j, hj, rfl⟩
          simp only [hj, dite_true]
          exact (s.equivFin.symm ⟨j, hj⟩).2
        · intro hx
          refine ⟨(s.equivFin ⟨x, hx⟩ : ℕ), (s.equivFin ⟨x, hx⟩).2, ?_⟩
          simp
      rw [himg]
      exact htop
  tfae_have 3 → 1 := by
    rintro ⟨n, α, hα, htop⟩
    have h1 := finiteDimensional_adjoin_tower F E n α hα
    rw [htop] at h1
    exact LinearEquiv.finiteDimensional (IntermediateField.topEquiv (F := F) (E := E)).toLinearEquiv
  tfae_finish

end finite

section isomorphisms

variable {F F' K K' : Type*} [Field F] [Field F'] [Field K] [Field K'] [Algebra F K]
  [Algebra F' K']

/-- AA-388. An isomorphism `σ : F ≃ F'` of base fields extends to an isomorphism `F(α) ≃ F'(β)`
sending `α` to `β`, whenever `α` is algebraic over `F` and `β` is a root of the image under `σ` of
the minimal polynomial of `α`. -/
@[kb "judson2026" "Lemma 21.2.4, p. 293"]
theorem exists_ringEquiv_adjoin (σ : F ≃+* F') (α : K) (β : K') (hα : IsIntegral F α)
    (hβ : aeval β ((minpoly F α).map (σ : F →+* F')) = 0) :
    ∃ τ : F⟮α⟯ ≃+* F'⟮β⟯,
      (∀ x : F, τ (algebraMap F F⟮α⟯ x) = algebraMap F' F'⟮β⟯ (σ x)) ∧
        τ (AdjoinSimple.gen F α) = AdjoinSimple.gen F' β := by
  have hirr : Irreducible ((minpoly F α).map (σ : F →+* F')) :=
    (MulEquiv.irreducible_iff (Polynomial.mapEquiv σ).toMulEquiv (x := minpoly F α)).2
      (minpoly.irreducible hα)
  have hmon : ((minpoly F α).map (σ : F →+* F')).Monic := (minpoly.monic hα).map _
  have hβint : IsIntegral F' β := ⟨_, hmon, by simpa [aeval_def] using hβ⟩
  have hmin : (minpoly F α).map (σ : F →+* F') = minpoly F' β :=
    minpoly.eq_of_irreducible_of_monic hirr hβ hmon
  let e2 := AdjoinRoot.mapRingEquiv σ (minpoly F α) (minpoly F' β) (by rw [← hmin])
  refine ⟨(adjoinRootEquivAdjoin F hα).symm.toRingEquiv.trans
    (e2.trans (adjoinRootEquivAdjoin F' hβint).toRingEquiv), ?_, ?_⟩
  · intro x
    have h2 := (adjoinRootEquivAdjoin F' hβint).commutes (σ x)
    simp [e2]
    exact h2
  · simp [e2]
    exact adjoinRootEquivAdjoin_apply_root F' hβint

/-- AA-389. An isomorphism `σ : F ≃ F'` of base fields extends to an isomorphism of splitting fields
`K ≃ K'` of `p` over `F` and of `σ(p)` over `F'`. -/
@[kb "judson2026" "Theorem 21.2.6, p. 294"]
theorem exists_ringEquiv_of_isSplittingField (σ : F ≃+* F') (p : F[X])
    [IsSplittingField F K p] [IsSplittingField F' K' (p.map (σ : F →+* F'))] :
    ∃ τ : K ≃+* K', ∀ x : F, τ (algebraMap F K x) = algebraMap F' K' (σ x) := by
  let _ : Algebra F K' := ((algebraMap F' K').comp (σ : F →+* F')).toAlgebra
  have halg : ∀ x : F, algebraMap F K' x = algebraMap F' K' (σ x) := fun x => rfl
  have hsplit : IsSplittingField F K' p := by
    refine ⟨?_, ?_⟩
    · have := IsSplittingField.splits K' (p.map (σ : F →+* F'))
      rwa [Polynomial.map_map] at this
    · have hroot : p.rootSet K' = (p.map (σ : F →+* F')).rootSet K' := by
        rw [rootSet, aroots, rootSet, aroots, Polynomial.map_map]
        rfl
      rw [hroot]
      rw [eq_top_iff]
      have key : ∀ x ∈ Algebra.adjoin F' ((p.map (σ : F →+* F')).rootSet K' : Set K'),
          x ∈ Algebra.adjoin F ((p.map (σ : F →+* F')).rootSet K' : Set K') := by
        intro x hx
        induction hx using Algebra.adjoin_induction with
        | mem x hx => exact Algebra.subset_adjoin hx
        | algebraMap y =>
          have : algebraMap F' K' y = algebraMap F K' (σ.symm y) := by
            rw [halg]; simp
          rw [this]; exact Subalgebra.algebraMap_mem _ _
        | add x y _ _ hx hy => exact Subalgebra.add_mem _ hx hy
        | mul x y _ _ hx hy => exact Subalgebra.mul_mem _ hx hy
      intro x _
      apply key
      rw [IsSplittingField.adjoin_rootSet]; trivial
  refine ⟨((IsSplittingField.algEquiv K p).trans (IsSplittingField.algEquiv K' p).symm).toRingEquiv,
    fun x => ?_⟩
  exact ((IsSplittingField.algEquiv K p).trans (IsSplittingField.algEquiv K' p).symm).commutes x

/-- AA-389 (uniqueness). Two splitting fields of the same polynomial over `F` are isomorphic over
`F`. -/
@[kb "judson2026" "Corollary 21.2.8, p. 294"]
theorem splittingField_unique [Algebra F K'] (p : F[X]) [IsSplittingField F K p]
    [IsSplittingField F K' p] : Nonempty (K ≃ₐ[F] K') :=
  ⟨(IsSplittingField.algEquiv K p).trans (IsSplittingField.algEquiv K' p).symm⟩

end isomorphisms

end UndergradKB.AbstractAlgebra
