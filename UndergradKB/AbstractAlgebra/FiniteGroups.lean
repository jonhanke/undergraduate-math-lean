/-! ## Chapter 13 -/

/-- AA-193. `g` lies in the subgroup generated by `s` iff `g` is a finite product of integer powers
of elements of `s`. -/
@[kb "judson2026" "Proposition 13.1.3, p. 177"]
theorem mem_closure_iff_exists_list {G : Type*} [Group G] (s : Set G) (g : G) :
    g ∈ Subgroup.closure s ↔
      ∃ l : List (G × ℤ), (∀ p ∈ l, p.1 ∈ s) ∧ g = (l.map fun p => p.1 ^ p.2).prod := by
  constructor
  · intro hg
    induction hg using Subgroup.closure_induction with
    | mem x hx => exact ⟨[(x, 1)], by simpa using hx, by simp⟩
    | one => exact ⟨[], by simp, by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨l1, h1, e1⟩ := hx
      obtain ⟨l2, h2, e2⟩ := hy
      refine ⟨l1 ++ l2, fun p hp => ?_, by simp [e1, e2]⟩
      rcases List.mem_append.1 hp with h | h
      exacts [h1 p h, h2 p h]
    | inv x _ hx =>
      obtain ⟨l, h1, e1⟩ := hx
      refine ⟨(l.map fun p => (p.1, -p.2)).reverse, fun p hp => ?_, ?_⟩
      · obtain ⟨q, hq, rfl⟩ := List.mem_map.1 (List.mem_reverse.1 hp)
        exact h1 q hq
      · rw [e1, List.prod_inv_reverse]
        simp [Function.comp_def, List.map_reverse]
  · rintro ⟨l, hl, rfl⟩
    refine list_prod_mem ?_
    intro x hx
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
    exact zpow_mem (Subgroup.subset_closure (hl p hp)) _

section PrimaryDecomposition

open Subgroup

variable (G : Type*) [CommGroup G] [Finite G]

/-- The `p`-primary component of a finite abelian group has order the `p`-part of `|G|`. -/
theorem card_primaryComponent (p : ℕ) [hp : Fact p.Prime] :
    Nat.card (CommGroup.primaryComponent G p) = p ^ (Nat.card G).factorization p := by
  obtain ⟨P⟩ := (inferInstance : Nonempty (Sylow p G))
  have h1 : (P : Subgroup G) ≤ CommGroup.primaryComponent G p := by
    intro g hg
    obtain ⟨k, hk⟩ := P.isPGroup ⟨g, hg⟩
    exact ⟨k, by simpa using congrArg Subtype.val hk⟩
  obtain ⟨Q, hQ⟩ := (CommGroup.primaryComponent.isPGroup (G := G) (p := p)).exists_le_sylow
  have e1 := Subgroup.card_le_of_le h1
  have e2 := Subgroup.card_le_of_le hQ
  rw [Sylow.card_eq_multiplicity] at e1 e2
  exact le_antisymm e2 e1

/-- The primary components of a finite abelian group for the primes dividing `|G|` are independent. -/
theorem iSupIndep_primaryComponent :
    iSupIndep (fun p : (Nat.card G).primeFactors => CommGroup.primaryComponent G (p : ℕ)) := by
  have hfact : ∀ p : (Nat.card G).primeFactors, Fact (p : ℕ).Prime :=
    fun p => ⟨Nat.prime_of_mem_primeFactors p.prop⟩
  have := fun p : (Nat.card G).primeFactors =>
    Fintype.ofFinite (CommGroup.primaryComponent G (p : ℕ))
  refine independent_of_coprime_order (fun _ _ _ x y _ _ => Commute.all x y) fun p₁ p₂ hne => ?_
  have h1 := card_primaryComponent G p₁
  have h2 := card_primaryComponent G p₂
  beta_reduce
  rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, h1, h2]
  exact Nat.Coprime.pow _ _ ((Nat.coprime_primes (hfact p₁).out (hfact p₂).out).2
    (fun h => hne (Subtype.ext h)))

/-- The product map from the primary components of a finite abelian group onto `G` is bijective. -/
theorem primaryComponents_bijective :
    Function.Bijective (Subgroup.noncommPiCoprod
      (H := fun p : (Nat.card G).primeFactors => CommGroup.primaryComponent G (p : ℕ))
      (fun _ _ _ x y _ _ => Commute.all x y)) := by
  have hfact : ∀ p : (Nat.card G).primeFactors, Fact (p : ℕ).Prime :=
    fun p => ⟨Nat.prime_of_mem_primeFactors p.prop⟩
  refine Nat.bijective_iff_injective_and_card _ |>.mpr
    ⟨injective_noncommPiCoprod_of_iSupIndep (iSupIndep_primaryComponent G), ?_⟩
  simp_rw [Nat.card_pi, card_primaryComponent]
  exact (Nat.prod_primeFactors_coe_pow_factorization (Nat.card_pos (α := G)).ne').symm

/-- AA-197. A finite abelian group is the internal direct product of its `p`-primary components
(the subgroups of elements of `p`-power order, `CommGroup.primaryComponent G p`), one for each
prime `p` dividing `|G|`: the components are independent (each meets the join of the others
trivially; elements of different components commute since `G` is abelian) and their join is `G`. -/
@[kb "judson2026" "Lemma 13.1.8, p. 178"]
theorem abelian_internal_direct_product_primary :
    iSupIndep (fun p : (Nat.card G).primeFactors => CommGroup.primaryComponent G (p : ℕ)) ∧
    ⨆ p : (Nat.card G).primeFactors, CommGroup.primaryComponent G (p : ℕ) = ⊤ := by
  refine ⟨iSupIndep_primaryComponent G, ?_⟩
  rw [← Subgroup.noncommPiCoprod_range (hcomm := fun _ _ _ x y _ _ => Commute.all x y),
    MonoidHom.range_eq_top]
  exact (primaryComponents_bijective G).2

/-- AA-197, packaged isomorphism: `G ≅ ∏ₚ (p-primary component of G)`, product over the primes
dividing `|G|`. -/
@[kb "judson2026" "Lemma 13.1.8, p. 178"]
noncomputable def abelianPrimaryEquiv :
    (∀ p : (Nat.card G).primeFactors, CommGroup.primaryComponent G (p : ℕ)) ≃* G :=
  MulEquiv.ofBijective _ (primaryComponents_bijective G)

end PrimaryDecomposition

section Complement

open Subgroup

/-- AA-198 (Lemma 13.1.9). Let `G` be a finite abelian `p`-group and `g` an element of maximal order.
Then `⟨g⟩` has a complement `K`: `⟨g⟩ ∩ K = 1` and `⟨g⟩ K = G`. -/
@[kb "judson2026" "Lemma 13.1.9, p. 179"]
theorem exists_complement_of_max_order {G : Type*} [CommGroup G] [Finite G] {p : ℕ}
    [hp : Fact p.Prime] (hG : IsPGroup p G) (g : G) (hg : ∀ x : G, orderOf x ≤ orderOf g) :
    ∃ K : Subgroup G, zpowers g ⊓ K = ⊥ ∧ zpowers g ⊔ K = ⊤ := by
  classical
  obtain ⟨n, hn⟩ := (IsPGroup.iff_orderOf.1 hG) g
  have hexp : ∀ x : G, x ^ (p ^ n) = 1 := by
    intro x
    obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.1 hG) x
    have h1 := hg x
    rw [hk, hn] at h1
    have h2 : k ≤ n := (Nat.pow_le_pow_iff_right hp.out.one_lt).1 h1
    rw [← orderOf_dvd_iff_pow_eq_one, hk]
    exact pow_dvd_pow p h2
  have := Fintype.ofFinite (Subgroup G)
  -- `K` maximal (by order) among subgroups meeting `⟨g⟩` trivially
  obtain ⟨K, hKS, hKmax⟩ := Finset.exists_max_image
    (Finset.univ.filter (fun K : Subgroup G => zpowers g ⊓ K = ⊥)) (fun K => Nat.card K)
    ⟨⊥, by simp⟩
  rw [Finset.mem_filter] at hKS
  refine ⟨K, hKS.2, ?_⟩
  by_contra hne
  set L := zpowers g ⊔ K with hL
  obtain ⟨y, hy⟩ : ∃ y : G, y ∉ L := by
    by_contra h
    exact hne (eq_top_iff.2 fun y _ => not_not.1 fun hy => h ⟨y, hy⟩)
  -- an element outside `L` whose `p`-th power lies in `L`
  have hex : ∃ j : ℕ, y ^ (p ^ j) ∈ L := ⟨n, by rw [hexp y]; exact one_mem _⟩
  let j := Nat.find hex
  have hj : y ^ (p ^ j) ∈ L := Nat.find_spec hex
  have hj0 : j ≠ 0 := by
    intro h0
    rw [h0] at hj
    simp at hj
    exact hy hj
  obtain ⟨j', hj'⟩ := Nat.exists_eq_succ_of_ne_zero hj0
  have hx : y ^ (p ^ j') ∉ L := Nat.find_min hex (by omega)
  have hxp : (y ^ (p ^ j')) ^ p ∈ L := by
    rw [← pow_mul, ← pow_succ]
    rw [hj'] at hj
    exact hj
  obtain ⟨x, hx, hxp⟩ : ∃ x : G, x ∉ L ∧ x ^ p ∈ L := ⟨_, hx, hxp⟩
  have hn1 : 1 ≤ n := by
    by_contra h0
    have h00 : n = 0 := by omega
    have := hexp x
    rw [h00, pow_zero, pow_one] at this
    rw [this] at hx
    exact hx (one_mem _)
  -- `x ^ p = g ^ a * k`, and `p ∣ a` because `x ^ (p ^ n) = 1`
  obtain ⟨u, hu, k, hk, huk⟩ := Subgroup.mem_sup.1 hxp
  obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.1 hu
  have hpn : p ^ n = p * p ^ (n - 1) := by
    rw [← pow_succ']; congr 1; omega
  have h1 : (x ^ p) ^ (p ^ (n - 1)) = 1 := by
    rw [← pow_mul, ← hpn]; exact hexp x
  rw [← huk, mul_pow, ← zpow_natCast, ← zpow_mul] at h1
  have h2 : g ^ (a * ((p ^ (n - 1) : ℕ) : ℤ)) ∈ K := by
    have : g ^ (a * ((p ^ (n - 1) : ℕ) : ℤ)) = (k ^ (p ^ (n - 1)))⁻¹ :=
      eq_inv_of_mul_eq_one_left h1
    rw [this]
    exact inv_mem (pow_mem hk _)
  have h3 : g ^ (a * ((p ^ (n - 1) : ℕ) : ℤ)) = 1 := by
    have : g ^ (a * ((p ^ (n - 1) : ℕ) : ℤ)) ∈ zpowers g ⊓ K :=
      ⟨Subgroup.zpow_mem _ (Subgroup.mem_zpowers g) _, h2⟩
    rw [hKS.2] at this
    exact this
  have h4 := (orderOf_dvd_iff_zpow_eq_one).2 h3
  rw [hn, hpn] at h4
  have h5 : (p : ℤ) ∣ a := by
    push_cast at h4
    have hne0 : ((p : ℤ) ^ (n - 1)) ≠ 0 := pow_ne_zero _ (by exact_mod_cast hp.out.ne_zero)
    exact Int.dvd_of_mul_dvd_mul_right hne0 h4
  obtain ⟨b, rfl⟩ := h5
  -- replace `x` by `x' = x g ^ (-b)`, with `x' ^ p = k ∈ K`
  have hx'p : (x * g ^ (-b)) ^ p = k := by
    rw [mul_pow, ← huk, ← zpow_natCast (g ^ (-b)), ← zpow_mul, mul_right_comm, ← zpow_add]
    have : ((p : ℤ) * b + -b * (p : ℤ)) = 0 := by ring
    rw [this, zpow_zero, one_mul]
  generalize hx' : x * g ^ (-b) = x' at hx'p
  have hx'L : x' ∉ L := by
    intro h
    apply hx
    have : x = x' * g ^ b := by rw [← hx']; simp
    rw [this]
    exact mul_mem h (Subgroup.mem_sup_left (zpow_mem_zpowers g b))
  have hkL : K ≤ L := le_sup_right
  have hx'K : x' ∉ K := fun h => hx'L (hkL h)
  -- `K ⊔ ⟨x'⟩` still meets `⟨g⟩` trivially, contradicting maximality of `K`
  have hK'S : zpowers g ⊓ (K ⊔ zpowers x') = ⊥ := by
    rw [eq_bot_iff]
    intro z hz
    obtain ⟨hzA, hzK'⟩ := hz
    obtain ⟨k', hk', w, hw, hkw⟩ := Subgroup.mem_sup.1 hzK'
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.1 hw
    have hpi : (p : ℤ) ∣ i := by
      by_contra hpi
      have hcop : IsCoprime (p : ℤ) i :=
        (Prime.coprime_iff_not_dvd (Nat.prime_iff_prime_int.1 hp.out)).2 hpi
      obtain ⟨s, t, hst⟩ := hcop
      have hxi : x' ^ i ∈ L := by
        have : x' ^ i = k'⁻¹ * z := by rw [← hkw]; group
        rw [this]
        exact mul_mem (inv_mem (hkL hk')) (Subgroup.mem_sup_left hzA)
      have e : (p : ℤ) * s + i * t = 1 := by linarith
      have hxe : (x' ^ p) ^ s * (x' ^ i) ^ t = x' := by
        rw [← zpow_natCast, ← zpow_mul, ← zpow_mul, ← zpow_add, e, zpow_one]
      apply hx'L
      rw [← hxe]
      refine mul_mem (zpow_mem ?_ _) (zpow_mem hxi _)
      rw [hx'p]
      exact hkL hk
    obtain ⟨m, rfl⟩ := hpi
    have hzK : z ∈ K := by
      rw [zpow_mul, zpow_natCast, hx'p] at hkw
      rw [← hkw]
      exact mul_mem hk' (zpow_mem hk m)
    have : z ∈ zpowers g ⊓ K := ⟨hzA, hzK⟩
    rwa [hKS.2] at this
  have hlt : K < K ⊔ zpowers x' := by
    refine lt_of_le_of_ne le_sup_left (fun h => hx'K ?_)
    rw [h]
    exact Subgroup.mem_sup_right (mem_zpowers x')
  have hle := hKmax (K ⊔ zpowers x') (Finset.mem_filter.2 ⟨Finset.mem_univ _, hK'S⟩)
  exact absurd (Subgroup.card_lt_of_lt hlt) (not_lt.2 hle)

end Complement

/-! ## Chapter 15 -/

section Counting

open MulAction Pointwise

variable {G : Type*} [Group G]

/-- AA-234. Product formula `|H K| · |H ∩ K| = |H| · |K|` (so `|H K| = |H||K| / |H ∩ K|`)
for subgroups `H`, `K`, with `H K` the product set. (Stated with `Nat.card`, so it holds for
arbitrary subgroups.) -/
@[kb "judson2026" "Lemma 15.2.10, p. 205"]
theorem card_mul_set_mul_card_inf (H K : Subgroup G) :
    Nat.card ((H : Set G) * (K : Set G)) * Nat.card (H ⊓ K : Subgroup G) =
      Nat.card H * Nat.card K := by
  rw [Subgroup.card_mul_eq_card_subgroup_mul_card_quotient]
  have h1 : ((H : Set G).image (↑) : Set (G ⧸ K)) = orbit H ((1 : G) : G ⧸ K) := by
    ext x
    induction x using QuotientGroup.induction_on with
    | H g => simp [mem_orbit_iff, Subgroup.smul_def]
  have h3 : stabilizer H ((1 : G) : G ⧸ K) = K.subgroupOf H := by
    ext x
    simp [mem_stabilizer_iff, Subgroup.smul_def]
    rw [QuotientGroup.eq]
    simp [Subgroup.mem_subgroupOf]
  have h4 : Nat.card (orbit H ((1 : G) : G ⧸ K)) = K.relIndex H := by
    rw [Subgroup.relIndex, ← h3, index_stabilizer, Nat.card_coe_set_eq]
  rw [h1, h4]
  have := Subgroup.relIndex_mul_card (H := K) (K := H)
  rw [mul_comm (Nat.card K), mul_assoc, ← this, inf_comm]
  ring

/-- `g • K = K` for the conjugation action iff `g` normalizes `K`. -/
theorem conj_smul_eq_iff (K : Subgroup G) (g : G) :
    MulAut.conj g • K = K ↔ g ∈ Subgroup.normalizer (K : Set G) := by
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  rfl

/-- AA-229. The number of `H`-conjugates `h K h⁻¹` (`h ∈ H`) of a subgroup `K` equals the index
`[H : N_G(K) ∩ H]`. -/
@[kb "judson2026" "Lemma 15.1.6, p. 202"]
theorem card_conjugates (H K : Subgroup G) :
    {L : Subgroup G | ∃ h ∈ H, MulAut.conj h • K = L}.ncard
      = (Subgroup.normalizer (K : Set G) ⊓ H).relIndex H := by
  let : MulAction H (Subgroup G) := MulAction.compHom _ (MulAut.conj.comp H.subtype)
  have h1 : stabilizer H K = (Subgroup.normalizer (K : Set G) ⊓ H).subgroupOf H := by
    ext x
    simp only [mem_stabilizer_iff, Subgroup.mem_subgroupOf, Subgroup.mem_inf]
    rw [← conj_smul_eq_iff]
    simp
    exact Iff.rfl
  have h2 : {L : Subgroup G | ∃ h ∈ H, MulAut.conj h • K = L} = orbit H K := by
    ext L
    simp [mem_orbit_iff]
    constructor <;> rintro ⟨a, b, h⟩ <;> exact ⟨a, b, h⟩
  rw [h2, Subgroup.relIndex, ← h1, index_stabilizer]

end Counting

section OrderPQ

variable {G : Type*} [Group G]

/-- The `p`-part of a group of order `p q` is just `p`. -/
theorem sylow_card_pq {p q : ℕ} [hp : Fact p.Prime] [hq : Fact q.Prime] (hpq : p ≠ q)
    [Finite G] (hG : Nat.card G = p * q) (P : Sylow p G) : Nat.card P = p := by
  rw [Sylow.card_eq_multiplicity, hG, Nat.factorization_mul hp.out.ne_zero hq.out.ne_zero]
  simp [hp.out.factorization, hq.out.factorization, hpq]

/-- In a group of order `p q`, the number of Sylow `p`-subgroups is `1` or `q ≡ 1 (mod p)`. -/
theorem sylow_count_pq {p q : ℕ} [hp : Fact p.Prime] [hq : Fact q.Prime] (hpq : p ≠ q)
    [Finite G] (hG : Nat.card G = p * q) :
    Nat.card (Sylow p G) = 1 ∨ q ≡ 1 [MOD p] := by
  obtain ⟨P⟩ := (inferInstance : Nonempty (Sylow p G))
  have h1 : Nat.card (Sylow p G) ∣ q := by
    have h2 := P.card_dvd_index
    have h3 : P.index ∣ q := by
      have := sylow_card_pq hpq hG P
      have h4 := Subgroup.index_mul_card (H := (P : Subgroup G))
      rw [this, hG, mul_comm] at h4
      exact (Nat.eq_of_mul_eq_mul_left hp.out.pos h4) ▸ dvd_rfl
    exact h2.trans h3
  rcases (Nat.dvd_prime hq.out).1 h1 with h | h
  · exact Or.inl h
  · right
    have := card_sylow_modEq_one (p := p) (G := G)
    rwa [h] at this

/-- For primes `p < q` and `|G| = p q`, there is a unique Sylow `q`-subgroup. -/
theorem sylow_count_larger_prime {p q : ℕ} [hp : Fact p.Prime] [hq : Fact q.Prime] (hpq : p < q)
    [Finite G] (hG : Nat.card G = p * q) : Nat.card (Sylow q G) = 1 := by
  have hG' : Nat.card G = q * p := by rw [hG, mul_comm]
  rcases sylow_count_pq hpq.ne' hG' with h | h
  · exact h
  · exfalso
    have := h
    rw [Nat.ModEq, Nat.mod_eq_of_lt hpq, Nat.mod_eq_of_lt hq.out.one_lt] at this
    exact hp.out.one_lt.ne' this

/-- AA-232 (first part). If `p < q` are primes and `|G| = p q`, then `G` has a normal subgroup
of order `q`; in particular `G` is not simple (when `p > 1`). -/
@[kb "judson2026" "Theorem 15.2.2, p. 203"]
theorem exists_normal_subgroup_card_of_card_eq_mul_primes {p q : ℕ} [hp : Fact p.Prime]
    [hq : Fact q.Prime] (hpq : p < q) [Finite G] (hG : Nat.card G = p * q) :
    ∃ N : Subgroup G, N.Normal ∧ Nat.card N = q := by
  have hG' : Nat.card G = q * p := by rw [hG, mul_comm]
  have hc := sylow_count_larger_prime hpq hG
  have : Subsingleton (Sylow q G) := (Nat.card_eq_one_iff_unique.1 hc).1
  obtain ⟨P⟩ := (inferInstance : Nonempty (Sylow q G))
  exact ⟨P, Sylow.normal_of_subsingleton P, sylow_card_pq hpq.ne' hG' P⟩

/-- AA-232 (second part). If `p < q` are primes, `|G| = p q` and `q ≢ 1 (mod p)`, then `G` is
cyclic. -/
@[kb "judson2026" "Theorem 15.2.2, p. 203"]
theorem isCyclic_of_card_eq_mul_primes {p q : ℕ} [hp : Fact p.Prime] [hq : Fact q.Prime]
    (hpq : p < q) [Finite G] (hG : Nat.card G = p * q) (h : ¬ q ≡ 1 [MOD p]) : IsCyclic G := by
  have hne : q ≠ p := hpq.ne'
  have hG' : Nat.card G = q * p := by rw [hG, mul_comm]
  have hc := sylow_count_larger_prime hpq hG
  have hc' : Nat.card (Sylow p G) = 1 := (sylow_count_pq hpq.ne hG).resolve_right h
  have := (Nat.card_eq_one_iff_unique.1 hc).1
  have := (Nat.card_eq_one_iff_unique.1 hc').1
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := G) p ⟨q, hG⟩
  obtain ⟨y, hy⟩ := exists_prime_orderOf_dvd_card' (G := G) q ⟨p, hG'⟩
  have hxP : ∀ P : Sylow p G, x ∈ P := by
    intro P
    have hpg := IsPGroup.of_card (G := Subgroup.zpowers x) (p := p) (n := 1)
      (((Nat.card_zpowers x).trans hx).trans (pow_one p).symm)
    obtain ⟨Q, hQ⟩ := hpg.exists_le_sylow
    rw [Subsingleton.elim P Q]
    exact hQ (Subgroup.mem_zpowers x)
  have hyQ : ∀ Q : Sylow q G, y ∈ Q := by
    intro P
    have hpg := IsPGroup.of_card (G := Subgroup.zpowers y) (p := q) (n := 1)
      (((Nat.card_zpowers y).trans hy).trans (pow_one q).symm)
    obtain ⟨Q, hQ⟩ := hpg.exists_le_sylow
    rw [Subsingleton.elim P Q]
    exact hQ (Subgroup.mem_zpowers y)
  obtain ⟨P⟩ := (inferInstance : Nonempty (Sylow p G))
  obtain ⟨Q⟩ := (inferInstance : Nonempty (Sylow q G))
  have hdis : Disjoint (P : Subgroup G) (Q : Subgroup G) := by
    apply Subgroup.disjoint_of_coprime_natCard
    rw [sylow_card_pq hpq.ne hG P, sylow_card_pq hne hG' Q]
    exact (Nat.coprime_primes hp.out hq.out).2 hpq.ne
  have hcomm : Commute x y :=
    Subgroup.commute_of_normal_of_disjoint _ _ (Sylow.normal_of_subsingleton P)
      (Sylow.normal_of_subsingleton Q) hdis x y (hxP P) (hyQ Q)
  apply isCyclic_of_orderOf_eq_card (x * y)
  rw [hcomm.orderOf_mul_eq_mul_orderOf_of_coprime, hx, hy, hG]
  rw [hx, hy]
  exact (Nat.coprime_primes hp.out hq.out).2 hpq.ne

end OrderPQ

end UndergradKB.AbstractAlgebra
