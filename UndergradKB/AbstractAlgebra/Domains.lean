/-- AA-313. In `ℤ[x]` the ideal generated by `5` and `x` is not principal. -/
@[kb "judson2026" "Example 18.2.10, p. 252"]
theorem not_isPrincipal_span_five_X :
    ¬ (Ideal.span {(C 5 : ℤ[X]), X}).IsPrincipal := by
  intro ⟨g, hg⟩
  have hg0 : g ∈ Ideal.span {(C 5 : ℤ[X]), X} := by rw [hg]; exact Ideal.mem_span_singleton_self g
  have h5 : g ∣ (C 5 : ℤ[X]) := by
    have : (C 5 : ℤ[X]) ∈ Ideal.span {(C 5 : ℤ[X]), X} := Ideal.subset_span (by simp)
    rw [hg] at this
    exact Ideal.mem_span_singleton.mp this
  have hX : g ∣ (X : ℤ[X]) := by
    have : (X : ℤ[X]) ∈ Ideal.span {(C 5 : ℤ[X]), X} := Ideal.subset_span (by simp)
    rw [hg] at this
    exact Ideal.mem_span_singleton.mp this
  have hdeg : g.natDegree = 0 := by
    have := natDegree_le_of_dvd h5 (by simp)
    simpa using this
  have hgC : g = C (g.coeff 0) := eq_C_of_natDegree_eq_zero hdeg
  obtain ⟨h, hh⟩ := hX
  have hc : g.coeff 0 * h.coeff 1 = 1 := by
    have := congrArg (fun p => p.coeff 1) hh
    simp only [coeff_X_one] at this
    rw [hgC, coeff_C_mul] at this
    simpa using this.symm
  have hu : IsUnit g := by
    rw [hgC]
    exact isUnit_C.mpr (IsUnit.of_mul_eq_one _ hc)
  have h1 : Ideal.span {(C 5 : ℤ[X]), X} = ⊤ := Ideal.eq_top_of_isUnit_mem _ hg0 hu
  have hle : Ideal.span {(C 5 : ℤ[X]), X} ≤
      RingHom.ker ((Int.castRingHom (ZMod 5)).comp (Polynomial.evalRingHom 0)) := by
    rw [Ideal.span_le]
    intro x hx
    rcases hx with rfl | rfl
    · simp [RingHom.mem_ker]; decide
    · simp [RingHom.mem_ker]
  rw [h1] at hle
  have : (1 : ℤ[X]) ∈ RingHom.ker ((Int.castRingHom (ZMod 5)).comp (Polynomial.evalRingHom 0)) :=
    hle Submodule.mem_top
  simp [RingHom.mem_ker] at this
  exact absurd this (by decide)

/-- AA-313, AA-326. `ℤ[x]` is a unique factorization domain but not a principal ideal domain, so a
UFD need not be a PID. -/
@[kb "judson2026" "Remark 18.2.26, p. 255"]
theorem int_polynomial_ufd_not_pid :
    UniqueFactorizationMonoid ℤ[X] ∧ ¬ IsPrincipalIdealRing ℤ[X] := by
  refine ⟨inferInstance, fun h => ?_⟩
  exact not_isPrincipal_span_five_X (h.principal _)

/-- Two is irreducible in `ℤ[√-3]`. -/
theorem irreducible_two_zsqrtd_neg_three : Irreducible (2 : ℤ√(-3)) := by
  have hn : ∀ x : ℤ√(-3), x.norm = x.re * x.re + 3 * x.im * x.im := by
    intro x; rw [Zsqrtd.norm_def]; ring
  have hunit : ∀ x : ℤ√(-3), x.norm = 1 → IsUnit x := fun x hx =>
    (Zsqrtd.norm_eq_one_iff' (by norm_num) x).mp hx
  have h2 : (2 : ℤ√(-3)).norm = 4 := by rw [hn]; simp
  refine irreducible_iff.mpr ⟨?_, ?_⟩
  · intro hu
    have := (Zsqrtd.norm_eq_one_iff' (by norm_num) _).mpr hu
    omega
  · intro a b hab
    have hnab : a.norm * b.norm = 4 := by rw [← Zsqrtd.norm_mul, ← hab, h2]
    have ha0 : 0 ≤ a.norm := Zsqrtd.norm_nonneg (by norm_num) a
    have hb0 : 0 ≤ b.norm := Zsqrtd.norm_nonneg (by norm_num) b
    have hale : a.norm ≤ 4 := by
      have : a.norm ∣ 4 := ⟨b.norm, hnab.symm⟩
      exact Int.le_of_dvd (by norm_num) this
    have ha2 : a.norm ≠ 2 := by
      intro h
      rw [hn] at h
      have h1 : a.re ≤ 1 := by nlinarith [mul_self_nonneg a.im]
      have h1' : -1 ≤ a.re := by nlinarith [mul_self_nonneg a.im]
      have h2 : a.im ≤ 0 := by nlinarith [mul_self_nonneg a.re]
      have h2' : 0 ≤ a.im := by nlinarith [mul_self_nonneg a.re]
      have : a.im = 0 := le_antisymm h2 h2'
      rw [this] at h
      have e : a.re = -1 ∨ a.re = 0 ∨ a.re = 1 := by omega
      rcases e with e | e | e <;> simp [e] at h
    have key : a.norm = 1 ∨ b.norm = 1 := by
      generalize a.norm = m at hnab ha0 hale ha2
      generalize b.norm = k at hnab hb0
      have hm : m = 0 ∨ m = 1 ∨ m = 2 ∨ m = 3 ∨ m = 4 := by omega
      rcases hm with rfl | rfl | rfl | rfl | rfl <;> omega
    rcases key with k | k
    · exact Or.inl (hunit a k)
    · exact Or.inr (hunit b k)

/-- AA-304. `ℤ[√-3]` is not a unique factorization domain: `2` is irreducible but does not
divide either factor of `4 = (1 + √-3)(1 - √-3)`. -/
@[kb "judson2026" "Example 18.2.3, p. 250"]
theorem not_ufd_zsqrtd_neg_three : ¬ UniqueFactorizationMonoid (ℤ√(-3)) := by
  intro hufd
  have hp : Prime (2 : ℤ√(-3)) :=
    (UniqueFactorizationMonoid.irreducible_iff_prime).mp irreducible_two_zsqrtd_neg_three
  have hdvd : (2 : ℤ√(-3)) ∣ (Zsqrtd.mk 1 1) * (Zsqrtd.mk 1 (-1)) := by
    refine ⟨2, ?_⟩
    ext <;> simp
  rcases hp.dvd_or_dvd hdvd with ⟨c, hc⟩ | ⟨c, hc⟩
  · have := congrArg Zsqrtd.re hc
    simp at this
    omega
  · have := congrArg Zsqrtd.re hc
    simp at this
    omega

/-- Bridging definition for the book's Euclidean valuation: `ν` satisfies `ν a ≤ ν (a b)` for
nonzero `a, b`, and every `a` can be divided by a nonzero `b` with remainder `0` or of smaller
valuation than `b`. -/
def IsEuclideanValuation {D : Type*} [CommRing D] (ν : D → ℕ) : Prop :=
  (∀ a b : D, a ≠ 0 → b ≠ 0 → ν a ≤ ν (a * b)) ∧
  ∀ a b : D, b ≠ 0 → ∃ q r : D, a = b * q + r ∧ (r = 0 ∨ ν r < ν b)

/-- AA-314. `ℤ` with `ν = |·|` satisfies the book's Euclidean valuation axioms. -/
@[kb "judson2026" "Definition Euclidean domain, p. 252"]
theorem isEuclideanValuation_int : IsEuclideanValuation Int.natAbs := by
  refine ⟨fun a b ha hb => ?_, fun a b hb => ?_⟩
  · rw [Int.natAbs_mul]
    exact Nat.le_mul_of_pos_right _ (Int.natAbs_pos.mpr hb)
  · refine ⟨a / b, a % b, (Int.mul_ediv_add_emod a b).symm, ?_⟩
    by_cases h : a % b = 0
    · exact Or.inl h
    · right
      have := Int.emod_lt a hb
      have h0 := Int.emod_nonneg a hb
      omega

/-- AA-314. `F[x]` with `ν = deg` satisfies the book's Euclidean valuation axioms. -/
theorem isEuclideanValuation_polynomial (F : Type*) [Field F] :
    IsEuclideanValuation (fun p : F[X] => p.natDegree) := by
  refine ⟨fun a b ha hb => ?_, fun a b hb => ?_⟩
  · simp only [natDegree_mul ha hb]
    omega
  · refine ⟨a / b, a % b, (EuclideanDomain.div_add_mod a b).symm, ?_⟩
    by_cases h : a % b = 0
    · exact Or.inl h
    · exact Or.inr (natDegree_lt_natDegree h (degree_mod_lt a hb))

section Example18_2_1

open MvPolynomial

/-- The subalgebra of `ℚ[x, y]` generated by `x²`, `y²` and `xy` (Example 18.2.1; we take the
generated subring to contain the rational constants). -/
noncomputable def evenSubalgebra : Subalgebra ℚ (MvPolynomial (Fin 2) ℚ) :=
  Algebra.adjoin ℚ {X 0 ^ 2, X 1 ^ 2, X 0 * X 1}

/-- The substitution `x ↦ -x`, `y ↦ -y`. -/
noncomputable def signFlip : MvPolynomial (Fin 2) ℚ →ₐ[ℚ] MvPolynomial (Fin 2) ℚ :=
  MvPolynomial.aeval fun i => - X i

theorem signFlip_X (i : Fin 2) : signFlip (X i) = - X i := by simp [signFlip]

theorem signFlip_eq_of_mem_evenSubalgebra {a : MvPolynomial (Fin 2) ℚ} (ha : a ∈ evenSubalgebra) :
    signFlip a = a := by
  have : evenSubalgebra ≤ AlgHom.equalizer signFlip (AlgHom.id ℚ (MvPolynomial (Fin 2) ℚ)) := by
    apply Algebra.adjoin_le
    rintro x (rfl | rfl | rfl) <;> simp [AlgHom.mem_equalizer, signFlip_X]
  exact this ha

theorem aux_xy_factor (a b : MvPolynomial (Fin 2) ℚ) (ha : signFlip a = a)
    (h : X 0 * X 1 = a * b) (hx : (X 0 : MvPolynomial (Fin 2) ℚ) ∣ a) : IsUnit b := by
  obtain ⟨a', rfl⟩ := hx
  have hX0 : (X 0 : MvPolynomial (Fin 2) ℚ) ≠ 0 := X_ne_zero 0
  have h1 : X 1 = a' * b := by
    apply mul_left_cancel₀ hX0
    rw [h]; ring
  rcases (MvPolynomial.prime_X (R := ℚ) (i := (1 : Fin 2))).irreducible.isUnit_or_isUnit h1 with
    hu | hu
  · exfalso
    obtain ⟨r, hr, rfl⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
    have hr0 : r ≠ 0 := hr.ne_zero
    have h2 : signFlip (X 0 * MvPolynomial.C r) = X 0 * MvPolynomial.C r := ha
    rw [map_mul, signFlip_X,
      show signFlip (MvPolynomial.C r) = MvPolynomial.C r from AlgHom.commutes signFlip r] at h2
    have h3 : (2 : MvPolynomial (Fin 2) ℚ) * (X 0 * MvPolynomial.C r) = 0 := by
      linear_combination -h2
    rcases mul_eq_zero.mp h3 with h4 | h4
    · exact two_ne_zero h4
    · rcases mul_eq_zero.mp h4 with h5 | h5
      · exact hX0 h5
      · exact hr0 (MvPolynomial.C_eq_zero.mp h5)
  · exact hu

/-- AA-301. In the subring `R` of `ℚ[x, y]` generated by `x²`, `y²`, `xy`, the element `xy` is
irreducible but not prime. -/
@[kb "judson2026" "Example 18.2.1, p. 249"]
theorem xy_irreducible_not_prime :
    ∃ p : evenSubalgebra, Irreducible p ∧ ¬ Prime p ∧ (p : MvPolynomial (Fin 2) ℚ) = X 0 * X 1 := by
  have hxy : (X 0 * X 1 : MvPolynomial (Fin 2) ℚ) ∈ evenSubalgebra :=
    Algebra.subset_adjoin (by simp)
  have hx2 : (X 0 ^ 2 : MvPolynomial (Fin 2) ℚ) ∈ evenSubalgebra :=
    Algebra.subset_adjoin (by simp)
  have hy2 : (X 1 ^ 2 : MvPolynomial (Fin 2) ℚ) ∈ evenSubalgebra :=
    Algebra.subset_adjoin (by simp)
  have hX0 : (X 0 : MvPolynomial (Fin 2) ℚ) ≠ 0 := X_ne_zero 0
  have hX1 : (X 1 : MvPolynomial (Fin 2) ℚ) ≠ 0 := X_ne_zero 1
  -- a unit of the ambient ring lying in the subalgebra is a unit of the subalgebra
  have unit_lift : ∀ b : evenSubalgebra, IsUnit (b : MvPolynomial (Fin 2) ℚ) → IsUnit b := by
    intro b hb
    obtain ⟨r, hr, hbr⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hb
    have hr' : r ≠ 0 := hr.ne_zero
    refine isUnit_iff_exists_inv.mpr ⟨⟨MvPolynomial.C r⁻¹, ?_⟩, ?_⟩
    · exact evenSubalgebra.algebraMap_mem r⁻¹
    · apply Subtype.ext
      simp [hbr, ← MvPolynomial.C_mul, hr']
  refine ⟨⟨X 0 * X 1, hxy⟩, ?_, ?_, rfl⟩
  · refine irreducible_iff.mpr ⟨?_, ?_⟩
    · intro hu
      have hu' : IsUnit (X 0 * X 1 : MvPolynomial (Fin 2) ℚ) := hu.map evenSubalgebra.val
      exact (MvPolynomial.prime_X (R := ℚ) (i := (0 : Fin 2))).not_isUnit
        (isUnit_of_mul_isUnit_left hu')
    · intro a b hab
      have hab' : (X 0 * X 1 : MvPolynomial (Fin 2) ℚ) = (a : MvPolynomial (Fin 2) ℚ) * b :=
        congrArg Subtype.val hab
      have hfa := signFlip_eq_of_mem_evenSubalgebra a.2
      have hfb := signFlip_eq_of_mem_evenSubalgebra b.2
      have hdvd : (X 0 : MvPolynomial (Fin 2) ℚ) ∣ (a : MvPolynomial (Fin 2) ℚ) * b :=
        ⟨X 1, by rw [← hab']⟩
      rcases (MvPolynomial.prime_X (R := ℚ) (i := (0 : Fin 2))).dvd_or_dvd hdvd with h | h
      · exact Or.inr (unit_lift b (aux_xy_factor _ _ hfa hab' h))
      · exact Or.inl (unit_lift a (aux_xy_factor _ _ hfb (by rw [hab']; ring) h))
  · intro hp
    have hdvd : (⟨X 0 * X 1, hxy⟩ : evenSubalgebra) ∣
        (⟨X 0 ^ 2, hx2⟩ : evenSubalgebra) * ⟨X 1 ^ 2, hy2⟩ :=
      ⟨⟨X 0 * X 1, hxy⟩, Subtype.ext (by simp; ring)⟩
    have key : ∀ (c : MvPolynomial (Fin 2) ℚ) (i j : Fin 2), i ≠ j →
        (X i ^ 2 : MvPolynomial (Fin 2) ℚ) = X i * X j * c → False := by
      intro c i j hij h
      have hXi : (X i : MvPolynomial (Fin 2) ℚ) ≠ 0 := X_ne_zero i
      have h1 : (X i : MvPolynomial (Fin 2) ℚ) = X j * c := by
        apply mul_left_cancel₀ hXi
        linear_combination h
      have h2 : (X j : MvPolynomial (Fin 2) ℚ) ∣ X i := ⟨c, h1⟩
      exact hij ((MvPolynomial.X_dvd_X (R := ℚ)).mp h2).symm
    rcases hp.dvd_or_dvd hdvd with ⟨c, hc⟩ | ⟨c, hc⟩
    · have := congrArg Subtype.val hc
      exact key c 0 1 (by decide) (by simpa using this)
    · have := congrArg Subtype.val hc
      exact key c 1 0 (by decide) (by simpa [mul_comm] using this)

end Example18_2_1

end UndergradKB.AbstractAlgebra
