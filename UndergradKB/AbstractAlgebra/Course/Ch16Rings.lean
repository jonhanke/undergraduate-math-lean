/-! # Judson–Beezer, chapter 16: rings (course layer)

Thin wrappers, in the book's terms, around Mathlib results. -/

namespace UndergradKB.AbstractAlgebra.Course

open Function

open Quaternion

/-- AA-242. The real quaternions form a noncommutative division ring: nonzero elements are
invertible, and `i j ≠ j i`. -/
@[kb "judson2026" "Example 16.1.7, p. 211"]
theorem judson_16_1_7 :
    (∀ a : ℍ[ℝ], a ≠ 0 → IsUnit a) ∧ ∃ a b : ℍ[ℝ], a * b ≠ b * a := by
  refine ⟨fun a ha => isUnit_iff_ne_zero.mpr ha, ⟨⟨0, 1, 0, 0⟩, ⟨0, 0, 1, 0⟩, ?_⟩⟩
  intro h
  have := congrArg QuaternionAlgebra.imK h
  norm_num at this

/-- AA-243. Sign rules in any ring. -/
@[kb "judson2026" "Proposition 16.1.8, p. 212"]
theorem judson_16_1_8 {R : Type*} [Ring R] (a b : R) :
    a * 0 = 0 ∧ 0 * a = 0 ∧ a * (-b) = -(a * b) ∧ (-a) * b = -(a * b) ∧ (-a) * (-b) = a * b :=
  ⟨mul_zero a, zero_mul a, mul_neg a b, neg_mul a b, neg_mul_neg a b⟩

/-- AA-246. A commutative ring with `1 ≠ 0` is an integral domain iff nonzero factors cancel. -/
@[kb "judson2026" "Proposition 16.2.4, p. 214"]
theorem judson_16_2_4 {R : Type*} [CommRing R] [Nontrivial R] :
    IsDomain R ↔ ∀ a b c : R, a ≠ 0 → a * b = a * c → b = c := by
  constructor
  · intro _ a b c ha h
    exact mul_left_cancel₀ ha h
  · intro h
    have : NoZeroDivisors R := ⟨fun {a b} hab => by
      by_contra hne
      push Not at hne
      exact hne.2 (h a b 0 hne.1 (by simpa using hab))⟩
    exact NoZeroDivisors.to_isDomain R

/-- AA-247. Every finite integral domain is a field. -/
@[kb "judson2026" "Theorem 16.2.5, p. 214"]
theorem judson_16_2_5 {R : Type*} [CommRing R] [IsDomain R] [Finite R] : IsField R :=
  Finite.isField_of_domain R

/-- AA-251. For a prime `p`, `ℤ_p` is a field of characteristic `p`. -/
@[kb "judson2026" "Example 16.2.6, p. 215"]
theorem judson_16_2_6 (p : ℕ) [Fact p.Prime] : IsField (ZMod p) ∧ CharP (ZMod p) p :=
  ⟨Field.toIsField (ZMod p), ZMod.charP p⟩

/-- AA-249. In a ring with identity the characteristic is the additive order of `1`. -/
@[kb "judson2026" "Lemma 16.2.7, p. 215"]
theorem judson_16_2_7 {R : Type*} [Ring R] : ringChar R = addOrderOf (1 : R) :=
  by
  have := CharP.addOrderOf_one R
  exact ringChar.eq R _

/-- AA-250. The characteristic of an integral domain is prime or zero. -/
@[kb "judson2026" "Theorem 16.2.8, p. 215"]
theorem judson_16_2_8 {R : Type*} [CommRing R] [IsDomain R] (p : ℕ) [CharP R p] :
    p.Prime ∨ p = 0 :=
  CharP.char_is_prime_or_zero R p

/-- AA-255. Reduction mod `n` is a ring homomorphism `ℤ → ℤ_n` with kernel `nℤ`, and
`ℤ/nℤ ≅ ℤ_n`. -/
@[kb "judson2026" "Example 16.3.1, p. 215"]
theorem judson_16_3_1 (n : ℕ) :
    RingHom.ker (Int.castRingHom (ZMod n)) = Ideal.span {(n : ℤ)} ∧
      Nonempty (ℤ ⧸ Ideal.span {(n : ℤ)} ≃+* ZMod n) :=
  ⟨ZMod.ker_intCastRingHom n, ⟨Int.quotientSpanNatEquivZMod n⟩⟩

/-- AA-257. An ideal containing a unit is the whole ring. -/
@[kb "judson2026" "Example 16.3.4, p. 216"]
theorem judson_16_3_4 {R : Type*} [CommRing R] (I : Ideal R) {u : R} (hu : IsUnit u)
    (huI : u ∈ I) : I = ⊤ :=
  Ideal.eq_top_of_isUnit_mem I huI hu

/-- AA-258. In a commutative ring, `⟨a⟩ = {a r}` (the principal ideal generated by `a`). -/
@[kb "judson2026" "Example 16.3.5, p. 216"]
theorem judson_16_3_5 {R : Type*} [CommRing R] (a : R) :
    (Ideal.span {a} : Set R) = {x | ∃ r, a * r = x} := by
  ext x
  simp [Ideal.mem_span_singleton']
  constructor <;> rintro ⟨r, hr⟩ <;> exact ⟨r, by rw [mul_comm]; exact hr⟩

/-- AA-259. Every ideal of `ℤ` is principal. -/
@[kb "judson2026" "Theorem 16.3.6, p. 216"]
theorem judson_16_3_6 (I : Ideal ℤ) : ∃ n : ℤ, I = Ideal.span {n} :=
  ⟨_, (Submodule.IsPrincipal.span_singleton_generator I).symm⟩

/-- AA-260. The kernel of a ring homomorphism is an ideal: closed under sums and under
multiplication by arbitrary ring elements on both sides. -/
@[kb "judson2026" "Proposition 16.3.8, p. 217"]
theorem judson_16_3_8 {R S : Type*} [Ring R] [Ring S] (f : R →+* S) :
    (∀ a ∈ RingHom.ker f, ∀ b ∈ RingHom.ker f, a + b ∈ RingHom.ker f) ∧
      ∀ r, ∀ a ∈ RingHom.ker f, r * a ∈ RingHom.ker f ∧ a * r ∈ RingHom.ker f := by
  refine ⟨fun a ha b hb => add_mem ha hb, fun _ a ha => ?_⟩
  rw [RingHom.mem_ker] at ha ⊢
  simp [ha]

/-- AA-261. `R/I` is a ring and `r ↦ r + I` is a surjective ring homomorphism with
kernel `I`. -/
@[kb "judson2026" "Theorem 16.3.10, p. 217"]
theorem judson_16_3_10 {R : Type*} [CommRing R] (I : Ideal R) :
    Function.Surjective (Ideal.Quotient.mk I) ∧ RingHom.ker (Ideal.Quotient.mk I) = I :=
  ⟨Ideal.Quotient.mk_surjective, Ideal.mk_ker⟩

/-- AA-262. First isomorphism theorem for rings: `R/ker ψ ≅ ψ(R)`, via `r + ker ψ ↦ ψ(r)`. -/
@[kb "judson2026" "Theorem 16.3.12, p. 218"]
theorem judson_16_3_12 {R S : Type*} [CommRing R] [CommRing S] (ψ : R →+* S) :
    ∃ e : R ⧸ RingHom.ker ψ ≃+* ψ.range, ∀ r : R, (e (Ideal.Quotient.mk _ r) : S) = ψ r :=
  ⟨RingHom.quotientKerEquivRange ψ, fun _ => rfl⟩

/-- AA-264. Third isomorphism theorem for rings: for ideals `J ⊆ I`,
`R/I ≅ (R/J)/(I/J)`. -/
@[kb "judson2026" "Theorem 16.3.14, p. 218"]
theorem judson_16_3_14 {R : Type*} [CommRing R] (I J : Ideal R) (h : J ≤ I) :
    Nonempty (R ⧸ I ≃+* (R ⧸ J) ⧸ I.map (Ideal.Quotient.mk J)) :=
  ⟨(DoubleQuot.quotQuotEquivQuotOfLE h).symm⟩

/-- AA-267. For a commutative ring `R` with `1`, `M` is maximal iff `R/M` is a field. -/
@[kb "judson2026" "Theorem 16.4.1, p. 218"]
theorem judson_16_4_1 {R : Type*} [CommRing R] (M : Ideal R) :
    M.IsMaximal ↔ IsField (R ⧸ M) :=
  Ideal.Quotient.maximal_ideal_iff_isField_quotient M

/-- AA-269. For commutative `R` with `1 ≠ 0`, `P` is prime iff `R/P` is an integral domain. -/
@[kb "judson2026" "Proposition 16.4.4, p. 219"]
theorem judson_16_4_4 {R : Type*} [CommRing R] (P : Ideal R) :
    P.IsPrime ↔ IsDomain (R ⧸ P) :=
  (Ideal.Quotient.isDomain_iff_prime P).symm

/-- AA-270. Every maximal ideal of a commutative ring with identity is prime. -/
@[kb "judson2026" "Corollary 16.4.6, p. 219"]
theorem judson_16_4_6 {R : Type*} [CommRing R] (M : Ideal R) (h : M.IsMaximal) : M.IsPrime :=
  h.isPrime

/-- AA-271. For a prime `p`, `pℤ` is maximal, and every nonzero prime ideal of `ℤ` is of this
form. -/
@[kb "judson2026" "Example 16.4.5, p. 219"]
theorem judson_16_4_5 :
    (∀ p : ℕ, p.Prime → (Ideal.span {(p : ℤ)}).IsMaximal) ∧
      ∀ P : Ideal ℤ, P.IsPrime → P ≠ ⊥ → ∃ p : ℕ, p.Prime ∧ P = Ideal.span {(p : ℤ)} := by
  refine ⟨fun p hp => haveI := Fact.mk hp; Int.ideal_span_isMaximal_of_prime p, fun P hP hbot => ?_⟩
  obtain ⟨n, rfl⟩ := judson_16_3_6 P
  have hn : n ≠ 0 := by
    rintro rfl
    exact hbot (by simp)
  have hpr : Prime n := (Ideal.span_singleton_prime hn).mp hP
  exact ⟨n.natAbs, Int.prime_iff_natAbs_prime.mp hpr, (Int.span_natAbs n).symm⟩

/-- AA-272. Chinese remainder lemma for two coprime moduli: the system
`x ≡ a (mod m)`, `x ≡ b (mod n)` has a solution, unique mod `mn`. -/
@[kb "judson2026" "Lemma 16.5.1, p. 220"]
theorem judson_16_5_1 {m n : ℕ} (h : Nat.Coprime m n) (a b : ℕ) :
    ∃ x : ℕ, x ≡ a [MOD m] ∧ x ≡ b [MOD n] ∧
      ∀ y : ℕ, y ≡ a [MOD m] → y ≡ b [MOD n] → y ≡ x [MOD m * n] :=
  ⟨_, (Nat.chineseRemainder h a b).2.1, (Nat.chineseRemainder h a b).2.2,
    fun _ h1 h2 => Nat.chineseRemainder_modEq_unique h h1 h2⟩

/-- AA-273. Chinese Remainder Theorem: for pairwise coprime nonzero moduli `n_i`
(`i` in a finite index set) the system `x ≡ a_i (mod n_i)` has a solution, unique modulo
the product. -/
@[kb "judson2026" "Theorem 16.5.3, p. 221"]
theorem judson_16_5_3 {ι : Type*} (l : List ι) (a n : ι → ℕ)
    (co : l.Pairwise (Nat.Coprime on n)) :
    ∃ x : ℕ, (∀ i ∈ l, x ≡ a i [MOD n i]) ∧
      ∀ y : ℕ, (∀ i ∈ l, y ≡ a i [MOD n i]) → y ≡ x [MOD (l.map n).prod] :=
  ⟨(Nat.chineseRemainderOfList a n l co).1, fun i hi => (Nat.chineseRemainderOfList a n l co).2 i hi,
    fun _ hy => Nat.chineseRemainderOfList_modEq_unique a n l co hy⟩

/-- AA-274. For coprime `m, n`, `ℤ_{mn} ≅ ℤ_m × ℤ_n` as rings, so `+` and `·` can be
computed componentwise. -/
@[kb "judson2026" "Example 16.5.5, p. 223"]
theorem judson_16_5_5 {m n : ℕ} (h : Nat.Coprime m n) :
    Nonempty (ZMod (m * n) ≃+* ZMod m × ZMod n) :=
  ⟨ZMod.chineseRemainder h⟩

/-- AA-245. A subset of a ring (not necessarily unital) is a subring iff it is nonempty and
closed under products and differences. -/
@[kb "judson2026" "Proposition 16.1.10, p. 213"]
theorem judson_16_1_10 {R : Type*} [NonUnitalRing R] (S : Set R) :
    (∃ T : NonUnitalSubring R, (T : Set R) = S) ↔
      S.Nonempty ∧ (∀ a ∈ S, ∀ b ∈ S, a * b ∈ S) ∧ (∀ a ∈ S, ∀ b ∈ S, a - b ∈ S) :=
  exists_nonUnitalSubring_iff S

/-- AA-245. Unital version: a subset of a ring is a subring iff it contains `1` and is closed
under products and differences. -/
@[kb "judson2026" "Proposition 16.1.10 (unital), p. 213"]
theorem judson_16_1_10_unital {R : Type*} [Ring R] (S : Set R) :
    (∃ T : Subring R, (T : Set R) = S) ↔
      1 ∈ S ∧ (∀ a ∈ S, ∀ b ∈ S, a * b ∈ S) ∧ (∀ a ∈ S, ∀ b ∈ S, a - b ∈ S) :=
  exists_subring_iff S

/-- AA-254. A ring homomorphism sends `0` to `0`, and `1` to `1`. -/
@[kb "judson2026" "Proposition 16.3.3 (zero and one), p. 216"]
theorem judson_16_3_3_zero_one {R S : Type*} [Ring R] [Ring S] (f : R →+* S) :
    f 0 = 0 ∧ f 1 = 1 :=
  ⟨map_zero f, map_one f⟩

/-- AA-254. The image of a commutative ring under a ring homomorphism is commutative. -/
@[kb "judson2026" "Proposition 16.3.3 (commutative image), p. 216"]
theorem judson_16_3_3 {R S : Type*} [CommRing R] [Ring S] (f : R →+* S) (x y : f.range) :
    x * y = y * x :=
  range_mul_comm f x y

/-- AA-254. The image of a field under a ring homomorphism into a nontrivial ring is a field
(and the homomorphism is injective). -/
@[kb "judson2026" "Proposition 16.3.3 (field image), p. 216"]
theorem judson_16_3_3_field {R S : Type*} [Field R] [Ring S] [Nontrivial S] (f : R →+* S) :
    IsField f.range ∧ Function.Injective f :=
  ⟨isField_range f, injective_of_field f⟩

/-- AA-263. Second isomorphism theorem: for a subring `S` and an ideal `I` of a commutative ring
`R`, `S / (S ∩ I) ≅ (S + I) / I`. -/
@[kb "judson2026" "Theorem 16.3.13, p. 218"]
theorem judson_16_3_13 {R : Type*} [CommRing R] (S : Subring R) (I : Ideal R) :
    Nonempty (S ⧸ I.comap S.subtype ≃+*
      (subringAddIdeal S I) ⧸ I.comap (subringAddIdeal S I).subtype) :=
  second_isomorphism_theorem S I

/-- AA-265. Correspondence theorem (ideal part): the ideals of `R / I` correspond, order
isomorphically, to the ideals of `R` containing `I`. -/
@[kb "judson2026" "Theorem 16.3.15, p. 218"]
theorem judson_16_3_15 {R : Type*} [CommRing R] (I : Ideal R) :
    Nonempty (Ideal (R ⧸ I) ≃o {J : Ideal R // I ≤ J}) :=
  ⟨idealQuotientOrderIso I⟩

