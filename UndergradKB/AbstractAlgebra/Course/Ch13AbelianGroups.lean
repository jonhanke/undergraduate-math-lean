import Mathlib.GroupTheory.FiniteAbelian.Basic
import Mathlib.GroupTheory.Perm.Cycle.Type
import Mathlib.GroupTheory.PGroup
import Mathlib.GroupTheory.Solvable
import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple
import UndergradKB.Common.Attr
import UndergradKB.AbstractAlgebra.FiniteGroups
import UndergradKB.AbstractAlgebra.Series

/-! # Judson–Beezer, chapter 13: the structure of groups (course layer)

Thin wrappers in the book's terms around Mathlib for the abelian special cases of Cauchy's
theorem, the fundamental theorems of finite and finitely generated abelian groups, and the
solvability of symmetric groups. -/

namespace UndergradKB.AbstractAlgebra.Course

/-- AA-195. Cauchy's theorem for finite abelian groups: if a prime `p` divides the order of `G`,
then `G` has an element of order `p`. -/
@[kb "judson2026" "Lemma 13.1.6, p. 178"]
theorem judson_13_1_6 {G : Type*} [CommGroup G] [Finite G] {p : ℕ} (hp : p.Prime)
    (h : p ∣ Nat.card G) : ∃ g : G, orderOf g = p := by
  have : Fact p.Prime := ⟨hp⟩
  exact exists_prime_orderOf_dvd_card' p h

/-- AA-196. A finite abelian group is a `p`-group iff its order is a power of `p`. -/
@[kb "judson2026" "Lemma 13.1.7, p. 178"]
theorem judson_13_1_7 {G : Type*} [CommGroup G] [Finite G] {p : ℕ} (hp : p.Prime) :
    IsPGroup p G ↔ ∃ n : ℕ, Nat.card G = p ^ n := by
  have : Fact p.Prime := ⟨hp⟩
  exact IsPGroup.iff_card

/-- AA-199. Fundamental theorem of finite abelian groups (additive form): a finite abelian group is
isomorphic to a (finite) direct sum of cyclic groups `ℤ_{pᵢ^{eᵢ}}` of prime-power order. -/
@[kb "judson2026" "Theorem 13.1.4, p. 177"]
theorem judson_13_1_4 (G : Type*) [AddCommGroup G] [Finite G] :
    ∃ (ι : Type) (_ : Fintype ι) (p : ι → ℕ) (_ : ∀ i, (p i).Prime) (e : ι → ℕ),
      Nonempty (G ≃+ DirectSum ι fun i => ZMod (p i ^ e i)) :=
  AddCommGroup.equiv_directSum_zmod_of_finite G

/-- AA-200. Fundamental theorem of finitely generated abelian groups: such a group is isomorphic
to a product of copies of `ℤ` and finitely many cyclic groups `ℤ_{pᵢ^{eᵢ}}` of prime-power order. -/
@[kb "judson2026" "Theorem 13.1.10, p. 180"]
theorem judson_13_1_10 (G : Type*) [CommGroup G] [Group.FG G] :
    ∃ (ι j : Type) (_ : Fintype ι) (_ : Fintype j) (p : ι → ℕ) (_ : ∀ i, (p i).Prime)
      (e : ι → ℕ),
      Nonempty (G ≃* (j → Multiplicative ℤ) × ((i : ι) → Multiplicative (ZMod (p i ^ e i)))) :=
  CommGroup.equiv_free_prod_prod_multiplicative_zmod G

/-- AA-205. The symmetric group `S_n` is solvable for `n ≤ 4`. -/
@[kb "judson2026" "Example 13.2.9, p. 183"]
theorem judson_13_2_9_solvable (n : ℕ) (hn : n ≤ 4) : Group.IsSolvable (Equiv.Perm (Fin n)) :=
  Equiv.Perm.isSolvable (by simpa using hn)

/-- AA-205. The symmetric group `S_n` is not solvable for `n ≥ 5`. -/
@[kb "judson2026" "Example 13.2.9, p. 183"]
theorem judson_13_2_9_not_solvable (n : ℕ) (hn : 5 ≤ n) :
    ¬ Group.IsSolvable (Equiv.Perm (Fin n)) :=
  Equiv.Perm.not_isSolvable (Fin n) (by simpa using hn)

/-- AA-193. The subgroup generated by a set `s` consists exactly of the finite products of
integer powers of elements of `s`. -/
@[kb "judson2026" "Proposition 13.1.3, p. 177"]
theorem judson_13_1_3 {G : Type*} [Group G] (s : Set G) (g : G) :
    g ∈ Subgroup.closure s ↔
      ∃ l : List (G × ℤ), (∀ p ∈ l, p.1 ∈ s) ∧ g = (l.map fun p => p.1 ^ p.2).prod :=
  mem_closure_iff_exists_list s g

/-- AA-197. A finite abelian group is the internal direct product of its subgroups of elements
of `p`-power order, one for each prime `p` dividing its order: the subgroups are independent and
generate `G`. -/
@[kb "judson2026" "Lemma 13.1.8, p. 178"]
theorem judson_13_1_8 (G : Type*) [CommGroup G] [Finite G] :
    iSupIndep (fun p : (Nat.card G).primeFactors => CommGroup.primaryComponent G (p : ℕ)) ∧
    ⨆ p : (Nat.card G).primeFactors, CommGroup.primaryComponent G (p : ℕ) = ⊤ :=
  abelian_internal_direct_product_primary G

/-- AA-197. Isomorphism form of the same lemma: `G` is the product of its primary components. -/
@[kb "judson2026" "Lemma 13.1.8 (product form), p. 178"]
theorem judson_13_1_8_prod (G : Type*) [CommGroup G] [Finite G] :
    Nonempty ((∀ p : (Nat.card G).primeFactors, CommGroup.primaryComponent G (p : ℕ)) ≃* G) :=
  ⟨abelianPrimaryEquiv G⟩

/-- AA-198. Let `G` be a finite abelian `p`-group and `g` an element of maximal order. Then
`⟨g⟩` has a complement `K` with `⟨g⟩ ∩ K = 1` and `⟨g⟩ K = G`. -/
@[kb "judson2026" "Lemma 13.1.9, p. 179"]
theorem judson_13_1_9 {G : Type*} [CommGroup G] [Finite G] {p : ℕ} (hp : p.Prime)
    (hG : IsPGroup p G) (g : G) (hg : ∀ x : G, orderOf x ≤ orderOf g) :
    ∃ K : Subgroup G, Subgroup.zpowers g ⊓ K = ⊥ ∧ Subgroup.zpowers g ⊔ K = ⊤ := by
  haveI : Fact p.Prime := ⟨hp⟩
  exact exists_complement_of_max_order hG g hg

/-- AA-203. Jordan-Holder: any two composition series of a group are isomorphic (same factor
groups up to isomorphism and permutation). -/
@[kb "judson2026" "Theorem 13.2.8, p. 182"]
theorem judson_13_2_8 {G : Type*} [Group G] (s t : SubnormalSeries G)
    (hs : s.IsCompositionSeries) (ht : t.IsCompositionSeries) : s.Isomorphic t :=
  jordan_holder_group s t hs ht

end UndergradKB.AbstractAlgebra.Course
