import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.GroupTheory.Index
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple
import UndergradKB.Common.Attr
import UndergradKB.AbstractAlgebra.Alternating

/-! # Judson–Beezer, chapter 10: normal subgroups and factor groups (course layer)

Thin wrappers in the book's terms around Mathlib for normal subgroups, factor groups and the
simplicity of the alternating groups. -/

namespace UndergradKB.AbstractAlgebra.Course

/-- AA-142. Every subgroup of an abelian group is normal. -/
@[kb "judson2026" "Example 10.1.1, p. 143"]
theorem judson_10_1_1 {G : Type*} [Group G] (hG : ∀ a b : G, a * b = b * a) (H : Subgroup G) :
    H.Normal :=
  ⟨fun n hn g => by rwa [hG g n, mul_assoc, mul_inv_cancel, mul_one]⟩

/-- AA-143. A subgroup `N` is normal iff `g n g⁻¹ ∈ N` for all `g` and `n ∈ N` (equivalently
`g N g⁻¹ ⊆ N`), iff `g N g⁻¹ = N` for every `g`. -/
@[kb "judson2026" "Theorem 10.1.3, p. 143"]
theorem judson_10_1_3 {G : Type*} [Group G] (N : Subgroup G) :
    (N.Normal ↔ ∀ g : G, ∀ n ∈ N, g * n * g⁻¹ ∈ N) ∧
    (N.Normal ↔ ∀ g : G, N.map (MulAut.conj g).toMonoidHom = N) :=
  ⟨⟨fun h g n hn => h.conj_mem n hn g, fun h => ⟨fun n hn g => h g n hn⟩⟩,
    Subgroup.normal_iff_map_conj_eq⟩

/-- AA-144. For `N` normal in `G` the cosets form a group under `(aN)(bN) = abN`, whose order is
the index `[G : N]`. -/
@[kb "judson2026" "Theorem 10.1.4, p. 144"]
theorem judson_10_1_4 {G : Type*} [Group G] (N : Subgroup G) [N.Normal] :
    (∀ a b : G, ((a * b : G) : G ⧸ N) = (a : G ⧸ N) * (b : G ⧸ N)) ∧
    Nat.card (G ⧸ N) = N.index :=
  ⟨fun _ _ => rfl, N.index_eq_card.symm⟩

/-- AA-147. A group of prime order `p` (for instance a cyclic group of order `p`) is simple. -/
@[kb "judson2026" "Definition 10.2, p. 145"]
theorem judson_10_2_prime_order_simple {G : Type*} [Group G] {p : ℕ} (hp : p.Prime)
    (h : Nat.card G = p) : IsSimpleGroup G := by
  have : Fact p.Prime := ⟨hp⟩
  exact isSimpleGroup_of_prime_card h

/-- AA-148. The alternating group `A_n` is generated by the 3-cycles. -/
@[kb "judson2026" "Lemma 10.2.1, p. 145"]
theorem judson_10_2_1 (n : ℕ) :
    Subgroup.closure {σ : Equiv.Perm (Fin n) | σ.IsThreeCycle} = alternatingGroup (Fin n) :=
  Equiv.Perm.closure_three_cycles_eq_alternating

/-- AA-151. The alternating group `A_n` is simple for `n ≥ 5`. -/
@[kb "judson2026" "Theorem 10.2.4, p. 148"]
theorem judson_10_2_4 (n : ℕ) (hn : 5 ≤ n) : IsSimpleGroup (alternatingGroup (Fin n)) :=
  alternatingGroup.isSimpleGroup (by simpa using hn)

/-- AA-149. Lemma 10.2.2: for `n ≥ 3`, a normal subgroup of `Aₙ` containing a 3-cycle is `Aₙ`. -/
@[kb "judson2026" "Lemma 10.2.2, p. 146"]
theorem judson_10_2_2 {n : ℕ} (hn : 3 ≤ n) (N : Subgroup (alternatingGroup (Fin n))) [N.Normal]
    (h : ∃ g ∈ N, Equiv.Perm.IsThreeCycle (g : Equiv.Perm (Fin n))) : N = ⊤ :=
  UndergradKB.AbstractAlgebra.alternatingGroup_eq_top_of_threeCycle hn N h

/-- AA-150. Lemma 10.2.3: for `n ≥ 5`, every nontrivial normal subgroup of `Aₙ` contains a 3-cycle. -/
@[kb "judson2026" "Lemma 10.2.3, p. 146"]
theorem judson_10_2_3 {n : ℕ} (hn : 5 ≤ n) (N : Subgroup (alternatingGroup (Fin n))) [N.Normal]
    (hN : N ≠ ⊥) : ∃ g ∈ N, Equiv.Perm.IsThreeCycle (g : Equiv.Perm (Fin n)) :=
  UndergradKB.AbstractAlgebra.exists_threeCycle_of_normal_ne_bot hn N hN

end UndergradKB.AbstractAlgebra.Course
