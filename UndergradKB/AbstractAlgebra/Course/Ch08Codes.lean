import Mathlib.InformationTheory.Hamming
import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Matrix.Mul
import Mathlib.Algebra.CharP.Two
import UndergradKB.Common.Attr
import UndergradKB.AbstractAlgebra.Codes2

/-! # Judson–Beezer, chapter 8: algebraic coding theory (course layer)

Thin wrappers around Mathlib for Hamming distance and weight, and for the action of a binary matrix
on a standard basis vector. Binary words of length `n` are `Fin n → ZMod 2`. -/

namespace UndergradKB.AbstractAlgebra.Course

/-- AA-107. Hamming distance on binary words is a metric (zero exactly on equal words, symmetric,
triangle inequality), and the weight of `x` is its distance from `0`. -/
@[kb "judson2026" "Proposition 8.1.11, p. 111"]
theorem judson_8_1_11 (n : ℕ) (x y z : Fin n → ZMod 2) :
    (0 ≤ hammingDist x y) ∧ (hammingDist x y = 0 ↔ x = y) ∧
    hammingDist x y = hammingDist y x ∧
    hammingDist x z ≤ hammingDist x y + hammingDist y z ∧
    hammingNorm x = hammingDist x 0 :=
  ⟨Nat.zero_le _, hammingDist_eq_zero, hammingDist_comm x y, hammingDist_triangle x y z,
    (hammingDist_zero_right x).symm⟩

/-- AA-110. For binary `n`-tuples, `w(x + y) = d(x, y)`. -/
@[kb "judson2026" "Lemma 8.2.2, p. 114"]
theorem judson_8_2_2 (n : ℕ) (x y : Fin n → ZMod 2) :
    hammingNorm (x + y) = hammingDist x y := by
  rw [hammingDist_eq_hammingNorm]
  congr 1
  funext i
  simp

/-- AA-119. For a binary matrix `H`, the product `H eᵢ` is the `i`-th column of `H`. -/
@[kb "judson2026" "Proposition 8.3.8, p. 120"]
theorem judson_8_3_8 (m n : ℕ) (H : Matrix (Fin m) (Fin n) (ZMod 2)) (i : Fin n) :
    H.mulVec (Pi.single i 1) = fun j => H j i := by
  rw [Matrix.mulVec_single_one]
  rfl

/-! ### Theorems proved in `UndergradKB.AbstractAlgebra.Codes` and `Codes2` -/

open UndergradKB.AbstractAlgebra

/-- AA-105. On a binary symmetric channel (bit-error probability `q`, `p = 1 - q`), the probability
that exactly `k` of the `n` bits are in error is `C(n,k) q^k p^(n-k)`. -/
@[kb "judson2026" "Theorem 8.1.7, p. 110"]
theorem judson_8_1_7 {n : ℕ} (p q : ℝ) (k : ℕ) :
    ∑ e ∈ Finset.univ.filter (fun e : Word n => hammingNorm e = k), errProb p q e =
      (n.choose k : ℝ) * q ^ k * p ^ (n - k) :=
  prob_exactly_k_errors p q k

/-- AA-108. A code with minimum distance at least `2k+1` corrects any `k` or fewer errors (the
nearest codeword to a received word within `k` of `c` is `c`) and detects any `2k` or fewer errors
(a word within `2k` of a codeword, but different from it, is not a codeword). -/
@[kb "judson2026" "Theorem 8.1.13, p. 112"]
theorem judson_8_1_13 {n k : ℕ} {C : Finset (Word n)} (h : 2 * k + 1 ≤ minDist C) :
    (∀ c ∈ C, ∀ r : Word n, hammingDist r c ≤ k →
      (∀ c' ∈ C, c' ≠ c → k < hammingDist r c') ∧ ∀ c' ∈ C, hammingDist r c ≤ hammingDist r c') ∧
    (∀ c ∈ C, ∀ r : Word n, hammingDist r c ≤ 2 * k → r ≠ c → r ∉ C) :=
  ⟨fun _ hc _ hr => correct_up_to h hc hr, fun _ hc _ hr hne => detect_up_to h hc hr hne⟩

/-- AA-111. For a group code, the minimum distance is the least weight of a nonzero codeword. -/
@[kb "judson2026" "Theorem 8.2.3, p. 114"]
theorem judson_8_2_3 {n : ℕ} (C : GroupCode n) :
    minDist C.toFinset = sInf {w | ∃ x ∈ C, x ≠ 0 ∧ hammingNorm x = w} :=
  minDist_groupCode C

/-- AA-112. The null space `{x | H x = 0}` of a binary `m × n` matrix is a group code. -/
@[kb "judson2026" "Theorem 8.2.6, p. 115"]
theorem judson_8_2_6 {m n : ℕ} (H : Matrix (Fin m) (Fin n) (ZMod 2)) :
    ∃ C : GroupCode n, ∀ x : Word n, x ∈ C ↔ H.mulVec x = 0 :=
  ⟨nullCode H, fun _ => Iff.rfl⟩

/-- AA-115. For the canonical parity-check matrix `H = (A | I_m)`, a word `x` of length `k + m` is
a codeword iff its last `m` bits (check bits) equal `A` applied to the first `k` bits
(information bits); so the code is a `(k+m, k)` block code. -/
@[kb "judson2026" "Theorem 8.3.3, p. 118"]
theorem judson_8_3_3 {k m : ℕ} (A : Matrix (Fin m) (Fin k) (ZMod 2)) (x : Word (k + m)) :
    x ∈ nullCode (canonH A) ↔
      (fun b => x (Fin.natAdd k b)) = A.mulVec (fun a => x (Fin.castAdd m a)) :=
  mem_nullCode_canonH_iff A x

/-- AA-116. The image of a standard generator matrix `G = (I_k over A)` is a `(k+m, k)` block code
(encoding is injective, built into `BlockCode`) which is additive, and whose set of codewords is
the group code generated by `G`. -/
@[kb "judson2026" "Theorem 8.3.4, p. 118"]
theorem judson_8_3_4 {k m : ℕ} (A : Matrix (Fin m) (Fin k) (ZMod 2)) :
    (∀ u : Word k, (stdBlockCode A).encode u = (stdG A).mulVec u) ∧
    (∀ u v : Word k, (stdBlockCode A).encode (u + v) =
      (stdBlockCode A).encode u + (stdBlockCode A).encode v) ∧
    (stdBlockCode A).codewords = (stdCode A : Set (Word (k + m))) :=
  ⟨fun _ => rfl, stdBlockCode_encode_add A, stdBlockCode_codewords A⟩

/-- AA-117. For `H = (A | I_m)` and `G = (I_k over A)` over `ℤ_2`, `H G = 0`. -/
@[kb "judson2026" "Lemma 8.3.5, p. 118"]
theorem judson_8_3_5 {k m : ℕ} (A : Matrix (Fin m) (Fin k) (ZMod 2)) :
    canonH A * stdG A = 0 :=
  canonH_mul_stdG A

/-- AA-118. The code generated by the standard generator matrix `G` is the null space of the
canonical parity-check matrix `H`. -/
@[kb "judson2026" "Theorem 8.3.6, p. 119"]
theorem judson_8_3_6 {k m : ℕ} (A : Matrix (Fin m) (Fin k) (ZMod 2)) :
    stdCode A = nullCode (canonH A) :=
  stdCode_eq_nullCode A

/-- AA-120. The null space of `H` detects single errors iff `H` has no zero column. -/
@[kb "judson2026" "Theorem 8.3.9, p. 120"]
theorem judson_8_3_9 {m n : ℕ} (H : Matrix (Fin m) (Fin n) (ZMod 2)) :
    (∀ c ∈ nullCode H, ∀ i : Fin n, c + Pi.single i 1 ∉ nullCode H) ↔ ∀ i, H.col i ≠ 0 :=
  nullCode_detects_iff H

/-- AA-121. The null space of `H` corrects single errors iff `H` has no zero column and no two
equal columns. -/
@[kb "judson2026" "Theorem 8.3.12, p. 120"]
theorem judson_8_3_12 {m n : ℕ} (H : Matrix (Fin m) (Fin n) (ZMod 2)) :
    (∀ r : Word n, ∀ c ∈ nullCode H, ∀ c' ∈ nullCode H,
        hammingDist r c ≤ 1 → hammingDist r c' ≤ 1 → c = c') ↔
      (∀ i, H.col i ≠ 0) ∧ ∀ i j, i ≠ j → H.col i ≠ H.col j :=
  nullCode_corrects_iff H

/-- AA-123. If `x = c + e` with `c` a codeword of `Null(H)`, the syndrome `H x` of `x` equals the
syndrome `H e` of the error. -/
@[kb "judson2026" "Proposition 8.4.2, p. 121"]
theorem judson_8_4_2 {m n : ℕ} (H : Matrix (Fin m) (Fin n) (ZMod 2)) {c : Word n}
    (hc : c ∈ nullCode H) (e : Word n) : H.mulVec (c + e) = H.mulVec e :=
  syndrome_add_codeword H hc e

/-- AA-124. For a single-error-correcting code `Null(H)` and a received word `r` within one error of
a codeword `c`: either `r = c` and the syndrome is `0`, or `r` differs from `c` in one position `i`,
the syndrome equals the `i`-th column of `H`, and no other column equals it. -/
@[kb "judson2026" "Theorem 8.4.3, p. 122"]
theorem judson_8_4_3 {m n : ℕ} (H : Matrix (Fin m) (Fin n) (ZMod 2))
    (hcorr : ∀ r : Word n, ∀ c ∈ nullCode H, ∀ c' ∈ nullCode H,
      hammingDist r c ≤ 1 → hammingDist r c' ≤ 1 → c = c')
    {c r : Word n} (hc : c ∈ nullCode H) (hr : hammingDist r c ≤ 1) :
    (r = c ∧ H.mulVec r = 0) ∨
      ∃ i, r = c + Pi.single i 1 ∧ H.mulVec r = H.col i ∧
        ∀ j, H.col j = H.mulVec r → j = i :=
  syndrome_single_error H hcorr hc hr

/-- AA-126. Two binary words lie in the same coset of `C = Null(H)` iff they have the same
syndrome. -/
@[kb "judson2026" "Proposition 8.4.9, p. 123"]
theorem judson_8_4_9 {m n : ℕ} (H : Matrix (Fin m) (Fin n) (ZMod 2)) (r s : Word n) :
    (r : Word n ⧸ nullCode H) = s ↔ H.mulVec r = H.mulVec s :=
  quotient_eq_iff_syndrome H r s

end UndergradKB.AbstractAlgebra.Course
