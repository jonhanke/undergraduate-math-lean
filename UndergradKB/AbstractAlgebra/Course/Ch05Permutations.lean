import Mathlib.GroupTheory.Perm.Cycle.Factors
import Mathlib.GroupTheory.Perm.Sign
import Mathlib.GroupTheory.SpecificGroups.Alternating
import Mathlib.GroupTheory.SpecificGroups.Dihedral
import Mathlib.Data.Fintype.Perm
import UndergradKB.Common.Attr
import UndergradKB.AbstractAlgebra.Cube

/-! # Judson–Beezer, chapter 5: permutation groups (course layer)

Thin wrappers around Mathlib for symmetric groups, cycle decomposition, parity, the alternating
groups and dihedral groups. -/

open Equiv

namespace UndergradKB.AbstractAlgebra.Course

/-- AA-063. The symmetric group `S_n` of permutations of `{1, …, n}` has `n!` elements. -/
@[kb "judson2026" "Theorem 5.1.1, p. 73"]
theorem judson_5_1_1 (n : ℕ) : Nat.card (Perm (Fin n)) = n.factorial := by
  rw [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin]

/-- AA-066. Disjoint cycles (indeed any disjoint permutations) commute. -/
@[kb "judson2026" "Proposition 5.1.8, p. 76"]
theorem judson_5_1_8 {α : Type*} (σ τ : Perm α) (h : Perm.Disjoint σ τ) : σ * τ = τ * σ :=
  h.commute.eq

/-- AA-067. Every permutation of a finite set is a product of pairwise disjoint cycles. -/
@[kb "judson2026" "Theorem 5.1.9, p. 76"]
theorem judson_5_1_9 (n : ℕ) (σ : Perm (Fin n)) :
    ∃ l : List (Perm (Fin n)), l.prod = σ ∧ (∀ c ∈ l, c.IsCycle) ∧ l.Pairwise Perm.Disjoint :=
  ⟨(Perm.cycleFactors σ).1, (Perm.cycleFactors σ).2⟩

/-- AA-069. Every permutation of a finite set is a product of transpositions. -/
@[kb "judson2026" "Proposition 5.1.12, p. 77"]
theorem judson_5_1_12 {α : Type*} [Finite α] [DecidableEq α] (σ : Perm α) :
    ∃ l : List (Perm α), (∀ t ∈ l, t.IsSwap) ∧ l.prod = σ := by
  induction σ using Perm.swap_induction_on with
  | one => exact ⟨[], by simp, rfl⟩
  | swap_mul f x y hxy ih =>
    obtain ⟨l, hl, rfl⟩ := ih
    refine ⟨swap x y :: l, ?_, by simp⟩
    intro t ht
    rcases List.mem_cons.mp ht with rfl | ht
    · exact ⟨x, y, hxy, rfl⟩
    · exact hl t ht

/-- AA-070. Parity is well defined: if two products of transpositions give the same permutation,
the numbers of factors have the same parity (in particular the identity is only an even product). -/
@[kb "judson2026" "Theorem 5.1.15, p. 78"]
theorem judson_5_1_15 {α : Type*} [Fintype α] [DecidableEq α] (l l' : List (Perm α))
    (hl : ∀ t ∈ l, t.IsSwap) (hl' : ∀ t ∈ l', t.IsSwap) (h : l.prod = l'.prod) :
    Even l.length ↔ Even l'.length := by
  have h1 := Perm.sign_prod_list_swap hl
  have h2 := Perm.sign_prod_list_swap hl'
  rw [h] at h1
  have h3 : (-1 : ℤˣ) ^ l.length = (-1) ^ l'.length := h1.symm.trans h2
  have hne : (-1 : ℤˣ) ≠ 1 := by decide
  rw [← neg_one_pow_eq_one_iff_even hne, ← neg_one_pow_eq_one_iff_even hne, h3]

/-- AA-070. The identity permutation is only a product of an even number of transpositions. -/
@[kb "judson2026" "Lemma 5.1.14, p. 77"]
theorem judson_5_1_14 {α : Type*} [Fintype α] [DecidableEq α] (l : List (Perm α))
    (hl : ∀ t ∈ l, t.IsSwap) (h : l.prod = 1) : Even l.length :=
  (judson_5_1_15 l [] hl (by simp) (by simpa using h)).mpr (by simp)

/-- AA-072. The even permutations (products of an even number of transpositions) form a subgroup,
the alternating group. -/
@[kb "judson2026" "Theorem 5.1.16, p. 78"]
theorem judson_5_1_16 (α : Type*) [Fintype α] [DecidableEq α] :
    ∃ A : Subgroup (Perm α), ∀ σ, σ ∈ A ↔
      ∃ l : List (Perm α), (∀ t ∈ l, t.IsSwap) ∧ l.prod = σ ∧ Even l.length := by
  refine ⟨alternatingGroup α, fun σ => ?_⟩
  rw [Perm.mem_alternatingGroup]
  constructor
  · intro hs
    obtain ⟨l, hl, rfl⟩ := judson_5_1_12 σ
    refine ⟨l, hl, rfl, ?_⟩
    rw [Perm.sign_prod_list_swap hl] at hs
    have hne : (-1 : ℤˣ) ≠ 1 := by decide
    exact (neg_one_pow_eq_one_iff_even hne).mp hs
  · rintro ⟨l, hl, rfl, he⟩
    rw [Perm.sign_prod_list_swap hl]
    exact he.neg_one_pow

/-- AA-073. For `n ≥ 2`, the alternating group `A_n` has `n!/2` elements. -/
@[kb "judson2026" "Proposition 5.1.17, p. 79"]
theorem judson_5_1_17 (n : ℕ) (hn : 2 ≤ n) :
    Nat.card (alternatingGroup (Fin n)) = n.factorial / 2 := by
  have : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.mpr hn
  rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]

/-- AA-075. The dihedral group `D_n` has order `2n` (order part only; the embedding into `S_n` is
not stated). -/
@[kb "judson2026" "Theorem 5.2.2, p. 80"]
theorem judson_5_2_2 (n : ℕ) [NeZero n] : Nat.card (DihedralGroup n) = 2 * n := by
  rw [Nat.card_eq_fintype_card, DihedralGroup.card]

/-- AA-076. `D_n` is generated by a rotation `r` of order `n` and a reflection `s` of order 2
with `s r s = r⁻¹`. -/
@[kb "judson2026" "Theorem 5.2.3, p. 80"]
theorem judson_5_2_3 (n : ℕ) [NeZero n] :
    orderOf (DihedralGroup.r 1 : DihedralGroup n) = n ∧
    orderOf (DihedralGroup.sr 0 : DihedralGroup n) = 2 ∧
    (DihedralGroup.sr 0 : DihedralGroup n) * DihedralGroup.r 1 * DihedralGroup.sr 0 =
      (DihedralGroup.r 1)⁻¹ ∧
    Subgroup.closure {(DihedralGroup.r 1 : DihedralGroup n), DihedralGroup.sr 0} = ⊤ := by
  refine ⟨DihedralGroup.orderOf_r_one, DihedralGroup.orderOf_sr 0, by simp, ?_⟩
  rw [eq_top_iff]
  rintro (i | i) -
  · have h : (DihedralGroup.r i : DihedralGroup n) = DihedralGroup.r 1 ^ (ZMod.cast i : ℤ) := by
      rw [DihedralGroup.r_one_zpow, ZMod.intCast_zmod_cast]
    rw [h]
    exact Subgroup.zpow_mem _ (Subgroup.subset_closure (by simp)) _
  · have h : (DihedralGroup.sr i : DihedralGroup n) =
        DihedralGroup.r (-i) * DihedralGroup.sr 0 := by
      rw [DihedralGroup.r_mul_sr]; simp
    have hr : (DihedralGroup.r (-i) : DihedralGroup n) ∈
        Subgroup.closure {(DihedralGroup.r 1 : DihedralGroup n), DihedralGroup.sr 0} := by
      have h' : (DihedralGroup.r (-i) : DihedralGroup n) =
          DihedralGroup.r 1 ^ (ZMod.cast (-i) : ℤ) := by
        rw [DihedralGroup.r_one_zpow, ZMod.intCast_zmod_cast]
      rw [h']
      exact Subgroup.zpow_mem _ (Subgroup.subset_closure (by simp)) _
    rw [h]
    exact Subgroup.mul_mem _ hr (Subgroup.subset_closure (by simp))

/-- AA-077. Proposition 5.2.8: the group of rotations of the cube (integer matrices of determinant 1
permuting the cube's vertices) has 24 elements. -/
@[kb "judson2026" "Proposition 5.2.8, p. 83"]
theorem judson_5_2_8 : Nat.card UndergradKB.AbstractAlgebra.CubeRotations = 24 :=
  UndergradKB.AbstractAlgebra.card_cubeRotations

/-- AA-077. Theorem 5.2.9: the group of rotations of the cube is isomorphic to `S₄`
(via its action on the four diagonals). -/
@[kb "judson2026" "Theorem 5.2.9, p. 83"]
theorem judson_5_2_9 :
    Nonempty (UndergradKB.AbstractAlgebra.CubeRotations ≃* Equiv.Perm (Fin 4)) :=
  ⟨UndergradKB.AbstractAlgebra.cubeRotationsEquivPerm⟩

end UndergradKB.AbstractAlgebra.Course
