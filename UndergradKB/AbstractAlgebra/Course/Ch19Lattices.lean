Thin wrappers around Mathlib for the order-theoretic results of chapter 19. -/

namespace UndergradKB.AbstractAlgebra.Course

/-- AA-328. The power set of `X` is a Boolean algebra under inclusion, with join union, meet
intersection and complement the set complement. -/
@[kb "judson2026" "Example 19.1.10, p. 262"]
theorem judson_19_1_10 {X : Type*} (A B : Set X) :
    A ⊔ B = A ∪ B ∧ A ⊓ B = A ∩ B ∧ Aᶜ = {x | x ∉ A} ∧ (A ≤ B ↔ A ⊆ B) :=
  ⟨rfl, rfl, rfl, Iff.rfl⟩

/-- AA-329. The subgroups of a group form a lattice under inclusion: the meet of `H` and `K` is
`H ∩ K` and the join is the subgroup generated by `H ∪ K`. -/
@[kb "judson2026" "Example 19.1.11, p. 262"]
theorem judson_19_1_11 {G : Type*} [Group G] (H K : Subgroup G) :
    ((H ⊓ K : Subgroup G) : Set G) = (H : Set G) ∩ K ∧
      H ⊔ K = Subgroup.closure ((H : Set G) ∪ K) :=
  ⟨rfl, Subgroup.sup_eq_closure H K⟩

/-- AA-332. A least upper bound of a subset of a poset, if it exists, is unique. -/
@[kb "judson2026" "Theorem 19.1.9, p. 262"]
theorem judson_19_1_9 {P : Type*} [PartialOrder P] (S : Set P) {a b : P}
    (ha : IsLUB S a) (hb : IsLUB S b) : a = b :=
  ha.unique hb

/-- AA-332. Dual form: a greatest lower bound, if it exists, is unique. -/
theorem judson_19_1_9_glb {P : Type*} [PartialOrder P] (S : Set P) {a b : P}
    (ha : IsGLB S a) (hb : IsGLB S b) : a = b :=
  ha.unique hb

/-- AA-335. In a lattice, join and meet are commutative, associative and idempotent, and satisfy
the absorption laws. -/
@[kb "judson2026" "Theorem 19.1.13, p. 262"]
theorem judson_19_1_13 {L : Type*} [Lattice L] (a b c : L) :
    a ⊔ b = b ⊔ a ∧ a ⊓ b = b ⊓ a ∧
    a ⊔ (b ⊔ c) = (a ⊔ b) ⊔ c ∧ a ⊓ (b ⊓ c) = (a ⊓ b) ⊓ c ∧
    a ⊔ a = a ∧ a ⊓ a = a ∧ a ⊔ (a ⊓ b) = a ∧ a ⊓ (a ⊔ b) = a :=
  ⟨sup_comm a b, inf_comm a b, (sup_assoc a b c).symm, (inf_assoc a b c).symm, sup_idem a,
    inf_idem a, sup_inf_self, inf_sup_self⟩

/-- AA-336. Two commutative, associative operations satisfying the absorption laws make the type
a lattice, whose order is `a ≤ b ↔ a ∨ b = b`. -/
@[kb "judson2026" "Theorem 19.1.14, p. 263"]
theorem judson_19_1_14 {L : Type*} (sup inf : L → L → L)
    (sup_comm : ∀ a b, sup a b = sup b a) (sup_assoc : ∀ a b c, sup (sup a b) c = sup a (sup b c))
    (inf_comm : ∀ a b, inf a b = inf b a) (inf_assoc : ∀ a b c, inf (inf a b) c = inf a (inf b c))
    (sup_inf_self : ∀ a b, sup a (inf a b) = a) (inf_sup_self : ∀ a b, inf a (sup a b) = a) :
    ∃ inst : Lattice L, (∀ a b, inst.toSemilatticeSup.toMax.max a b = sup a b) ∧
      (∀ a b, inst.toSemilatticeInf.toMin.min a b = inf a b) ∧
      ∀ a b, @LE.le L inst.toLE a b ↔ sup a b = b := by
  letI : Max L := ⟨sup⟩
  letI : Min L := ⟨inf⟩
  letI inst : Lattice L := Lattice.mk' sup_comm sup_assoc inf_comm inf_assoc sup_inf_self
    inf_sup_self
  exact ⟨inst, fun a b => rfl, fun a b => rfl, fun a b => sup_eq_right.symm⟩

/-- AA-338. A lattice satisfies `a ∧ (b ∨ c) = (a ∧ b) ∨ (a ∧ c)` for all elements iff it satisfies
the dual law `a ∨ (b ∧ c) = (a ∨ b) ∧ (a ∨ c)`. -/
@[kb "judson2026" "Theorem 19.2.1, p. 264"]
theorem judson_19_2_1 {L : Type*} [Lattice L] :
    (∀ a b c : L, a ⊓ (b ⊔ c) = (a ⊓ b) ⊔ (a ⊓ c)) ↔
      ∀ a b c : L, a ⊔ (b ⊓ c) = (a ⊔ b) ⊓ (a ⊔ c) := by
  have key : ∀ {M : Type _} [Lattice M], (∀ a b c : M, a ⊓ (b ⊔ c) = (a ⊓ b) ⊔ (a ⊓ c)) →
      ∀ a b c : M, a ⊔ (b ⊓ c) = (a ⊔ b) ⊓ (a ⊔ c) := by
    intro M _ h
    let _ : DistribLattice M := DistribLattice.ofInfSupLe fun a b c => (h a b c).le
    exact fun a b c => sup_inf_left a b c
  refine ⟨key, fun h => ?_⟩
  exact fun a b c => key (M := Lᵒᵈ) h a b c

/-- AA-340. Identities in a Boolean algebra: `a ∨ I = I`, `a ∧ O = O`, cancellation, uniqueness of
complements, `(a')' = a`, `I' = O`, `O' = I`, and De Morgan's laws. -/
@[kb "judson2026" "Theorem 19.2.3, p. 265"]
theorem judson_19_2_3 {B : Type*} [BooleanAlgebra B] (a b c : B) :
    a ⊔ ⊤ = ⊤ ∧ a ⊓ ⊥ = ⊥ ∧
    (b ⊓ a = c ⊓ a → b ⊔ a = c ⊔ a → b = c) ∧
    (a ⊓ b = ⊥ → a ⊔ b = ⊤ → aᶜ = b) ∧
    aᶜᶜ = a ∧ (⊤ : B)ᶜ = ⊥ ∧ (⊥ : B)ᶜ = ⊤ ∧
    (a ⊔ b)ᶜ = aᶜ ⊓ bᶜ ∧ (a ⊓ b)ᶜ = aᶜ ⊔ bᶜ :=
  ⟨sup_top_eq a, inf_bot_eq a, fun h₁ h₂ => eq_of_inf_eq_sup_eq h₁ h₂, fun h₀ h₁ => compl_unique h₀ h₁,
    compl_compl a, compl_top, compl_bot, compl_sup, compl_inf⟩

/-- AA-341. In a Boolean algebra, `a ≤ b` iff `a ∧ b' = O` iff `a' ∨ b = I`. -/
@[kb "judson2026" "Lemma 19.2.6, p. 267"]
theorem judson_19_2_6 {B : Type*} [BooleanAlgebra B] (a b : B) :
    (a ≤ b ↔ a ⊓ bᶜ = ⊥) ∧ (a ≤ b ↔ aᶜ ⊔ b = ⊤) := by
  refine ⟨?_, ?_⟩
  · rw [← disjoint_compl_right_iff, disjoint_iff]
  · rw [← compl_eq_bot, compl_sup, compl_compl, ← disjoint_iff, disjoint_compl_right_iff]

/-- AA-344. In a finite Boolean algebra, every nonzero element lies above some atom. -/
@[kb "judson2026" "Lemma 19.2.4, p. 266"]
theorem judson_19_2_4 {B : Type*} [BooleanAlgebra B] [Finite B] {b : B} (hb : b ≠ ⊥) :
    ∃ a, IsAtom a ∧ a ≤ b :=
  (eq_bot_or_exists_atom_le b).resolve_left hb

/-- AA-345. Distinct atoms of a Boolean algebra have meet `O`. -/
@[kb "judson2026" "Lemma 19.2.5, p. 266"]
theorem judson_19_2_5 {B : Type*} [BooleanAlgebra B] {a b : B} (ha : IsAtom a) (hb : IsAtom b)
    (hab : a ≠ b) : a ⊓ b = ⊥ :=
  ha.inf_eq_bot_of_ne hb hab

/-- AA-339. A set with two operations (meet, join), constants and complement satisfying the
equational axioms (commutativity, associativity, mutual distributivity, identities, complements)
is a Boolean algebra whose meet, join, top, bottom and complement are the given ones. -/
@[kb "judson2026" "Theorem 19.2.2, p. 264-265"]
theorem judson_19_2_2 {α : Type*} [Min α] [Max α] [Top α] [Bot α] [Compl α]
    (h : BooleanAxioms α) :
    ∃ B : BooleanAlgebra α,
      (∀ a b : α, @Min.min α B.toMin a b = a ⊓ b) ∧ (∀ a b : α, @Max.max α B.toMax a b = a ⊔ b) ∧
      @Top.top α B.toTop = ⊤ ∧ @Bot.bot α B.toBot = ⊥ ∧
      (∀ a : α, @Compl.compl α B.toCompl a = aᶜ) :=
  ⟨h.toBooleanAlgebra, fun _ _ => rfl, fun _ _ => rfl, rfl, rfl, fun _ => rfl⟩

/-- AA-339. Conversely, every Boolean algebra satisfies the equational axioms. -/
@[kb "judson2026" "Theorem 19.2.2 (converse), p. 264-265"]
theorem judson_19_2_2_converse (B : Type*) [BooleanAlgebra B] : BooleanAxioms B :=
  ⟨inf_comm, sup_comm, inf_assoc, sup_assoc, inf_sup_left, sup_inf_left, inf_top_eq, sup_bot_eq,
    fun _ => inf_compl_eq_bot, fun _ => sup_compl_eq_top⟩

/-- AA-346. In a finite Boolean algebra, if `b ⋠ c` then some atom lies below `b` but not
below `c`. -/
@[kb "judson2026" "Lemma 19.2.7, p. 267"]
theorem judson_19_2_7 {B : Type*} [BooleanAlgebra B] [Finite B] {b c : B} (h : ¬ b ≤ c) :
    ∃ a : B, IsAtom a ∧ a ≤ b ∧ ¬ a ≤ c :=
  exists_atom_le_not_le h

/-- AA-347. In a finite Boolean algebra every element is the join of the atoms below it, and a
finite set of atoms with join `b` is exactly the set of atoms below `b`. -/
@[kb "judson2026" "Lemma 19.2.8, p. 267"]
theorem judson_19_2_8 {B : Type*} [BooleanAlgebra B] [Finite B] (b : B) :
    (∃ S : Finset B, (∀ a ∈ S, IsAtom a) ∧ S.sup id = b) ∧
    ∀ S : Finset B, (∀ a ∈ S, IsAtom a) → S.sup id = b →
      (S : Set B) = {a : B | IsAtom a ∧ a ≤ b} :=
  sup_atoms_le_eq b

/-- AA-348. Every finite Boolean algebra is isomorphic (as an ordered set, hence as a lattice) to
the power set of its set of atoms. -/
@[kb "judson2026" "Theorem 19.2.9, p. 267-268"]
theorem judson_19_2_9 {B : Type*} [BooleanAlgebra B] [Finite B] :
    Nonempty (B ≃o Set {a : B // IsAtom a}) :=
  ⟨atomsOrderIso⟩

/-- AA-349. A finite Boolean algebra with `n` atoms has `2 ^ n` elements. -/
@[kb "judson2026" "Corollary 19.2.10, p. 268"]
theorem judson_19_2_10 {B : Type*} [BooleanAlgebra B] [Finite B] :
    Nat.card B = 2 ^ Nat.card {a : B // IsAtom a} :=
  card_eq_two_pow_card_atoms

/-- AA-351. Circuits up to equal behaviour form a Boolean algebra in which meet is series,
join is parallel and complement is the complementary circuit. -/
@[kb "judson2026" "Theorem 19.3.7, p. 269"]
theorem judson_19_3_7 (n : ℕ) :
    Nonempty (BooleanAlgebra (CircuitClass n)) ∧
    ∀ c d : Circuit n, CircuitClass.mk (Circuit.series c d) = CircuitClass.mk c ⊓ CircuitClass.mk d ∧
      CircuitClass.mk (Circuit.parallel c d) = CircuitClass.mk c ⊔ CircuitClass.mk d ∧
      CircuitClass.mk c.compl = (CircuitClass.mk c)ᶜ :=
  ⟨⟨CircuitClass.instBooleanAlgebra⟩, fun _ _ => ⟨rfl, rfl, rfl⟩⟩

