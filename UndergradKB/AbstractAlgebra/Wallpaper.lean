import Mathlib.GroupTheory.SpecificGroups.Dihedral
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.LinearAlgebra.UnitaryGroup
import Mathlib.LinearAlgebra.Matrix.ToLin
import UndergradKB.AbstractAlgebra.FiniteSymmetry
import UndergradKB.AbstractAlgebra.MatrixGroups2
import UndergradKB.Common.Attr

/-!
# Point groups of plane lattices (partial result towards the wallpaper groups)

Judson–Beezer, Section 12.2: the point group of a wallpaper group is a finite subgroup of `O(2)`
preserving a plane lattice, and the crystallographic restriction shows it is one of the ten groups
`ℤ_n`, `D_n` with `n ∈ {1, 2, 3, 4, 6}`. This file proves exactly that step
(`point_group_crystallographic`): a finite subgroup of `O(2)` whose elements all preserve a lattice
generated by two independent vectors is isomorphic to `ℤ_n` or `D_n` with `n ∈ {1, 2, 3, 4, 6}`.

The full theorem (exactly 17 wallpaper groups, Theorem 12.2.12) is NOT proved. Missing
ingredients:
* the definition of a wallpaper group as a discrete cocompact subgroup of the Euclidean group of
  the plane (and the proof that its point group preserves its translation lattice);
* the exact sequence translation lattice → group → point group, in particular that the
  translation subgroup is a rank-two lattice;
* the classification of the extensions (the possible actions of the ten point groups on the five
  lattice types, with glide reflections and non-split extensions) up to affine conjugacy, which
  yields the count 17.
-/

namespace UndergradKB.AbstractAlgebra

open Matrix

/-- The monoid homomorphism sending an orthogonal matrix to the linear map of `ℝ²` it defines. -/
noncomputable def orthToEnd : Matrix.orthogonalGroup (Fin 2) ℝ →* Module.End ℝ (Fin 2 → ℝ) where
  toFun A := Matrix.toLin' (A : Matrix (Fin 2) (Fin 2) ℝ)
  map_one' := by simp; rfl
  map_mul' A B := by simp [Matrix.toLin'_mul]; rfl

lemma orthToEnd_injective : Function.Injective orthToEnd := by
  intro A B h
  apply Subtype.ext
  exact Matrix.toLin'.injective h

/-- AA-191 (partial). The point group of a plane lattice is one of the ten crystallographic point
groups: a finite subgroup `G` of `O(2)` all of whose elements map the lattice generated by two
linearly independent vectors into itself is isomorphic to `ℤ_n` or `D_n` with
`n ∈ {1, 2, 3, 4, 6}`. The count 17 of wallpaper groups is not proved. -/
@[kb "judson2026" "Theorem 12.2.12, p. 171"]
theorem point_group_crystallographic (G : Subgroup (Matrix.orthogonalGroup (Fin 2) ℝ)) [Finite G]
    (x y : Fin 2 → ℝ) (hxy : LinearIndependent ℝ ![x, y])
    (hG : ∀ A : G, ∀ v ∈ lattice2 x y,
      Matrix.toLin' ((A : Matrix.orthogonalGroup (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) v ∈
        lattice2 x y) :
    ∃ n ∈ ({1, 2, 3, 4, 6} : Finset ℕ),
      (Nonempty (G ≃* Multiplicative (ZMod n))) ∨ (Nonempty (G ≃* DihedralGroup n)) := by
  obtain ⟨n, hn, hpos, hiso⟩ := finite_subgroup_orthogonal_two G
  refine ⟨n, ?_, hiso⟩
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := rotationPart G)
  have hord : orderOf g = n := by
    rw [hn]; exact orderOf_eq_card_of_forall_mem_zpowers hg
  let g' : G := g.1
  have hg' : orderOf g' = n := by
    rw [← hord]; exact Subgroup.orderOf_coe g
  let f : G →* Module.End ℝ (Fin 2 → ℝ) := orthToEnd.comp G.subtype
  have hf : Function.Injective f := fun a b h =>
    Subtype.ext (orthToEnd_injective h)
  have hT : orderOf (f g') = n := by rw [orderOf_injective f hf g', hg']
  have hpow : f g' ^ n = 1 := by rw [← hT]; exact pow_orderOf_eq_one _
  have := crystallographic_restriction (V := Fin 2 → ℝ) (by simp) hxy (f g')
    (fun v hv => hG g' v hv) n hpos.ne' hpow
  rw [hT] at this
  simp only [Finset.mem_insert, Finset.mem_singleton]
  omega

end UndergradKB.AbstractAlgebra
