/-! # Judson–Beezer, chapters 3, 5, 6, 14: permutation and dihedral groups

Small groups (triangle symmetries, `Q₈`), dihedral groups inside symmetric groups, cycles,
`A₄` has no subgroup of order 6, conjugacy classes and fixed colorings. -/

namespace UndergradKB.AbstractAlgebra

open Equiv Equiv.Perm

/-! ### `A₄` has no subgroup of order 6 -/

/-- AA-088. The group `A₄` (order 12) has no subgroup of order 6. -/
@[kb "judson2026" "Proposition 6.2.7, p. 92"]
theorem alternatingGroup_four_no_subgroup_order_six
    (H : Subgroup (alternatingGroup (Fin 4))) : Nat.card H ≠ 6 := by
  intro h6
  have hcard : Nat.card (alternatingGroup (Fin 4)) = 12 := by
    rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]; decide
  have hidx : H.index = 2 := by
    have := H.index_mul_card
    rw [h6, hcard] at this
    omega
  have hsub : {g : alternatingGroup (Fin 4) | IsThreeCycle (g : Perm (Fin 4))} ⊆ H := by
    intro g hg
    have h3 : (g : Perm (Fin 4)) ^ 3 = 1 := by
      rw [← hg.orderOf]; exact pow_orderOf_eq_one _
    have : g = (g ^ 2) ^ 2 := by
      apply Subtype.ext
      have : (g : Perm (Fin 4)) ^ 4 = g := by
        rw [pow_succ (g : Perm (Fin 4)) 3, h3, one_mul]
      simpa [← pow_mul] using this.symm
    rw [this]
    exact Subgroup.sq_mem_of_index_two hidx _
  have htop : H = ⊤ := by
    rw [eq_top_iff, ← alternatingGroup.closure_isThreeCycles_eq_top, Subgroup.closure_le]
    exact hsub
  rw [htop, Subgroup.card_top, hcard] at h6
  omega

/-! ### Dihedral groups inside symmetric groups -/

/-- The action of the dihedral group on `ZMod n` (the `n` vertices of an `n`-gon):
rotation `r i` adds `i`, reflection `sr i` sends `x` to `-i - x`. -/
def dihedralToPerm (n : ℕ) : DihedralGroup n →* Perm (ZMod n) :=
  MonoidHom.mk'
    (fun g => match g with
      | DihedralGroup.r i => Equiv.addRight i
      | DihedralGroup.sr i => (Equiv.neg _).trans (Equiv.subLeft i |>.trans (Equiv.neg _)))
    (by
      intro a b
      cases a <;> cases b <;> (ext x; simp; ring))

theorem dihedralToPerm_r (n : ℕ) (i x : ZMod n) :
    dihedralToPerm n (DihedralGroup.r i) x = x + i := rfl

theorem dihedralToPerm_sr (n : ℕ) (i x : ZMod n) :
    dihedralToPerm n (DihedralGroup.sr i) x = -i - x := by
  simp [dihedralToPerm]; ring

theorem two_ne_zero_zmod {n : ℕ} (hn : 3 ≤ n) : (2 : ZMod n) ≠ 0 := by
  intro h
  have h' : ((2 : ℕ) : ZMod n) = 0 := by simpa using h
  rw [ZMod.natCast_eq_zero_iff] at h'
  have := Nat.le_of_dvd (by norm_num) h'
  omega

theorem dihedralToPerm_injective {n : ℕ} (hn : 3 ≤ n) :
    Function.Injective (dihedralToPerm n) := by
  have h2 := two_ne_zero_zmod hn
  intro a b hab
  have key : ∀ x, dihedralToPerm n a x = dihedralToPerm n b x := fun x => by rw [hab]
  have k0 := key 0
  have k1 := key 1
  cases a <;> cases b <;>
    simp only [dihedralToPerm_r, dihedralToPerm_sr] at k0 k1
  · simpa using k0
  · exfalso; apply h2; linear_combination k1 - k0
  · exfalso; apply h2; linear_combination k0 - k1
  · congr 1; linear_combination -k0

/-- AA-075. For `n ≥ 3`, `D_n` embeds in the symmetric group on the `n` vertices, so it is
(isomorphic to) a subgroup of order `2n` of `S_n`. -/
@[kb "judson2026" "Theorem 5.2.2, p. 80"]
theorem dihedralGroup_embeds_perm {n : ℕ} (hn : 3 ≤ n) :
    ∃ f : DihedralGroup n →* Perm (ZMod n),
      Function.Injective f ∧ Nat.card f.range = 2 * n := by
  refine ⟨dihedralToPerm n, dihedralToPerm_injective hn, ?_⟩
  rw [Nat.card_congr (MonoidHom.ofInjective (dihedralToPerm_injective hn)).toEquiv.symm,
    DihedralGroup.nat_card]

/-- AA-076. `D_n` is generated by a rotation `r 1` of order `n` and a reflection `sr 0` of
order 2, which satisfy `s r s = r⁻¹`. -/
@[kb "judson2026" "Theorem 5.2.3, p. 80"]
theorem dihedralGroup_generated (n : ℕ) :
    orderOf (DihedralGroup.r 1 : DihedralGroup n) = n ∧
    orderOf (DihedralGroup.sr 0 : DihedralGroup n) = 2 ∧
    (DihedralGroup.sr 0 * DihedralGroup.r 1 * DihedralGroup.sr 0 : DihedralGroup n)
      = (DihedralGroup.r 1)⁻¹ ∧
    Subgroup.closure {(DihedralGroup.r 1 : DihedralGroup n), DihedralGroup.sr 0} = ⊤ := by
  refine ⟨DihedralGroup.orderOf_r_one, DihedralGroup.orderOf_sr 0, by simp, ?_⟩
  rw [eq_top_iff]
  rintro (i | i) -
  · have : (DihedralGroup.r i : DihedralGroup n) = (DihedralGroup.r 1) ^ (ZMod.cast i : ℤ) := by
      rw [DihedralGroup.r_one_zpow]; simp
    rw [this]
    exact Subgroup.zpow_mem _ (Subgroup.subset_closure (by simp)) _
  · have : (DihedralGroup.sr i : DihedralGroup n)
        = DihedralGroup.r (-i) * DihedralGroup.sr 0 := by simp
    rw [this]
    refine Subgroup.mul_mem _ ?_ (Subgroup.subset_closure (by simp))
    have : (DihedralGroup.r (-i) : DihedralGroup n) = (DihedralGroup.r 1) ^ (ZMod.cast (-i) : ℤ) := by
      rw [DihedralGroup.r_one_zpow]; simp
    rw [this]
    exact Subgroup.zpow_mem _ (Subgroup.subset_closure (by simp)) _

/-- AA-030. The symmetries of the triangle `D₃` are the group `S₃` of order 6, nonabelian. -/
@[kb "judson2026" "Example 3.2.6, p. 47"]
theorem dihedralGroup_three :
    Nonempty (DihedralGroup 3 ≃* Perm (Fin 3)) ∧ Nat.card (DihedralGroup 3) = 6 ∧
      ¬ IsMulCommutative (DihedralGroup 3) := by
  refine ⟨?_, by rw [DihedralGroup.nat_card], DihedralGroup.not_commutative (by norm_num)
    (by norm_num)⟩
  have hinj := dihedralToPerm_injective (le_refl 3)
  have hbij : Function.Bijective (dihedralToPerm 3) := by
    refine hinj.bijective_of_nat_card_le ?_
    rw [DihedralGroup.nat_card, Nat.card_eq_fintype_card, Fintype.card_perm, ZMod.card]
    decide
  exact ⟨(MulEquiv.ofBijective _ hbij).trans (Equiv.permCongrHom (Equiv.refl (Fin 3)))⟩

/-- AA-032. The quaternion group `Q₈ = QuaternionGroup 2` has order 8 and is nonabelian. -/
@[kb "judson2026" "Example 3.2.8, p. 48"]
theorem quaternionGroup_two :
    Nat.card (QuaternionGroup 2) = 8 ∧ ¬ IsMulCommutative (QuaternionGroup 2) := by
  refine ⟨by simp [Nat.card_eq_fintype_card, QuaternionGroup.card], fun h => ?_⟩
  have := h.is_comm.comm (QuaternionGroup.a 1) (QuaternionGroup.xa 0)
  simp [QuaternionGroup.a_mul_xa, QuaternionGroup.xa_mul_a] at this
  revert this
  decide

/-! ### Cycles -/

/-- AA-065. The book's cycle `(a₁ a₂ … a_k)` (distinct entries, `k ≥ 2`) is Mathlib's
`List.formPerm`: it is a cycle, it sends `a_i` to `a_{i+1}` (indices mod `k`), its support has
exactly `k` elements and its order is `k`. -/
@[kb "judson2026" "Definition (cycle of length k), p. 75"]
theorem formPerm_isCycle_length {α : Type*} [DecidableEq α] [Fintype α] (l : List α)
    (hl : l.Nodup) (hk : 2 ≤ l.length) :
    (List.formPerm l).IsCycle ∧
    (∀ i (h : i < l.length), List.formPerm l l[i] = l[(i + 1) % l.length]'(Nat.mod_lt _ (by omega))) ∧
    (List.formPerm l).support.card = l.length ∧ orderOf (List.formPerm l) = l.length := by
  have hc := List.isCycle_formPerm hl hk
  have hcard : (List.formPerm l).support.card = l.length := by
    rw [List.support_formPerm_of_nodup _ hl, List.toFinset_card_of_nodup hl]
    intro x h; simp [h] at hk
  exact ⟨hc, fun i h => List.formPerm_apply_getElem l hl i h, hcard, by rw [hc.orderOf, hcard]⟩

/-- AA-065 (disjoint cycles). Disjoint permutations (in particular disjoint cycles) commute. -/
@[kb "judson2026" "Definition (disjoint cycles), p. 75"]
theorem disjoint_cycles_commute {α : Type*} {σ τ : Perm α} (h : Disjoint σ τ) :
    σ * τ = τ * σ := h.commute.eq

/-! ### Conjugacy classes of `S_n` and fixed colorings -/

/-- The partition of `n` attached to the conjugacy class of a permutation (cycle lengths,
fixed points counted as 1-cycles). -/
noncomputable def conjClassesPartition(α : Type*) [Fintype α] [DecidableEq α] :
    ConjClasses (Perm α) ≃ (Fintype.card α).Partition :=
  Equiv.ofBijective
    (Quotient.lift (fun σ : Perm α => σ.partition)
      (fun _ _ h => Equiv.Perm.partition_eq_of_isConj.1 h))
    (by
      constructor
      · intro a b
        induction a using Quotient.inductionOn
        induction b using Quotient.inductionOn
        intro h
        exact Quotient.sound (Equiv.Perm.partition_eq_of_isConj.2 h)
      · intro p
        set m := p.parts.filter (2 ≤ ·) with hm
        set o := p.parts.filter (fun a => ¬ 2 ≤ a) with ho
        have hsplit : m + o = p.parts := Multiset.filter_add_not _ _
        have ho1 : o = Multiset.replicate (Multiset.card o) 1 := by
          refine Multiset.eq_replicate_card.2 ?_
          intro b hb
          rw [ho, Multiset.mem_filter] at hb
          have := p.parts_pos hb.1
          omega
        have hsum : m.sum + o.sum = Fintype.card α := by
          rw [← Multiset.sum_add, hsplit]; exact p.parts_sum
        have hosum : o.sum = Multiset.card o := by
          conv_lhs => rw [ho1]
          simp
        obtain ⟨g, hg⟩ := (Equiv.Perm.exists_with_cycleType_iff (α := α) (m := m)).2
          ⟨by omega, fun a ha => (Multiset.mem_filter.1 ha).2⟩
        refine ⟨Quotient.mk _ g, ?_⟩
        show g.partition = p
        apply Nat.Partition.ext
        have hs : g.support.card = m.sum := by rw [← Equiv.Perm.sum_cycleType, hg]
        have hk : Fintype.card α - g.support.card = Multiset.card o := by omega
        rw [Equiv.Perm.parts_partition, hg, hk, ← ho1, hsplit])

theorem comp_zpow_apply {X Y : Type*} {σ : Perm X} {f : X → Y} (hf : ∀ x, f (σ x) = f x)
    (i : ℤ) (x : X) : f ((σ ^ i) x) = f x := by
  induction i using Int.induction_on generalizing x with
  | zero => simp
  | succ i ih => rw [zpow_add_one, Perm.mul_apply, ih (σ x), hf]
  | pred i ih =>
    rw [zpow_sub_one, Perm.mul_apply, ih]
    have := hf (σ⁻¹ x)
    simp at this
    exact this.symm

/-- Colorings fixed by `σ` correspond to functions on the cycle classes of `σ`. -/
def fixedColoringsEquiv {X Y : Type*} (σ : Perm X) :
    {f : X → Y // f ∘ σ = f} ≃ (Quotient (SameCycle.setoid σ) → Y) where
  toFun f := Quotient.lift f.1 (fun x y h => by
    obtain ⟨i, rfl⟩ := h
    exact (comp_zpow_apply (fun x => congrFun f.2 x) i x).symm)
  invFun F := ⟨F ∘ Quotient.mk _, funext fun x =>
    congrArg F (Quotient.sound (Equiv.Perm.sameCycle_apply_left.2 SameCycle.rfl))⟩
  left_inv f := Subtype.ext (funext fun x => rfl)
  right_inv F := funext fun q => Quotient.inductionOn q fun x => rfl

/-- The cycle classes of `σ` (with fixed points as singleton classes) are the cycles of `σ`
together with its fixed points. -/
noncomputable def cycleKey {X : Type*} [Fintype X] [DecidableEq X] (σ : Perm X) (x : X) :
    σ.cycleFactorsFinset ⊕ {x // x ∉ σ.support} :=
  if h : x ∈ σ.support then Sum.inl ⟨σ.cycleOf x, cycleOf_mem_cycleFactorsFinset_iff.2 h⟩
  else Sum.inr ⟨x, h⟩

/-- The cycle classes of `σ` (with fixed points as singleton classes) are the cycles of `σ`
together with its fixed points. -/
noncomputable def cycleClassesEquiv {X : Type*} [Fintype X] [DecidableEq X] (σ : Perm X) :
    Quotient (SameCycle.setoid σ) ≃ σ.cycleFactorsFinset ⊕ {x // x ∉ σ.support} :=
  Equiv.ofBijective
    (Quotient.lift (cycleKey σ)
      (fun x y h => by
        unfold cycleKey
        by_cases hx : x ∈ σ.support
        · have hy : y ∈ σ.support := h.mem_support_iff.1 hx
          simp only [hx, hy, dite_true]
          exact congrArg Sum.inl (Subtype.ext h.cycleOf_eq)
        · have hy : y ∉ σ.support := fun hy => hx (h.mem_support_iff.2 hy)
          have : x = y := by
            simp only [mem_support, not_not] at hx hy
            exact h.eq_of_left hx
          subst this
          simp [hx]))
    (by
      constructor
      · refine Quotient.ind (fun x => Quotient.ind (fun y => ?_))
        intro h
        apply Quotient.sound
        change SameCycle σ x y
        change cycleKey σ x = cycleKey σ y at h
        unfold cycleKey at h
        by_cases hx : x ∈ σ.support <;> by_cases hy : y ∈ σ.support
        · rw [dif_pos hx, dif_pos hy] at h
          exact (sameCycle_iff_cycleOf_eq_of_mem_support hx hy).2
            (congrArg Subtype.val (Sum.inl.inj h))
        · rw [dif_pos hx, dif_neg hy] at h
          exact absurd h (by simp)
        · rw [dif_neg hx, dif_pos hy] at h
          exact absurd h (by simp)
        · rw [dif_neg hx, dif_neg hy] at h
          have := congrArg Subtype.val (Sum.inr.inj h)
          simp only at this
          subst this
          exact SameCycle.refl _ _
      · rintro (⟨c, hc⟩ | ⟨x, hx⟩)
        · obtain ⟨a, ha⟩ := (mem_cycleFactorsFinset_iff.1 hc).1.nonempty_support
          have hsa : a ∈ σ.support := mem_cycleFactorsFinset_support_le hc ha
          refine ⟨Quotient.mk _ a, ?_⟩
          change cycleKey σ a = Sum.inl ⟨c, hc⟩
          unfold cycleKey
          rw [dif_pos hsa]
          exact congrArg Sum.inl (Subtype.ext (cycle_is_cycleOf ha hc).symm)
        · refine ⟨Quotient.mk _ x, ?_⟩
          change cycleKey σ x = Sum.inr ⟨x, hx⟩
          unfold cycleKey
          rw [dif_neg hx])

/-- AA-223. A permutation `σ` of a finite set `X` fixes exactly `|Y| ^ c` colorings
`f : X → Y` (under `f ↦ f ∘ σ`), where `c` is the number of cycles of `σ` counting fixed points
as cycles of length 1. -/
@[kb "judson2026" "Proposition 14.3.5, p. 193"]
theorem card_fixed_colorings {X Y : Type*} [Fintype X] [DecidableEq X] [Finite Y] (σ : Perm X) :
    Nat.card {f : X → Y // f ∘ σ = f} =
      Nat.card Y ^ (σ.cycleType.card + (Fintype.card X - σ.support.card)) := by
  have hQ : Nat.card (Quotient (SameCycle.setoid σ)) =
      σ.cycleType.card + (Fintype.card X - σ.support.card) := by
    rw [Nat.card_congr (cycleClassesEquiv σ), Nat.card_sum]
    have hF : Nat.card {x // x ∉ σ.support} = Fintype.card X - σ.support.card := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype_compl, Fintype.card_coe]
    rw [hF]
    simp [cycleType_def, Nat.card_eq_fintype_card]
  rw [Nat.card_congr (fixedColoringsEquiv σ), Nat.card_fun, hQ]

/-- AA-219. The number of conjugacy classes of `S_n` equals the number of partitions of `n`. -/
@[kb "judson2026" "Example 14.2.3, p. 189"]
theorem card_conjClasses_perm (n : ℕ) :
    Nat.card (ConjClasses (Perm (Fin n))) = Nat.card n.Partition := by
  have := Nat.card_congr (conjClassesPartition (Fin n))
  simpa using this

