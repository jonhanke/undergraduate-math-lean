import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.LinearAlgebra.Vandermonde
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
import Mathlib.InformationTheory.Hamming
import Mathlib.FieldTheory.Minpoly.Field
import UndergradKB.Common.Attr

/-! # Judson–Beezer, section 22.2: polynomial codes and cyclic codes

Words of length `n` over a field `F` are `Fin n → F`. A word `w` is identified with the polynomial
`∑ w i X^i` (`toPoly`); the ring `R_n = F[x]/(x^n - 1)` is `AdjoinRoot (X^n - 1)`. The cyclic shift
corresponds to multiplication by `x`, so cyclic codes are the ideals of `R_n` (Theorem 22.2.3), which
are generated by monic divisors of `x^n - 1`; the BCH bound is proved with the Vandermonde determinant.
-/

open Polynomial

namespace UndergradKB.AbstractAlgebra

namespace CyclicCodes

variable {F : Type*} [Field F] {n : ℕ}

/-- The polynomial `∑ w i X^i` of a word. -/
noncomputable def toPoly (w : Fin n → F) : F[X] := ∑ i : Fin n, C (w i) * X ^ (i : ℕ)

lemma coeff_toPoly_apply (w : Fin n → F) (m : ℕ) :
    (toPoly w).coeff m = ∑ i : Fin n, if m = (i : ℕ) then w i else 0 := by
  have := map_sum (lcoeff F m) (fun i : Fin n => C (w i) * X ^ (i : ℕ)) Finset.univ
  simp only [lcoeff_apply, coeff_C_mul, coeff_X_pow] at this
  rw [toPoly, this]
  simp

lemma coeff_toPoly (w : Fin n → F) (i : Fin n) : (toPoly w).coeff i = w i := by
  rw [coeff_toPoly_apply]
  simp [Fin.val_inj]

lemma coeff_toPoly_of_le(w : Fin n → F) {m : ℕ} (h : n ≤ m) : (toPoly w).coeff m = 0 := by
  rw [coeff_toPoly_apply]
  refine Finset.sum_eq_zero fun i _ => ?_
  have : m ≠ (i : ℕ) := by have := i.2; omega
  simp [this]

lemma degree_Xn_sub_one (hn : 0 < n) : (X ^ n - 1 : F[X]).degree = n := by
  simpa using degree_X_pow_sub_C hn (1 : F)

lemma Xn_sub_one_ne_zero [NeZero n] : (X ^ n - 1 : F[X]) ≠ 0 := by
  intro h
  have := degree_Xn_sub_one (F := F) (Nat.pos_of_ne_zero (NeZero.ne n))
  rw [h] at this
  simp at this

lemma toPoly_mem_degreeLT (w : Fin n → F) : toPoly w ∈ degreeLT F n := by
  rw [mem_degreeLT, degree_lt_iff_coeff_zero]
  intro m hm
  exact coeff_toPoly_of_le w hm

lemma toPoly_add (w w' : Fin n → F) : toPoly (w + w') = toPoly w + toPoly w' := by
  simp [toPoly, add_mul, Finset.sum_add_distrib]

lemma toPoly_smul (c : F) (w : Fin n → F) : toPoly (c • w) = C c * toPoly w := by
  simp [toPoly, Finset.mul_sum, mul_assoc, mul_left_comm _ (C c)]

lemma toPoly_injective : Function.Injective (toPoly (F := F) (n := n)) := by
  intro w w' h
  funext i
  rw [← coeff_toPoly w i, ← coeff_toPoly w' i, h]

lemma toPoly_surj {p : F[X]} (hp : p ∈ degreeLT F n) : ∃ w : Fin n → F, toPoly w = p := by
  refine ⟨fun i => p.coeff i, ?_⟩
  ext m
  by_cases hm : m < n
  · simpa using coeff_toPoly (fun i : Fin n => p.coeff i) ⟨m, hm⟩
  · rw [coeff_toPoly_of_le _ (not_lt.mp hm)]
    exact ((degree_lt_iff_coeff_zero _ _).mp (mem_degreeLT.mp hp) m (not_lt.mp hm)).symm

/-- The ring `R_n = F[x] / (x^n - 1)`. -/
abbrev Rn (F : Type*) [Field F] (n : ℕ) := AdjoinRoot (X ^ n - 1 : F[X])

/-- The image of a word in `R_n`. -/
noncomputable def toR (w : Fin n → F) : Rn F n := AdjoinRoot.mk _ (toPoly w)

lemma toR_add (w w' : Fin n → F) : toR (w + w') = toR w + toR w' := by
  simp [toR, toPoly_add]

lemma toR_smul (c : F) (w : Fin n → F) : toR (c • w) = algebraMap F (Rn F n) c * toR w := by
  simp [toR, toPoly_smul, AdjoinRoot.mk_C]

lemma toR_injective : Function.Injective (toR (F := F) (n := n)) := by
  intro w w' h
  apply toPoly_injective
  have hd : (X ^ n - 1 : F[X]) ∣ toPoly w - toPoly w' := AdjoinRoot.mk_eq_mk.mp h
  by_contra hne
  have hne' : toPoly w - toPoly w' ≠ 0 := sub_ne_zero.mpr hne
  have hlt : degree (toPoly w - toPoly w') < degree (X ^ n - 1 : F[X]) := by
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · exact absurd (by funext i; exact i.elim0 : w = w') (fun h' => hne (by rw [h']))
    · rw [degree_Xn_sub_one hn]
      exact mem_degreeLT.mp (Submodule.sub_mem _ (toPoly_mem_degreeLT w)
        (toPoly_mem_degreeLT w'))
  exact hne' (eq_zero_of_dvd_of_degree_lt hd hlt)

lemma toR_surjective [NeZero n] : Function.Surjective (toR (F := F) (n := n)) := by
  intro r
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective r
  have hm : (X ^ n - 1 : F[X]).Monic := monic_X_pow_sub_C _ (NeZero.ne n)
  have hlt : p %ₘ (X ^ n - 1) ∈ degreeLT F n := by
    rw [mem_degreeLT]
    have := degree_modByMonic_lt p hm
    rwa [degree_Xn_sub_one (Nat.pos_of_ne_zero (NeZero.ne n))] at this
  obtain ⟨w, hw⟩ := toPoly_surj hlt
  refine ⟨w, ?_⟩
  rw [toR, hw, AdjoinRoot.mk_eq_mk]
  refine ⟨-(p /ₘ (X ^ n - 1)), ?_⟩
  have := modByMonic_add_div p (X ^ n - 1 : F[X])
  linear_combination this

lemma root_pow (n : ℕ) : (AdjoinRoot.root (X ^ n - 1 : F[X])) ^ n = 1 := by
  have h := AdjoinRoot.eval₂_root (X ^ n - 1 : F[X])
  simp only [eval₂_sub, eval₂_X_pow, eval₂_one] at h
  exact sub_eq_zero.mp h

lemma root_pow_mod (m : ℕ) : (AdjoinRoot.root (X ^ n - 1 : F[X])) ^ (m % n) =
    (AdjoinRoot.root (X ^ n - 1 : F[X])) ^ m := by
  conv_rhs => rw [← Nat.div_add_mod m n, pow_add, pow_mul, root_pow, one_pow, one_mul]

lemma toR_eq_sum (w : Fin n → F) : toR w =
    ∑ i : Fin n, algebraMap F (Rn F n) (w i) * (AdjoinRoot.root (X ^ n - 1 : F[X])) ^ (i : ℕ) := by
  simp [toR, toPoly, map_sum, AdjoinRoot.mk_C, AdjoinRoot.mk_X]

/-- The cyclic shift of a word: the entry at position `i` moves to `i + 1`. -/
def shift [NeZero n] (w : Fin n → F) : Fin n → F := fun i => w (i - 1)

lemma toR_shift [NeZero n] (w : Fin n → F) :
    toR (shift w) = AdjoinRoot.root (X ^ n - 1 : F[X]) * toR w := by
  rw [toR_eq_sum, toR_eq_sum, Finset.mul_sum]
  refine Fintype.sum_equiv (Equiv.subRight (1 : Fin n)) _ _ fun i => ?_
  simp only [shift, Equiv.subRight_apply]
  have h1 : (i : ℕ) = ((i - 1).val + (1 : Fin n).val) % n := by
    rw [← Fin.val_add]; simp
  have h2 : (AdjoinRoot.root (X ^ n - 1 : F[X])) ^ ((1 : Fin n) : ℕ) =
      AdjoinRoot.root (X ^ n - 1 : F[X]) := by
    rw [Fin.val_one', root_pow_mod 1, pow_one]
  have h3 : (AdjoinRoot.root (X ^ n - 1 : F[X])) ^ (i : ℕ) =
      AdjoinRoot.root (X ^ n - 1 : F[X]) * (AdjoinRoot.root (X ^ n - 1 : F[X])) ^ ((i - 1 : Fin n) : ℕ) := by
    conv_lhs => rw [h1, root_pow_mod, pow_add, h2]
    ring
  rw [h3]
  ring

/-- `toR` as an `F`-linear map. -/
noncomputable def toRₗ : (Fin n → F) →ₗ[F] Rn F n where
  toFun := toR
  map_add' := toR_add
  map_smul' c w := by
    show toR (c • w) = c • toR w
    rw [toR_smul, Algebra.smul_def]

lemma toRₗ_apply (w : Fin n → F) : toRₗ w = toR w := rfl

lemma toPoly_zero : toPoly (0 : Fin n → F) = 0 := by simp [toPoly]

/-! ### Cyclic codes (AA-412, AA-413) -/

/-- AA-412. A code (a subspace of `F^n`) is cyclic if it is closed under the cyclic shift. -/
@[kb "judson2026" "Definition (cyclic code), p. 307"]
def IsCyclicCode [NeZero n] (C : Submodule F (Fin n → F)) : Prop := ∀ w ∈ C, shift w ∈ C

lemma mul_root_pow_mem [NeZero n] {C : Submodule F (Fin n → F)} (hC : IsCyclicCode C) (k : ℕ) :
    ∀ w ∈ C, (AdjoinRoot.root (X ^ n - 1 : F[X])) ^ k * toR w ∈ C.map toRₗ := by
  induction k with
  | zero => intro w hw; exact ⟨w, hw, by simp [toRₗ_apply]⟩
  | succ k ih =>
    intro w hw
    have := ih (shift w) (hC w hw)
    rw [toR_shift] at this
    rw [pow_succ, mul_assoc]
    exact this

/-- AA-413 (Theorem 22.2.3). A linear code in `F^n` is cyclic iff its image in
`R_n = F[x]/(x^n - 1)` is an ideal. -/
@[kb "judson2026" "Theorem 22.2.3, p. 309"]
theorem isCyclicCode_iff_exists_ideal [NeZero n] (C : Submodule F (Fin n → F)) :
    IsCyclicCode C ↔ ∃ I : Ideal (Rn F n), (I : Set (Rn F n)) = toR '' (C : Set (Fin n → F)) := by
  constructor
  · intro hC
    refine ⟨{ carrier := toR '' (C : Set (Fin n → F))
              add_mem' := ?_, zero_mem' := ?_, smul_mem' := ?_ }, rfl⟩
    · rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
      exact ⟨a + b, C.add_mem ha hb, toR_add a b⟩
    · exact ⟨0, C.zero_mem, by simp [toR, toPoly_zero]⟩
    · rintro r _ ⟨w, hw, rfl⟩
      obtain ⟨u, rfl⟩ := toR_surjective r
      have hmem : toR u * toR w ∈ C.map toRₗ := by
        rw [toR_eq_sum u, Finset.sum_mul]
        refine Submodule.sum_mem _ fun i _ => ?_
        have := (C.map toRₗ).smul_mem (u i) (mul_root_pow_mem hC i w hw)
        rwa [Algebra.smul_def, ← mul_assoc] at this
      obtain ⟨v, hv, hv'⟩ := hmem
      exact ⟨v, hv, hv'⟩
  · rintro ⟨I, hI⟩ w hw
    have h1 : toR w ∈ I := by
      have : toR w ∈ (I : Set (Rn F n)) := by rw [hI]; exact ⟨w, hw, rfl⟩
      exact this
    have h2 : AdjoinRoot.root (X ^ n - 1 : F[X]) * toR w ∈ I := I.mul_mem_left _ h1
    rw [← toR_shift] at h2
    have : toR (shift w) ∈ toR '' (C : Set (Fin n → F)) := by rw [← hI]; exact h2
    obtain ⟨w', hw', hw''⟩ := this
    rw [← toR_injective hw'']
    exact hw'

/-! ### Ideals of `R_n` (AA-414) -/

lemma mk_dvd_iff {f g p : F[X]} (hg : g ∣ f) :
    AdjoinRoot.mk f g ∣ AdjoinRoot.mk f p ↔ g ∣ p := by
  constructor
  · rintro ⟨r, hr⟩
    obtain ⟨s, rfl⟩ := AdjoinRoot.mk_surjective r
    rw [← map_mul, AdjoinRoot.mk_eq_mk] at hr
    have h1 := dvd_trans hg hr
    have := dvd_add h1 (dvd_mul_right g s)
    simpa using this
  · intro h
    exact map_dvd _ h

/-- AA-414. Every ideal of `R_n = F[x]/(x^n - 1)` is generated by a unique monic divisor of
`x^n - 1`. -/
@[kb "judson2026" "Definition and statement (ideals of R_n), p. 309"]
theorem exists_unique_monic_generator [NeZero n] (I : Ideal (Rn F n)) :
    ∃! g : F[X], g.Monic ∧ g ∣ (X ^ n - 1 : F[X]) ∧
      I = Ideal.span {AdjoinRoot.mk (X ^ n - 1 : F[X]) g} := by
  have hf : (X ^ n - 1 : F[X]) ≠ 0 := Xn_sub_one_ne_zero
  have hdvd : ∀ {g1 g2 : F[X]}, g2 ∣ (X ^ n - 1 : F[X]) →
      Ideal.span {AdjoinRoot.mk (X ^ n - 1 : F[X]) g1} ≤
        Ideal.span {AdjoinRoot.mk (X ^ n - 1 : F[X]) g2} → g2 ∣ g1 := by
    intro g1 g2 h2 hle
    have := hle (Ideal.mem_span_singleton_self _)
    exact (mk_dvd_iff h2).mp (Ideal.mem_span_singleton.mp this)
  obtain ⟨h, hh⟩ := (IsPrincipalIdealRing.principal
    (I.comap (AdjoinRoot.mk (X ^ n - 1 : F[X])))).principal
  have hfh : h ∣ (X ^ n - 1 : F[X]) := by
    have : (X ^ n - 1 : F[X]) ∈ I.comap (AdjoinRoot.mk (X ^ n - 1 : F[X])) := by
      rw [Ideal.mem_comap, AdjoinRoot.mk_self]; exact I.zero_mem
    rw [hh] at this
    exact Ideal.mem_span_singleton.mp this
  have hh0 : h ≠ 0 := by
    rintro rfl
    exact hf (zero_dvd_iff.mp hfh)
  set g := h * C (h.leadingCoeff)⁻¹ with hg
  have hlc : h.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hh0
  have hgh : g ∣ h := ⟨C h.leadingCoeff, by
    rw [hg, mul_assoc, ← C_mul, inv_mul_cancel₀ hlc, C_1, mul_one]⟩
  have hhg : h ∣ g := ⟨_, rfl⟩
  have hspan : Ideal.span {g} = I.comap (AdjoinRoot.mk (X ^ n - 1 : F[X])) := by
    rw [hh]
    exact le_antisymm (Ideal.span_singleton_le_span_singleton.mpr hhg)
      (Ideal.span_singleton_le_span_singleton.mpr hgh)
  have hIg : I = Ideal.span {AdjoinRoot.mk (X ^ n - 1 : F[X]) g} := by
    have := Ideal.map_comap_of_surjective (AdjoinRoot.mk (X ^ n - 1 : F[X]))
      AdjoinRoot.mk_surjective I
    rw [← hspan, Ideal.map_span, Set.image_singleton] at this
    exact this.symm
  have hgm : g.Monic := monic_mul_leadingCoeff_inv hh0
  have hgf : g ∣ (X ^ n - 1 : F[X]) := dvd_trans hgh hfh
  refine ⟨g, ⟨hgm, hgf, hIg⟩, ?_⟩
  rintro g' ⟨hm', hd', hI'⟩
  have h1 : g' ∣ g := hdvd hd' (le_of_eq (by rw [← hIg, hI']))
  have h2 : g ∣ g' := hdvd hgf (le_of_eq (by rw [← hIg, hI']))
  exact eq_of_monic_of_associated hm' hgm (associated_of_dvd_dvd h1 h2)

/-! ### Polynomial codes (AA-411) -/

/-- The polynomial code of length `n` generated by `g`: the multiples of `g` of degree `< n`,
inside `F[x]`. -/
noncomputable def polynomialCode (n : ℕ) (g : F[X]) : Submodule F F[X] :=
  (Submodule.span F[X] {g}).restrictScalars F ⊓ degreeLT F n

lemma mem_polynomialCode {n : ℕ} {g p : F[X]} :
    p ∈ polynomialCode n g ↔ g ∣ p ∧ p ∈ degreeLT F n := by
  simp only [polynomialCode, Submodule.mem_inf, Submodule.restrictScalars_mem]
  exact and_congr Ideal.mem_span_singleton Iff.rfl

/-- AA-411. For `g` of degree `n - k`, the polynomial code is the image of `degreeLT F k` under
multiplication by `g`; the multiplication is injective, so the code has dimension `k`. -/
@[kb "judson2026" "Definition (polynomial code), p. 308"]
theorem polynomialCode_eq_map {n k : ℕ} {g : F[X]} (hg : g ≠ 0) (hdeg : g.natDegree + k = n) :
    polynomialCode n g = (degreeLT F k).map (LinearMap.mulLeft F g) ∧
    Function.Injective (LinearMap.mulLeft F g) ∧
    Module.finrank F (polynomialCode n g) = k := by
  have hinj : Function.Injective (LinearMap.mulLeft F g) := mul_right_injective₀ hg
  have heq : polynomialCode n g = (degreeLT F k).map (LinearMap.mulLeft F g) := by
    ext p
    rw [mem_polynomialCode, Submodule.mem_map]
    constructor
    · rintro ⟨⟨q, rfl⟩, hp⟩
      refine ⟨q, ?_, by simp [mul_comm]⟩
      rw [mem_degreeLT] at hp ⊢
      rcases eq_or_ne q 0 with rfl | hq
      · simp
      · have hp0 : g * q ≠ 0 := mul_ne_zero hg hq
        have h1 := (natDegree_lt_iff_degree_lt hp0).mpr hp
        rw [natDegree_mul hg hq] at h1
        exact (natDegree_lt_iff_degree_lt hq).mp (by omega)
    · rintro ⟨q, hq, rfl⟩
      refine ⟨⟨q, by simp [mul_comm]⟩, ?_⟩
      rw [mem_degreeLT] at hq ⊢
      rcases eq_or_ne q 0 with rfl | hq0
      · simp
      · have h1 := (natDegree_lt_iff_degree_lt hq0).mpr hq
        have : (LinearMap.mulLeft F g) q = g * q := rfl
        rw [this]
        exact (natDegree_lt_iff_degree_lt (mul_ne_zero hg hq0)).mp
          (by rw [natDegree_mul hg hq0]; omega)
  refine ⟨heq, hinj, ?_⟩
  rw [heq]
  have e1 := (Submodule.equivMapOfInjective (LinearMap.mulLeft F g) hinj (degreeLT F k)).symm
  rw [e1.finrank_eq, (degreeLTEquiv F k).finrank_eq, Module.finrank_fin_fun]

/-! ### Codes from generator polynomials, and the parity-check property (AA-415) -/

/-- The words whose polynomial is divisible by `g` (the code `⟨g⟩` in `R_n`). -/
noncomputable def cyclicCodeOf (n : ℕ) (g : F[X]) : Submodule F (Fin n → F) where
  carrier := {w | g ∣ toPoly w}
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq, toPoly_add] at *
    exact dvd_add ha hb
  zero_mem' := by simp [toPoly_zero]
  smul_mem' := by
    intro c w hw
    simp only [Set.mem_ofPred_eq, toPoly_smul] at *
    exact dvd_mul_of_dvd_right hw _

lemma mem_cyclicCodeOf {g : F[X]} {w : Fin n → F} : w ∈ cyclicCodeOf n g ↔ g ∣ toPoly w := Iff.rfl

lemma mem_cyclicCodeOf_iff_mem_span {g : F[X]} (hg : g ∣ (X ^ n - 1 : F[X])) (w : Fin n → F) :
    w ∈ cyclicCodeOf n g ↔ toR w ∈ Ideal.span {AdjoinRoot.mk (X ^ n - 1 : F[X]) g} := by
  rw [Ideal.mem_span_singleton, toR, mk_dvd_iff hg]
  rfl

theorem isCyclicCode_cyclicCodeOf [NeZero n] {g : F[X]} (hg : g ∣ (X ^ n - 1 : F[X])) :
    IsCyclicCode (cyclicCodeOf n g) := by
  intro w hw
  have h1 : AdjoinRoot.mk (X ^ n - 1 : F[X]) g ∣ toR w := (mk_dvd_iff hg).mpr hw
  have h2 : AdjoinRoot.mk (X ^ n - 1 : F[X]) g ∣ toR (shift w) := by
    rw [toR_shift]; exact Dvd.dvd.mul_left h1 _
  exact (mk_dvd_iff hg).mp h2

/-- Every cyclic code is `⟨g⟩` for a monic divisor `g` of `x^n - 1` (AA-413 and AA-414 combined). -/
theorem exists_monic_cyclicCodeOf [NeZero n] {C : Submodule F (Fin n → F)} (hC : IsCyclicCode C) :
    ∃ g : F[X], g.Monic ∧ g ∣ (X ^ n - 1 : F[X]) ∧ C = cyclicCodeOf n g := by
  obtain ⟨I, hI⟩ := (isCyclicCode_iff_exists_ideal C).mp hC
  obtain ⟨g, ⟨hm, hd, hIg⟩, -⟩ := exists_unique_monic_generator I
  refine ⟨g, hm, hd, ?_⟩
  ext w
  rw [mem_cyclicCodeOf_iff_mem_span hd, ← hIg]
  constructor
  · intro hw
    have : toR w ∈ (I : Set (Rn F n)) := by rw [hI]; exact ⟨w, hw, rfl⟩
    exact this
  · intro hw
    have : toR w ∈ toR '' (C : Set (Fin n → F)) := by rw [← hI]; exact hw
    obtain ⟨w', hw', h⟩ := this
    rw [← toR_injective h]
    exact hw'

/-- AA-415 (Proposition 22.2.5, parity check). If `x^n - 1 = g h`, a word lies in `⟨g⟩` iff
its class times `h` is zero in `R_n`. -/
@[kb "judson2026" "Proposition 22.2.5, p. 310"]
theorem mem_cyclicCodeOf_iff_mul_eq_zero [NeZero n] {g h : F[X]} (hgh : g * h = X ^ n - 1)
    (w : Fin n → F) :
    w ∈ cyclicCodeOf n g ↔ toR w * AdjoinRoot.mk (X ^ n - 1 : F[X]) h = 0 := by
  have hh : h ≠ 0 := by
    rintro rfl
    exact Xn_sub_one_ne_zero (F := F) (n := n) (by rw [← hgh, mul_zero])
  rw [toR, ← map_mul, AdjoinRoot.mk_eq_zero, ← hgh, mem_cyclicCodeOf, mul_dvd_mul_iff_right hh]

/-! ### The BCH bound (AA-418) -/

section BCH

variable {E : Type*} [Field E] [Algebra F E] [DecidableEq F]

lemma aeval_toPoly (x : E) (w : Fin n → F) :
    aeval x (toPoly w) = ∑ i : Fin n, algebraMap F E (w i) * x ^ (i : ℕ) := by
  simp [toPoly, map_sum]

/-- Core of the BCH bound: a nonzero word whose polynomial vanishes at `s` consecutive powers
`ω^a, ..., ω^(a+s-1)` of a primitive `n`th root has more than `s` nonzero entries. -/
theorem lt_hammingNorm_of_vanishing [NeZero n] {ω : E} (hω : IsPrimitiveRoot ω n) (a s : ℕ)
    {w : Fin n → F} (hw : w ≠ 0) (hz : ∀ k < s, aeval (ω ^ (a + k)) (toPoly w) = 0) :
    s < hammingNorm w := by
  by_contra hle
  push_neg at hle
  set S : Finset (Fin n) := Finset.univ.filter (fun i => w i ≠ 0) with hS
  have hcard : hammingNorm w = S.card := rfl
  let e : Fin S.card ≃ S := S.equivFin.symm
  let idx : Fin S.card → Fin n := fun j => (e j).1
  let v : Fin S.card → E := fun j => ω ^ (idx j : ℕ)
  let y : Fin S.card → E := fun j => algebraMap F E (w (idx j)) * v j ^ a
  have hv : Function.Injective v := by
    intro j1 j2 h
    have := hω.pow_inj (idx j1).2 (idx j2).2 h
    exact e.injective (Subtype.ext (Fin.ext this))
  have hsys : ∀ k : Fin S.card, ∑ j, v j ^ (k : ℕ) * y j = 0 := by
    intro k
    have hk := hz k (by omega)
    rw [aeval_toPoly] at hk
    set f : Fin n → E := fun i => algebraMap F E (w i) * (ω ^ (a + k)) ^ (i : ℕ) with hf
    have h1 : ∑ i, f i = ∑ i ∈ S, f i := by
      symm
      refine Finset.sum_subset (Finset.subset_univ _) fun i _ hi => ?_
      have : w i = 0 := by simpa [hS] using hi
      simp [hf, this]
    have h2 : ∑ i ∈ S, f i = ∑ j, f (idx j) := by
      rw [← Finset.sum_coe_sort S f]
      exact (Equiv.sum_comp e (fun x : S => f x)).symm
    rw [← hk, h1, h2]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [hf, v, y]
    ring
  have hdet : (Matrix.transpose (Matrix.vandermonde v)).det ≠ 0 := by
    rw [Matrix.det_transpose]
    exact Matrix.det_vandermonde_ne_zero_iff.mpr hv
  have hy : y = 0 := by
    refine Matrix.eq_zero_of_mulVec_eq_zero hdet ?_
    funext k
    simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Matrix.vandermonde_apply,
      Pi.zero_apply]
    exact hsys k
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hw
  have hiS : i ∈ S := by simpa [hS] using hi
  have hj := congrFun hy (S.equivFin ⟨i, hiS⟩)
  have hω0 : ω ≠ 0 := hω.ne_zero (NeZero.ne n)
  simp only [y, v, idx, e, Equiv.symm_apply_apply, Pi.zero_apply] at hj
  rcases mul_eq_zero.mp hj with h | h
  · exact hi (by simpa using h)
  · exact pow_ne_zero _ (pow_ne_zero _ hω0) h

/-- AA-418 (Theorem 22.2.8, BCH bound). If `g` vanishes at `s` consecutive powers of a primitive
`n`th root `ω`, every nonzero word of the code `⟨g⟩` has at least `s + 1` nonzero entries. -/
@[kb "judson2026" "Theorem 22.2.8, p. 311"]
theorem bch_bound [NeZero n] {ω : E} (hω : IsPrimitiveRoot ω n) (a s : ℕ) {g : F[X]}
    (hg : ∀ k < s, aeval (ω ^ (a + k)) g = 0) {w : Fin n → F} (hw : w ∈ cyclicCodeOf n g)
    (hw0 : w ≠ 0) : s + 1 ≤ hammingNorm w := by
  refine lt_hammingNorm_of_vanishing hω a s hw0 fun k hk => ?_
  obtain ⟨q, hq⟩ := hw
  rw [hq, map_mul, hg k hk, zero_mul]

/-- Minimum distance form of the BCH bound: distinct codewords of `⟨g⟩` are at Hamming distance
at least `s + 1`. -/
theorem bch_minDist [NeZero n] {ω : E} (hω : IsPrimitiveRoot ω n) (a s : ℕ) {g : F[X]}
    (hg : ∀ k < s, aeval (ω ^ (a + k)) g = 0) {u v : Fin n → F} (hu : u ∈ cyclicCodeOf n g)
    (hv : v ∈ cyclicCodeOf n g) (huv : u ≠ v) : s + 1 ≤ hammingDist u v := by
  rw [hammingDist_eq_hammingNorm, neg_add_eq_sub]
  exact bch_bound (w := v - u) hω a s hg ((cyclicCodeOf n g).sub_mem hv hu)
    (sub_ne_zero.mpr huv.symm)

/-! ### BCH codes (AA-419, AA-420) -/

noncomputable local instance instNormalizedGCDMonoidPoly (K : Type*) [Field K] [DecidableEq K] :
    NormalizedGCDMonoid K[X] := UniqueFactorizationMonoid.toNormalizedGCDMonoid K[X]

/-- The generator of the BCH code with designed distance `2r + 1`: the lcm of the minimal
polynomials over `F` of `ω, ω^2, ..., ω^(2r)`. -/
noncomputable def bchGenerator (F : Type*) [Field F] [DecidableEq F] {E : Type*} [Field E] [Algebra F E] (ω : E)
    (r : ℕ) : F[X] := (Finset.Icc 1 (2 * r)).lcm (fun i => minpoly F (ω ^ i))

/-- AA-419. The BCH code of length `n`, generated by `bchGenerator F ω r`. -/
@[kb "judson2026" "Definition (BCH code), p. 312"]
noncomputable def bchCode (n : ℕ) {E : Type*} [Field E] [Algebra F E] (ω : E) (r : ℕ) :
    Submodule F (Fin n → F) := cyclicCodeOf n (bchGenerator F ω r)

lemma bchGenerator_dvd [NeZero n] {ω : E} (hω : IsPrimitiveRoot ω n) (r : ℕ) :
    bchGenerator F ω r ∣ (X ^ n - 1 : F[X]) := by
  refine Finset.lcm_dvd fun i _ => minpoly.dvd F _ ?_
  have : (ω ^ i) ^ n = 1 := by rw [← pow_mul, mul_comm, pow_mul, hω.pow_eq_one, one_pow]
  simp [this]

/-- A BCH code is cyclic. -/
theorem isCyclicCode_bchCode [NeZero n] {ω : E} (hω : IsPrimitiveRoot ω n) (r : ℕ) :
    IsCyclicCode (bchCode (F := F) n ω r) :=
  isCyclicCode_cyclicCodeOf (bchGenerator_dvd hω r)

/-- AA-420 (Theorem 22.2.9). A word lies in the BCH code iff its polynomial vanishes at
`ω^i` for `i = 1, ..., 2r`; moreover distinct codewords are at distance at least `2r + 1`. -/
@[kb "judson2026" "Theorem 22.2.9, p. 312"]
theorem mem_bchCode_iff [NeZero n] {ω : E} (hω : IsPrimitiveRoot ω n) (r : ℕ) (w : Fin n → F) :
    w ∈ bchCode n ω r ↔ ∀ i ∈ Finset.Icc 1 (2 * r), aeval (ω ^ i) (toPoly w) = 0 := by
  rw [bchCode, mem_cyclicCodeOf, bchGenerator, Finset.lcm_dvd_iff]
  refine forall₂_congr fun i _ => ?_
  exact minpoly.dvd_iff

theorem bchCode_minDist [NeZero n] {ω : E} (hω : IsPrimitiveRoot ω n) (r : ℕ)
    {u v : Fin n → F} (hu : u ∈ bchCode n ω r) (hv : v ∈ bchCode n ω r) (huv : u ≠ v) :
    2 * r + 1 ≤ hammingDist u v := by
  refine bch_minDist (g := bchGenerator F ω r) hω 1 (2 * r) (fun k hk => ?_) hu hv huv
  refine minpoly.dvd_iff.mp ?_
  exact Finset.dvd_lcm (f := fun i => minpoly F (ω ^ i)) (s := Finset.Icc 1 (2 * r))
    (b := 1 + k) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)

end BCH

