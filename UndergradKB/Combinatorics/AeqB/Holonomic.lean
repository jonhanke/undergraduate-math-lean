/-!
# An operator algebra viewpoint (Petkovsek–Wilf–Zeilberger, "A = B", Chapter 9)

* CO-515: the shift operators `N, K` and the multiplication operators `n, k` acting on functions
  `F(n,k)`, with the relations (9.3.2)–(9.3.3); operators with polynomial coefficients are the
  subalgebra they generate.
* CO-433: elimination: from `P F = Q F = 0` every `A P + B Q` annihilates `F` (9.3.1); if such an
  operator is `R = S(N,n) + (K - 1) R̄`, then `S(N,n) F = (K - 1) G` with `G = -R̄ F`, and the sum
  `a(n) = ∑_k F(n,k)` satisfies `S(N,n) a = 0`.
* CO-434: the modified elimination problem `S(N,n) = A P + B Q + (K - 1) C` (Almkvist's
  observation), with the same conclusion.
* CO-436: creative anti-symmetrizing: it suffices that `P(N,n) F - (K - 1) G` be antisymmetric.
* CO-438: for multisums it suffices that the symmetrizer of `P(N,n) F - ∑_i Δ_{k_i} G_i` vanish.
* CO-519: the operator ring of P-Di functions: `T x = 2 x T`, `E x = x E + E`, `E T = T E^2`.
* CO-520: integrating a function annihilated by a `y`-free operator `R(x, T_x, E_x, T_y, E_y)` gives a
  function annihilated by `R(x, T_x, E_x, 1/2, 1)`.
-/

set_option linter.unusedSectionVars false

noncomputable section

namespace UndergradKB.Combinatorics.AeqB
open Finset

namespace Holonomic

/-! ### CO-515: the algebra generated by `n, k, N, K` -/

section Algebra

variable (K : Type*) [Field K]

/-- The shift `N F(n,k) = F(n+1,k)`. -/
def opN : Module.End K (ℤ → ℤ → K) where
  toFun F n k := F (n + 1) k
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The shift `K F(n,k) = F(n,k+1)`. -/
def opK : Module.End K (ℤ → ℤ → K) where
  toFun F n k := F n (k + 1)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Multiplication by `n`. -/
def opn : Module.End K (ℤ → ℤ → K) where
  toFun F n k := (n : K) * F n k
  map_add' F G := by funext n k; simp [mul_add]
  map_smul' c F := by funext n k; simp [mul_left_comm]

/-- Multiplication by `k`. -/
def opk : Module.End K (ℤ → ℤ → K) where
  toFun F n k := (k : K) * F n k
  map_add' F G := by funext n k; simp [mul_add]
  map_smul' c F := by funext n k; simp [mul_left_comm]

/-- CO-515. The linear recurrence operators with polynomial coefficients: the subalgebra of the
`K`-linear operators on functions `F(n,k)` generated by `N, K, n, k`. -/
@[kb "petkovsekwilfzeilberger1996" "text (9.3.2)-(9.3.3), p. 187"]
def recOpAlgebra : Subalgebra K (Module.End K (ℤ → ℤ → K)) :=
  Algebra.adjoin K {opN K, opK K, opn K, opk K}

/-- CO-515. The defining relations (9.3.2)–(9.3.3): `NK = KN`, `Nk = kN`, `nK = Kn`, `nk = kn`,
`Nn = (n+1)N`, `Kk = (k+1)K`. -/
@[kb "petkovsekwilfzeilberger1996" "text (9.3.2)-(9.3.3), p. 187"]
theorem relations :
    opN K * opK K = opK K * opN K ∧ opN K * opk K = opk K * opN K ∧
      opn K * opK K = opK K * opn K ∧ opn K * opk K = opk K * opn K ∧
      opN K * opn K = (opn K + 1) * opN K ∧ opK K * opk K = (opk K + 1) * opK K := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> ext F n k <;>
    simp [opN, opK, opn, opk, mul_apply_eq_comp] <;> ring

end Algebra

/-! ### CO-433, CO-434: elimination -/

section Elimination

variable {K : Type*} [Field K]

/-- A `k`-free operator `S(N, n) = ∑_{j ≤ J} s_j(n) N^j`. -/
def sOp (J : ℕ) (s : ℕ → ℤ → K) : Module.End K (ℤ → ℤ → K) where
  toFun F n k := ∑ j ∈ range (J + 1), s j n * F (n + j) k
  map_add' F G := by funext n k; simp [mul_add, sum_add_distrib]
  map_smul' c F := by funext n k; simp [mul_sum, mul_left_comm]

/-- Summing `S(N,n) F = (K - 1) G` over `k`: if `F(n, ·)` and `G(n, ·)` have finite support, then
`∑_j s_j(n) a(n+j) = 0` for `a(n) = ∑_k F(n,k)`. -/
theorem sum_of_telescoped (J : ℕ) (s : ℕ → ℤ → K) (F G : ℤ → ℤ → K)
    (hF : ∀ n, (Function.support (F n)).Finite) (hG : ∀ n, (Function.support (G n)).Finite)
    (h : ∀ n k, ∑ j ∈ range (J + 1), s j n * F (n + j) k = G n (k + 1) - G n k) (n : ℤ) :
    ∑ j ∈ range (J + 1), s j n * ∑ᶠ k, F (n + j) k = 0 := by
  classical
  let T : Finset ℤ := (range (J + 1)).biUnion fun j => (hF (n + j)).toFinset
  have hT : ∀ j ∈ range (J + 1), ∑ᶠ k, F (n + j) k = ∑ k ∈ T, F (n + j) k := by
    intro j hj
    refine finsum_eq_sum_of_support_subset _ fun k hk => ?_
    simp only [Finset.coe_biUnion, Set.mem_iUnion, Finset.mem_coe, Set.Finite.mem_toFinset, T]
    exact ⟨j, hj, hk⟩
  rw [sum_congr rfl fun j hj => by rw [hT j hj]]
  simp_rw [mul_sum]
  rw [sum_comm]
  have hsupp : (Function.support fun k => ∑ j ∈ range (J + 1), s j n * F (n + j) k) ⊆ T := by
    intro k hk
    obtain ⟨j, hj, hk'⟩ := Finset.exists_ne_zero_of_sum_ne_zero hk
    simp only [Finset.coe_biUnion, Set.mem_iUnion, Finset.mem_coe, Set.Finite.mem_toFinset, T]
    exact ⟨j, hj, right_ne_zero_of_mul hk'⟩
  rw [← finsum_eq_sum_of_support_subset _ hsupp]
  simp_rw [h n]
  exact finsum_telescope (hG n)

/-- CO-433. Elimination (9.3.1)–(9.3.4). If `P F = 0` and `Q F = 0` then `(A P + B Q) F = 0` for all
operators `A, B`; if `A P + B Q = S(N,n) + (K - 1) R̄`, then `S(N,n) F = (K - 1) G` with
`G = -R̄ F`, and (for finitely supported `F(n,·)`, `G(n,·)`) the sum `a(n) = ∑_k F(n,k)` satisfies
`S(N,n) a = 0`. -/
@[kb "petkovsekwilfzeilberger1996" "text, p. 187-189"]
theorem elimination (P Q A B Rbar : Module.End K (ℤ → ℤ → K)) (J : ℕ) (s : ℕ → ℤ → K)
    (F : ℤ → ℤ → K) (hP : P F = 0) (hQ : Q F = 0)
    (hR : A * P + B * Q = sOp J s + (opK K - 1) * Rbar) :
    (A * P + B * Q) F = 0 ∧
    (∀ n k, ∑ j ∈ range (J + 1), s j n * F (n + j) k = (-Rbar F) n (k + 1) - (-Rbar F) n k) ∧
    ((∀ n, (Function.support (F n)).Finite) → (∀ n, (Function.support ((Rbar F) n)).Finite) →
      ∀ n, ∑ j ∈ range (J + 1), s j n * ∑ᶠ k, F (n + j) k = 0) := by
  have h0 : (A * P + B * Q) F = 0 := by
    simp [mul_apply_eq_comp, hP, hQ]
  have h1 : ∀ n k, ∑ j ∈ range (J + 1), s j n * F (n + j) k =
      (-Rbar F) n (k + 1) - (-Rbar F) n k := by
    intro n k
    have := congrFun (congrFun (congrArg (fun T => T F) hR) n) k
    rw [h0] at this
    simp only [LinearMap.add_apply, mul_apply_eq_comp, LinearMap.sub_apply, one_apply_eq_self,
      Pi.add_apply, Pi.sub_apply, Pi.zero_apply] at this
    change 0 = ∑ j ∈ range (J + 1), s j n * F (n + j) k + (Rbar F n (k + 1) - Rbar F n k) at this
    simp only [Pi.neg_apply]
    linear_combination -this
  refine ⟨h0, h1, fun hF hG n => sum_of_telescoped J s F (-Rbar F) hF ?_ h1 n⟩
  intro n
  simpa [Function.support_neg] using hG n

/-- CO-434. The modified elimination problem: if `S(N,n) = A P + B Q + (K - 1) C` (left multiples of
`P, Q`, a right multiple of `K - 1`) and `P F = Q F = 0`, then `S(N,n) F = (K - 1) G` with
`G = C F`, and the sum `a(n) = ∑_k F(n,k)` satisfies `S(N,n) a = 0`. -/
@[kb "petkovsekwilfzeilberger1996" "Modified elimination problem, p. 189"]
theorem modified_elimination (P Q A B C : Module.End K (ℤ → ℤ → K)) (J : ℕ) (s : ℕ → ℤ → K)
    (F : ℤ → ℤ → K) (hP : P F = 0) (hQ : Q F = 0)
    (hS : sOp J s = A * P + B * Q + (opK K - 1) * C) :
    (∀ n k, ∑ j ∈ range (J + 1), s j n * F (n + j) k = (C F) n (k + 1) - (C F) n k) ∧
    ((∀ n, (Function.support (F n)).Finite) → (∀ n, (Function.support ((C F) n)).Finite) →
      ∀ n, ∑ j ∈ range (J + 1), s j n * ∑ᶠ k, F (n + j) k = 0) := by
  have h1 : ∀ n k, ∑ j ∈ range (J + 1), s j n * F (n + j) k = (C F) n (k + 1) - (C F) n k := by
    intro n k
    have := congrFun (congrFun (congrArg (fun T => T F) hS) n) k
    simp only [LinearMap.add_apply, mul_apply_eq_comp, hP, hQ, map_zero, zero_add,
      LinearMap.sub_apply, one_apply_eq_self, Pi.sub_apply] at this
    exact this
  exact ⟨h1, fun hF hG n => sum_of_telescoped J s F (C F) hF hG h1 n⟩

/-- CO-436. Creative anti-symmetrizing: if `H(n,k) = S(N,n) F(n,k) - (G(n,k+1) - G(n,k))` is
antisymmetric, `H(n,k) = -H(n, n + α - k)`, rather than zero, the sum `a(n) = ∑_k F(n,k)` still
satisfies `S(N,n) a = 0` (for finitely supported `F(n,·)`, `G(n,·)`). -/
@[kb "petkovsekwilfzeilberger1996" "text, p. 198"]
theorem antisymmetrizing [CharZero K] (J : ℕ) (s : ℕ → ℤ → K) (F G : ℤ → ℤ → K) (α : ℤ)
    (hF : ∀ n, (Function.support (F n)).Finite) (hG : ∀ n, (Function.support (G n)).Finite)
    (hanti : ∀ n k, (∑ j ∈ range (J + 1), s j n * F (n + j) k - (G n (k + 1) - G n k)) =
      -(∑ j ∈ range (J + 1), s j n * F (n + j) (n + α - k) -
        (G n (n + α - k + 1) - G n (n + α - k)))) (n : ℤ) :
    ∑ j ∈ range (J + 1), s j n * ∑ᶠ k, F (n + j) k = 0 := by
  set H : ℤ → ℤ → K := fun n k =>
    ∑ j ∈ range (J + 1), s j n * F (n + j) k - (G n (k + 1) - G n k) with hH
  have hHsum : ∑ᶠ k, H n k = 0 := finsum_eq_zero_of_reflect H α (fun n k => hanti n k) n
  classical
  let T : Finset ℤ := (range (J + 1)).biUnion fun j => (hF (n + j)).toFinset
  have hT : ∀ j ∈ range (J + 1), ∑ᶠ k, F (n + j) k = ∑ k ∈ T, F (n + j) k := by
    intro j hj
    refine finsum_eq_sum_of_support_subset _ fun k hk => ?_
    simp only [Finset.coe_biUnion, Set.mem_iUnion, Finset.mem_coe, Set.Finite.mem_toFinset, T]
    exact ⟨j, hj, hk⟩
  rw [sum_congr rfl fun j hj => by rw [hT j hj]]
  simp_rw [mul_sum]
  rw [sum_comm]
  have hsupp : (Function.support fun k => ∑ j ∈ range (J + 1), s j n * F (n + j) k) ⊆ T := by
    intro k hk
    obtain ⟨j, hj, hk'⟩ := Finset.exists_ne_zero_of_sum_ne_zero hk
    simp only [Finset.coe_biUnion, Set.mem_iUnion, Finset.mem_coe, Set.Finite.mem_toFinset, T]
    exact ⟨j, hj, right_ne_zero_of_mul hk'⟩
  rw [← finsum_eq_sum_of_support_subset _ hsupp]
  have hS : (Function.support fun k => ∑ j ∈ range (J + 1), s j n * F (n + j) k).Finite :=
    T.finite_toSet.subset hsupp
  have hD : (Function.support fun k => G n (k + 1) - G n k).Finite := by
    refine ((hG n).preimage (Equiv.addRight (1 : ℤ)).injective.injOn |>.union (hG n)).subset ?_
    intro k hk
    by_contra hc
    simp only [Set.mem_union, Set.mem_preimage, Function.mem_support, not_or, not_not,
      Equiv.coe_addRight] at hc
    exact hk (by simp [hc.1, hc.2])
  have e : ∑ᶠ k, H n k = ∑ᶠ k, ∑ j ∈ range (J + 1), s j n * F (n + j) k -
      ∑ᶠ k, (G n (k + 1) - G n k) := finsum_sub_distrib hS hD
  rw [finsum_telescope (hG n), sub_zero] at e
  rw [← e, hHsum]

end Elimination

/-! ### CO-438: symmetric multisums -/

section Multisum

variable {K : Type*} [Field K] [CharZero K] {r : ℕ}

/-- CO-438. Symmetrizing the certificate condition for multisums. Let
`H(n; k) = ∑_j s_j(n) F(n+j; k) - ∑_i (G_i(n; k + e_i) - G_i(n; k))` for `k ∈ ℤ^r`. If the
symmetrizer `∑_{π ∈ S_r} H(n; k ∘ π)` vanishes identically (and all functions have finite support
in `k`), then `r! · ∑_j s_j(n) ∑_k F(n+j; k) = 0`, hence `S(N,n) ∑_k F = 0`. (The book assumes `F`
symmetric; the argument does not need it.) -/
@[kb "petkovsekwilfzeilberger1996" "text, p. 198-199"]
theorem symmetrizer_multisum (J : ℕ) (s : ℕ → ℤ → K) (F : ℤ → (Fin r → ℤ) → K)
    (G : Fin r → ℤ → (Fin r → ℤ) → K)
    (hF : ∀ n, (Function.support (F n)).Finite) (hG : ∀ i n, (Function.support (G i n)).Finite)
    (hsym : ∀ n (k : Fin r → ℤ), ∑ π : Equiv.Perm (Fin r),
      (∑ j ∈ range (J + 1), s j n * F (n + j) (k ∘ π) -
        ∑ i, (G i n (k ∘ π + Pi.single i 1) - G i n (k ∘ π))) = 0) (n : ℤ) :
    ∑ j ∈ range (J + 1), s j n * ∑ᶠ k, F (n + j) k = 0 := by
  set H : (Fin r → ℤ) → K := fun k =>
    ∑ j ∈ range (J + 1), s j n * F (n + j) k - ∑ i, (G i n (k + Pi.single i 1) - G i n k) with hH
  have hSF : ∀ j : ℕ, (Function.support fun k => s j n * F (n + j) k).Finite := fun j =>
    (hF (n + j)).subset (Function.support_mul_subset_right _ _)
  have hshift : ∀ i, (Function.support fun k => G i n (k + Pi.single i 1)).Finite := fun i =>
    (hG i n).preimage (f := fun k : Fin r → ℤ => k + Pi.single i 1)
      (fun x _ y _ h => add_right_cancel h)
  have hDi : ∀ i, (Function.support fun k => G i n (k + Pi.single i 1) - G i n k).Finite :=
    fun i => ((hshift i).union (hG i n)).subset (Function.support_sub _ _)
  have hA : (Function.support fun k => ∑ j ∈ range (J + 1), s j n * F (n + j) k).Finite := by
    refine (Set.finite_iUnion (ι := range (J + 1)) fun j => hSF j).subset fun k hk => ?_
    obtain ⟨j, hj, hk'⟩ := Finset.exists_ne_zero_of_sum_ne_zero hk
    exact Set.mem_iUnion.2 ⟨⟨j, hj⟩, hk'⟩
  have hB : (Function.support fun k => ∑ i, (G i n (k + Pi.single i 1) - G i n k)).Finite := by
    refine (Set.finite_iUnion fun i => hDi i).subset fun k hk => ?_
    obtain ⟨i, -, hk'⟩ := Finset.exists_ne_zero_of_sum_ne_zero hk
    exact Set.mem_iUnion.2 ⟨i, hk'⟩
  have hHfin : (Function.support H).Finite := (hA.union hB).subset (Function.support_sub _ _)
  -- the sum of `H` is `S(N,n) a(n)`: the telescoping parts vanish
  have htel : ∀ i, ∑ᶠ k, (G i n (k + Pi.single i 1) - G i n k) = 0 := fun i => by
    rw [finsum_sub_distrib (hshift i) (hG i n)]
    have := finsum_comp_equiv (Equiv.addRight (Pi.single i (1 : ℤ))) (f := G i n)
    simp only [Equiv.coe_addRight] at this
    rw [this, sub_self]
  have hsumH : ∑ᶠ k, H k = ∑ j ∈ range (J + 1), s j n * ∑ᶠ k, F (n + j) k := by
    rw [hH, finsum_sub_distrib hA hB,
      finsum_sum_comm univ (fun k i => G i n (k + Pi.single i 1) - G i n k) (fun i _ => hDi i),
      finsum_sum_comm (range (J + 1)) (fun k j => s j n * F (n + j) k) (fun j _ => hSF j)]
    simp only [htel, sum_const_zero, sub_zero]
    exact sum_congr rfl fun j _ => (mul_finsum _ _).symm
  -- reindexing by a permutation does not change the sum
  let e : Equiv.Perm (Fin r) → (Fin r → ℤ) ≃ (Fin r → ℤ) := fun π =>
    { toFun := fun k => k ∘ π
      invFun := fun k => k ∘ π.symm
      left_inv := fun k => by funext x; simp
      right_inv := fun k => by funext x; simp }
  have hperm : ∀ π : Equiv.Perm (Fin r), ∑ᶠ k, H (k ∘ π) = ∑ᶠ k, H k := fun π =>
    finsum_comp_equiv (e π) (f := H)
  have hsuppπ : ∀ π : Equiv.Perm (Fin r), (Function.support fun k => H (k ∘ π)).Finite :=
    fun π => hHfin.preimage (e π).injective.injOn
  have hzero : ∑ π : Equiv.Perm (Fin r), ∑ᶠ k, H (k ∘ π) = 0 := by
    rw [← finsum_sum_comm univ (fun (k : Fin r → ℤ) (π : Equiv.Perm (Fin r)) => H (k ∘ π))
      (fun π _ => hsuppπ π)]
    exact finsum_eq_zero_of_forall_eq_zero fun k => hsym n k
  simp only [hperm, sum_const, card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
    at hzero
  rw [← hsumH]
  exact (mul_eq_zero.1 hzero).resolve_left (by exact_mod_cast Nat.factorial_ne_zero r)

end Multisum

/-! ### CO-519, CO-520: P-Di functions -/

section PDi

/-- The doubling operator `T f(x) = f(2x)`. -/
def opT : Module.End ℝ (ℝ → ℝ) where
  toFun f x := f (2 * x)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The shift `E f(x) = f(x+1)`. -/
def opE : Module.End ℝ (ℝ → ℝ) where
  toFun f x := f (x + 1)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Multiplication by `x`. -/
def opX : Module.End ℝ (ℝ → ℝ) where
  toFun f x := x * f x
  map_add' f g := by funext x; simp [mul_add]
  map_smul' c f := by funext x; simp [mul_left_comm]

/-- CO-519. The commutation relations of the operator ring of P-Di functions:
`T x = 2 x T`, `E x = x E + E`, `E T = T E^2`. -/
@[kb "petkovsekwilfzeilberger1996" "text, p. 199"]
theorem pdi_relations :
    opT * opX = (2 : ℝ) • (opX * opT) ∧ opE * opX = opX * opE + opE ∧ opE * opT = opT * opE ^ 2 := by
  refine ⟨?_, ?_, ?_⟩ <;> ext f x <;> simp [opT, opE, opX, pow_two] <;> ring_nf

/-- CO-520. Let `F(x,y)` be annihilated by an operator `R(x, T_x, E_x, T_y, E_y)` free of `y`,
`R = ∑_{m ∈ S} c_m(x) T_x^{a} E_x^{b} T_y^{c} E_y^{d}` (so `(R F)(x,y) = ∑ c_m(x) F(2^a x + b, 2^c y + d)`).
Since `∫ F(x, y+1) dy = ∫ F(x,y) dy` and `∫ F(x, 2y) dy = (1/2) ∫ F(x,y) dy`, the integral
`a(x) = ∫ F(x,y) dy` is annihilated by `R(x, T_x, E_x, 1/2, 1)`. -/
@[kb "petkovsekwilfzeilberger1996" "text, p. 199-200"]
theorem integral_annihilated (S : Finset (ℕ × ℕ × ℕ × ℕ)) (c : ℕ × ℕ × ℕ × ℕ → ℝ → ℝ)
    (F : ℝ → ℝ → ℝ)
    (hint : ∀ m ∈ S, ∀ x, MeasureTheory.Integrable
      (fun y => F (2 ^ m.1 * x + m.2.1) (2 ^ m.2.2.1 * y + m.2.2.2)))
    (hR : ∀ x y, ∑ m ∈ S, c m x * F (2 ^ m.1 * x + m.2.1) (2 ^ m.2.2.1 * y + m.2.2.2) = 0)
    (x : ℝ) :
    ∑ m ∈ S, c m x * (1 / 2) ^ m.2.2.1 * ∫ y, F (2 ^ m.1 * x + m.2.1) y = 0 := by
  have h0 : ∫ y, ∑ m ∈ S, c m x * F (2 ^ m.1 * x + m.2.1) (2 ^ m.2.2.1 * y + m.2.2.2) = 0 := by
    simp [hR x]
  rw [MeasureTheory.integral_finsetSum S fun m hm => (hint m hm x).const_mul (c m x)] at h0
  rw [← h0]
  refine sum_congr rfl fun m _ => ?_
  rw [MeasureTheory.integral_const_mul]
  have e1 : ∫ y, F (2 ^ m.1 * x + m.2.1) (2 ^ m.2.2.1 * y + m.2.2.2) =
      ∫ y, F (2 ^ m.1 * x + m.2.1) (2 ^ m.2.2.1 * y) := by
    have := MeasureTheory.Measure.integral_comp_mul_left
      (fun z => F (2 ^ m.1 * x + m.2.1) (z + m.2.2.2)) (2 ^ m.2.2.1)
    have h2 := MeasureTheory.Measure.integral_comp_mul_left
      (fun z => F (2 ^ m.1 * x + m.2.1) z) (2 ^ m.2.2.1)
    rw [this, h2, MeasureTheory.integral_add_right_eq_self
      (fun z => F (2 ^ m.1 * x + m.2.1) z) (m.2.2.2 : ℝ)]
  rw [e1, MeasureTheory.Measure.integral_comp_mul_left (fun z => F (2 ^ m.1 * x + m.2.1) z)]
  rw [abs_of_pos (by positivity), smul_eq_mul, one_div, inv_pow]
  ring

end PDi

end Holonomic

end UndergradKB.Combinatorics.AeqB
