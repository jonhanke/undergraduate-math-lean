import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring
import Mathlib.Algebra.Field.Subfield.Basic
import Mathlib.Analysis.Complex.Basic
import UndergradKB.Common.Attr
import UndergradKB.Geometry.RulerCompassConverse
import UndergradKB.Geometry.SetSquare
import UndergradKB.Geometry.RulerParallel

/-! # Geometric constructions, wave 2 (Petrunin, chapter 19 and Exercise 5.7)

* Exercise 5.7 (p. 39): the foot of the perpendicular from a point to a line is ruler-and-compass constructible
  (`rc_foot_perpendicular`).
* Theorem 19.11 (p. 161), the "if" direction: set-square constructions reach every point whose coordinates lie in
  the field generated by the coordinates of the given points (`SSConstructible.of_mem_closure`,
  `ssConstructible_iff`).
* Comparison of construction tools (pp. 163-164): `ConstructionTools.StrongerThan` and friends, with examples.
* Mohr-Mascheroni theorem 19.19 (p. 164): a compass alone is equivalent to ruler and compass
  (`rcConstructible_iff_cConstructible`).
-/

namespace UndergradKB.Geometry

open RCConv

/-! ### Exercise 5.7: the foot of a perpendicular -/

section Perpendicular

variable {S : Set (ℝ × ℝ)}

/-- Both apexes of equilateral triangles on a segment between constructed points are constructed. -/
theorem rc_apex {P Q : ℝ × ℝ} (hP : RCConstructible S (.point P)) (hQ : RCConstructible S (.point Q))
    (hPQ : P ≠ Q) :
    RCConstructible S (.point (Ep P Q)) ∧ RCConstructible S (.point (Em P Q)) := by
  have hc1 : RCConstructible S (.circle P Q) := .circle hP hQ
  have hc2 : RCConstructible S (.circle Q P) := .circle hQ hP
  constructor
  · refine RCConstructible.circleCircle hc1 hc2 hPQ ?_ ?_
    · simp only [OnCircle, Ep]
      linear_combination ((Q.1 - P.1) ^ 2 + (Q.2 - P.2) ^ 2) / 4 * h3
    · simp only [OnCircle, Ep]
      linear_combination ((Q.1 - P.1) ^ 2 + (Q.2 - P.2) ^ 2) / 4 * h3
  · refine RCConstructible.circleCircle hc1 hc2 hPQ ?_ ?_
    · simp only [OnCircle, Em]
      linear_combination ((Q.1 - P.1) ^ 2 + (Q.2 - P.2) ^ 2) / 4 * h3
    · simp only [OnCircle, Em]
      linear_combination ((Q.1 - P.1) ^ 2 + (Q.2 - P.2) ^ 2) / 4 * h3

/-- The mirror image of `P` in the line `AB`. -/
noncomputable def reflLine (A B P : ℝ × ℝ) : ℝ × ℝ :=
  (A.1 + (((B.1 - A.1) ^ 2 - (B.2 - A.2) ^ 2) * (P.1 - A.1) + 2 * (B.1 - A.1) * (B.2 - A.2) * (P.2 - A.2)) /
      ((B.1 - A.1) ^ 2 + (B.2 - A.2) ^ 2),
   A.2 + (2 * (B.1 - A.1) * (B.2 - A.2) * (P.1 - A.1) - ((B.1 - A.1) ^ 2 - (B.2 - A.2) ^ 2) * (P.2 - A.2)) /
      ((B.1 - A.1) ^ 2 + (B.2 - A.2) ^ 2))

/-- The mirror image of a constructed point in a line through two constructed points is constructed. -/
theorem rc_reflLine {A B P : ℝ × ℝ} (hA : RCConstructible S (.point A)) (hB : RCConstructible S (.point B))
    (hP : RCConstructible S (.point P)) (hAB : A ≠ B) : RCConstructible S (.point (reflLine A B P)) := by
  have hN := (ne_coords hAB).ne'
  refine RCConstructible.circleCircle (.circle hA hP) (.circle hB hP) hAB ?_ ?_
  · simp only [OnCircle, reflLine]; field_simp; ring
  · simp only [OnCircle, reflLine]; field_simp; ring

/-- **Exercise 5.7** (Petrunin, p. 39): the foot of the perpendicular from a constructed point `P` to the line
`AB` of two constructed points `A ≠ B` is constructible by ruler and compass, and so is a second point `Q ≠ P`
of the perpendicular. Precisely: there are constructed points `F` and `Q ≠ P` with `F` on the line `AB`,
`F` on the line `PQ`, and both `PQ` and `PF` perpendicular to `AB` (so `F` is the foot, and `PQ` is the
perpendicular thru `P`). If `P` lies on `AB`, then `F = P`. -/
@[kb "petrunin2025" "Exercise 5.7, p. 39"]
theorem rc_foot_perpendicular {P A B : ℝ × ℝ} (hP : RCConstructible S (.point P))
    (hA : RCConstructible S (.point A)) (hB : RCConstructible S (.point B)) (hAB : A ≠ B) :
    ∃ F Q : ℝ × ℝ, RCConstructible S (.point F) ∧ RCConstructible S (.point Q) ∧ OnLine A B F ∧
      Q ≠ P ∧ OnLine P Q F ∧ (F.1 - P.1) * (B.1 - A.1) + (F.2 - P.2) * (B.2 - A.2) = 0 ∧
      (Q.1 - P.1) * (B.1 - A.1) + (Q.2 - P.2) * (B.2 - A.2) = 0 := by
  have hN := ne_coords hAB
  have hN' := hN.ne'
  obtain ⟨a1, a2⟩ := A
  obtain ⟨b1, b2⟩ := B
  obtain ⟨p1, p2⟩ := P
  simp only at hN hN'
  by_cases hc : (b1 - a1) * (p2 - a2) - (b2 - a2) * (p1 - a1) = 0
  · -- `P` lies on the line `AB`
    set t : ℝ := ((p1 - a1) * (b1 - a1) + (p2 - a2) * (b2 - a2)) / ((b1 - a1) ^ 2 + (b2 - a2) ^ 2) with ht
    have hp1 : p1 = a1 + t * (b1 - a1) := by
      rw [ht]; field_simp; linear_combination (-(b2 - a2)) * hc
    have hp2 : p2 = a2 + t * (b2 - a2) := by
      rw [ht]; field_simp; linear_combination (b1 - a1) * hc
    set c : ℝ := if t = 0 then 1 else 0 with hcdef
    have hct : t - c ≠ 0 := by
      by_cases h0 : t = 0
      · simp [hcdef, h0]
      · simp [hcdef, h0]
    -- `C = A + c (B - A)` and its mirror image `C' = 2P - C`
    have hC : RCConstructible S (.point (a1 + c * (b1 - a1), a2 + c * (b2 - a2))) := by
      by_cases h0 : t = 0
      · simp only [hcdef, h0, ite_true]
        simpa using hB
      · simp only [hcdef, h0, ite_false]
        simpa using hA
    have hCP : (a1 + c * (b1 - a1), a2 + c * (b2 - a2)) ≠ (p1, p2) := by
      intro h
      have h1 := congrArg Prod.fst h
      have h2 := congrArg Prod.snd h
      simp only at h1 h2
      rw [hp1] at h1; rw [hp2] at h2
      have e1 : (t - c) * (b1 - a1) = 0 := by linarith
      have e2 : (t - c) * (b2 - a2) = 0 := by linarith
      rcases mul_eq_zero.mp e1 with e | e
      · exact hct e
      rcases mul_eq_zero.mp e2 with e' | e'
      · exact hct e'
      apply hAB; rw [sub_eq_zero.mp e, sub_eq_zero.mp e']
    have hC': RCConstructible S (.point (a1 + (2 * t - c) * (b1 - a1), a2 + (2 * t - c) * (b2 - a2))) := by
      refine RCConstructible.lineCircle (p := (a1, a2)) (q := (b1, b2)) (c := (p1, p2))
        (d := (a1 + c * (b1 - a1), a2 + c * (b2 - a2))) (.line hA hB hAB) (.circle hP hC)
        ⟨2 * t - c, rfl, rfl⟩ ?_
      simp only [OnCircle]
      rw [hp1, hp2]; ring
    have hCC' : (a1 + c * (b1 - a1), a2 + c * (b2 - a2)) ≠
        (a1 + (2 * t - c) * (b1 - a1), a2 + (2 * t - c) * (b2 - a2)) := by
      intro h
      have h1 := congrArg Prod.fst h
      have h2 := congrArg Prod.snd h
      simp only at h1 h2
      have e1 : (t - c) * (b1 - a1) = 0 := by linarith
      have e2 : (t - c) * (b2 - a2) = 0 := by linarith
      rcases mul_eq_zero.mp e1 with e | e
      · exact hct e
      rcases mul_eq_zero.mp e2 with e' | e'
      · exact hct e'
      apply hAB; rw [sub_eq_zero.mp e, sub_eq_zero.mp e']
    have hQ:= (rc_apex hC hC' hCC').1
    refine ⟨(p1, p2), Ep _ _, hP, hQ, ⟨t, hp1, hp2⟩, ?_, ⟨0, by simp, by simp⟩, ?_, ?_⟩
    · intro h
      have h1 := congrArg Prod.fst h
      have h2 := congrArg Prod.snd h
      simp only [Ep] at h1 h2
      have hs := sqrt3_pos
      have e1 : (t - c) * (b2 - a2) = 0 := by
        have : √3 * ((t - c) * (b2 - a2)) = 0 := by rw [hp1] at h1; linear_combination (-1 : ℝ) * h1
        rcases mul_eq_zero.mp this with e | e
        · exact absurd e hs.ne'
        · exact e
      have e2 : (t - c) * (b1 - a1) = 0 := by
        have : √3 * ((t - c) * (b1 - a1)) = 0 := by rw [hp2] at h2; linear_combination h2
        rcases mul_eq_zero.mp this with e | e
        · exact absurd e hs.ne'
        · exact e
      rcases mul_eq_zero.mp e1 with e | e
      · exact hct e
      rcases mul_eq_zero.mp e2 with e' | e'
      · exact hct e'
      apply hAB
      rw [sub_eq_zero.mp e', sub_eq_zero.mp e]
    · simp
    · simp only [Ep]
      rw [hp1, hp2]; ring
  · -- `P` is off the line `AB`: reflect it
    have hR := rc_reflLine hA hB hP hAB
    have h1 : (reflLine (a1, a2) (b1, b2) (p1, p2)).1 - p1 =
        2 * (b2 - a2) * ((b1 - a1) * (p2 - a2) - (b2 - a2) * (p1 - a1)) / ((b1 - a1) ^ 2 + (b2 - a2) ^ 2) := by
      simp only [reflLine]; field_simp; ring
    have h2 : (reflLine (a1, a2) (b1, b2) (p1, p2)).2 - p2 =
        -(2 * (b1 - a1) * ((b1 - a1) * (p2 - a2) - (b2 - a2) * (p1 - a1))) /
          ((b1 - a1) ^ 2 + (b2 - a2) ^ 2) := by
      simp only [reflLine]; field_simp; ring
    have hRP : reflLine (a1, a2) (b1, b2) (p1, p2) ≠ (p1, p2) := by
      intro h
      have e1 := congrArg Prod.fst h
      have e2 := congrArg Prod.snd h
      simp only at e1 e2
      rw [e1, sub_self] at h1
      rw [e2, sub_self] at h2
      have g1 : (b2 - a2) * ((b1 - a1) * (p2 - a2) - (b2 - a2) * (p1 - a1)) = 0 := by
        have := h1.symm
        rw [div_eq_zero_iff] at this
        rcases this with this | this
        · linarith
        · exact absurd this hN'
      have g2 : (b1 - a1) * ((b1 - a1) * (p2 - a2) - (b2 - a2) * (p1 - a1)) = 0 := by
        have := h2.symm
        rw [div_eq_zero_iff] at this
        rcases this with this | this
        · linarith
        · exact absurd this hN'
      rcases mul_eq_zero.mp g1 with e | e
      · rcases mul_eq_zero.mp g2 with e' | e'
        · apply hAB; rw [sub_eq_zero.mp e, sub_eq_zero.mp e']
        · exact hc e'
      · exact hc e
    set t : ℝ := ((p1 - a1) * (b1 - a1) + (p2 - a2) * (b2 - a2)) / ((b1 - a1) ^ 2 + (b2 - a2) ^ 2) with ht
    have hdet : (b1 - a1) * ((reflLine (a1, a2) (b1, b2) (p1, p2)).2 - p2) -
        (b2 - a2) * ((reflLine (a1, a2) (b1, b2) (p1, p2)).1 - p1) ≠ 0 := by
      rw [h1, h2]
      have : (b1 - a1) * (-(2 * (b1 - a1) * ((b1 - a1) * (p2 - a2) - (b2 - a2) * (p1 - a1))) /
          ((b1 - a1) ^ 2 + (b2 - a2) ^ 2)) -
          (b2 - a2) * (2 * (b2 - a2) * ((b1 - a1) * (p2 - a2) - (b2 - a2) * (p1 - a1)) /
          ((b1 - a1) ^ 2 + (b2 - a2) ^ 2)) =
          -2 * ((b1 - a1) * (p2 - a2) - (b2 - a2) * (p1 - a1)) := by
        field_simp; ring
      rw [this]
      exact mul_ne_zero (by norm_num) hc
    have hF : RCConstructible S (.point (a1 + t * (b1 - a1), a2 + t * (b2 - a2))) := by
      refine RCConstructible.lineLine (p := (a1, a2)) (q := (b1, b2)) (p' := (p1, p2))
        (q' := reflLine (a1, a2) (b1, b2) (p1, p2)) (.line hA hB hAB) (.line hP hR hRP.symm) hdet
        ⟨t, rfl, rfl⟩ ⟨1 / 2, ?_, ?_⟩
      · simp only [reflLine, ht]; field_simp; ring
      · simp only [reflLine, ht]; field_simp; ring
    refine ⟨_, _, hF, hR, ⟨t, rfl, rfl⟩, hRP, ⟨1 / 2, ?_, ?_⟩, ?_, ?_⟩
    · simp only [reflLine, ht]; field_simp; ring
    · simp only [reflLine, ht]; field_simp; ring
    · simp only [ht]; field_simp; ring
    · rw [h1, h2]; field_simp; ring

end Perpendicular

/-! ### Theorem 19.11, the "if" direction -/

section SetSquareIf

variable {S : Set (ℝ × ℝ)}

/-- A version of `SSConstructible.perp` with an explicit direction. -/
theorem ssc_perp {p v x w : ℝ × ℝ} (h : SSConstructible S (.line p v)) (hx : SSConstructible S (.point x))
    (hw : w = (-v.2, v.1)) : SSConstructible S (.line x w) := hw ▸ h.perp hx

theorem ssc_diagPlus {p v x w : ℝ × ℝ} (h : SSConstructible S (.line p v)) (hx : SSConstructible S (.point x))
    (hw : w = (v.1 - v.2, v.1 + v.2)) : SSConstructible S (.line x w) := hw ▸ h.diagPlus hx

theorem ssc_diagMinus {p v x w : ℝ × ℝ} (h : SSConstructible S (.line p v)) (hx : SSConstructible S (.point x))
    (hw : w = (v.1 + v.2, v.2 - v.1)) : SSConstructible S (.line x w) := hw ▸ h.diagMinus hx

/-- The two initial points `(0,0)` and `(1,0)`. -/
def AxisPts (S : Set (ℝ × ℝ)) : Prop := ((0 : ℝ), (0 : ℝ)) ∈ S ∧ ((1 : ℝ), (0 : ℝ)) ∈ S

theorem ssc_xaxis (hS : AxisPts S) : SSConstructible S (.line (0, 0) (1, 0)) := by
  have := SSConstructible.line (S := S) (p := (0, 0)) (q := (1, 0)) (.init hS.1) (.init hS.2) (by simp)
  simpa using this

theorem ssc_vert (hS : AxisPts S) {x : ℝ × ℝ} (hx : SSConstructible S (.point x)) :
    SSConstructible S (.line x (0, 1)) :=
  ssc_perp (ssc_xaxis hS) hx (by simp)

theorem ssc_horiz (hS : AxisPts S) {x : ℝ × ℝ} (hx : SSConstructible S (.point x)) :
    SSConstructible S (.line x (-1, 0)) :=
  ssc_perp (ssc_vert hS hx) hx (by simp)

theorem ssc_yaxis (hS : AxisPts S) : SSConstructible S (.line (0, 0) (0, 1)) :=
  ssc_vert hS (.init hS.1)

/-- The foot of a constructed point on the `x`-axis. -/
theorem ssc_foot_x (hS : AxisPts S) {a b : ℝ} (h : SSConstructible S (.point (a, b))) :
    SSConstructible S (.point (a, 0)) :=
  SSConstructible.inter (ssc_vert hS h) (ssc_xaxis hS) (by norm_num) ⟨-b, by simp, by simp⟩ ⟨a, by simp, by simp⟩

/-- The projection of a constructed point on the `y`-axis. -/
theorem ssc_foot_y (hS : AxisPts S) {a b : ℝ} (h : SSConstructible S (.point (a, b))) :
    SSConstructible S (.point (0, b)) :=
  SSConstructible.inter (ssc_horiz hS h) (ssc_yaxis hS) (by norm_num) ⟨a, by simp, by simp⟩ ⟨b, by simp, by simp⟩

/-- Transport a point of the `y`-axis to the `x`-axis by the `-π/4` line. -/
theorem ssc_y_to_x (hS : AxisPts S) {b : ℝ} (h : SSConstructible S (.point (0, b))) :
    SSConstructible S (.point (b, 0)) :=
  SSConstructible.inter (ssc_diagMinus (ssc_xaxis hS) h (w := (1, -1)) (by simp)) (ssc_xaxis hS) (by norm_num)
    ⟨b, by simp, by simp⟩ ⟨b, by simp, by simp⟩

/-- A point from its abscissa `x` and the point `(x - y, 0)`. -/
theorem ssc_point_of_axes (hS : AxisPts S) {x y : ℝ} (hx : SSConstructible S (.point (x, 0)))
    (hxy : SSConstructible S (.point (x - y, 0))) : SSConstructible S (.point (x, y)) :=
  SSConstructible.inter (ssc_vert hS hx) (ssc_diagPlus (ssc_xaxis hS) hxy (w := (1, 1)) (by simp)) (by norm_num)
    ⟨y, by simp, by simp⟩ ⟨y, by simp, by simp⟩

theorem ssc_point_minus_one (hS : AxisPts S) : SSConstructible S (.point (0, -1)) :=
  SSConstructible.inter (ssc_diagPlus (ssc_xaxis hS) (SSConstructible.init hS.2) (w := (1, 1)) (by simp))
    (ssc_yaxis hS) (by norm_num) ⟨-1, by simp, by simp⟩ ⟨-1, by simp, by simp⟩

/-- Transfer of ruler-and-parallel-tool constructions to the set-square: the parallel line is obtained by
four right-angle steps. -/
theorem rp_to_ss {S S' : Set (ℝ × ℝ)} (hS' : ∀ s ∈ S', SSConstructible S (.point s)) {o : RCObj}
    (ho : RPConstructible S' o) :
    (match o with
      | .point x => SSConstructible S (.point x)
      | .line p q => SSConstructible S (.line p (q.1 - p.1, q.2 - p.2))
      | .circle _ _ => True) := by
  induction ho with
  | init hx => exact hS' _ hx
  | line _ _ hpq ihp ihq => exact SSConstructible.line ihp ihq hpq
  | @parallel c p q _ _ hpq ihc ihl =>
    have L1 := SSConstructible.perp ihl ihc
    have L2 := SSConstructible.perp L1 ihc
    have L3 := SSConstructible.perp L2 ihc
    exact ssc_perp L3 ihc (by ext <;> simp)
  | lineLine _ _ hdet hx hx' ih ih' => exact SSConstructible.inter ih ih' hdet hx hx'

theorem ssc_arith (hS : AxisPts S) {a b : ℝ} (ha : SSConstructible S (.point (a, 0)))
    (hb : SSConstructible S (.point (b, 0))) :
    SSConstructible S (.point (a + b, 0)) ∧ SSConstructible S (.point (a - b, 0)) ∧
      SSConstructible S (.point (a * b, 0)) ∧ (b ≠ 0 → SSConstructible S (.point (a / b, 0))) := by
  set S' : Set (ℝ × ℝ) := {(0, 0), (1, 0), (a, 0), (b, 0), (0, -1)} with hS'def
  have hS' : ∀ s ∈ S', SSConstructible S (.point s) := by
    rintro s (rfl | rfl | rfl | rfl | rfl)
    · exact .init hS.1
    · exact .init hS.2
    · exact ha
    · exact hb
    · exact ssc_point_minus_one hS
  obtain ⟨h1, h2, h3, h4⟩ := rp_add_sub_mul_div (S := S') (a := a) (b := b) (e := (0, -1)) (by simp)
    (by simp [hS'def]) (by simp [hS'def]) (by simp [hS'def]) (by simp [hS'def]) (by simp [hS'def])
  exact ⟨rp_to_ss hS' h1, rp_to_ss hS' h2, rp_to_ss hS' h3, fun h => rp_to_ss hS' (h4 h)⟩

/-- The abscissae of the set-square constructible points of the `x`-axis form a subfield of `ℝ`. -/
def ssAxisField (hS : AxisPts S) : Subfield ℝ where
  carrier := {a | SSConstructible S (.point (a, 0))}
  mul_mem' {a b} ha hb := (ssc_arith hS ha hb).2.2.1
  one_mem' := SSConstructible.init hS.2
  add_mem' {a b} ha hb := (ssc_arith hS ha hb).1
  zero_mem' := SSConstructible.init hS.1
  neg_mem' {a} ha := by
    have := (ssc_arith hS (SSConstructible.init hS.1 : SSConstructible S (.point (0, 0))) ha).2.1
    simpa using this
  inv_mem' {a} ha := by
    by_cases h0 : a = 0
    · subst h0; simpa using (SSConstructible.init hS.1 : SSConstructible S (.point (0, 0)))
    · have := (ssc_arith hS (SSConstructible.init hS.2 : SSConstructible S (.point (1, 0))) ha).2.2.2 h0
      simpa using this

/-- The set of all coordinates of the points of `S`. -/
def coordSet (S : Set (ℝ × ℝ)) : Set ℝ := {a | ∃ p ∈ S, a = p.1 ∨ a = p.2}

/-- **Theorem 19.11** (Petrunin, p. 161), the "if" direction: if `(0,0)` and `(1,0)` are initial points and the
coordinates `x`, `y` of a point lie in the subfield of `ℝ` generated by the coordinates of the initial points
(the numbers expressible by `+`, `-`, `·`, `/` from the integers and these coordinates), then the point is
constructible with a set-square. (The book's argument: set-square constructions simulate the parallel tool
of Exercise 14.7; here via `rp_add_sub_mul_div`.) -/
@[kb "petrunin2025" "Theorem 19.11 (if), p. 161"]
theorem SSConstructible.of_mem_closure (hS : AxisPts S) {x y : ℝ} (hx : x ∈ Subfield.closure (coordSet S))
    (hy : y ∈ Subfield.closure (coordSet S)) : SSConstructible S (.point (x, y)) := by
  have hsub : Subfield.closure (coordSet S) ≤ ssAxisField hS := by
    rw [Subfield.closure_le]
    rintro a ⟨⟨p1, p2⟩, hp, rfl | rfl⟩
    · exact ssc_foot_x hS (SSConstructible.init hp)
    · exact ssc_y_to_x hS (ssc_foot_y hS (SSConstructible.init hp))
  have hx' : x ∈ ssAxisField hS := hsub hx
  have hy' : y ∈ ssAxisField hS := hsub hy
  exact ssc_point_of_axes hS hx' ((ssAxisField hS).sub_mem hx' hy')

/-- **Theorem 19.11** (Petrunin, p. 161), both directions: if `(0,0)` and `(1,0)` are initial points, a point
is constructible with a set-square if and only if both its coordinates lie in the subfield generated by the
coordinates of the initial points. -/
@[kb "petrunin2025" "Theorem 19.11, p. 161"]
theorem ssConstructible_iff (hS : AxisPts S) {X : ℝ × ℝ} :
    SSConstructible S (.point X) ↔
      X.1 ∈ Subfield.closure (coordSet S) ∧ X.2 ∈ Subfield.closure (coordSet S) := by
  constructor
  · intro h
    exact SSConstructible.coords (Subfield.closure (coordSet S))
      (fun x hx => ⟨Subfield.subset_closure ⟨x, hx, Or.inl rfl⟩, Subfield.subset_closure ⟨x, hx, Or.inr rfl⟩⟩) h
  · rintro ⟨h1, h2⟩
    exact SSConstructible.of_mem_closure hS h1 h2

end SetSquareIf

/-! ### The compass alone (Mohr-Mascheroni): the complex-number toolkit

In this section `U : Set ℂ` is a set of points of the plane, closed under the compass step: the intersection
points of two circles with distinct centres in `U`, each passing thru a point of `U` (the book's compass).
We show that if `0, 1 ∈ U` then `U` is a subfield of `ℂ` closed under conjugation and square roots. -/

section Toolkit

open ComplexConjugate

namespace MM

/-- A set of points closed under the compass step (circles given by a centre and a point on them). -/
def Closed (U : Set ℂ) : Prop :=
  ∀ c d c' d' x : ℂ, c ∈ U → d ∈ U → c' ∈ U → d' ∈ U → c ≠ c' →
    Complex.normSq (x - c) = Complex.normSq (d - c) → Complex.normSq (x - c') = Complex.normSq (d' - c') →
    x ∈ U

variable {U : Set ℂ}

/-- The mirror image of `z` in the line `ab`. -/
noncomputable def refl (a b z : ℂ) : ℂ := a + (b - a) / conj (b - a) * conj (z - a)

theorem normSq_ne {u : ℂ} (hu : u ≠ 0) : Complex.normSq u ≠ 0 := Complex.normSq_pos.mpr hu |>.ne'

theorem refl_mem (hU : Closed U) {a b z : ℂ} (ha : a ∈ U) (hb : b ∈ U) (hz : z ∈ U) (hab : a ≠ b) :
    refl a b z ∈ U := by
  have hu : b - a ≠ 0 := sub_ne_zero.mpr hab.symm
  have hu' : conj b - conj a ≠ 0 := by rw [← map_sub (starRingEnd ℂ)]; exact (map_ne_zero _).mpr hu
  have hns := normSq_ne hu
  refine hU a z b z _ ha hz hb hz hab ?_ ?_
  · simp only [refl, add_sub_cancel_left, map_mul, map_div₀, Complex.normSq_conj]
    rw [div_self hns, one_mul]
  · have : refl a b z - b = (b - a) / conj (b - a) * conj (z - b) := by
      simp only [refl, map_sub] at hu' ⊢
      field_simp
      ring
    rw [this]
    simp only [map_mul, map_div₀, Complex.normSq_conj]
    rw [div_self hns, one_mul]

theorem conj_mem (hU : Closed U) (h0 : (0 : ℂ) ∈ U) (h1 : (1 : ℂ) ∈ U) {z : ℂ} (hz : z ∈ U) : conj z ∈ U := by
  have := refl_mem hU h0 h1 hz (by norm_num)
  simpa [refl] using this

/-- The primitive sixth root of unity `e^{iπ/3}`. -/
noncomputable def om : ℂ := ⟨1 / 2, √3 / 2⟩

theorem om_sq : om ^ 2 = om - 1 := by
  have h3 : √3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  apply Complex.ext <;> simp [om, pow_two] <;> nlinarith

theorem conj_om : conj om = 1 - om := by
  apply Complex.ext <;> simp [om] <;> norm_num

theorem normSq_om : Complex.normSq om = 1 := by
  have h3 : √3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  simp [Complex.normSq_apply, om]; nlinarith

theorem normSq_om_sub : Complex.normSq (om - 1) = 1 := by
  have h3 : √3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  simp [Complex.normSq_apply, om]; nlinarith

theorem om_ne : 2 * om - 1 ≠ 0 := by
  intro h
  have := congrArg Complex.im h
  simp [om] at this

theorem apex_mem (hU : Closed U) {a b : ℂ} (ha : a ∈ U) (hb : b ∈ U) (hab : a ≠ b) :
    a + om * (b - a) ∈ U ∧ a + conj om * (b - a) ∈ U := by
  constructor
  · refine hU a b b a _ ha hb hb ha hab ?_ ?_
    · simp [map_mul, normSq_om]
    · have : a + om * (b - a) - b = (om - 1) * (b - a) := by ring
      rw [this, map_mul, normSq_om_sub, one_mul, ← neg_sub b a, Complex.normSq_neg]
  · refine hU a b b a _ ha hb hb ha hab ?_ ?_
    · simp [map_mul, normSq_om]
    · have : a + conj om * (b - a) - b = conj (om - 1) * (b - a) := by
        rw [map_sub, conj_om]; simp; ring
      rw [this, map_mul, Complex.normSq_conj, normSq_om_sub, one_mul, ← neg_sub b a, Complex.normSq_neg]

theorem double_mem (hU : Closed U) {a b : ℂ} (ha : a ∈ U) (hb : b ∈ U) (hab : a ≠ b) : 2 * b - a ∈ U := by
  have hba : b ≠ a := hab.symm
  have hom : om ≠ 0 := by
    intro h; have := normSq_om; rw [h] at this; simp at this
  have p1 := (apex_mem hU hb ha hba).1
  have e1 : om * (a - b) ≠ 0 := mul_ne_zero hom (sub_ne_zero.mpr hab)
  have p2 := (apex_mem hU hb p1 (by intro h; apply e1; linear_combination -h)).1
  have e2 : om * (b + om * (a - b) - b) ≠ 0 := by
    apply mul_ne_zero hom; intro h; apply e1; linear_combination h
  have p3 := (apex_mem hU hb p2 (by intro h; apply e2; linear_combination -h)).1
  have : b + om * (b + om * (b + om * (a - b) - b) - b) = 2 * b - a := by
    linear_combination ((om + 1) * (a - b)) * om_sq
  rwa [this] at p3

/-- The mirror image of `z` in the perpendicular bisector of `st`. -/
noncomputable def pr (s t z : ℂ) : ℂ := (s + t) / 2 - (t - s) / conj (t - s) * conj (z - (s + t) / 2)

theorem pr_mem (hU : Closed U) {s t z : ℂ} (hs : s ∈ U) (ht : t ∈ U) (hz : z ∈ U) (hst : s ≠ t) :
    pr s t z ∈ U := by
  obtain ⟨hP, hQ⟩ := apex_mem hU hs ht hst
  have hv : t - s ≠ 0 := sub_ne_zero.mpr hst.symm
  have hv' : conj t - conj s ≠ 0 := by rw [← map_sub (starRingEnd ℂ)]; exact (map_ne_zero _).mpr hv
  have h2 := om_ne
  have hPQ : s + om * (t - s) ≠ s + conj om * (t - s) := by
    intro h
    have : (om - conj om) * (t - s) = 0 := by linear_combination h
    rcases mul_eq_zero.mp this with h' | h'
    · apply h2; rw [conj_om] at h'; linear_combination h'
    · exact hv h'
  have key := refl_mem hU hP hQ hz hPQ
  have hQP : s + conj om * (t - s) - (s + om * (t - s)) = (2 * om - 1) * (s - t) := by
    rw [conj_om]; ring
  have hcQP : conj ((2 * om - 1) * (s - t)) = (2 * om - 1) * (conj t - conj s) := by
    simp only [map_sub, map_mul, map_one, map_ofNat, conj_om]; ring
  have hq : (2 * om - 1) * (s - t) / ((2 * om - 1) * (conj t - conj s)) = (s - t) / (conj t - conj s) :=
    mul_div_mul_left _ _ h2
  have hzP : conj (z - (s + om * (t - s))) = conj z - conj s - (1 - om) * (conj t - conj s) := by
    simp only [map_sub, map_mul, map_add, conj_om]; ring
  have e : refl (s + om * (t - s)) (s + conj om * (t - s)) z = pr s t z := by
    unfold refl pr
    rw [hQP, hcQP, hq, hzP]
    simp only [map_sub, map_add, map_div₀, map_ofNat]
    field_simp
    ring
  rwa [e] at key

theorem trans_mem (hU : Closed U) {d e z : ℂ} (hd : d ∈ U) (he : e ∈ U) (hz : z ∈ U) : z + (e - d) ∈ U := by
  by_cases hde : d = e
  · simpa [hde] using hz
  have hd' := double_mem hU he hd (Ne.symm hde)
  have hne : 2 * d - e ≠ e := by
    intro h; apply hde; linear_combination h / 2
  have hy := pr_mem hU hd' he hz hne
  have hx := pr_mem hU hd he hy hde
  have hv : e - d ≠ 0 := sub_ne_zero.mpr (Ne.symm hde)
  have hv' : conj e - conj d ≠ 0 := by rw [← map_sub (starRingEnd ℂ)]; exact (map_ne_zero _).mpr hv
  have a1 : (2 * d - e + e) / 2 = d := by ring
  have a2 : e - (2 * d - e) = 2 * (e - d) := by ring
  have hy_eq : pr (2 * d - e) e z = d - (e - d) / (conj e - conj d) * (conj z - conj d) := by
    unfold pr
    rw [a1, a2]
    simp only [map_sub, map_mul, map_ofNat]
    have h2' : (2 : ℂ) ≠ 0 := two_ne_zero
    rw [mul_div_mul_left _ _ h2']
  have : pr d e (pr (2 * d - e) e z) = z + (e - d) := by
    rw [hy_eq]
    unfold pr
    simp only [map_sub, map_add, map_mul, map_div₀, map_ofNat, Complex.conj_conj]
    field_simp
    ring
  rwa [this] at hx

theorem add_mem' (hU : Closed U) (h0 : (0 : ℂ) ∈ U) {z w : ℂ} (hz : z ∈ U) (hw : w ∈ U) : z + w ∈ U := by
  simpa using trans_mem hU h0 hw hz

theorem neg_mem' (hU : Closed U) (h0 : (0 : ℂ) ∈ U) {z : ℂ} (hz : z ∈ U) : -z ∈ U := by
  simpa using trans_mem hU hz h0 h0

/-- Inversion in the unit circle. -/
noncomputable def invc (z : ℂ) : ℂ := (((Complex.normSq z)⁻¹ : ℝ) : ℂ) * z

theorem inv_step (hU : Closed U) (h0 : (0 : ℂ) ∈ U) {z X Y : ℂ} (hz0 : z ≠ 0) (hX : X ∈ U) (hY : Y ∈ U)
    (hXY : X ≠ Y) (hX1 : Complex.normSq X = 1) (hY1 : Complex.normSq Y = 1)
    (hXz : Complex.normSq (X - z) = Complex.normSq z) (hYz : Complex.normSq (Y - z) = Complex.normSq z) :
    invc z ∈ U := by
  have hN : Complex.normSq z ≠ 0 := normSq_ne hz0
  have key : ∀ W : ℂ, Complex.normSq W = 1 → Complex.normSq (W - z) = Complex.normSq z →
      Complex.normSq (invc z - W) = Complex.normSq (0 - W) := by
    intro W hW hWz
    have hre : (W * conj z).re = 1 / 2 := by
      have := Complex.normSq_sub W z
      linarith
    have hre' : (z * conj W).re = 1 / 2 := by
      have : z * conj W = conj (W * conj z) := by simp [mul_comm]
      rw [this, Complex.conj_re, hre]
    rw [Complex.normSq_sub, zero_sub, Complex.normSq_neg, hW]
    unfold invc
    rw [mul_assoc, Complex.re_ofReal_mul, hre', Complex.normSq_mul, Complex.normSq_ofReal]
    field_simp
    ring
  exact hU X 0 Y 0 _ hX h0 hY h0 hXY (key X hX1 hXz) (key Y hY1 hYz)

/-- For `σ² = 1 - c²` the point `z·(c + iσ)/ρ` is on the unit circle and at distance `|z|` from `z`. -/
theorem inv_pts {z : ℂ} (hz0 : z ≠ 0) (hbig : 1 / 4 < Complex.normSq z) :
    ∃ c s : ℝ, 0 < s ∧ s ^ 2 = 1 - c ^ 2 ∧ ∃ ρ : ℝ, 0 < ρ ∧ ρ ^ 2 = Complex.normSq z ∧ c * ρ = 1 / 2 ∧
      ∀ σ : ℝ, σ ^ 2 = 1 - c ^ 2 → Complex.normSq (z * ⟨c / ρ, σ / ρ⟩) = 1 ∧
        Complex.normSq (z * ⟨c / ρ, σ / ρ⟩ - z) = Complex.normSq z := by
  have hN0 : 0 < Complex.normSq z := by linarith
  obtain ⟨ρ, hρpos, hρ2⟩ : ∃ ρ : ℝ, 0 < ρ ∧ ρ ^ 2 = Complex.normSq z :=
    ⟨√(Complex.normSq z), Real.sqrt_pos.mpr hN0, Real.sq_sqrt hN0.le⟩
  have hρhalf : 1 / 2 < ρ := by nlinarith
  obtain ⟨c, hcρ⟩ : ∃ c : ℝ, c * ρ = 1 / 2 := ⟨1 / (2 * ρ), by field_simp⟩
  have hc0 : 0 < c := by nlinarith
  have hc1 : c < 1 := by nlinarith
  have hs2 : 0 < 1 - c ^ 2 := by nlinarith
  refine ⟨c, √(1 - c ^ 2), Real.sqrt_pos.mpr hs2, Real.sq_sqrt hs2.le, ρ, hρpos, hρ2, hcρ, ?_⟩
  intro σ hσ
  have hρ0 : ρ ≠ 0 := hρpos.ne'
  constructor
  · rw [Complex.normSq_mul, ← hρ2, Complex.normSq_mk]
    have : ρ ^ 2 * (c / ρ * (c / ρ) + σ / ρ * (σ / ρ)) = c ^ 2 + σ ^ 2 := by field_simp
    rw [this]; linarith
  · have : z * (⟨c / ρ, σ / ρ⟩ : ℂ) - z = z * (⟨c / ρ - 1, σ / ρ⟩ : ℂ) := by
      apply Complex.ext <;> simp <;> ring
    rw [this, Complex.normSq_mul, ← hρ2, Complex.normSq_mk]
    have : ρ ^ 2 * ((c / ρ - 1) * (c / ρ - 1) + σ / ρ * (σ / ρ)) = (c - ρ) ^ 2 + σ ^ 2 := by field_simp
    rw [this]
    linear_combination hσ - 2 * hcρ

theorem inv_big (hU : Closed U) (h0 : (0 : ℂ) ∈ U) (h1 : (1 : ℂ) ∈ U) {z : ℂ} (hz : z ∈ U) (hz0 : z ≠ 0)
    (hbig : 1 / 4 < Complex.normSq z) : invc z ∈ U := by
  obtain ⟨c, s, hs, hs2, ρ, hρ, hρ2, hcρ, hpts⟩ := inv_pts hz0 hbig
  have hmem : ∀ σ : ℝ, σ ^ 2 = 1 - c ^ 2 → z * (⟨c / ρ, σ / ρ⟩ : ℂ) ∈ U := by
    intro σ hσ
    obtain ⟨e1, e2⟩ := hpts σ hσ
    refine hU z 0 0 1 _ hz h0 h0 h1 hz0 ?_ ?_
    · rw [e2, zero_sub, Complex.normSq_neg]
    · rw [sub_zero, sub_zero, e1]; simp
  have hXY : z * (⟨c / ρ, s / ρ⟩ : ℂ) ≠ z * (⟨c / ρ, -s / ρ⟩ : ℂ) := by
    intro h
    have := mul_left_cancel₀ hz0 h
    have h2 := congrArg Complex.im this
    simp at h2
    have : s = 0 := by
      have hρ0 : ρ ≠ 0 := hρ.ne'
      field_simp at h2
      linarith
    linarith
  exact inv_step hU h0 hz0 (hmem s hs2) (hmem (-s) (by rw [neg_sq]; exact hs2)) hXY (hpts s hs2).1
    (hpts (-s) (by rw [neg_sq]; exact hs2)).1 (hpts s hs2).2 (hpts (-s) (by rw [neg_sq]; exact hs2)).2

theorem inv_all (hU : Closed U) (h0 : (0 : ℂ) ∈ U) (h1 : (1 : ℂ) ∈ U) :
    ∀ n : ℕ, ∀ z : ℂ, z ∈ U → z ≠ 0 → 1 / 4 < Complex.normSq z * 4 ^ n → invc z ∈ U := by
  intro n
  induction n with
  | zero =>
    intro z hz hz0 h
    exact inv_big hU h0 h1 hz hz0 (by simpa using h)
  | succ n ih =>
    intro z hz hz0 h
    have h2z : z + z ∈ U := add_mem' hU h0 hz hz
    have hn : Complex.normSq (z + z) = 4 * Complex.normSq z := by
      rw [← two_mul, Complex.normSq_mul]
      have : Complex.normSq (2 : ℂ) = 4 := by simp [Complex.normSq_apply]; norm_num
      rw [this]
    have hz2 : z + z ≠ 0 := by
      intro h'; apply hz0; linear_combination h' / 2
    have := ih (z + z) h2z hz2 (by rw [hn]; rw [pow_succ] at h; linarith)
    have e : invc z = invc (z + z) + invc (z + z) := by
      unfold invc
      rw [hn]
      have hN : Complex.normSq z ≠ 0 := normSq_ne hz0
      push_cast
      field_simp
      ring
    rw [e]
    exact add_mem' hU h0 this this

theorem inv_mem' (hU : Closed U) (h0 : (0 : ℂ) ∈ U) (h1 : (1 : ℂ) ∈ U) {z : ℂ} (hz : z ∈ U) (hz0 : z ≠ 0) :
    z⁻¹ ∈ U := by
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (1 / 4 / Complex.normSq z) (by norm_num : (1 : ℝ) < 4)
  have hN : 0 < Complex.normSq z := Complex.normSq_pos.mpr hz0
  have := inv_all hU h0 h1 n z hz hz0 (by have := (div_lt_iff₀ hN).mp hn; linarith)
  have h := conj_mem hU h0 h1 this
  rwa [show z⁻¹ = conj (invc z) by
    rw [Complex.inv_def]; unfold invc; rw [map_mul, Complex.conj_ofReal, mul_comm]] 

section Field

variable (hU : Closed U) (h0 : (0 : ℂ) ∈ U) (h1 : (1 : ℂ) ∈ U)
include hU h0 h1

theorem half_mem {z : ℂ} (hz : z ∈ U) : z / 2 ∈ U := by
  by_cases h : z = 0
  · simpa [h] using h0
  have a := inv_mem' hU h0 h1 hz h
  have b := add_mem' hU h0 a a
  have hb0 : z⁻¹ + z⁻¹ ≠ 0 := by
    rw [← two_mul]; exact mul_ne_zero two_ne_zero (inv_ne_zero h)
  have c := inv_mem' hU h0 h1 b hb0
  have e : (z⁻¹ + z⁻¹)⁻¹ = z / 2 := by
    rw [← two_mul, mul_inv, inv_inv]; ring
  rwa [e] at c

theorem sq_mem {z : ℂ} (hz : z ∈ U) : z ^ 2 ∈ U := by
  by_cases h : z = 0
  · simpa [h] using h0
  by_cases h' : z + 1 = 0
  · have : z = -1 := by linear_combination h'
    rw [this]; simpa using h1
  have a := inv_mem' hU h0 h1 hz h
  have hz1 : z + 1 ∈ U := add_mem' hU h0 hz h1
  have b := inv_mem' hU h0 h1 hz1 h'
  have d := add_mem' hU h0 a (neg_mem' hU h0 b)
  have e : z⁻¹ + -(z + 1)⁻¹ = (z * (z + 1))⁻¹ := by field_simp; ring
  have hd0 : z⁻¹ + -(z + 1)⁻¹ ≠ 0 := by rw [e]; exact inv_ne_zero (mul_ne_zero h h')
  have f := inv_mem' hU h0 h1 d hd0
  rw [e, inv_inv] at f
  have g := add_mem' hU h0 f (neg_mem' hU h0 hz)
  have : z ^ 2 = z * (z + 1) + -z := by ring
  rwa [← this] at g

theorem mul_mem'' {z w : ℂ} (hz : z ∈ U) (hw : w ∈ U) : z * w ∈ U := by
  have a := sq_mem hU h0 h1 (add_mem' hU h0 hz hw)
  have b := sq_mem hU h0 h1 hz
  have c := sq_mem hU h0 h1 hw
  have d := half_mem hU h0 h1 (add_mem' hU h0 (add_mem' hU h0 a (neg_mem' hU h0 b)) (neg_mem' hU h0 c))
  have : z * w = ((z + w) ^ 2 + -z ^ 2 + -w ^ 2) / 2 := by ring
  rwa [← this] at d

/-- If `0, 1 ∈ U` and `U` is closed under the compass step, then `U` is a subfield of `ℂ`. -/
noncomputable def fieldOf : Subfield ℂ where
  carrier := U
  mul_mem' := fun ha hb => mul_mem'' hU h0 h1 ha hb
  one_mem' := h1
  add_mem' := fun ha hb => add_mem' hU h0 ha hb
  zero_mem' := h0
  neg_mem' := fun ha => neg_mem' hU h0 ha
  inv_mem' := fun {a} ha => by
    by_cases h : a = 0
    · simpa [h] using h0
    · exact inv_mem' hU h0 h1 ha h

theorem mem_fieldOf {z : ℂ} : z ∈ fieldOf hU h0 h1 ↔ z ∈ U := Iff.rfl

/-- The point `i √a` for a real `a > 0`, `a ≠ 1`, in `U`: intersect the circle with centre `(a-1)/2` thru `-1`
and its mirror image. -/
theorem gadget {a : ℝ} (ha : (a : ℂ) ∈ U) (ha0 : 0 < a) (ha1 : a ≠ 1) :
    Complex.I * ((√a : ℝ) : ℂ) ∈ U := by
  set F := fieldOf hU h0 h1
  have h2 : (2 : ℂ) ∈ F := by
    have := F.add_mem F.one_mem F.one_mem
    rwa [one_add_one_eq_two] at this
  have hm : ((a : ℂ) - 1) / 2 ∈ F := F.div_mem (F.sub_mem ha h1) h2
  have hmn : -(((a : ℂ) - 1) / 2) ∈ F := F.neg_mem hm
  have hm1 : (-1 : ℂ) ∈ F := F.neg_mem F.one_mem
  have ht : √a ^ 2 = a := Real.sq_sqrt ha0.le
  refine hU (((a : ℂ) - 1) / 2) (-1) (-(((a : ℂ) - 1) / 2)) 1 _ hm hm1 hmn h1 ?_ ?_ ?_
  · intro h
    apply ha1
    have := congrArg Complex.re h
    simp at this
    linarith
  · simp [Complex.normSq_apply]
    linear_combination ht
  · simp [Complex.normSq_apply]
    linear_combination ht

theorem I_mem : Complex.I ∈ U := by
  set F := fieldOf hU h0 h1
  have h2 : (2 : ℂ) ∈ F := by
    have := F.add_mem F.one_mem F.one_mem
    rwa [one_add_one_eq_two] at this
  have h4 : ((4 : ℝ) : ℂ) ∈ U := by
    have : (4 : ℂ) ∈ F := by
      have := F.add_mem h2 h2
      rwa [show (2 : ℂ) + 2 = 4 by norm_num] at this
    have h4' : (4 : ℂ) ∈ U := this
    simpa using h4'
  have := gadget hU h0 h1 h4 (by norm_num) (by norm_num)
  have e : √(4 : ℝ) = 2 := by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num]; exact Real.sqrt_sq (by norm_num)
  rw [e] at this
  have h3 : Complex.I = Complex.I * ((2 : ℝ) : ℂ) / 2 := by push_cast; ring
  rw [h3]
  have this' : Complex.I * 2 ∈ U := by simpa using this
  exact F.div_mem this' h2

theorem sqrt_mem {a : ℝ} (ha : (a : ℂ) ∈ U) : ((√a : ℝ) : ℂ) ∈ U := by
  by_cases h0' : a ≤ 0
  · rw [Real.sqrt_eq_zero_of_nonpos h0']; simpa using h0
  push Not at h0'
  by_cases h1' : a = 1
  · rw [h1']; simpa using h1
  have := gadget hU h0 h1 ha h0' h1'
  set F := fieldOf hU h0 h1
  have hI : Complex.I ∈ F := I_mem hU h0 h1
  have : Complex.I * ((√a : ℝ) : ℂ) / Complex.I ∈ F := F.div_mem this hI
  rwa [mul_div_cancel_left₀ _ Complex.I_ne_zero] at this

/-- **The structure of a compass-closed set.** If `0, 1 ∈ U` and `U` is closed under the compass step, there is
a subfield `K` of `ℝ`, closed under square roots, such that `U = K + iK`. -/
theorem exists_subfield : ∃ K : Subfield ℝ, (∀ a ∈ K, 0 ≤ a → √a ∈ K) ∧
    ∀ z : ℂ, z ∈ U ↔ z.re ∈ K ∧ z.im ∈ K := by
  set F := fieldOf hU h0 h1
  have hI : Complex.I ∈ F := I_mem hU h0 h1
  have h2 : (2 : ℂ) ∈ F := by
    have := F.add_mem F.one_mem F.one_mem
    rwa [one_add_one_eq_two] at this
  refine ⟨F.comap Complex.ofRealHom, ?_, ?_⟩
  · intro a ha _
    rw [Subfield.mem_comap, Complex.ofRealHom_eq_coe] at ha ⊢
    exact sqrt_mem hU h0 h1 (a := a) ha
  · intro z
    simp only [Subfield.mem_comap, Complex.ofRealHom_eq_coe]
    constructor
    · intro hz
      have hc : conj z ∈ F := conj_mem hU h0 h1 hz
      constructor
      · rw [Complex.re_eq_add_conj]; exact F.div_mem (F.add_mem hz hc) h2
      · rw [Complex.im_eq_sub_conj]
        exact F.div_mem (F.sub_mem hz hc) (F.mul_mem h2 hI)
    · rintro ⟨hr, hi⟩
      rw [← Complex.re_add_im z]
      exact F.add_mem hr (F.mul_mem hi hI)

end Field

end MM

end Toolkit

/-! ### Coordinates of ruler-and-compass constructions over a square-root closed subfield -/

section CoordsK

variable (K : Subfield ℝ)

theorem K_two : (2 : ℝ) ∈ K := by
  have := K.add_mem K.one_mem K.one_mem
  rwa [one_add_one_eq_two] at this

theorem K_four : (4 : ℝ) ∈ K := by
  have := K.add_mem (K_two K) (K_two K)
  rwa [show (2 : ℝ) + 2 = 4 by norm_num] at this

theorem K_lineLine {p1 p2 v1 v2 p1' p2' v1' v2' t s : ℝ}
    (hp1 : p1 ∈ K) (hp2 : p2 ∈ K) (hv1 : v1 ∈ K) (hv2 : v2 ∈ K) (hp1' : p1' ∈ K) (hp2' : p2' ∈ K)
    (hv1' : v1' ∈ K) (hv2' : v2' ∈ K) (hdet : v1 * v2' - v2 * v1' ≠ 0)
    (h1 : p1 + t * v1 = p1' + s * v1') (h2 : p2 + t * v2 = p2' + s * v2') : t ∈ K := by
  have ht : t = ((p1' - p1) * v2' - (p2' - p2) * v1') / (v1 * v2' - v2 * v1') := by
    rw [eq_div_iff hdet]
    linear_combination v2' * h1 - v1' * h2
  rw [ht]
  exact K.div_mem (K.sub_mem (K.mul_mem (K.sub_mem hp1' hp1) hv2') (K.mul_mem (K.sub_mem hp2' hp2) hv1'))
    (K.sub_mem (K.mul_mem hv1 hv2') (K.mul_mem hv2 hv1'))

theorem K_lineCircle (hK : ∀ a ∈ K, √a ∈ K) {p1 p2 v1 v2 c1 c2 R t : ℝ}
    (hp1 : p1 ∈ K) (hp2 : p2 ∈ K) (hv1 : v1 ∈ K) (hv2 : v2 ∈ K) (hc1 : c1 ∈ K) (hc2 : c2 ∈ K)
    (hR : R ∈ K) (hv : v1 ≠ 0 ∨ v2 ≠ 0)
    (h : (p1 + t * v1 - c1) ^ 2 + (p2 + t * v2 - c2) ^ 2 = R) : t ∈ K := by
  set a := v1 ^ 2 + v2 ^ 2 with ha
  set b := 2 * (v1 * (p1 - c1) + v2 * (p2 - c2)) with hb
  set e := (p1 - c1) ^ 2 + (p2 - c2) ^ 2 - R with he
  have hapos : 0 < a := by
    rcases hv with hv | hv
    · have := sq_pos_of_ne_zero hv; positivity
    · have := sq_pos_of_ne_zero hv; positivity
  have key : (2 * a * t + b) ^ 2 = b ^ 2 - 4 * a * e := by
    rw [ha, hb, he]; linear_combination (4 * (v1 ^ 2 + v2 ^ 2)) * h
  have hA : a ∈ K := by
    rw [ha]; exact K.add_mem (K.pow_mem hv1 2) (K.pow_mem hv2 2)
  have hB : b ∈ K := by
    rw [hb]
    exact K.mul_mem (K_two K) (K.add_mem (K.mul_mem hv1 (K.sub_mem hp1 hc1)) (K.mul_mem hv2 (K.sub_mem hp2 hc2)))
  have hE : e ∈ K := by
    rw [he]
    exact K.sub_mem (K.add_mem (K.pow_mem (K.sub_mem hp1 hc1) 2) (K.pow_mem (K.sub_mem hp2 hc2) 2)) hR
  have hD : √(b ^ 2 - 4 * a * e) ∈ K :=
    hK _ (K.sub_mem (K.pow_mem hB 2) (K.mul_mem (K.mul_mem (K_four K) hA) hE))
  have hsq : √(b ^ 2 - 4 * a * e) = |2 * a * t + b| := by
    rw [← key, Real.sqrt_sq_eq_abs]
  have h2a : 2 * a ∈ K := K.mul_mem (K_two K) hA
  rcases abs_choice (2 * a * t + b) with habs | habs
  · have ht : t = (√(b ^ 2 - 4 * a * e) - b) / (2 * a) := by
      rw [hsq, habs]; field_simp; ring
    rw [ht]; exact K.div_mem (K.sub_mem hD hB) h2a
  · have ht : t = (-√(b ^ 2 - 4 * a * e) - b) / (2 * a) := by
      rw [hsq, habs]; field_simp; ring
    rw [ht]; exact K.div_mem (K.sub_mem (K.neg_mem hD) hB) h2a

/-- The ruler-and-compass analogue of `RCConstructible.coords` for an arbitrary subfield `K` of `ℝ` closed under
square roots (the book's case is the subfield of constructible numbers over the initial coordinates). -/
theorem RCConstructible.coordsK (hK : ∀ a ∈ K, √a ∈ K) {S : Set (ℝ × ℝ)} (hS : ∀ x ∈ S, x.1 ∈ K ∧ x.2 ∈ K)
    {x : ℝ × ℝ} (hx : RCConstructible S (.point x)) : x.1 ∈ K ∧ x.2 ∈ K := by
  let good : RCObj → Prop
    | .point x => x.1 ∈ K ∧ x.2 ∈ K
    | .line p q => (p.1 ∈ K ∧ p.2 ∈ K) ∧ (q.1 ∈ K ∧ q.2 ∈ K) ∧ p ≠ q
    | .circle c d => (c.1 ∈ K ∧ c.2 ∈ K) ∧ (d.1 ∈ K ∧ d.2 ∈ K)
  suffices ∀ o, RCConstructible S o → good o from this _ hx
  intro o ho
  induction ho with
  | init hx => exact hS _ hx
  | line _ _ hpq ihp ihq => exact ⟨ihp, ihq, hpq⟩
  | circle _ _ ihc ihd => exact ⟨ihc, ihd⟩
  | @lineLine p q p' q' x _ _ hdet hx hx' ih ih' =>
    obtain ⟨⟨hp1, hp2⟩, ⟨hq1, hq2⟩, -⟩ := ih
    obtain ⟨⟨hp1', hp2'⟩, ⟨hq1', hq2'⟩, -⟩ := ih'
    obtain ⟨t, ht1, ht2⟩ := hx
    obtain ⟨s, hs1, hs2⟩ := hx'
    have htc := K_lineLine K hp1 hp2 (K.sub_mem hq1 hp1) (K.sub_mem hq2 hp2) hp1' hp2'
      (K.sub_mem hq1' hp1') (K.sub_mem hq2' hp2') hdet (ht1.symm.trans hs1) (ht2.symm.trans hs2)
    refine ⟨?_, ?_⟩
    · rw [ht1]; exact K.add_mem hp1 (K.mul_mem htc (K.sub_mem hq1 hp1))
    · rw [ht2]; exact K.add_mem hp2 (K.mul_mem htc (K.sub_mem hq2 hp2))
  | @lineCircle p q c d x _ _ hx hxc ih ih' =>
    obtain ⟨⟨hp1, hp2⟩, ⟨hq1, hq2⟩, hpq⟩ := ih
    obtain ⟨⟨hc1, hc2⟩, ⟨hd1, hd2⟩⟩ := ih'
    obtain ⟨t, ht1, ht2⟩ := hx
    have hv : q.1 - p.1 ≠ 0 ∨ q.2 - p.2 ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact hpq (Prod.ext (by linarith [hcon.1]) (by linarith [hcon.2]))
    have hR : (d.1 - c.1) * (d.1 - c.1) + (d.2 - c.2) * (d.2 - c.2) ∈ K :=
      K.add_mem (K.mul_mem (K.sub_mem hd1 hc1) (K.sub_mem hd1 hc1))
        (K.mul_mem (K.sub_mem hd2 hc2) (K.sub_mem hd2 hc2))
    have hcirc : (p.1 + t * (q.1 - p.1) - c.1) ^ 2 + (p.2 + t * (q.2 - p.2) - c.2) ^ 2 =
        (d.1 - c.1) * (d.1 - c.1) + (d.2 - c.2) * (d.2 - c.2) := by
      rw [← ht1, ← ht2, hxc]; ring
    have htc := K_lineCircle K hK hp1 hp2 (K.sub_mem hq1 hp1) (K.sub_mem hq2 hp2) hc1 hc2 hR hv hcirc
    refine ⟨?_, ?_⟩
    · rw [ht1]; exact K.add_mem hp1 (K.mul_mem htc (K.sub_mem hq1 hp1))
    · rw [ht2]; exact K.add_mem hp2 (K.mul_mem htc (K.sub_mem hq2 hp2))
  | @circleCircle c d c' d' x _ _ hcc hx hx' ih ih' =>
    obtain ⟨⟨hc1, hc2⟩, ⟨hd1, hd2⟩⟩ := ih
    obtain ⟨⟨hc1', hc2'⟩, ⟨hd1', hd2'⟩⟩ := ih'
    set w1 := c'.1 - c.1
    set w2 := c'.2 - c.2
    set R := (d.1 - c.1) * (d.1 - c.1) + (d.2 - c.2) * (d.2 - c.2) with hRdef
    set R' := (d'.1 - c'.1) * (d'.1 - c'.1) + (d'.2 - c'.2) * (d'.2 - c'.2) with hR'def
    have hw : w1 ≠ 0 ∨ w2 ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact hcc (Prod.ext (by linarith [hcon.1]) (by linarith [hcon.2]))
    have hW : 0 < w1 ^ 2 + w2 ^ 2 := by
      rcases hw with hw | hw
      · have := sq_pos_of_ne_zero hw; positivity
      · have := sq_pos_of_ne_zero hw; positivity
    have hw1 : w1 ∈ K := K.sub_mem hc1' hc1
    have hw2 : w2 ∈ K := K.sub_mem hc2' hc2
    have hR : R ∈ K := K.add_mem (K.mul_mem (K.sub_mem hd1 hc1) (K.sub_mem hd1 hc1))
      (K.mul_mem (K.sub_mem hd2 hc2) (K.sub_mem hd2 hc2))
    have hR' : R' ∈ K := K.add_mem (K.mul_mem (K.sub_mem hd1' hc1') (K.sub_mem hd1' hc1'))
      (K.mul_mem (K.sub_mem hd2' hc2') (K.sub_mem hd2' hc2'))
    have hWc : w1 * w1 + w2 * w2 ∈ K := K.add_mem (K.mul_mem hw1 hw1) (K.mul_mem hw2 hw2)
    set lam := (R - R' + (w1 * w1 + w2 * w2)) / (2 * (w1 * w1 + w2 * w2)) with hlam
    have hlamc : lam ∈ K :=
      K.div_mem (K.add_mem (K.sub_mem hR hR') hWc) (K.mul_mem (K_two K) hWc)
    set t := ((x.1 - c.1) * (-w2) + (x.2 - c.2) * w1) / (w1 ^ 2 + w2 ^ 2) with ht
    have hx1 : OnCircle c d x := hx
    have hx2 : OnCircle c' d' x := hx'
    unfold OnCircle at hx1 hx2
    have hdot : (x.1 - c.1) * w1 + (x.2 - c.2) * w2 = (R - R' + (w1 * w1 + w2 * w2)) / 2 := by
      rw [hRdef, hR'def]
      have e1 : x.1 - c'.1 = (x.1 - c.1) - w1 := by ring
      have e2 : x.2 - c'.2 = (x.2 - c.2) - w2 := by ring
      rw [e1, e2] at hx2
      linear_combination (1 / 2 : ℝ) * hx1 - (1 / 2 : ℝ) * hx2
    have hdecomp1 : x.1 = (c.1 + lam * w1) + t * (-w2) := by
      rw [hlam, ht]; field_simp
      linear_combination (w1 * 2) * hdot
    have hdecomp2 : x.2 = (c.2 + lam * w2) + t * w1 := by
      rw [hlam, ht]; field_simp
      linear_combination (w2 * 2) * hdot
    have hcirc : ((c.1 + lam * w1) + t * (-w2) - c.1) ^ 2 + ((c.2 + lam * w2) + t * w1 - c.2) ^ 2 = R := by
      rw [← hdecomp1, ← hdecomp2, hx1, hRdef]; ring
    have hv : -w2 ≠ 0 ∨ w1 ≠ 0 := by
      rcases hw with hw | hw
      · exact Or.inr hw
      · exact Or.inl (neg_ne_zero.mpr hw)
    have htc := K_lineCircle K hK (K.add_mem hc1 (K.mul_mem hlamc hw1)) (K.add_mem hc2 (K.mul_mem hlamc hw2))
      (K.neg_mem hw2) hw1 hc1 hc2 hR hv hcirc
    refine ⟨?_, ?_⟩
    · rw [hdecomp1]; exact K.add_mem (K.add_mem hc1 (K.mul_mem hlamc hw1)) (K.mul_mem htc (K.neg_mem hw2))
    · rw [hdecomp2]; exact K.add_mem (K.add_mem hc2 (K.mul_mem hlamc hw2)) (K.mul_mem htc hw1)

end CoordsK

/-! ### Mohr-Mascheroni theorem 19.19 -/

section MohrMascheroni

/-- Constructions with a compass alone (Petrunin, Section 19F, p. 164): from the initial points `S`, new points
are the intersection points of two circles with distinct centres, each circle given by a constructed centre
and a constructed point on it; no line is ever drawn. -/
inductive CConstructible (S : Set (ℝ × ℝ)) : ℝ × ℝ → Prop
  | init {x : ℝ × ℝ} : x ∈ S → CConstructible S x
  | circleCircle {c d c' d' x : ℝ × ℝ} : CConstructible S c → CConstructible S d → CConstructible S c' →
      CConstructible S d' → c ≠ c' → OnCircle c d x → OnCircle c' d' x → CConstructible S x

/-- A point constructed with the compass alone is constructed with ruler and compass. -/
theorem CConstructible.rc {S : Set (ℝ × ℝ)} {x : ℝ × ℝ} (h : CConstructible S x) :
    RCConstructible S (.point x) := by
  induction h with
  | init hx => exact .init hx
  | circleCircle _ _ _ _ hcc ho ho' ihc ihd ihc' ihd' =>
    exact RCConstructible.circleCircle (.circle ihc ihd) (.circle ihc' ihd') hcc ho ho'

/-- With at most one initial point, ruler and compass construct nothing new. -/
theorem rc_degenerate {S : Set (ℝ × ℝ)} (hS : ∀ a ∈ S, ∀ b ∈ S, a = b) {x : ℝ × ℝ}
    (hx : RCConstructible S (.point x)) : x ∈ S := by
  let good : RCObj → Prop
    | .point x => x ∈ S
    | .line _ _ => False
    | .circle c d => c ∈ S ∧ d ∈ S
  suffices ∀ o, RCConstructible S o → good o from this _ hx
  intro o ho
  induction ho with
  | init hx => exact hx
  | line _ _ hpq ihp ihq => exact hpq (hS _ ihp _ ihq)
  | circle _ _ ihc ihd => exact ⟨ihc, ihd⟩
  | lineLine _ _ _ _ _ ih ih' => exact False.elim ih
  | lineCircle _ _ _ _ ih ih' => exact False.elim ih
  | circleCircle _ _ hcc _ _ ih ih' => exact absurd (hS _ ih.1 _ ih'.1) hcc

/-- Coordinates with respect to the frame with origin `A` and unit point `B`. -/
noncomputable def frame (A B p : ℝ × ℝ) : ℝ × ℝ :=
  (((p.1 - A.1) * (B.1 - A.1) + (p.2 - A.2) * (B.2 - A.2)) / ((B.1 - A.1) ^ 2 + (B.2 - A.2) ^ 2),
   (-(p.1 - A.1) * (B.2 - A.2) + (p.2 - A.2) * (B.1 - A.1)) / ((B.1 - A.1) ^ 2 + (B.2 - A.2) ^ 2))

/-- The inverse of `frame A B`. -/
def unframe (A B q : ℝ × ℝ) : ℝ × ℝ :=
  (A.1 + q.1 * (B.1 - A.1) - q.2 * (B.2 - A.2), A.2 + q.1 * (B.2 - A.2) + q.2 * (B.1 - A.1))

theorem unframe_frame {A B : ℝ × ℝ} (hAB : A ≠ B) (p : ℝ × ℝ) : unframe A B (frame A B p) = p := by
  have hN := (ne_coords hAB).ne'
  apply Prod.ext <;> simp only [frame, unframe] <;> field_simp <;> ring

theorem frame_unframe {A B : ℝ × ℝ} (hAB : A ≠ B) (q : ℝ × ℝ) : frame A B (unframe A B q) = q := by
  have hN := (ne_coords hAB).ne'
  apply Prod.ext <;> simp only [frame, unframe] <;> field_simp <;> ring

theorem frame_inj {A B : ℝ × ℝ} (hAB : A ≠ B) {p q : ℝ × ℝ} (h : frame A B p = frame A B q) : p = q := by
  rw [← unframe_frame hAB p, h, unframe_frame hAB]

theorem frame_dist {A B : ℝ × ℝ} (hAB : A ≠ B) (u v : ℝ × ℝ) :
    ((frame A B u).1 - (frame A B v).1) ^ 2 + ((frame A B u).2 - (frame A B v).2) ^ 2 =
      ((u.1 - v.1) ^ 2 + (u.2 - v.2) ^ 2) / ((B.1 - A.1) ^ 2 + (B.2 - A.2) ^ 2) := by
  have hN := (ne_coords hAB).ne'
  simp only [frame]; field_simp; ring

/-- The image of a ruler-and-compass object under the map `f`. -/
def RCObj.map (f : ℝ × ℝ → ℝ × ℝ) : RCObj → RCObj
  | .point x => .point (f x)
  | .line p q => .line (f p) (f q)
  | .circle c d => .circle (f c) (f d)

/-- Ruler-and-compass constructions can be transported to the frame `A, B`. -/
theorem frame_transfer {A B : ℝ × ℝ} (hAB : A ≠ B) {S : Set (ℝ × ℝ)} {o : RCObj}
    (h : RCConstructible S o) : RCConstructible (frame A B '' S) (o.map (frame A B)) := by
  have hN := (ne_coords hAB).ne'
  induction h with
  | init hx => exact .init ⟨_, hx, rfl⟩
  | line _ _ hpq ihp ihq => exact .line ihp ihq (fun h => hpq (frame_inj hAB h))
  | circle _ _ ihc ihd => exact .circle ihc ihd
  | @lineLine p q p' q' x _ _ hdet hx hx' ih ih' =>
    have onl : ∀ {p q x : ℝ × ℝ}, OnLine p q x → OnLine (frame A B p) (frame A B q) (frame A B x) := by
      rintro p q x ⟨t, h1, h2⟩
      refine ⟨t, ?_, ?_⟩ <;> simp only [frame, h1, h2] <;> ring
    refine RCConstructible.lineLine ih ih' ?_ (onl hx) (onl hx')
    have : ((frame A B q).1 - (frame A B p).1) * ((frame A B q').2 - (frame A B p').2) -
        ((frame A B q).2 - (frame A B p).2) * ((frame A B q').1 - (frame A B p').1) =
        ((q.1 - p.1) * (q'.2 - p'.2) - (q.2 - p.2) * (q'.1 - p'.1)) / ((B.1 - A.1) ^ 2 + (B.2 - A.2) ^ 2) := by
      simp only [frame]; field_simp; ring
    rw [this]; exact div_ne_zero hdet hN
  | @lineCircle p q c d x _ _ hx hxc ih ih' =>
    have onl : ∀ {p q x : ℝ × ℝ}, OnLine p q x → OnLine (frame A B p) (frame A B q) (frame A B x) := by
      rintro p q x ⟨t, h1, h2⟩
      refine ⟨t, ?_, ?_⟩ <;> simp only [frame, h1, h2] <;> ring
    refine RCConstructible.lineCircle ih ih' (onl hx) ?_
    unfold OnCircle at hxc ⊢
    rw [frame_dist hAB, frame_dist hAB, hxc]
  | @circleCircle c d c' d' x _ _ hcc hx hx' ih ih' =>
    refine RCConstructible.circleCircle ih ih' (fun h => hcc (frame_inj hAB h)) ?_ ?_
    · unfold OnCircle at hx ⊢
      rw [frame_dist hAB, frame_dist hAB, hx]
    · unfold OnCircle at hx' ⊢
      rw [frame_dist hAB, frame_dist hAB, hx']

/-- **Mohr-Mascheroni theorem** (Petrunin, Theorem 19.19, p. 164), for an arbitrary initial configuration `S`
of points of the plane: a point can be constructed with ruler and compass if and only if it can be constructed
with the compass alone (circles given by a constructed centre and a constructed point on them).

The proof follows the field route: starting from two distinct initial points `A ≠ B` (taken as `0` and `1` of
the complex plane, by a similarity), the compass-constructible points form a subfield of `ℂ` closed under
conjugation and square roots (translations by reflections in perpendicular bisectors, inversion in the unit
circle for `1/z`, the multiplication via `z(z+1) = 1/(1/z - 1/(z+1))`, the square root by the circle with
diameter `[-1, a]`); then the coordinates argument of Theorem 19.8 applies. (With at most one initial point,
nothing new is constructible by either tool.) -/
@[kb "petrunin2025" "Theorem 19.19 (Mohr-Mascheroni), p. 164"]
theorem rcConstructible_iff_cConstructible (S : Set (ℝ × ℝ)) (x : ℝ × ℝ) :
    RCConstructible S (.point x) ↔ CConstructible S x := by
  refine ⟨fun hx => ?_, CConstructible.rc⟩
  by_cases hdeg : ∀ a ∈ S, ∀ b ∈ S, a = b
  · exact .init (rc_degenerate hdeg hx)
  push Not at hdeg
  obtain ⟨A, hA, B, hB, hAB⟩ := hdeg
  have hN := (ne_coords hAB).ne'
  set U : Set ℂ := {z : ℂ | CConstructible S (unframe A B (z.re, z.im))} with hUdef
  have hclosed : MM.Closed U := by
    intro c d c' d' x hc hd hc' hd' hne h1 h2
    have o1 : ∀ {c d x : ℂ}, Complex.normSq (x - c) = Complex.normSq (d - c) →
        OnCircle (unframe A B (c.re, c.im)) (unframe A B (d.re, d.im)) (unframe A B (x.re, x.im)) := by
      intro c d x h
      simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im] at h
      unfold OnCircle
      simp only [unframe]
      linear_combination ((B.1 - A.1) ^ 2 + (B.2 - A.2) ^ 2) * h
    refine CConstructible.circleCircle hc hd hc' hd' ?_ (o1 h1) (o1 h2)
    intro h
    apply hne
    have := congrArg (frame A B) h
    rw [frame_unframe hAB, frame_unframe hAB] at this
    exact Complex.ext (congrArg Prod.fst this) (congrArg Prod.snd this)
  have h0 : (0 : ℂ) ∈ U := by
    show CConstructible S (unframe A B ((0 : ℂ).re, (0 : ℂ).im))
    have : unframe A B ((0 : ℂ).re, (0 : ℂ).im) = A := by
      apply Prod.ext <;> simp [unframe]
    rw [this]; exact .init hA
  have h1 : (1 : ℂ) ∈ U := by
    show CConstructible S (unframe A B ((1 : ℂ).re, (1 : ℂ).im))
    have : unframe A B ((1 : ℂ).re, (1 : ℂ).im) = B := by
      apply Prod.ext <;> simp [unframe]
    rw [this]; exact .init hB
  obtain ⟨K, hsq, hK⟩ := MM.exists_subfield hclosed h0 h1
  have hsq' : ∀ a ∈ K, √a ∈ K := by
    intro a ha
    by_cases h : 0 ≤ a
    · exact hsq a ha h
    · rw [Real.sqrt_eq_zero_of_nonpos (not_le.mp h).le]; exact K.zero_mem
  have hS' : ∀ y ∈ frame A B '' S, y.1 ∈ K ∧ y.2 ∈ K := by
    rintro _ ⟨s, hs, rfl⟩
    have : (⟨(frame A B s).1, (frame A B s).2⟩ : ℂ) ∈ U := by
      show CConstructible S (unframe A B ((frame A B s).1, (frame A B s).2))
      have e : unframe A B ((frame A B s).1, (frame A B s).2) = s := unframe_frame hAB s
      rw [e]; exact .init hs
    exact (hK _).mp this
  have hxK := RCConstructible.coordsK K hsq' hS' (frame_transfer hAB hx)
  have : (⟨(frame A B x).1, (frame A B x).2⟩ : ℂ) ∈ U := (hK _).mpr hxK
  have h' : CConstructible S (unframe A B ((frame A B x).1, (frame A B x).2)) := this
  rwa [show ((frame A B x).1, (frame A B x).2) = frame A B x from rfl, unframe_frame hAB] at h'

end MohrMascheroni

/-! ### Comparison of construction tools (Petrunin, Section 19F, pp. 163-164) -/

section Comparison

/-- A set of construction tools, as far as constructing *points* is concerned (the book, p. 164, compares sets of
tools by the configurations of points they construct): to every initial configuration it assigns the set of
points that can be constructed from it. -/
def ConstructionTools : Type := Set (ℝ × ℝ) → Set (ℝ × ℝ)

namespace ConstructionTools

/-- **`T₁` is stronger than `T₂`** (Petrunin, p. 163-164): every configuration of points that can be constructed
with `T₂` can also be constructed with `T₁`; initial configurations are finite sets of points. -/
@[kb "petrunin2025" "Definition of stronger tools, pp. 163-164"]
def StrongerThan (T₁ T₂ : ConstructionTools) : Prop := ∀ S : Set (ℝ × ℝ), S.Finite → T₂ S ⊆ T₁ S

/-- **`T₁` is strictly stronger than `T₂`**: stronger, and some point can be constructed with `T₁` but not with
`T₂` from some initial configuration. -/
@[kb "petrunin2025" "Definition of strictly stronger tools, p. 164"]
def StrictlyStronger (T₁ T₂ : ConstructionTools) : Prop :=
  StrongerThan T₁ T₂ ∧ ∃ S : Set (ℝ × ℝ), S.Finite ∧ ¬ T₁ S ⊆ T₂ S

/-- **The tool sets are equivalent**: each is stronger than the other. -/
@[kb "petrunin2025" "Definition of equivalent tools, p. 164"]
def Equivalent (T₁ T₂ : ConstructionTools) : Prop := StrongerThan T₁ T₂ ∧ StrongerThan T₂ T₁

/-- **The tool sets are incomparable**: each constructs something, from some configuration, that the other
cannot. -/
@[kb "petrunin2025" "Definition of incomparable tools, p. 164"]
def Incomparable (T₁ T₂ : ConstructionTools) : Prop :=
  (∃ S : Set (ℝ × ℝ), S.Finite ∧ ¬ T₁ S ⊆ T₂ S) ∧ (∃ S : Set (ℝ × ℝ), S.Finite ∧ ¬ T₂ S ⊆ T₁ S)

/-- Ruler and compass. -/
def rulerCompass : ConstructionTools := fun S => {x | RCConstructible S (.point x)}

/-- The compass alone. -/
def compass : ConstructionTools := fun S => {x | CConstructible S x}

/-- The (45 degree) set-square, also usable as a ruler. -/
def setSquare : ConstructionTools := fun S => {x | SSConstructible S (.point x)}

/-- Ruler and parallel tool. -/
def rulerParallel : ConstructionTools := fun S => {x | RPConstructible S (.point x)}

theorem stronger_refl (T : ConstructionTools) : StrongerThan T T := fun _ _ => subset_rfl

theorem StrongerThan.trans {T₁ T₂ T₃ : ConstructionTools} (h₁ : StrongerThan T₁ T₂) (h₂ : StrongerThan T₂ T₃) :
    StrongerThan T₁ T₃ := fun S hS => (h₂ S hS).trans (h₁ S hS)

theorem Equivalent.symm {T₁ T₂ : ConstructionTools} (h : Equivalent T₁ T₂) : Equivalent T₂ T₁ := ⟨h.2, h.1⟩

/-- A strictly stronger tool set is not stronger in the other direction. -/
theorem StrictlyStronger.not_stronger {T₁ T₂ : ConstructionTools} (h : StrictlyStronger T₁ T₂) :
    ¬ StrongerThan T₂ T₁ := by
  rintro h'
  obtain ⟨S, hS, hnot⟩ := h.2
  exact hnot (h' S hS)

/-- **Mohr-Mascheroni** (Petrunin, Theorem 19.19, p. 164) in the language of tool comparison: the compass
alone is equivalent to ruler and compass. -/
@[kb "petrunin2025" "Theorem 19.19 (as tool equivalence), p. 164"]
theorem compass_equivalent_rulerCompass : Equivalent compass rulerCompass :=
  ⟨fun S _ x hx => (rcConstructible_iff_cConstructible S x).mp hx,
   fun S _ x hx => (rcConstructible_iff_cConstructible S x).mpr hx⟩

/-- The set-square is stronger than ruler and parallel tool (it simulates the parallel tool by four right-angle
steps), for every initial configuration. -/
theorem setSquare_stronger_rulerParallel : StrongerThan setSquare rulerParallel :=
  fun S _ x hx => rp_to_ss (S' := S) (fun s hs => SSConstructible.init hs) hx

theorem axisPts_standard : AxisPts ({(0, 0), (1, 0)} : Set (ℝ × ℝ)) := ⟨by simp, by simp⟩

/-- The set-square is **strictly** stronger than ruler and parallel tool: from `(0,0)` and `(1,0)` it constructs
`(0,-1)`, which the ruler with a parallel tool cannot reach (Exercise 14.9). -/
theorem setSquare_strictlyStronger_rulerParallel : StrictlyStronger setSquare rulerParallel := by
  refine ⟨setSquare_stronger_rulerParallel, {(0, 0), (1, 0)}, Set.toFinite _, ?_⟩
  intro h
  have hmem : ((0 : ℝ), (-1 : ℝ)) ∈ setSquare ({(0, 0), (1, 0)} : Set (ℝ × ℝ)) :=
    ssc_point_minus_one axisPts_standard
  have := h hmem
  have hS : ∀ s ∈ ({(0, 0), (1, 0)} : Set (ℝ × ℝ)), s.2 = 0 := by
    rintro s (rfl | rfl) <;> rfl
  exact (not_rp_perpendicular hS).2.1 (-1) (by norm_num) this

/-- From the standard configuration `(0,0), (1,0)`, everything a set-square constructs is constructed by ruler
and compass (rational points are constructible). -/
theorem setSquare_subset_rulerCompass_standard :
    setSquare {(0, 0), (1, 0)} ⊆ rulerCompass {(0, 0), (1, 0)} := by
  intro x hx
  obtain ⟨⟨q1, h1⟩, ⟨q2, h2⟩⟩ := SSConstructible.rational (S := {(0, 0), (1, 0)})
    (by
      rintro y (rfl | rfl)
      · exact ⟨⟨0, by simp⟩, ⟨0, by simp⟩⟩
      · exact ⟨⟨1, by simp⟩, ⟨0, by simp⟩⟩) hx
  have := rcConstructible_of_isConstructible (IsConstructible.ratCast q1) (IsConstructible.ratCast q2)
  rw [h1, h2] at this
  exact this

/-- Ruler and compass construct, from `(0,0)` and `(1,0)`, a point that the set-square does not: the apex
`(1/2, √3/2)` of the equilateral triangle on the base (Exercise 19.12). Hence the set-square is not stronger than
ruler and compass. -/
theorem not_setSquare_stronger_rulerCompass : ¬ StrongerThan setSquare rulerCompass := by
  intro h
  have h2 : IsConstructible 2 := by exact_mod_cast IsConstructible.intCast 2
  have h3 : IsConstructible 3 := by exact_mod_cast IsConstructible.intCast 3
  have hx : ((1 : ℝ) / 2, √3 / 2) ∈ rulerCompass ({(0, 0), (1, 0)} : Set (ℝ × ℝ)) := by
    refine (rcConstructible_iff).mpr ⟨?_, h3.sqrt.div h2⟩
    simpa using (IsConstructible.intCast 1).div h2
  have := h _ (Set.toFinite _) hx
  exact (SSConstructible.not_equilateral this).1 rfl

end ConstructionTools

end Comparison

/-! ### Poncelet-Steiner: the easy inclusion -/

section PonceletSteiner

/-- Ruler-only constructions with a given circle (Petrunin, p. 164): the circle has centre `O` and passes thru
`P`; new points are the intersections of two lines or of a line and the given circle. -/
inductive RGConstructible (O P : ℝ × ℝ) (S : Set (ℝ × ℝ)) : RCObj → Prop
  | init {x : ℝ × ℝ} : x ∈ S → RGConstructible O P S (.point x)
  | line {p q : ℝ × ℝ} : RGConstructible O P S (.point p) → RGConstructible O P S (.point q) → p ≠ q →
      RGConstructible O P S (.line p q)
  | lineLine {p q p' q' x : ℝ × ℝ} : RGConstructible O P S (.line p q) → RGConstructible O P S (.line p' q') →
      (q.1 - p.1) * (q'.2 - p'.2) - (q.2 - p.2) * (q'.1 - p'.1) ≠ 0 →
      OnLine p q x → OnLine p' q' x → RGConstructible O P S (.point x)
  | lineCircle {p q x : ℝ × ℝ} : RGConstructible O P S (.line p q) → OnLine p q x → OnCircle O P x →
      RGConstructible O P S (.point x)

/-- **Poncelet-Steiner theorem** (Petrunin, p. 164), the easy inclusion only: if the centre `O` and a point `P`
of the given circle are among the initial points, then every point constructed by the ruler alone together with
the given circle is constructed by ruler and compass. The hard inclusion (ruler and a given circle with its
centre construct everything ruler and compass do) is not formalized. -/
@[kb "petrunin2025" "Poncelet-Steiner theorem (easy inclusion), p. 164"]
theorem RGConstructible.rc {O P : ℝ × ℝ} {S : Set (ℝ × ℝ)} (hO : O ∈ S) (hP : P ∈ S) {o : RCObj}
    (h : RGConstructible O P S o) : RCConstructible S o := by
  induction h with
  | init hx => exact .init hx
  | line _ _ hpq ihp ihq => exact .line ihp ihq hpq
  | lineLine _ _ hdet hx hx' ih ih' => exact RCConstructible.lineLine ih ih' hdet hx hx'
  | lineCircle _ hx hc ih => exact RCConstructible.lineCircle ih (.circle (.init hO) (.init hP)) hx hc

end PonceletSteiner

end UndergradKB.Geometry
