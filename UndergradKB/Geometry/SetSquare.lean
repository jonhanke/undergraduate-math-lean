import Mathlib.NumberTheory.Fermat
import Mathlib.Tactic.NormNum.Prime
import Mathlib.Geometry.Euclidean.Angle.Oriented.Affine
import Mathlib.Geometry.Euclidean.Angle.Oriented.Rotation
import Mathlib.NumberTheory.Real.Irrational
import UndergradKB.Geometry.Constructible

/-! # Set-square constructions and regular polygons (Petrunin, chapter 19, Sections 19D-E and 19A-C)

* Theorem 19.11 and Exercise 19.12 (pp. 161): set-square constructions in coordinates `ℝ × ℝ`
  (`SSConstructible`), the "only if" direction of Theorem 19.11 (all constructed points have coordinates in any
  subfield containing the initial coordinates), the rational observation and the impossibility of the
  equilateral triangle on a base.
* Fermat primes (p. 158) and the definition of a regular `n`-gon inscribed in a circle (p. 158), with existence
  of regular `n`-gons in an oriented plane.
* Exercise 19.7 (p. 159): closure of constructible numbers under `ab`, `a/b`, `√(ab)` (algebraic version). -/

namespace UndergradKB.Geometry

open Real

/-! ### Set-square constructions -/

/-- Objects of a set-square construction: points and lines `p + t v` given by a point `p` and a direction
vector `v`. -/
inductive SSObj
  | point (x : ℝ × ℝ)
  | line (p v : ℝ × ℝ)

/-- `x` lies on the line through `p` with direction `v`. -/
def OnDir (p v x : ℝ × ℝ) : Prop := ∃ t : ℝ, x.1 = p.1 + t * v.1 ∧ x.2 = p.2 + t * v.2

/-- Set-square constructions from the initial points `S` (Petrunin, Section 19D, pp. 160-161): the set-square
is used as a ruler (the line through two distinct constructed points) and also produces the line through a
constructed point making the angle `π/2` or `±π/4` with a constructed line. Directions of the new lines are
the direction `v` of the old line rotated by `π/2`, `π/4`, `-π/4` (up to scaling): `(-v₂, v₁)`,
`(v₁ - v₂, v₁ + v₂)`, `(v₁ + v₂, v₂ - v₁)`. New points are intersections of two non-parallel constructed
lines. -/
inductive SSConstructible (S : Set (ℝ × ℝ)) : SSObj → Prop
  | init {x : ℝ × ℝ} : x ∈ S → SSConstructible S (.point x)
  | line {p q : ℝ × ℝ} : SSConstructible S (.point p) → SSConstructible S (.point q) → p ≠ q →
      SSConstructible S (.line p (q.1 - p.1, q.2 - p.2))
  | perp {p v x : ℝ × ℝ} : SSConstructible S (.line p v) → SSConstructible S (.point x) →
      SSConstructible S (.line x (-v.2, v.1))
  | diagPlus {p v x : ℝ × ℝ} : SSConstructible S (.line p v) → SSConstructible S (.point x) →
      SSConstructible S (.line x (v.1 - v.2, v.1 + v.2))
  | diagMinus {p v x : ℝ × ℝ} : SSConstructible S (.line p v) → SSConstructible S (.point x) →
      SSConstructible S (.line x (v.1 + v.2, v.2 - v.1))
  | inter {p v p' v' x : ℝ × ℝ} : SSConstructible S (.line p v) → SSConstructible S (.line p' v') →
      v.1 * v'.2 - v.2 * v'.1 ≠ 0 → OnDir p v x → OnDir p' v' x → SSConstructible S (.point x)

/-- **Theorem 19.11** (Petrunin, p. 161), the "only if" direction, for an arbitrary subfield `F` of `ℝ`
(the book's case is the subfield generated by the initial coordinates; every subfield contains the integers):
if all coordinates of the initial points lie in `F`, then so do the coordinates of every point constructed
with a set-square. The "if" direction is not formalized. -/
@[kb "petrunin2025" "Theorem 19.11 (only if), p. 161"]
theorem SSConstructible.coords {S : Set (ℝ × ℝ)} (F : Subfield ℝ) (hS : ∀ x ∈ S, x.1 ∈ F ∧ x.2 ∈ F)
    {x : ℝ × ℝ} (hx : SSConstructible S (.point x)) : x.1 ∈ F ∧ x.2 ∈ F := by
  let good : SSObj → Prop
    | .point x => x.1 ∈ F ∧ x.2 ∈ F
    | .line p v => (p.1 ∈ F ∧ p.2 ∈ F) ∧ (v.1 ∈ F ∧ v.2 ∈ F)
  suffices ∀ o, SSConstructible S o → good o from this _ hx
  intro o ho
  induction ho with
  | init hx => exact hS _ hx
  | line _ _ _ ihp ihq => exact ⟨ihp, F.sub_mem ihq.1 ihp.1, F.sub_mem ihq.2 ihp.2⟩
  | perp _ _ ih ihx => exact ⟨ihx, F.neg_mem ih.2.2, ih.2.1⟩
  | diagPlus _ _ ih ihx => exact ⟨ihx, F.sub_mem ih.2.1 ih.2.2, F.add_mem ih.2.1 ih.2.2⟩
  | diagMinus _ _ ih ihx => exact ⟨ihx, F.add_mem ih.2.1 ih.2.2, F.sub_mem ih.2.2 ih.2.1⟩
  | @inter p v p' v' x _ _ hdet hx hx' ih ih' =>
    obtain ⟨⟨hp1, hp2⟩, ⟨hv1, hv2⟩⟩ := ih
    obtain ⟨⟨hp1', hp2'⟩, ⟨hv1', hv2'⟩⟩ := ih'
    obtain ⟨t, ht1, ht2⟩ := hx
    obtain ⟨s, hs1, hs2⟩ := hx'
    have h1 : p.1 + t * v.1 = p'.1 + s * v'.1 := ht1.symm.trans hs1
    have h2 : p.2 + t * v.2 = p'.2 + s * v'.2 := ht2.symm.trans hs2
    have ht : t = ((p'.1 - p.1) * v'.2 - (p'.2 - p.2) * v'.1) / (v.1 * v'.2 - v.2 * v'.1) := by
      rw [eq_div_iff hdet]
      linear_combination v'.2 * h1 - v'.1 * h2
    have htF : t ∈ F := by
      rw [ht]
      exact F.div_mem (F.sub_mem (F.mul_mem (F.sub_mem hp1' hp1) hv2') (F.mul_mem (F.sub_mem hp2' hp2) hv1'))
        (F.sub_mem (F.mul_mem hv1 hv2') (F.mul_mem hv2 hv1'))
    exact ⟨by rw [ht1]; exact F.add_mem hp1 (F.mul_mem htF hv1),
      by rw [ht2]; exact F.add_mem hp2 (F.mul_mem htF hv2)⟩

/-- **Observation after Theorem 19.11** (Petrunin, p. 161): if all initial points are rational (coordinates in
the image of `ℚ`, the prime subfield of `ℝ`), then every point constructed with a set-square is rational. -/
@[kb "petrunin2025" "Observation after Theorem 19.11, p. 161"]
theorem SSConstructible.rational {S : Set (ℝ × ℝ)} (hS : ∀ x ∈ S, (∃ q : ℚ, (q : ℝ) = x.1) ∧ ∃ q : ℚ, (q : ℝ) = x.2)
    {x : ℝ × ℝ} (hx : SSConstructible S (.point x)) : (∃ q : ℚ, (q : ℝ) = x.1) ∧ ∃ q : ℚ, (q : ℝ) = x.2 :=
  SSConstructible.coords (Rat.castHom ℝ).fieldRange hS hx

/-- **Exercise 19.12** (Petrunin, p. 161): an equilateral triangle on the base `(0,0)`, `(1,0)` cannot be
constructed with a set-square: neither apex `(1/2, ±√3/2)` is a constructed point. -/
@[kb "petrunin2025" "Exercise 19.12, p. 161"]
theorem SSConstructible.not_equilateral {x : ℝ × ℝ} (hx : SSConstructible {(0, 0), (1, 0)} (.point x)) :
    x ≠ (1 / 2, √3 / 2) ∧ x ≠ (1 / 2, -(√3 / 2)) := by
  have hS : ∀ y ∈ ({(0, 0), (1, 0)} : Set (ℝ × ℝ)),
      (∃ q : ℚ, (q : ℝ) = y.1) ∧ ∃ q : ℚ, (q : ℝ) = y.2 := by
    rintro y (rfl | rfl)
    · exact ⟨⟨0, by simp⟩, ⟨0, by simp⟩⟩
    · exact ⟨⟨1, by simp⟩, ⟨0, by simp⟩⟩
  obtain ⟨-, q, hq⟩ := hx.rational hS
  have hirr : Irrational (√3) := by
    have := Nat.Prime.irrational_sqrt (p := 3) (by norm_num)
    simpa using this
  have key : x.2 = √3 / 2 ∨ x.2 = -(√3 / 2) → False := by
    intro h
    apply hirr
    rcases h with h | h
    · exact ⟨2 * q, by push_cast; rw [hq, h]; ring⟩
    · exact ⟨-(2 * q), by push_cast; rw [hq, h]; ring⟩
  constructor
  · rintro rfl; exact key (Or.inl rfl)
  · rintro rfl; exact key (Or.inr rfl)

/-! ### Fermat primes -/

/-- A Fermat prime (Petrunin, p. 158): a prime number of the form `2^k + 1`. -/
def IsFermatPrime (p : ℕ) : Prop := p.Prime ∧ ∃ k : ℕ, p = 2 ^ k + 1

/-- A prime Fermat number `Nat.fermatNumber n = 2^(2^n) + 1` is a Fermat prime. -/
theorem isFermatPrime_of_fermatNumber {n : ℕ} (h : (Nat.fermatNumber n).Prime) :
    IsFermatPrime (Nat.fermatNumber n) := ⟨h, 2 ^ n, rfl⟩

/-- The five known Fermat primes (Petrunin, p. 158): `3, 5, 17, 257, 65537`. -/
@[kb "petrunin2025" "Fermat primes, p. 158"]
theorem isFermatPrime_known :
    IsFermatPrime 3 ∧ IsFermatPrime 5 ∧ IsFermatPrime 17 ∧ IsFermatPrime 257 ∧ IsFermatPrime 65537 :=
  ⟨⟨by norm_num, 1, by norm_num⟩, ⟨by norm_num, 2, by norm_num⟩, ⟨by norm_num, 4, by norm_num⟩,
    ⟨by norm_num, 8, by norm_num⟩, ⟨by norm_num, 16, by norm_num⟩⟩

/-- The known Fermat primes are exactly the Fermat numbers `F₀, ..., F₄`. -/
theorem fermatNumber_values :
    Nat.fermatNumber 0 = 3 ∧ Nat.fermatNumber 1 = 5 ∧ Nat.fermatNumber 2 = 17 ∧ Nat.fermatNumber 3 = 257 ∧
      Nat.fermatNumber 4 = 65537 := by
  refine ⟨rfl, rfl, rfl, rfl, ?_⟩
  simp [Nat.fermatNumber]

/-! ### Regular polygons -/

section Polygon

variable {V P : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [MetricSpace P] [NormedAddTorsor V P]
  [Fact (Module.finrank ℝ V = 2)] [Module.Oriented ℝ V (Fin 2)]

open EuclideanGeometry

/-- A regular `n`-gon `A₀ ... A_{n-1}` inscribed in a circle with centre `O` (Petrunin, p. 158): the vertices
lie on a circle of positive radius `r` about `O`, and all the directed angles `∡ A_i O A_{i+1}` (indices
modulo `n`) are equal to `2π/n`, or all are equal to `-(2π/n)`. -/
def IsRegularNGon (n : ℕ) [NeZero n] (O : P) (A : Fin n → P) : Prop :=
  (∃ r : ℝ, 0 < r ∧ ∀ i, dist (A i) O = r) ∧
    ((∀ i, ∡ (A i) O (A (i + 1)) = ((2 * π / n : ℝ) : Real.Angle)) ∨
      ∀ i, ∡ (A i) O (A (i + 1)) = -((2 * π / n : ℝ) : Real.Angle))

omit [Fact (Module.finrank ℝ V = 2)] in
private lemma nsmul_mod {θ : Real.Angle} {n : ℕ} (h : n • θ = 0) (m : ℕ) : (m % n) • θ = m • θ := by
  conv_rhs => rw [← Nat.mod_add_div m n, add_smul, mul_comm, mul_smul, h, smul_zero, add_zero]

/-- A regular `n`-gon inscribed in a circle exists for every `n ≥ 3` (Petrunin, p. 158), through any vertex
`A₀ ≠ O`: rotate `A₀` about `O` by multiples of `2π/n`. -/
@[kb "petrunin2025" "Regular n-gon, p. 158"]
theorem exists_isRegularNGon (n : ℕ) [NeZero n] (hn : 3 ≤ n) (O A₀ : P) (h : A₀ ≠ O) :
    ∃ A : Fin n → P, IsRegularNGon n O A ∧ A ⟨0, Nat.pos_of_neZero n⟩ = A₀ := by
  set o : Orientation ℝ V (Fin 2) := Module.Oriented.positiveOrientation with ho
  set v : V := A₀ -ᵥ O with hv
  have hv0 : v ≠ 0 := by simpa [hv, vsub_eq_zero_iff_eq] using h
  set θ : Real.Angle := ((2 * π / n : ℝ) : Real.Angle) with hθ
  have hnθ : n • θ = 0 := by
    rw [hθ, ← Real.Angle.coe_nsmul]
    have hn0 : (n : ℝ) ≠ 0 := by positivity
    rw [show n • (2 * π / n : ℝ) = 2 * π by simp [nsmul_eq_mul]; field_simp]
    exact Real.Angle.coe_two_pi
  refine ⟨fun i => o.rotation ((i : ℕ) • θ) v +ᵥ O, ⟨⟨‖v‖, norm_pos_iff.mpr hv0, fun i => ?_⟩, Or.inl fun i => ?_⟩, ?_⟩
  · simp
  · have hi : (((i + 1 : Fin n) : ℕ)) = ((i : ℕ) + 1) % n := by
      rw [Fin.val_add, Fin.val_one', Nat.add_mod_mod]
    have hb : (((i + 1 : Fin n) : ℕ)) • θ = (i : ℕ) • θ + θ := by
      rw [hi, nsmul_mod hnθ, succ_nsmul]
    have e : o.rotation (((i + 1 : Fin n) : ℕ) • θ) v = o.rotation θ (o.rotation ((i : ℕ) • θ) v) := by
      rw [o.rotation_rotation, hb, add_comm]
    have hr : o.rotation ((i : ℕ) • θ) v ≠ 0 := by simpa using hv0
    show o.oangle ((o.rotation ((i : ℕ) • θ) v +ᵥ O) -ᵥ O)
      ((o.rotation (((i + 1 : Fin n) : ℕ) • θ) v +ᵥ O) -ᵥ O) = θ
    rw [vadd_vsub, vadd_vsub, e]
    exact o.oangle_rotation_self_right hr θ
  · simp [hv]

end Polygon

/-! ### Exercise 19.7 -/

/-- **Exercise 19.7** (Petrunin, p. 159), algebraic form: if `a` and `b` are constructible numbers (lengths
constructible from a unit segment), so are `a * b`, `a / b` and `√(a * b)`. This is the statement used by
the book in the proof of Theorem 19.8; here it is the closure property of `IsConstructible`, not the
geometric construction by similar right triangles in a semicircle. -/
@[kb "petrunin2025" "Exercise 19.7, p. 159"]
theorem isConstructible_mul_div_sqrt {a b : ℝ} (ha : IsConstructible a) (hb : IsConstructible b) :
    IsConstructible (a * b) ∧ IsConstructible (a / b) ∧ IsConstructible (√(a * b)) :=
  ⟨ha.mul hb, ha.div hb, (ha.mul hb).sqrt⟩

end UndergradKB.Geometry
