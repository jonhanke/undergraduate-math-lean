import UndergradKB.Common.Attr
import UndergradKB.RepresentationTheory.DehnInvariant

/-! # The Dehn invariant under the local changes made by a straight cut (Etingof et al., Problem 1.51 (a))

When a polyhedron `A` is cut by a plane into `B` and `C`, the edges of `B` and `C` arise from those of `A` by three
local changes:

* an edge of `A` crossed by the plane is split into two edges with the same dihedral angle and lengths adding up
  (`dehnInvariant_split_length`);
* an edge of `A` lying in the plane is shared by `B` and `C`, with dihedral angles adding up
  (`dehnInvariant_split_angle`);
* a new edge inside a face of `A` appears in both pieces with supplementary dihedral angles `θ` and `π - θ`
  (`dehnInvariant_supplementary`), or as two edges with total angle `π`.

Each change leaves the Dehn invariant (of the edge list, `dehnInvariant`) unchanged, and the invariant is additive
over the union of edge lists (`dehnInvariant_append`).  `DehnMove` is the relation generated by these changes and by
reordering edges; `dehnInvariant_eq_of_dehnMove` shows it preserves the invariant, so the cube and the regular
tetrahedron (with nonzero edge) are never related by such moves (`not_dehnMove_cube_tetrahedron`).

Not formalized: the geometric statement that cutting an actual polyhedron in `ℝ³` changes its edge list by these
moves (Mathlib has no theory of polyhedra with edges and dihedral angles), and hence the geometric form of (a) and
of (c).
-/

namespace UndergradKB.RepresentationTheory

open Real TensorProduct

theorem dehnInvariant_nil : dehnInvariant [] = 0 := rfl

theorem dehnInvariant_cons (e : ℝ × ℝ) (l : List (ℝ × ℝ)) :
    dehnInvariant (e :: l) = e.1 ⊗ₜ[ℚ] (ratSubspace.mkQ (e.2 / π)) + dehnInvariant l := by
  simp [dehnInvariant]

/-- The Dehn invariant is additive over the union of edge lists. -/
@[kb "etingof2011" "Problem 1.51, p. 19"]
theorem dehnInvariant_append (l l' : List (ℝ × ℝ)) :
    dehnInvariant (l ++ l') = dehnInvariant l + dehnInvariant l' := by
  simp [dehnInvariant, List.map_append, List.sum_append]

theorem dehnInvariant_perm {l l' : List (ℝ × ℝ)} (h : l.Perm l') : dehnInvariant l = dehnInvariant l' := by
  unfold dehnInvariant
  exact (h.map _).sum_eq

/-- Splitting an edge into two pieces with the same dihedral angle. -/
@[kb "etingof2011" "Problem 1.51, p. 19"]
theorem dehnInvariant_split_length (a b θ : ℝ) :
    dehnInvariant [(a + b, θ)] = dehnInvariant [(a, θ), (b, θ)] := by
  simp [dehnInvariant, add_tmul]

/-- Splitting the dihedral angle at an edge into two angles. -/
@[kb "etingof2011" "Problem 1.51, p. 19"]
theorem dehnInvariant_split_angle (a θ θ' : ℝ) :
    dehnInvariant [(a, θ + θ')] = dehnInvariant [(a, θ), (a, θ')] := by
  simp [dehnInvariant, add_div, ← tmul_add]

/-- An edge with dihedral angles `θ` and `π - θ` on the two sides contributes nothing in total. -/
@[kb "etingof2011" "Problem 1.51, p. 19"]
theorem dehnInvariant_supplementary (a θ : ℝ) : dehnInvariant [(a, θ), (a, π - θ)] = 0 := by
  have h : ratSubspace.mkQ (θ / π) + ratSubspace.mkQ ((π - θ) / π) = 0 := by
    rw [← map_add, show θ / π + (π - θ) / π = ((1 : ℚ) : ℝ) by field_simp [pi_ne_zero]; push_cast; ring]
    exact mkQ_rat 1
  simp only [dehnInvariant, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]
  rw [← tmul_add, h, tmul_zero]

/-- The moves on edge lists made by straight cuts: reordering, splitting an edge's length, splitting its dihedral
angle, inserting a pair of edges with supplementary angles, all inside a larger list. -/
inductive DehnMove : List (ℝ × ℝ) → List (ℝ × ℝ) → Prop
  | refl (l) : DehnMove l l
  | perm {l l'} : l.Perm l' → DehnMove l l'
  | splitLength (a b θ : ℝ) (l l' : List (ℝ × ℝ)) : DehnMove (l ++ (a + b, θ) :: l') (l ++ (a, θ) :: (b, θ) :: l')
  | splitAngle (a θ θ' : ℝ) (l l' : List (ℝ × ℝ)) :
      DehnMove (l ++ (a, θ + θ') :: l') (l ++ (a, θ) :: (a, θ') :: l')
  | supplementary (a θ : ℝ) (l l' : List (ℝ × ℝ)) : DehnMove (l ++ l') (l ++ (a, θ) :: (a, π - θ) :: l')
  | symm {l l'} : DehnMove l l' → DehnMove l' l
  | trans {l l' l''} : DehnMove l l' → DehnMove l' l'' → DehnMove l l''

/-- **Etingof et al., Problem 1.51 (a), algebraic part.**  The Dehn invariant is unchanged by the local moves of a
straight cut. -/
@[kb "etingof2011" "Problem 1.51, p. 19"]
theorem dehnInvariant_eq_of_dehnMove {l l' : List (ℝ × ℝ)} (h : DehnMove l l') :
    dehnInvariant l = dehnInvariant l' := by
  induction h with
  | refl => rfl
  | perm hp => exact dehnInvariant_perm hp
  | splitLength a b θ l l' =>
    rw [dehnInvariant_append, dehnInvariant_append, dehnInvariant_cons, dehnInvariant_cons, dehnInvariant_cons]
    have := dehnInvariant_split_length a b θ
    simp only [dehnInvariant_cons, dehnInvariant_nil, add_zero] at this
    rw [this]
    abel
  | splitAngle a θ θ' l l' =>
    rw [dehnInvariant_append, dehnInvariant_append, dehnInvariant_cons, dehnInvariant_cons, dehnInvariant_cons]
    have := dehnInvariant_split_angle a θ θ'
    simp only [dehnInvariant_cons, dehnInvariant_nil, add_zero] at this
    rw [this]
    abel
  | supplementary a θ l l' =>
    rw [dehnInvariant_append, dehnInvariant_append, dehnInvariant_cons, dehnInvariant_cons]
    have := dehnInvariant_supplementary a θ
    simp only [dehnInvariant_cons, dehnInvariant_nil, add_zero] at this
    simp only at this ⊢
    rw [← add_assoc (a ⊗ₜ[ℚ] _), this, zero_add]
  | symm _ ih => exact ih.symm
  | trans _ _ ih ih' => exact ih.trans ih'

/-- **Etingof et al., Problem 1.51 (c), on edge lists.**  The edge list of a cube is never related by cut moves to
that of a regular tetrahedron with nonzero edge. -/
@[kb "etingof2011" "Problem 1.51, p. 19"]
theorem not_dehnMove_cube_tetrahedron (a b : ℝ) (hb : b ≠ 0) : ¬ DehnMove (cubeEdges a) (tetrahedronEdges b) :=
  fun h => dehnInvariant_cube_ne_tetrahedron a b hb (dehnInvariant_eq_of_dehnMove h)

end UndergradKB.RepresentationTheory
