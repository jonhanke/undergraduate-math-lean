/-! # The `q`-Weyl algebra (Etingof et al., §1.7)

For a unit `q` of a commutative ring `k`, the `q`-Weyl algebra is the `k`-algebra generated by
`x, x⁻¹, y, y⁻¹` with `x x⁻¹ = x⁻¹ x = 1`, `y y⁻¹ = y⁻¹ y = 1` and `y x = q x y`.

* `QWeylAlgebra k q`: the presented algebra (a `RingQuot` of a free algebra); `qWeylLift` is its
  universal property; `qWeylXUnit`, `qWeylYUnit` are the generators as units.
* `qWeyl_span`: the monomials `xⁱ yʲ` (`i, j ∈ ℤ`) span.
* `qWeyl_linearIndependent`: they are linearly independent, for every unit `q` (no root-of-unity
  hypothesis is needed), proved via the faithful action on the free module with basis `ℤ × ℤ`.
* `qWeylBasis`: the resulting basis indexed by `ℤ × ℤ`.
-/

namespace UndergradKB.RepresentationTheory

section Group

variable {G : Type*} [Group G]

/-- If `y x = c x y` with `c` central, then `y xⁱ = cⁱ xⁱ y` for all integers `i`. -/
theorem zpow_comm_rule {X Y c : G} (hcX : Commute c X) (h : Y * X = c * (X * Y)) (i : ℤ) :
    Y * X ^ i = c ^ i * (X ^ i * Y) := by
  have h1 : Y * X * Y⁻¹ = c * X := by rw [h]; group
  have h2 := congrArg (fun g : G => g ^ i) h1
  simp only [conj_zpow, hcX.mul_zpow] at h2
  have h3 : Y * X ^ i = c ^ i * X ^ i * Y := (mul_inv_eq_iff_eq_mul).1 h2
  rw [h3, mul_assoc]

/-- The companion rule for `y⁻¹`. -/
theorem zpow_comm_rule_inv {X Y c : G} (hcX : Commute c X) (hcY : Commute c Y)
    (h : Y * X = c * (X * Y)) (i : ℤ) : Y⁻¹ * X ^ i = c⁻¹ ^ i * (X ^ i * Y⁻¹) := by
  have e : X * Y⁻¹ = c * (Y⁻¹ * X) := by
    calc X * Y⁻¹ = Y⁻¹ * (Y * X) * Y⁻¹ := by group
      _ = Y⁻¹ * (c * (X * Y)) * Y⁻¹ := by rw [h]
      _ = (Y⁻¹ * c) * X * (Y * Y⁻¹) := by group
      _ = c * (Y⁻¹ * X) := by rw [← hcY.inv_right.eq]; group
  have h' : Y⁻¹ * X = c⁻¹ * (X * Y⁻¹) := by
    rw [e, ← mul_assoc, inv_mul_cancel, one_mul]
  exact zpow_comm_rule (X := X) (Y := Y⁻¹) hcX.inv_left h' i

end Group

section Presentation

variable (k : Type*) [CommRing k] (q : kˣ)

/-- The defining relations of the `q`-Weyl algebra on the free algebra on `x = ι 0`, `x⁻¹ = ι 1`,
`y = ι 2`, `y⁻¹ = ι 3`. -/
inductive QWeylRel : FreeAlgebra k (Fin 4) → FreeAlgebra k (Fin 4) → Prop
  | xxi : QWeylRel (FreeAlgebra.ι k 0 * FreeAlgebra.ι k 1) 1
  | xix : QWeylRel (FreeAlgebra.ι k 1 * FreeAlgebra.ι k 0) 1
  | yyi : QWeylRel (FreeAlgebra.ι k 2 * FreeAlgebra.ι k 3) 1
  | yiy : QWeylRel (FreeAlgebra.ι k 3 * FreeAlgebra.ι k 2) 1
  | yx : QWeylRel (FreeAlgebra.ι k 2 * FreeAlgebra.ι k 0)
      ((q : k) • (FreeAlgebra.ι k 0 * FreeAlgebra.ι k 2))

/-- The `q`-Weyl algebra: generated by invertible `x` and `y` (with the inverses as generators)
subject to `y x = q x y`. -/
@[kb "etingof2011" "§1.7, p. 11"]
abbrev QWeylAlgebra : Type _ := RingQuot (QWeylRel k q)

/-- The generator `x`. -/
def qWeylX : QWeylAlgebra k q := RingQuot.mkAlgHom k (QWeylRel k q) (FreeAlgebra.ι k 0)
/-- The generator `x⁻¹`. -/
def qWeylXinv : QWeylAlgebra k q := RingQuot.mkAlgHom k (QWeylRel k q) (FreeAlgebra.ι k 1)
/-- The generator `y`. -/
def qWeylY : QWeylAlgebra k q := RingQuot.mkAlgHom k (QWeylRel k q) (FreeAlgebra.ι k 2)
/-- The generator `y⁻¹`. -/
def qWeylYinv : QWeylAlgebra k q := RingQuot.mkAlgHom k (QWeylRel k q) (FreeAlgebra.ι k 3)

variable {k q}

theorem qWeylX_mul_qWeylXinv : qWeylX k q * qWeylXinv k q = 1 := by
  simpa [qWeylX, qWeylXinv] using RingQuot.mkAlgHom_rel k (QWeylRel.xxi (k := k) (q := q))

theorem qWeylXinv_mul_qWeylX : qWeylXinv k q * qWeylX k q = 1 := by
  simpa [qWeylX, qWeylXinv] using RingQuot.mkAlgHom_rel k (QWeylRel.xix (k := k) (q := q))

theorem qWeylY_mul_qWeylYinv : qWeylY k q * qWeylYinv k q = 1 := by
  simpa [qWeylY, qWeylYinv] using RingQuot.mkAlgHom_rel k (QWeylRel.yyi (k := k) (q := q))

theorem qWeylYinv_mul_qWeylY : qWeylYinv k q * qWeylY k q = 1 := by
  simpa [qWeylY, qWeylYinv] using RingQuot.mkAlgHom_rel k (QWeylRel.yiy (k := k) (q := q))

/-- The defining relation `y x = q x y` of the `q`-Weyl algebra. -/
@[kb "etingof2011" "§1.7, p. 11"]
theorem qWeylY_mul_qWeylX : qWeylY k q * qWeylX k q = (q : k) • (qWeylX k q * qWeylY k q) := by
  simpa [qWeylX, qWeylY] using RingQuot.mkAlgHom_rel k (QWeylRel.yx (k := k) (q := q))

/-- The generator `x` as a unit of the `q`-Weyl algebra. -/
def qWeylXUnit : (QWeylAlgebra k q)ˣ :=
  ⟨qWeylX k q, qWeylXinv k q, qWeylX_mul_qWeylXinv, qWeylXinv_mul_qWeylX⟩

/-- The generator `y` as a unit of the `q`-Weyl algebra. -/
def qWeylYUnit : (QWeylAlgebra k q)ˣ :=
  ⟨qWeylY k q, qWeylYinv k q, qWeylY_mul_qWeylYinv, qWeylYinv_mul_qWeylY⟩

/-- Hypotheses for a quadruple in an algebra to satisfy the `q`-Weyl relations. -/
structure IsQWeylRel {A : Type*} [Ring A] [Algebra k A] (q : kˣ) (x xi y yi : A) : Prop where
  xxi : x * xi = 1
  xix : xi * x = 1
  yyi : y * yi = 1
  yiy : yi * y = 1
  yx : y * x = (q : k) • (x * y)

/-- Universal property: a quadruple satisfying the relations gives an algebra map out of the
`q`-Weyl algebra. -/
noncomputable def qWeylLift {A : Type*} [Ring A] [Algebra k A] {x xi y yi : A}
    (r : IsQWeylRel q x xi y yi) : QWeylAlgebra k q →ₐ[k] A :=
  RingQuot.liftAlgHom k ⟨FreeAlgebra.lift k ![x, xi, y, yi], by
    intro a b hab
    cases hab
    · simpa using r.xxi
    · simpa using r.xix
    · simpa using r.yyi
    · simpa using r.yiy
    · simpa using r.yx⟩

theorem qWeylLift_X {A : Type*} [Ring A] [Algebra k A] {x xi y yi : A}
    (r : IsQWeylRel q x xi y yi) : qWeylLift r (qWeylX k q) = x := by
  simp [qWeylLift, qWeylX]

theorem qWeylLift_Xinv {A : Type*} [Ring A] [Algebra k A] {x xi y yi : A}
    (r : IsQWeylRel q x xi y yi) : qWeylLift r (qWeylXinv k q) = xi := by
  simp [qWeylLift, qWeylXinv]

theorem qWeylLift_Y {A : Type*} [Ring A] [Algebra k A] {x xi y yi : A}
    (r : IsQWeylRel q x xi y yi) : qWeylLift r (qWeylY k q) = y := by
  simp [qWeylLift, qWeylY]

theorem qWeylLift_Yinv {A : Type*} [Ring A] [Algebra k A] {x xi y yi : A}
    (r : IsQWeylRel q x xi y yi) : qWeylLift r (qWeylYinv k q) = yi := by
  simp [qWeylLift, qWeylYinv]

end Presentation

section Span

variable {k : Type*} [CommRing k] {A : Type*} [Ring A] [Algebra k A]

/-- The span of the monomials `xⁱ yʲ` (`i, j ∈ ℤ`) for two units `x, y` of an algebra. -/
def qmonSpan (X Y : Aˣ) : Submodule k A :=
  Submodule.span k (Set.range fun p : ℤ × ℤ => ((X ^ p.1 * Y ^ p.2 : Aˣ) : A))

/-- The image of a unit of `k` as a (central) unit of `A`. -/
def scalarUnit (k : Type*) [CommRing k] {A : Type*} [Ring A] [Algebra k A] (z : kˣ) : Aˣ :=
  Units.map (algebraMap k A : k →* A) z

theorem scalarUnit_mul_coe (z : kˣ) (u : Aˣ) :
    ((scalarUnit k z * u : Aˣ) : A) = (z : k) • (u : A) := by
  simp [scalarUnit, Algebra.smul_def]

theorem scalarUnit_zpow (z : kˣ) (i : ℤ) : scalarUnit k (A := A) z ^ i = scalarUnit k (z ^ i) := by
  simp [scalarUnit]

theorem scalarUnit_inv (z : kˣ) : (scalarUnit k (A := A) z)⁻¹ = scalarUnit k z⁻¹ := by
  simp [scalarUnit]

theorem commute_scalarUnit (z : kˣ) (u : Aˣ) : Commute (scalarUnit k z) u :=
  Units.ext (by simp [scalarUnit, Algebra.commutes])

variable {q : kˣ} {X Y : Aˣ}

theorem scalarUnit_mul_mem (z : kˣ) (i j : ℤ) :
    ((scalarUnit k z * (X ^ i * Y ^ j) : Aˣ) : A) ∈ qmonSpan (k := k) X Y := by
  rw [scalarUnit_mul_coe]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(i, j), rfl⟩)

theorem unit_mul_mem_qmonSpan (u : Aˣ)
    (hu : ∀ i j : ℤ, ((u * (X ^ i * Y ^ j) : Aˣ) : A) ∈ qmonSpan (k := k) X Y)
    {s : A} (hs : s ∈ qmonSpan (k := k) X Y) : (u : A) * s ∈ qmonSpan (k := k) X Y := by
  have : qmonSpan (k := k) X Y ≤ (qmonSpan (k := k) X Y).comap (LinearMap.mulLeft k (u : A)) := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨⟨i, j⟩, rfl⟩
    exact hu i j
  exact this hs

variable (hXY : (Y : A) * X = (q : k) • ((X : A) * Y))
include hXY

theorem qmon_unit_rel : Y * X = scalarUnit k q * (X * Y) := by
  apply Units.ext
  rw [scalarUnit_mul_coe]
  simpa using hXY

omit hXY in
theorem x_mul_mem_qmonSpan {s : A} (hs : s ∈ qmonSpan (k := k) X Y) :
    (X : A) * s ∈ qmonSpan (k := k) X Y := by
  refine unit_mul_mem_qmonSpan X (fun i j => ?_) hs
  rw [← mul_assoc, ← zpow_one_add]
  exact Submodule.subset_span ⟨(1 + i, j), rfl⟩

omit hXY in
theorem xinv_mul_mem_qmonSpan {s : A} (hs : s ∈ qmonSpan (k := k) X Y) :
    ((X⁻¹ : Aˣ) : A) * s ∈ qmonSpan (k := k) X Y := by
  refine unit_mul_mem_qmonSpan X⁻¹ (fun i j => ?_) hs
  rw [← mul_assoc, ← zpow_neg_one, ← zpow_add]
  exact Submodule.subset_span ⟨(-1 + i, j), rfl⟩

theorem y_mul_mem_qmonSpan {s : A} (hs : s ∈ qmonSpan (k := k) X Y) :
    (Y : A) * s ∈ qmonSpan (k := k) X Y := by
  refine unit_mul_mem_qmonSpan Y (fun i j => ?_) hs
  have h1 := zpow_comm_rule (commute_scalarUnit (A := A) (k := k) q X) (qmon_unit_rel hXY) i
  have : Y * (X ^ i * Y ^ j) = scalarUnit k (q ^ i) * (X ^ i * Y ^ (1 + j)) := by
    rw [← mul_assoc, h1, ← scalarUnit_zpow, zpow_one_add]
    simp only [mul_assoc]
  rw [this]
  exact scalarUnit_mul_mem _ _ _

theorem yinv_mul_mem_qmonSpan {s : A} (hs : s ∈ qmonSpan (k := k) X Y) :
    ((Y⁻¹ : Aˣ) : A) * s ∈ qmonSpan (k := k) X Y := by
  refine unit_mul_mem_qmonSpan Y⁻¹ (fun i j => ?_) hs
  have h1 := zpow_comm_rule_inv (commute_scalarUnit (A := A) (k := k) q X)
    (commute_scalarUnit (A := A) (k := k) q Y) (qmon_unit_rel hXY) i
  have hY : Y⁻¹ * Y ^ j = Y ^ (-1 + j) := by rw [← zpow_neg_one, ← zpow_add]
  have : Y⁻¹ * (X ^ i * Y ^ j) = scalarUnit k (q⁻¹ ^ i) * (X ^ i * Y ^ (-1 + j)) := by
    rw [← mul_assoc, h1, ← scalarUnit_zpow, scalarUnit_inv]
    simp only [mul_assoc]
    rw [hY]
  rw [this]
  exact scalarUnit_mul_mem _ _ _

end Span

section SpanQWeyl

variable {k : Type*} [CommRing k] {q : kˣ}

/-- The monomial `xⁱ yʲ` (`i, j ∈ ℤ`) of the `q`-Weyl algebra. -/
def qWeylMon (k : Type*) [CommRing k] (q : kˣ) (i j : ℤ) : QWeylAlgebra k q :=
  ((qWeylXUnit ^ i * qWeylYUnit ^ j : (QWeylAlgebra k q)ˣ) : QWeylAlgebra k q)

theorem qWeylYUnit_mul_qWeylXUnit :
    ((qWeylYUnit : (QWeylAlgebra k q)ˣ) : QWeylAlgebra k q) * (qWeylXUnit : (QWeylAlgebra k q)ˣ) =
      (q : k) • (((qWeylXUnit : (QWeylAlgebra k q)ˣ) : QWeylAlgebra k q) *
        (qWeylYUnit : (QWeylAlgebra k q)ˣ)) :=
  qWeylY_mul_qWeylX

/-- The monomials `xⁱ yʲ` (`i, j ∈ ℤ`) span the `q`-Weyl algebra. -/
@[kb "etingof2011" "§1.7, p. 11"]
theorem qWeyl_span :
    Submodule.span k (Set.range fun p : ℤ × ℤ => qWeylMon k q p.1 p.2) = ⊤ := by
  have h := qWeylYUnit_mul_qWeylXUnit (k := k) (q := q)
  have key : ∀ a : FreeAlgebra k (Fin 4), ∀ s ∈ qmonSpan (k := k) (qWeylXUnit (k := k) (q := q))
        (qWeylYUnit (k := k) (q := q)),
      RingQuot.mkAlgHom k (QWeylRel k q) a * s ∈ qmonSpan (k := k) (qWeylXUnit (k := k) (q := q))
        (qWeylYUnit (k := k) (q := q)) := by
    intro a
    induction a using FreeAlgebra.induction with
    | grade0 r =>
      intro s hs
      rw [AlgHom.commutes, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
      exact Submodule.smul_mem _ _ hs
    | grade1 i =>
      intro s hs
      fin_cases i
      · exact x_mul_mem_qmonSpan hs
      · exact xinv_mul_mem_qmonSpan hs
      · exact y_mul_mem_qmonSpan h hs
      · exact yinv_mul_mem_qmonSpan h hs
    | mul a b ha hb =>
      intro s hs
      rw [map_mul, mul_assoc]
      exact ha _ (hb s hs)
    | add a b ha hb =>
      intro s hs
      rw [map_add, add_mul]
      exact Submodule.add_mem _ (ha s hs) (hb s hs)
  rw [eq_top_iff]
  rintro z -
  obtain ⟨a, rfl⟩ := RingQuot.mkAlgHom_surjective k (QWeylRel k q) z
  have h1 : (1 : QWeylAlgebra k q) ∈ qmonSpan (k := k) (qWeylXUnit (k := k) (q := q))
      (qWeylYUnit (k := k) (q := q)) := Submodule.subset_span ⟨(0, 0), by simp⟩
  have := key a 1 h1
  simpa [qmonSpan, qWeylMon] using this

end SpanQWeyl

section Rep

variable (k : Type*) [CommRing k] (q : kˣ)

/-- The free module on `ℤ × ℤ` (basis vectors `v_{a,b}` standing for `xᵃ yᵇ`), on which the
`q`-Weyl algebra acts faithfully. -/
abbrev QWeylModel : Type _ := (ℤ × ℤ) →₀ k

variable {k}

/-- The linear map sending `v_p` to `c p • v_{s p}`. -/
noncomputable def shiftOp (c : ℤ × ℤ → k) (s : ℤ × ℤ → ℤ × ℤ) : Module.End k (QWeylModel k) :=
  Finsupp.lsum k fun p => LinearMap.toSpanSingleton k (QWeylModel k) (Finsupp.single (s p) (c p))

theorem shiftOp_single (c : ℤ × ℤ → k) (s : ℤ × ℤ → ℤ × ℤ) (p : ℤ × ℤ) (r : k) :
    shiftOp c s (Finsupp.single p r) = Finsupp.single (s p) (r * c p) := by
  simp [shiftOp]

/-- `x v_{a,b} = v_{a+1,b}`. -/
noncomputable def opX : Module.End k (QWeylModel k) := shiftOp (fun _ => 1) fun p => (p.1 + 1, p.2)
/-- `x⁻¹ v_{a,b} = v_{a-1,b}`. -/
noncomputable def opXi : Module.End k (QWeylModel k) := shiftOp (fun _ => 1) fun p => (p.1 - 1, p.2)
/-- `y v_{a,b} = qᵃ v_{a,b+1}`. -/
noncomputable def opY : Module.End k (QWeylModel k) :=
  shiftOp (fun p => ((q ^ p.1 : kˣ) : k)) fun p => (p.1, p.2 + 1)
/-- `y⁻¹ v_{a,b} = q⁻ᵃ v_{a,b-1}`. -/
noncomputable def opYi : Module.End k (QWeylModel k) :=
  shiftOp (fun p => ((q⁻¹ ^ p.1 : kˣ) : k)) fun p => (p.1, p.2 - 1)

variable {q}

theorem isQWeylRel_ops : IsQWeylRel q (opX (k := k)) opXi (opY q) (opYi q) where
  xxi := by
    refine Finsupp.lhom_ext fun p r => ?_
    simp [opX, opXi, shiftOp_single]
  xix := by
    refine Finsupp.lhom_ext fun p r => ?_
    simp [opX, opXi, shiftOp_single]
  yyi := by
    refine Finsupp.lhom_ext fun p r => ?_
    simp [opY, opYi, shiftOp_single]
  yiy := by
    refine Finsupp.lhom_ext fun p r => ?_
    simp [opY, opYi, shiftOp_single]
  yx := by
    refine Finsupp.lhom_ext fun p r => ?_
    have key : ((q ^ (p.1 + 1) : kˣ) : k) = q * ((q ^ p.1 : kˣ) : k) := by
      rw [zpow_add_one, Units.val_mul, mul_comm]
    simp only [opX, opY, Module.End.mul_eq_comp, LinearMap.comp_apply, LinearMap.smul_apply,
      shiftOp_single, Finsupp.smul_single, smul_eq_mul, mul_one]
    rw [key]
    congr 1
    ring

variable (q) in
/-- `x` acting on the model, as a unit. -/
noncomputable def opXU : (Module.End k (QWeylModel k))ˣ :=
  ⟨opX, opXi, (isQWeylRel_ops (k := k) (q := q)).xxi, (isQWeylRel_ops (k := k) (q := q)).xix⟩

variable (q) in
/-- `y` acting on the model, as a unit. -/
noncomputable def opYU : (Module.End k (QWeylModel k))ˣ :=
  ⟨opY q, opYi q, (isQWeylRel_ops (k := k) (q := q)).yyi, (isQWeylRel_ops (k := k) (q := q)).yiy⟩

theorem opXU_zpow_single (i : ℤ) :
    ∀ (a b : ℤ) (r : k), ((opXU q ^ i : (Module.End k (QWeylModel k))ˣ) : Module.End k (QWeylModel k))
      (Finsupp.single (a, b) r) = Finsupp.single (a + i, b) r := by
  induction i using Int.induction_on with
  | zero => intro a b r; simp
  | succ i ih =>
    intro a b r
    rw [zpow_add_one, Units.val_mul, Module.End.mul_eq_comp, LinearMap.comp_apply]
    have h1 : ((opXU q : (Module.End k (QWeylModel k))ˣ) : Module.End k (QWeylModel k))
        (Finsupp.single (a, b) r) = Finsupp.single (a + 1, b) r := by
      show opX _ = _
      simp [opX, shiftOp_single]
    rw [h1, ih]
    have : a + 1 + (i : ℤ) = a + ((i : ℤ) + 1) := by ring
    rw [this]
  | pred i ih =>
    intro a b r
    rw [zpow_sub_one, Units.val_mul, Module.End.mul_eq_comp, LinearMap.comp_apply]
    have h1 : (((opXU q)⁻¹ : (Module.End k (QWeylModel k))ˣ) : Module.End k (QWeylModel k))
        (Finsupp.single (a, b) r) = Finsupp.single (a - 1, b) r := by
      show opXi _ = _
      simp [opXi, shiftOp_single]
    rw [h1, ih]
    have : a - 1 + (-(i : ℤ)) = a + (-(i : ℤ) - 1) := by ring
    rw [this]

theorem opYU_zpow_single (j : ℤ) :
    ∀ (b : ℤ) (r : k), ((opYU q ^ j : (Module.End k (QWeylModel k))ˣ) : Module.End k (QWeylModel k))
      (Finsupp.single (0, b) r) = Finsupp.single (0, b + j) r := by
  induction j using Int.induction_on with
  | zero => intro b r; simp
  | succ j ih =>
    intro b r
    rw [zpow_add_one, Units.val_mul, Module.End.mul_eq_comp, LinearMap.comp_apply]
    have h1 : ((opYU q : (Module.End k (QWeylModel k))ˣ) : Module.End k (QWeylModel k))
        (Finsupp.single (0, b) r) = Finsupp.single (0, b + 1) r := by
      show opY q _ = _
      simp [opY, shiftOp_single]
    rw [h1, ih]
    have : b + 1 + (j : ℤ) = b + ((j : ℤ) + 1) := by ring
    rw [this]
  | pred j ih =>
    intro b r
    rw [zpow_sub_one, Units.val_mul, Module.End.mul_eq_comp, LinearMap.comp_apply]
    have h1 : (((opYU q)⁻¹ : (Module.End k (QWeylModel k))ˣ) : Module.End k (QWeylModel k))
        (Finsupp.single (0, b) r) = Finsupp.single (0, b - 1) r := by
      show opYi q _ = _
      simp [opYi, shiftOp_single]
    rw [h1, ih]
    have : b - 1 + (-(j : ℤ)) = b + (-(j : ℤ) - 1) := by ring
    rw [this]

variable (q) in
/-- The faithful representation of the `q`-Weyl algebra on the free module with basis `ℤ × ℤ`. -/
noncomputable def qWeylRep : QWeylAlgebra k q →ₐ[k] Module.End k (QWeylModel k) :=
  qWeylLift (isQWeylRel_ops (k := k) (q := q))

theorem qWeylRep_mon_single (i j : ℤ) :
    qWeylRep q (qWeylMon k q i j) (Finsupp.single (0, 0) (1 : k)) = Finsupp.single (i, j) 1 := by
  have hX : Units.map (qWeylRep q).toMonoidHom (qWeylXUnit (k := k) (q := q)) = opXU q :=
    Units.ext (qWeylLift_X _)
  have hY : Units.map (qWeylRep q).toMonoidHom (qWeylYUnit (k := k) (q := q)) = opYU q :=
    Units.ext (qWeylLift_Y _)
  have h : Units.map (qWeylRep q).toMonoidHom
      ((qWeylXUnit (k := k) (q := q)) ^ i * (qWeylYUnit (k := k) (q := q)) ^ j) =
      opXU q ^ i * opYU q ^ j := by
    rw [map_mul, map_zpow, map_zpow, hX, hY]
  have h2 := congrArg (fun u : (Module.End k (QWeylModel k))ˣ => (u : Module.End k (QWeylModel k))) h
  simp only [Units.coe_map, AlgHom.toRingHom_eq_coe, Units.val_mul] at h2
  show (qWeylRep q) ((qWeylXUnit ^ i * qWeylYUnit ^ j : (QWeylAlgebra k q)ˣ) : QWeylAlgebra k q) _ = _
  rw [show (qWeylRep q) ((qWeylXUnit ^ i * qWeylYUnit ^ j : (QWeylAlgebra k q)ˣ) : QWeylAlgebra k q) =
    _ from h2]
  rw [Module.End.mul_eq_comp, LinearMap.comp_apply, opYU_zpow_single, opXU_zpow_single]
  simp

/-- The monomials `xⁱ yʲ` (`i, j ∈ ℤ`) are linearly independent in the `q`-Weyl algebra, for every
unit `q` of the base ring. -/
@[kb "etingof2011" "§1.7, p. 11"]
theorem qWeyl_linearIndependent :
    LinearIndependent k (fun p : ℤ × ℤ => qWeylMon k q p.1 p.2) := by
  refine LinearIndependent.of_comp
    ((LinearMap.applyₗ (Finsupp.single ((0 : ℤ), (0 : ℤ)) (1 : k))) ∘ₗ
      (qWeylRep q).toLinearMap) ?_
  have : (((LinearMap.applyₗ (Finsupp.single ((0 : ℤ), (0 : ℤ)) (1 : k))) ∘ₗ
      (qWeylRep q).toLinearMap) ∘ fun p : ℤ × ℤ => qWeylMon k q p.1 p.2) =
      fun p => Finsupp.single p (1 : k) := by
    funext p
    exact qWeylRep_mon_single p.1 p.2
  rw [this]
  exact (Finsupp.basisSingleOne (R := k) (ι := ℤ × ℤ)).linearIndependent

/-- The monomials `xⁱ yʲ` (`i, j ∈ ℤ`) form a basis of the `q`-Weyl algebra, for every unit `q`. -/
@[kb "etingof2011" "§1.7, p. 11"]
noncomputable def qWeylBasis : Module.Basis (ℤ × ℤ) k (QWeylAlgebra k q) :=
  Module.Basis.mk qWeyl_linearIndependent qWeyl_span.ge

theorem qWeylBasis_apply (p : ℤ × ℤ) : qWeylBasis (k := k) (q := q) p = qWeylMon k q p.1 p.2 := by
  simp [qWeylBasis]

