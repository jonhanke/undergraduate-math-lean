/-!
# Etingof et al., Introduction to Representation Theory: problems formalized in wave 3 (second part)

Course names for the book problems proved in this library in the second session of wave 3, tagged with the source key
`etingof2011` and the locator of the problem.  Each is the repository theorem under the book's numbering (an alias:
same statement).
-/

namespace UndergradKB.RepresentationTheory.Course

open UndergradKB.RepresentationTheory

/-- Etingof et al., Problem 1.26 (a): in characteristic zero every nonzero two-sided ideal of the Weyl algebra is the
whole algebra. -/
@[kb "etingof2011" "Problem 1.26, p. 12"]
alias etingof_1_26_a' := weyl_ideal_eq_top

/-- Etingof et al., Problem 1.26 (b): in characteristic `p` the centre of the Weyl algebra is generated by `x^p` and
`y^p`. -/
@[kb "etingof2011" "Problem 1.26, p. 12"]
alias etingof_1_26_b := weyl_center_eq_adjoin

/-- Etingof et al., Problem 1.26 (c): over an algebraically closed field of characteristic `p`, every irreducible
finite-dimensional representation of the Weyl algebra is isomorphic to one of the `p`-dimensional models. -/
@[kb "etingof2011" "Problem 1.26, p. 12"]
alias etingof_1_26_c := weyl_irrep_iso

/-- Etingof et al., Problem 1.26 (c): the `p`-dimensional models are irreducible. -/
@[kb "etingof2011" "Problem 1.26, p. 12"]
alias etingof_1_26_c' := weylRepP_irreducible

/-- Etingof et al., Problem 1.57: in characteristic `p` the irreducible representations of the two-dimensional
non-abelian Lie algebra are one-dimensional or `p`-dimensional. -/
@[kb "etingof2011" "Problem 1.57, p. 22"]
alias etingof_1_57_p := aff1_irrep_char_p_classification

/-- Etingof et al., Problem 1.57: Lie's theorem fails in characteristic `p`. -/
@[kb "etingof2011" "Problem 1.57, p. 22"]
alias etingof_1_57_p' := aff1_lie_theorem_fails

/-- Etingof et al., Problem 2.22 (a): `Ext¹(V_a, V_b) = 0` for `a ≠ b`. -/
@[kb "etingof2011" "Problem 2.22, p. 30"]
alias etingof_2_22_a := ext_charRep_ne

/-- Etingof et al., Problem 2.22 (a): `Ext¹(V_a, V_a) ≅ kⁿ`. -/
@[kb "etingof2011" "Problem 2.22, p. 30"]
alias etingof_2_22_a' := ext_charRep_eq

/-- Etingof et al., Problem 2.22 (a): the two-dimensional representations of `ℂ[x_1, …, x_n]`. -/
@[kb "etingof2011" "Problem 2.22, p. 30"]
alias etingof_2_22_a'' := twoDim_classification

/-- Etingof et al., Problem 2.22 (b): infinitely many non-isomorphic indecomposable representations of the algebra
with `x_i x_j = 0`. -/
@[kb "etingof2011" "Problem 2.22, p. 30"]
alias etingof_2_22_b := infinitely_many_indecomposable

/-- Etingof et al., Problem 2.23: the two-dimensional representations of a quiver without oriented cycles. -/
@[kb "etingof2011" "Problem 2.23, p. 30"]
alias etingof_2_23'' := QRep.twoDim_quiver_classification

/-- Etingof et al., Problem 3.26: every irreducible representation occurs in a symmetric power of a faithful one. -/
@[kb "etingof2011" "Problem 3.26, p. 45"]
alias etingof_3_26_sym := exists_injective_intertwining_symPower

/-- Etingof et al., Problem 4.15 (b): an irreducible character of degree greater than one vanishes somewhere. -/
@[kb "etingof2011" "Problem 4.15, p. 51"]
alias etingof_4_15_b := exists_character_eq_zero_of_one_lt_finrank

/-- Etingof et al., Problem 5.41 (a): `Ext¹(V, S_i) = 0` at a source. -/
@[kb "etingof2011" "Problem 5.41, p. 97"]
alias etingof_5_41_a := QRep.subsingleton_qExt_source

/-- Etingof et al., Problem 5.41 (a): `Ext¹(S_i, V) = 0` at a sink. -/
@[kb "etingof2011" "Problem 5.41, p. 97"]
alias etingof_5_41_a' := QRep.subsingleton_qExt_sink

/-- Etingof et al., Problem 3.23 (a): `ℂ²` is irreducible as a real representation of `SU(2)`. -/
@[kb "etingof2011" "Problem 3.23, p. 44"]
alias etingof_3_23_a := su2_real_irreducible

/-- Etingof et al., Problem 3.23 (b), (c): the real commutant of `SU(2)` on `ℂ²` is the quaternion algebra. -/
@[kb "etingof2011" "Problem 3.23, p. 44"]
noncomputable abbrev etingof_3_23_c := su2Commutant_algEquiv

/-- Etingof et al., Problem 3.23 (e): the unit quaternions form a group isomorphic to `SU(2)`. -/
@[kb "etingof2011" "Problem 3.23, p. 44"]
noncomputable abbrev etingof_3_23_e := unitaryQuatEquivSU2

/-- Etingof et al., Problem 3.23 (f): the homomorphism `SU(2) → SO(3)` is surjective. -/
@[kb "etingof2011" "Problem 3.23, p. 44"]
alias etingof_3_23_f := rotSU2_surjective

/-- Etingof et al., Problem 3.23 (f): its kernel is `{1, -1}`. -/
@[kb "etingof2011" "Problem 3.23, p. 44"]
alias etingof_3_23_f' := rotSU2_eq_one_iff

/-- Etingof et al., Problem 1.27 (a): if `q` is not a root of unity, the q-Weyl algebra is simple. -/
@[kb "etingof2011" "Problem 1.27, p. 13"]
alias etingof_1_27_a := qweyl_isSimpleRing

/-- Etingof et al., Problem 1.27 (a): at a root of unity of order `m` the centre is generated by `x^{±m}`, `y^{±m}`. -/
@[kb "etingof2011" "Problem 1.27, p. 13"]
alias etingof_1_27_a' := qweyl_center_eq_adjoin

/-- Etingof et al., Problem 1.27 (c): every irreducible finite-dimensional representation is one of the explicit
`m`-dimensional models. -/
@[kb "etingof2011" "Problem 1.27, p. 13"]
alias etingof_1_27_c := qweyl_irrep_iso

/-- Etingof et al., Problem 4.1 (a): for quaternionic type the real equivariant endomorphisms form the quaternions
(the complex and real cases are `RealType.realEnd_algEquiv_of_isComplexType`, `..._of_isRealType`). -/
@[kb "etingof2011" "Problem 4.1, p. 47"]
alias etingof_4_1_a := RealType.realEnd_algEquiv_of_isQuaternionicType

/-- Etingof et al., Problem 4.1 (b): real type iff the representation has a real form. -/
@[kb "etingof2011" "Problem 4.1, p. 47"]
alias etingof_4_1_b := RealType.isRealType_iff_exists_realForm

/-- Etingof et al., Problem 5.40 (b): the Gram matrix of the simple roots of `L` is the `E8` Cartan matrix. -/
@[kb "etingof2011" "Problem 5.40, p. 97"]
alias etingof_5_40_b := e8Simple_gram

/-- Etingof et al., Problem 5.40 (d): `E8` has 240 roots. -/
@[kb "etingof2011" "Problem 5.40, p. 97"]
alias etingof_5_40_d := E8Root_ncard

/-- Etingof et al., Problem 5.40 (d): `E7` has 126 roots. -/
@[kb "etingof2011" "Problem 5.40, p. 97"]
alias etingof_5_40_d' := E7Root_ncard

/-- Etingof et al., Problem 5.40 (d): `E6` has 72 roots. -/
@[kb "etingof2011" "Problem 5.40, p. 97"]
alias etingof_5_40_d'' := E6Root_ncard

/-- Etingof et al., Problem 4.50 (a): restriction of `V_μ` to `S_{n-1}` is the sum over removed boxes. -/
@[kb "etingof2011" "Problem 4.50, p. 63"]
alias etingof_4_50_a := Branching.restrict_spechtChar

/-- Etingof et al., Problem 4.50 (b): induction of `V_λ` to `S_{n+1}` is the sum over added boxes. -/
@[kb "etingof2011" "Problem 4.50, p. 63"]
alias etingof_4_50_b := Branching.induce_spechtChar

/-- Etingof et al., Problem 4.34 (d): the representation of `A5` induced from the 3-dimensional irreducible
representation of `A4` has character `χ_4 + χ_5 + χ_3 + χ_3'`. -/
@[kb "etingof2011" "Problem 4.34, p. 57"]
alias etingof_4_34_d := A5Induced.ind_A4_threeDim

/-- Etingof et al., Problem 1.38 (a): the degree-`d` part of `k[x_1, …, x_m]` has dimension `C(m+d-1, d)`. -/
@[kb "etingof2011" "Problem 1.38, p. 14"]
alias etingof_1_38_a := finrank_homogeneousSubmodule

/-- Etingof et al., Problem 1.38 (b): the degree-`d` part of the free algebra on `m` generators has dimension `m^d`. -/
@[kb "etingof2011" "Problem 1.38, p. 14"]
alias etingof_1_38_b := finrank_tensorPower_fin

/-- Etingof et al., Problem 1.38 (c): the degree-`d` part of the exterior algebra has dimension `C(m, d)`. -/
@[kb "etingof2011" "Problem 1.38, p. 14"]
alias etingof_1_38_c := finrank_exteriorPower_fin

/-- Etingof et al., Problem 1.38 (d): paths of length `d` are counted by powers of the adjacency matrix. -/
@[kb "etingof2011" "Problem 1.38, p. 14"]
alias etingof_1_38_d := card_pathsOfLength

/-- Etingof et al., Problem 4.15 (a): all representations of a finite group are realised over one finite Galois
extension of `ℚ`. -/
@[kb "etingof2011" "Problem 4.15, p. 51"]
alias etingof_4_15_a := exists_galois_realization_field

/-- Etingof et al., Problem 3.24 (a): a finite rotation group is cyclic, dihedral, A4, S4 or A5. -/
@[kb "etingof2011" "Problem 3.24, p. 44"]
alias etingof_3_24_a := FiniteRotations.finite_subgroup_SO3_classification_full

/-- Etingof et al., Problem 3.27 (b): an `SO(3)`-equivariant linear elasticity law has two parameters `K`, `μ`. -/
@[kb "etingof2011" "Problem 3.27, p. 45"]
alias etingof_3_27 := Elasticity.classification

/-- Etingof et al., Problem 4.51: the sum of all transpositions acts on `V_λ` by the content `c(λ)`. -/
@[kb "etingof2011" "Problem 4.51, p. 63"]
alias etingof_4_51 := transpositionSum_spechtIrrRep

/-- Etingof et al., Problem 5.39 (a): the four families of representations of the cyclic quiver with two vertices
are indecomposable. -/
@[kb "etingof2011" "Problem 5.39, p. 96"]
alias etingof_5_39_a := CQParam.rep_indec

/-- Etingof et al., Problem 5.39 (a): and pairwise non-isomorphic. -/
@[kb "etingof2011" "Problem 5.39, p. 96"]
alias etingof_5_39_a' := CQParam.rep_noniso

/-- Etingof et al., Problem 5.39 (c): every indecomposable representation of the cyclic quiver with two vertices is
isomorphic to exactly one of the four families. -/
@[kb "etingof2011" "Problem 5.39, p. 96"]
alias etingof_5_39_c := cq_classification

/-- Etingof et al., Problem 4.52 (a): `(1 2) + ⋯ + (1 n)` is diagonalizable with integer eigenvalues in
`[1 - n, n - 1]` on every finite-dimensional representation of `S_n` (`n ≥ 3`). -/
@[kb "etingof2011" "Problem 4.52, p. 63"]
alias etingof_4_52_a := Content.jmElt_eigenbasis

/-- Etingof et al., Problem 4.52 (b): it acts on `V_λ` by a scalar iff `λ` is a rectangle. -/
@[kb "etingof2011" "Problem 4.52, p. 63"]
alias etingof_4_52_b := Content.jmOp_scalar_iff_isRect

/-- Etingof et al., Problem 5.41 (b): a composition series with simple factors counted by the dimension vector. -/
@[kb "etingof2011" "Problem 5.41, p. 97"]
alias etingof_5_41_b := QRep.jordanHolder

/-- Etingof et al., Problem 1.58 (a): `g_3` is six-dimensional (`g_1`, `g_2`: `serre1_finrank`, `serre2_finrank`). -/
@[kb "etingof2011" "Problem 1.58, p. 22"]
alias etingof_1_58_a := serre3_finrank

/-- Etingof et al., Problem 1.58 (b): `g_4` is infinite-dimensional. -/
@[kb "etingof2011" "Problem 1.58, p. 22"]
alias etingof_1_58_b := serre4_not_finite

/-- Etingof et al., Problem 4.69: conjugation-invariant polynomials on tuples of matrices are generated by traces of
words. -/
@[kb "etingof2011" "Problem 4.69, p. 68"]
alias etingof_4_69 := MatrixInv.invMv_eq_adjoin_traceMv

end UndergradKB.RepresentationTheory.Course
