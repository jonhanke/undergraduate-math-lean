import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.Algebra.MvPolynomial.Funext
import UndergradKB.Common.Attr
import UndergradKB.RepresentationTheory.ProblemsMatrixInvariants

/-! # Problem 4.69, continued: the invariants `T_σ` lie in the algebra generated by traces of words

* `evalWord Y w = Y_{w_1} ⋯ Y_{w_r}`, `wordTrace w Y = tr (evalWord Y w)`, `traceAlg N k` the subalgebra of
  functions `(Fin k → M_N(ℂ)) → ℂ` generated by the `wordTrace w`.
* `Tperm_decompose_fixed`, `Tperm_decompose_merge`: a permutation of `Fin (n+1)` is `decomposeFin.symm (p, σ')`;
  if `p = 0` then `T_σ(X) = tr(X₀) T_{σ'}(X₁,…)`; if `p = q+1` then `T_σ(X) = T_{σ'}(X')` where `X'` is obtained
  from `(X₁,…)` by replacing `X_{σ'⁻¹ q + 1}` by `X₀ X_{σ'⁻¹ q + 1}` (merging the point `0` into its cycle).
* `Tperm_word_mem`: hence `Y ↦ T_σ(w₁(Y), …, w_n(Y))` (any words `w_l`) lies in `traceAlg N k`; in particular for
  `X_l = Y_{c(l)}` (cycle-product form of the first fundamental theorem).
-/

namespace UndergradKB.RepresentationTheory

open Finset PiTensorProduct
open scoped Classical TensorProduct

namespace MatrixInv

variable {N k n : ℕ}

/-- Product of the matrices `Y_{w_1} ⋯ Y_{w_r}`. -/
def evalWord (Y : Fin k → Matrix (Fin N) (Fin N) ℂ) (w : List (Fin k)) : Matrix (Fin N) (Fin N) ℂ :=
  (w.map Y).prod

@[simp] theorem evalWord_append (Y : Fin k → Matrix (Fin N) (Fin N) ℂ) (u v : List (Fin k)) :
    evalWord Y (u ++ v) = evalWord Y u * evalWord Y v := by
  simp [evalWord]

/-- The trace function `Y ↦ tr (Y_{w_1} ⋯ Y_{w_r})`. -/
noncomputable def wordTrace (N : ℕ) (w : List (Fin k)) : (Fin k → Matrix (Fin N) (Fin N) ℂ) → ℂ :=
  fun Y => Matrix.trace (evalWord Y w)

variable (N k) in
/-- The algebra of functions on `k`-tuples of `N × N` matrices generated by the traces of words. -/
noncomputable def traceAlg : Subalgebra ℂ ((Fin k → Matrix (Fin N) (Fin N) ℂ) → ℂ) :=
  Algebra.adjoin ℂ (Set.range (wordTrace N : List (Fin k) → _))

theorem wordTrace_mem (w : List (Fin k)) : wordTrace N w ∈ traceAlg N k :=
  Algebra.subset_adjoin ⟨w, rfl⟩

/-- Splitting off the value at `0`. -/
theorem sum_split_zero {M : Type*} [AddCommMonoid M] (F : (Fin (n + 1) → Fin N) → M) :
    ∑ I, F I = ∑ i₀ : Fin N, ∑ J : Fin n → Fin N, F (Fin.cons i₀ J) := by
  rw [← Fintype.sum_prod_type' (f := fun i₀ J => F (Fin.cons i₀ J))]
  exact (Fintype.sum_equiv (Fin.consEquiv (fun _ : Fin (n + 1) => Fin N)) _ _ (fun _ => rfl)).symm

/-- If `σ` fixes `0` (`p = 0`) the point `0` contributes the factor `tr X₀`. -/
theorem Tperm_decompose_fixed (σ' : Equiv.Perm (Fin n)) (X : Fin (n + 1) → Matrix (Fin N) (Fin N) ℂ) :
    Tperm (Equiv.Perm.decomposeFin.symm (0, σ')) X =
      Matrix.trace (X 0) * Tperm σ' (fun i => X i.succ) := by
  unfold Tperm
  rw [sum_split_zero, Matrix.trace, Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun i₀ _ => Finset.sum_congr rfl fun J _ => ?_
  rw [Fin.prod_univ_succ]
  simp [Equiv.Perm.decomposeFin_symm_apply_zero, Equiv.Perm.decomposeFin_symm_apply_succ]

/-- If `σ 0 = q + 1`, the point `0` is merged into its cycle. -/
theorem Tperm_decompose_merge (σ' : Equiv.Perm (Fin n)) (q : Fin n)
    (X : Fin (n + 1) → Matrix (Fin N) (Fin N) ℂ) :
    Tperm (Equiv.Perm.decomposeFin.symm (q.succ, σ')) X =
      Tperm σ' (fun i => if i = σ'.symm q then X 0 * X i.succ else X i.succ) := by
  unfold Tperm
  rw [sum_split_zero, Finset.sum_comm]
  refine Finset.sum_congr rfl fun J _ => ?_
  set a' := σ'.symm q with ha'
  have hσa : σ' a' = q := by simp [ha']
  have hswap : ∀ j : Fin n, Equiv.swap (0 : Fin (n + 1)) q.succ j.succ = if j = q then 0 else j.succ := by
    intro j
    by_cases hj : j = q
    · subst hj; simp
    · rw [if_neg hj]
      exact Equiv.swap_apply_of_ne_of_ne (Fin.succ_ne_zero j) (fun h => hj (Fin.succ_injective _ h))
  have hterm : ∀ i₀ : Fin N,
      ∏ l, X l ((Fin.cons i₀ J : Fin (n + 1) → Fin N) (Equiv.Perm.decomposeFin.symm (q.succ, σ') l))
        ((Fin.cons i₀ J : Fin (n + 1) → Fin N) l) =
      X 0 (J q) i₀ * (X a'.succ i₀ (J a') * ∏ i ∈ Finset.univ.erase a', X i.succ (J (σ' i)) (J i)) := by
    intro i₀
    rw [Fin.prod_univ_succ]
    simp only [Equiv.Perm.decomposeFin_symm_apply_zero, Equiv.Perm.decomposeFin_symm_apply_succ, hswap,
      Fin.cons_zero, Fin.cons_succ]
    congr 1
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ a')]
    congr 1
    · have : σ' a' = q := hσa
      simp [this]
    · refine Finset.prod_congr rfl fun i hi => ?_
      have hi' : σ' i ≠ q := fun h => (Finset.mem_erase.mp hi).1 (by
        have := congrArg σ'.symm h
        simpa [ha'] using this)
      simp [hi']
  rw [Finset.sum_congr rfl (fun i₀ _ => hterm i₀)]
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ a')]
  have hR : ∏ i ∈ Finset.univ.erase a',
      (fun i => if i = σ'.symm q then X 0 * X i.succ else X i.succ) i (J (σ' i)) (J i) =
      ∏ i ∈ Finset.univ.erase a', X i.succ (J (σ' i)) (J i) := by
    refine Finset.prod_congr rfl fun i hi => ?_
    have hne : i ≠ σ'.symm q := (Finset.mem_erase.mp hi).1
    simp [hne]
  rw [hR]
  have hL : ∑ i₀ : Fin N, X 0 (J q) i₀ * (X a'.succ i₀ (J a') *
      ∏ i ∈ Finset.univ.erase a', X i.succ (J (σ' i)) (J i)) =
      (X 0 * X a'.succ) (J q) (J a') * ∏ i ∈ Finset.univ.erase a', X i.succ (J (σ' i)) (J i) := by
    rw [Matrix.mul_apply, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i₀ _ => ?_
    ring
  rw [hL]
  simp [hσa, ha']

/-- **Cycle-product form (membership version)**: for any words `w_l`, the function
`Y ↦ T_σ(w₁(Y), …, w_n(Y))` lies in the algebra generated by the traces of words. -/
theorem Tperm_word_mem : ∀ (n : ℕ) (σ : Equiv.Perm (Fin n)) (w : Fin n → List (Fin k)),
    (fun Y : Fin k → Matrix (Fin N) (Fin N) ℂ => Tperm σ (fun l => evalWord Y (w l))) ∈ traceAlg N k := by
  intro n
  induction n with
  | zero =>
    intro σ w
    have : (fun Y : Fin k → Matrix (Fin N) (Fin N) ℂ => Tperm σ (fun l => evalWord Y (w l))) = 1 := by
      funext Y
      simp [Tperm]
    rw [this]
    exact (traceAlg N k).one_mem
  | succ n ih =>
    intro σ w
    obtain ⟨⟨p, σ'⟩, hσ⟩ : ∃ x : Fin (n + 1) × Equiv.Perm (Fin n), Equiv.Perm.decomposeFin.symm x = σ :=
      ⟨Equiv.Perm.decomposeFin σ, by simp⟩
    subst hσ
    refine Fin.cases ?_ (fun q => ?_) p
    · have : (fun Y : Fin k → Matrix (Fin N) (Fin N) ℂ =>
          Tperm (Equiv.Perm.decomposeFin.symm (0, σ')) (fun l => evalWord Y (w l))) =
          wordTrace N (w 0) * (fun Y => Tperm σ' (fun i => evalWord Y (w i.succ))) := by
        funext Y
        rw [Tperm_decompose_fixed]
        rfl
      rw [this]
      exact (traceAlg N k).mul_mem (wordTrace_mem _) (ih σ' (fun i => w i.succ))
    · have : (fun Y : Fin k → Matrix (Fin N) (Fin N) ℂ =>
          Tperm (Equiv.Perm.decomposeFin.symm (q.succ, σ')) (fun l => evalWord Y (w l))) =
          fun Y => Tperm σ' (fun i => evalWord Y
            (if i = σ'.symm q then w 0 ++ w i.succ else w i.succ)) := by
        funext Y
        rw [Tperm_decompose_merge]
        congr 1
        funext i
        by_cases h : i = σ'.symm q
        · simp [h]
        · simp [h]
      rw [this]
      exact ih σ' _

/-- **Cycle-product form for colourings**: for `c : Fin n → Fin k`, the function
`Y ↦ T_σ(Y_{c(1)}, …, Y_{c(n)})` lies in the algebra generated by the traces of words in `Y₁, …, Y_k`. -/
@[kb "etingof2011" "Problem 4.69, p. 68"]
theorem Tperm_colouring_mem (σ : Equiv.Perm (Fin n)) (c : Fin n → Fin k) :
    (fun Y : Fin k → Matrix (Fin N) (Fin N) ℂ => Tperm σ (fun l => Y (c l))) ∈ traceAlg N k := by
  have := Tperm_word_mem (N := N) (k := k) n σ (fun l => [c l])
  simpa [evalWord] using this

/-! ### Polynomial functions of degree `n` and polarization -/

variable (N k) in
/-- The space `U = M_N(ℂ)^k` of `k`-tuples of matrices. -/
abbrev UU := Fin k → Matrix (Fin N) (Fin N) ℂ

variable (N k) in
/-- The coordinate function `Y ↦ (Y_i)_{ab}` as a linear functional on `U`. -/
def coordLin (s : Fin k × Fin N × Fin N) : UU N k →ₗ[ℂ] ℂ where
  toFun Y := Y s.1 s.2.1 s.2.2
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

variable (N k) in
/-- The homogeneous polynomial functions of degree `n` on `U`: the span of the products of `n` coordinates. -/
def polyFun (n : ℕ) : Submodule ℂ (UU N k → ℂ) :=
  Submodule.span ℂ (Set.range fun s : Fin n → Fin k × Fin N × Fin N =>
    fun Y : UU N k => ∏ j, coordLin N k (s j) Y)

theorem coord_mul_mem (s : Fin k × Fin N × Fin N) {f : UU N k → ℂ} (hf : f ∈ polyFun N k n) :
    (fun Y => coordLin N k s Y * f Y) ∈ polyFun N k (n + 1) := by
  induction hf using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨t, rfl⟩ := hx
    refine Submodule.subset_span ⟨Fin.cons s t, ?_⟩
    funext Y
    simp [Fin.prod_univ_succ]
  | zero =>
    have := (polyFun N k (n + 1)).zero_mem
    convert this using 1
    funext Y
    simp
  | add x y _ _ hx hy =>
    have := Submodule.add_mem _ hx hy
    convert this using 1
    funext Y
    simp [mul_add]
  | smul c x _ hx =>
    have := Submodule.smul_mem _ c hx
    convert this using 1
    funext Y
    simp [mul_left_comm]

theorem monomial_eval_mem : ∀ (d : ℕ) (m : (Fin k × Fin N × Fin N) →₀ ℕ), Finsupp.degree m = d →
    (fun Y : UU N k => MvPolynomial.eval (fun v => Y v.1 v.2.1 v.2.2) (MvPolynomial.monomial m (1 : ℂ))) ∈
      polyFun N k d := by
  intro d
  induction d with
  | zero =>
    intro m h
    have hm : m = 0 := (Finsupp.degree_eq_zero_iff m).mp h
    subst hm
    refine Submodule.subset_span ⟨finZeroElim, ?_⟩
    funext Y
    simp
  | succ d ih =>
    intro m h
    have hne : m ≠ 0 := by
      rintro rfl
      simp at h
    obtain ⟨v, hv⟩ : ∃ v, m v ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact hne (Finsupp.ext hcon)
    have hm : m = Finsupp.single v 1 + (m - Finsupp.single v 1) := by
      ext w
      by_cases hw : w = v
      · subst hw; simp; omega
      · simp [hw]
    have hdeg : Finsupp.degree (m - Finsupp.single v 1) = d := by
      have h2 := congrArg Finsupp.degree hm
      rw [map_add, Finsupp.degree_single] at h2
      omega
    have h3 := coord_mul_mem v (ih _ hdeg)
    convert h3 using 1
    funext Y
    conv_lhs => rw [hm]
    rw [MvPolynomial.monomial_single_add, map_mul, map_pow, MvPolynomial.eval_X, pow_one]
    rfl

/-- The evaluation of the polynomial `p` at a tuple of matrices (the coordinates `Y_i ab` are substituted for the
variables `(i, a, b)`). -/
noncomputable def evalFun (p : MvPolynomial (Fin k × Fin N × Fin N) ℂ) : UU N k → ℂ :=
  fun Y => MvPolynomial.eval (fun v => Y v.1 v.2.1 v.2.2) p

/-- A homogeneous polynomial of degree `d` gives a function in `polyFun N k d`. -/
theorem evalFun_mem_polyFun {p : MvPolynomial (Fin k × Fin N × Fin N) ℂ} {d : ℕ}
    (hp : MvPolynomial.IsHomogeneous p d) : evalFun p ∈ polyFun N k d := by
  have : evalFun p =
      ∑ m ∈ p.support, p.coeff m • fun Y : UU N k =>
        MvPolynomial.eval (fun v => Y v.1 v.2.1 v.2.2) (MvPolynomial.monomial m (1 : ℂ)) := by
    funext Y
    conv_lhs => rw [evalFun, p.as_sum]
    simp only [map_sum, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    refine Finset.sum_congr rfl fun m _ => ?_
    simp [MvPolynomial.eval_monomial]
  rw [this]
  refine Submodule.sum_mem _ fun m hm => Submodule.smul_mem _ _ ?_
  refine monomial_eval_mem d m ?_
  have := hp (MvPolynomial.mem_support_iff.mp hm)
  rw [Finsupp.degree_eq_weight_one]
  exact this

/-- A function in `polyFun N k n` is `Y ↦ φ (Y ⊗ ⋯ ⊗ Y)` for a linear functional `φ` on the tensor power. -/
theorem exists_functional {n : ℕ} {f : UU N k → ℂ} (hf : f ∈ polyFun N k n) :
    ∃ φ : (⨂[ℂ] _ : Fin n, UU N k) →ₗ[ℂ] ℂ, ∀ Y, f Y = φ (tprod ℂ fun _ : Fin n => Y) := by
  induction hf using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨s, rfl⟩ := hx
    refine ⟨PiTensorProduct.lift
      ((MultilinearMap.mkPiAlgebra ℂ (Fin n) ℂ).compLinearMap (fun j => coordLin N k (s j))), fun Y => ?_⟩
    simp [PiTensorProduct.lift.tprod]
  | zero => exact ⟨0, fun Y => by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨φ₁, h₁⟩ := hx
    obtain ⟨φ₂, h₂⟩ := hy
    exact ⟨φ₁ + φ₂, fun Y => by simp [h₁ Y, h₂ Y]⟩
  | smul c x _ hx =>
    obtain ⟨φ, h⟩ := hx
    exact ⟨c • φ, fun Y => by simp [h Y]⟩

variable (N k) in
/-- Conjugation `Y ↦ (g Y_i g')_i` as a linear map of `U`. -/
def conjU (g g' : Matrix (Fin N) (Fin N) ℂ) : UU N k →ₗ[ℂ] UU N k where
  toFun Y := fun i => g * Y i * g'
  map_add' Y Z := by funext i; simp [mul_add, add_mul]
  map_smul' c Y := by funext i; simp [mul_smul_comm, smul_mul_assoc]

variable (N k) in
/-- Invariance of a function on `U` under simultaneous conjugation by `GL_N(ℂ)`. -/
def IsConjInv (f : UU N k → ℂ) : Prop :=
  ∀ g : (Matrix (Fin N) (Fin N) ℂ)ˣ, ∀ Y : UU N k,
    f (conjU N k (g : Matrix (Fin N) (Fin N) ℂ) ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) : Matrix (Fin N) (Fin N) ℂ) Y)
      = f Y

/-- Symmetrization of a functional with prescribed values on the pure powers. -/
theorem exists_symmetric_functional {n : ℕ} {f : UU N k → ℂ}
    (φ : (⨂[ℂ] _ : Fin n, UU N k) →ₗ[ℂ] ℂ) (hφ : ∀ Y, f Y = φ (tprod ℂ fun _ : Fin n => Y)) :
    ∃ φ' : (⨂[ℂ] _ : Fin n, UU N k) →ₗ[ℂ] ℂ,
      (∀ Y, f Y = φ' (tprod ℂ fun _ : Fin n => Y)) ∧
        ∀ (τ : Equiv.Perm (Fin n)) x, φ' (tensorPowerPermRep ℂ n (UU N k) τ x) = φ' x := by
  have hn : (Nat.factorial n : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  refine ⟨(Nat.factorial n : ℂ)⁻¹ • ∑ τ : Equiv.Perm (Fin n), φ ∘ₗ tensorPowerPermRep ℂ n (UU N k) τ, ?_, ?_⟩
  · intro Y
    simp only [LinearMap.smul_apply, LinearMap.sum_apply, LinearMap.comp_apply, smul_eq_mul]
    have : ∀ τ : Equiv.Perm (Fin n), tensorPowerPermRep ℂ n (UU N k) τ (tprod ℂ fun _ : Fin n => Y) =
        tprod ℂ fun _ : Fin n => Y := fun τ => by rw [tensorPowerPermRep_tprod]
    simp_rw [this]
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul,
      ← hφ Y, ← mul_assoc, inv_mul_cancel₀ hn, one_mul]
  · intro ρ x
    simp only [LinearMap.smul_apply, LinearMap.sum_apply, LinearMap.comp_apply, smul_eq_mul]
    congr 1
    have : ∀ τ : Equiv.Perm (Fin n), tensorPowerPermRep ℂ n (UU N k) τ
        (tensorPowerPermRep ℂ n (UU N k) ρ x) = tensorPowerPermRep ℂ n (UU N k) (τ * ρ) x := fun τ => by
      rw [map_mul]; rfl
    simp_rw [this]
    exact Equiv.sum_comp (Equiv.mulRight ρ) (fun τ => φ (tensorPowerPermRep ℂ n (UU N k) τ x))

/-- A symmetric functional agreeing with an invariant function on the pure powers is invariant under
`C^{⊗ n}` (polarization / uniqueness in characteristic zero, via the span of pure powers). -/
theorem functional_invariant {n : ℕ} {f : UU N k → ℂ} (hf : IsConjInv N k f)
    (φ : (⨂[ℂ] _ : Fin n, UU N k) →ₗ[ℂ] ℂ) (hφ : ∀ Y, f Y = φ (tprod ℂ fun _ : Fin n => Y))
    (hsym : ∀ (τ : Equiv.Perm (Fin n)) x, φ (tensorPowerPermRep ℂ n (UU N k) τ x) = φ x)
    (g : (Matrix (Fin N) (Fin N) ℂ)ˣ) (x : ⨂[ℂ] _ : Fin n, UU N k) :
    φ (tensorPowerMap n (conjU N k (g : Matrix (Fin N) (Fin N) ℂ)
      ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) : Matrix (Fin N) (Fin N) ℂ)) x) = φ x := by
  set C := conjU N k (g : Matrix (Fin N) (Fin N) ℂ)
      ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) : Matrix (Fin N) (Fin N) ℂ) with hC
  let ψ : (⨂[ℂ] _ : Fin n, UU N k) →ₗ[ℂ] ℂ := φ ∘ₗ tensorPowerMap n C - φ
  have hψpure : ∀ Y : UU N k, ψ (tprod ℂ fun _ : Fin n => Y) = 0 := by
    intro Y
    simp only [ψ, LinearMap.sub_apply, LinearMap.comp_apply]
    have : tensorPowerMap n C (tprod ℂ fun _ : Fin n => Y) = tprod ℂ fun _ : Fin n => C Y := by
      simp [tensorPowerMap]
    rw [this, ← hφ, ← hφ, hC, hf g Y, sub_self]
  have hψperm : ∀ (τ : Equiv.Perm (Fin n)) y,
      ψ (tensorPowerPermRep ℂ n (UU N k) τ y) = ψ y := by
    intro τ y
    simp only [ψ, LinearMap.sub_apply, LinearMap.comp_apply]
    rw [tensorPowerMap_perm, hsym, hsym]
  have hψzero : ∀ y ∈ symmetricTensors ℂ n (UU N k), ψ y = 0 := by
    intro y hy
    rw [symmetricTensors_eq_span_purePowers] at hy
    have : Submodule.span ℂ (purePowers ℂ n (UU N k)) ≤ LinearMap.ker ψ := by
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨Y, rfl⟩
      exact hψpure Y
    exact this hy
  have hsymm : ∑ τ : Equiv.Perm (Fin n), tensorPowerPermRep ℂ n (UU N k) τ x ∈ symmetricTensors ℂ n (UU N k) :=
    (Representation.mem_invariants _ _).mpr fun τ => symmetrize_invariant x τ
  have h1 := hψzero _ hsymm
  rw [map_sum] at h1
  simp_rw [hψperm] at h1
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul] at h1
  have hn : (Nat.factorial n : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  have h2 : ψ x = 0 := (mul_eq_zero.mp h1).resolve_left hn
  simpa [ψ, sub_eq_zero] using h2

theorem conjU_single (g g' : Matrix (Fin N) (Fin N) ℂ) (i : Fin k) (x : Matrix (Fin N) (Fin N) ℂ) :
    conjU N k g g' (Pi.single i x) = Pi.single i (g * x * g') := by
  funext j
  by_cases h : j = i
  · subst h; simp [conjU]
  · simp [conjU, h]

/-- **Invariant homogeneous polynomial functions are generated by traces of words**
(restitution of the multilinear first fundamental theorem). -/
theorem polyFun_inv_mem {n : ℕ} {f : UU N k → ℂ} (hfmem : f ∈ polyFun N k n) (hf : IsConjInv N k f) :
    f ∈ traceAlg N k := by
  obtain ⟨φ, hφ⟩ := exists_functional hfmem
  obtain ⟨φ', hφ', hsym⟩ := exists_symmetric_functional φ hφ
  have hinv := fun g x => functional_invariant hf φ' hφ' hsym g x
  -- the multilinear form on `U^n`
  let M : MultilinearMap ℂ (fun _ : Fin n => UU N k) ℂ := φ'.compMultilinearMap (PiTensorProduct.tprod ℂ)
  have hM_diag : ∀ Y, f Y = M (fun _ => Y) := fun Y => hφ' Y
  have hM_inv : ∀ (g : (Matrix (Fin N) (Fin N) ℂ)ˣ) (U : Fin n → UU N k),
      M (fun l => conjU N k (g : Matrix (Fin N) (Fin N) ℂ)
        ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) : Matrix (Fin N) (Fin N) ℂ) (U l)) = M U := by
    intro g U
    have := hinv g (PiTensorProduct.tprod ℂ U)
    simpa [M, tensorPowerMap] using this
  -- components along a colouring
  let Mc : (Fin n → Fin k) → MultilinearMap ℂ (fun _ : Fin n => Matrix (Fin N) (Fin N) ℂ) ℂ :=
    fun c => M.compLinearMap (fun l => LinearMap.single ℂ (fun _ : Fin k => Matrix (Fin N) (Fin N) ℂ) (c l))
  have hMc_inv : ∀ c, ∀ (g : (Matrix (Fin N) (Fin N) ℂ)ˣ) (X : Fin n → Matrix (Fin N) (Fin N) ℂ),
      Mc c (fun l => (g : Matrix (Fin N) (Fin N) ℂ) * X l *
        ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) : Matrix (Fin N) (Fin N) ℂ)) = Mc c X := by
    intro c g X
    have := hM_inv g (fun l => Pi.single (c l) (X l))
    simp only [Mc, MultilinearMap.compLinearMap_apply, LinearMap.single_apply]
    rw [← this]
    congr 1
    funext l
    rw [conjU_single]
  choose coef hcoef using fun c => multilinear_fft (Mc c) (hMc_inv c)
  have hexp : ∀ Y : UU N k, f Y = ∑ c : Fin n → Fin k, Mc c (fun l => Y (c l)) := by
    intro Y
    rw [hM_diag]
    have hY : (fun _ : Fin n => Y) = fun l => ∑ i : Fin k, (Pi.single i (Y i) : UU N k) := by
      funext l
      exact (Finset.univ_sum_single Y).symm
    rw [hY, MultilinearMap.map_sum]
    refine Finset.sum_congr rfl fun c _ => ?_
    simp [Mc]
  have hfun : f = ∑ c : Fin n → Fin k, ∑ σ : Equiv.Perm (Fin n),
      coef c σ • fun Y : UU N k => Tperm σ (fun l => Y (c l)) := by
    funext Y
    rw [hexp Y]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    refine Finset.sum_congr rfl fun c _ => ?_
    exact hcoef c _
  rw [hfun]
  refine Subalgebra.sum_mem _ fun c _ => Subalgebra.sum_mem _ fun σ _ => ?_
  exact Subalgebra.smul_mem _ (Tperm_colouring_mem σ c) _

/-! ### The polynomial model -/

/-- The coordinates of a tuple of matrices as an assignment of the variables `(i, a, b)`. -/
def coordsOf (Y : UU N k) : Fin k × Fin N × Fin N → ℂ := fun v => Y v.1 v.2.1 v.2.2

/-- Evaluation of polynomials on tuples of matrices, as an algebra homomorphism into the algebra of functions. -/
noncomputable def evalAlg : MvPolynomial (Fin k × Fin N × Fin N) ℂ →ₐ[ℂ] (UU N k → ℂ) :=
  MvPolynomial.aeval fun v => fun Y : UU N k => Y v.1 v.2.1 v.2.2

theorem evalAlg_X (v : Fin k × Fin N × Fin N) (Y : UU N k) :
    evalAlg (MvPolynomial.X v) Y = Y v.1 v.2.1 v.2.2 := by
  simp [evalAlg]

theorem evalAlg_C (a : ℂ) (Y : UU N k) :
    evalAlg (MvPolynomial.C a : MvPolynomial (Fin k × Fin N × Fin N) ℂ) Y = a := by
  simp [evalAlg]

theorem evalAlg_apply (p : MvPolynomial (Fin k × Fin N × Fin N) ℂ) (Y : UU N k) :
    evalAlg p Y = MvPolynomial.eval (coordsOf Y) p := by
  induction p using MvPolynomial.induction_on with
  | C a => rw [evalAlg_C]; simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p v hp =>
    rw [map_mul, Pi.mul_apply, hp, map_mul, evalAlg_X, MvPolynomial.eval_X]
    rfl

theorem evalAlg_injective : Function.Injective (evalAlg : MvPolynomial (Fin k × Fin N × Fin N) ℂ →ₐ[ℂ] _) := by
  intro p q h
  apply MvPolynomial.funext
  intro x
  set Y : UU N k := fun i a b => x (i, a, b) with hY
  have hc : coordsOf Y = x := by funext v; rfl
  have e1 := evalAlg_apply p Y
  have e2 := evalAlg_apply q Y
  rw [hc] at e1 e2
  have h3 : evalAlg p Y = evalAlg q Y := by rw [h]
  rw [← e1, ← e2]
  exact h3

/-- The substitution `X_{i,rc} ↦ (g X_i g')_{rc}` (a linear substitution). -/
noncomputable def conjSub (g g' : Matrix (Fin N) (Fin N) ℂ) :
    MvPolynomial (Fin k × Fin N × Fin N) ℂ →ₐ[ℂ] MvPolynomial (Fin k × Fin N × Fin N) ℂ :=
  MvPolynomial.aeval fun v => ∑ a, ∑ b,
    MvPolynomial.C (g v.2.1 a * g' b v.2.2) * MvPolynomial.X (v.1, a, b)

theorem evalAlg_conjSub (g g' : Matrix (Fin N) (Fin N) ℂ) (p : MvPolynomial (Fin k × Fin N × Fin N) ℂ)
    (Y : UU N k) : evalAlg (conjSub g g' p) Y = evalAlg p (conjU N k g g' Y) := by
  have hX : ∀ v : Fin k × Fin N × Fin N, evalAlg (conjSub g g' (MvPolynomial.X v)) Y =
      conjU N k g g' Y v.1 v.2.1 v.2.2 := by
    intro v
    simp only [conjSub, MvPolynomial.aeval_X, map_sum, Finset.sum_apply, map_mul, Pi.mul_apply,
      evalAlg_C, evalAlg_X, conjU, LinearMap.coe_mk, AddHom.coe_mk, Matrix.mul_apply,
      Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun a _ => ?_
    ring
  induction p using MvPolynomial.induction_on with
  | C a => simp [evalAlg_C]
  | add p q hp hq => simp [hp, hq]
  | mul_X p v hp =>
    simp only [map_mul, Pi.mul_apply]
    rw [hp, hX, evalAlg_X]

theorem evalAlg_evalFun (p : MvPolynomial (Fin k × Fin N × Fin N) ℂ) (Y : UU N k) :
    evalAlg p Y = evalFun p Y := by
  rw [evalAlg_apply]; rfl

/-- The algebra of polynomial invariants of the conjugation action of `GL_N(ℂ)` on `k`-tuples of
`N × N` matrices (the action by linear substitution). -/
noncomputable def invMv (N k : ℕ) : Subalgebra ℂ (MvPolynomial (Fin k × Fin N × Fin N) ℂ) :=
  ⨅ g : (Matrix (Fin N) (Fin N) ℂ)ˣ,
    AlgHom.equalizer (conjSub (k := k) (g : Matrix (Fin N) (Fin N) ℂ)
      ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) : Matrix (Fin N) (Fin N) ℂ)) (AlgHom.id ℂ _)

theorem mem_invMv {p : MvPolynomial (Fin k × Fin N × Fin N) ℂ} :
    p ∈ invMv N k ↔ ∀ g : (Matrix (Fin N) (Fin N) ℂ)ˣ,
      conjSub (g : Matrix (Fin N) (Fin N) ℂ) ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
        Matrix (Fin N) (Fin N) ℂ) p = p := by
  simp [invMv, Algebra.mem_iInf, AlgHom.mem_equalizer]

theorem mem_invMv_iff {p : MvPolynomial (Fin k × Fin N × Fin N) ℂ} :
    p ∈ invMv N k ↔ IsConjInv N k (evalFun p) := by
  rw [mem_invMv]
  refine forall_congr' fun g => ?_
  refine Iff.trans evalAlg_injective.eq_iff.symm ?_
  constructor
  · intro h Y
    have := congrFun h Y
    rw [evalAlg_conjSub] at this
    exact (evalAlg_evalFun _ _).symm.trans (this.trans (evalAlg_evalFun _ _))
  · intro h
    funext Y
    rw [evalAlg_conjSub]
    exact (evalAlg_evalFun _ _).trans ((h Y).trans (evalAlg_evalFun _ _).symm)

/-! ### The polynomial `traceMv w` -/

/-- The generic matrix `(X_{i,ab})_{ab}`. -/
noncomputable def Xmat (i : Fin k) : Matrix (Fin N) (Fin N) (MvPolynomial (Fin k × Fin N × Fin N) ℂ) :=
  Matrix.of fun a b => MvPolynomial.X (i, a, b)

/-- The trace of the word `w` in the generic matrices, as a polynomial. -/
noncomputable def traceMv (w : List (Fin k)) : MvPolynomial (Fin k × Fin N × Fin N) ℂ :=
  Matrix.trace ((w.map (Xmat (N := N))).prod)

theorem evalAlg_traceMv (w : List (Fin k)) (Y : UU N k) :
    evalAlg (traceMv (N := N) w) Y = wordTrace N w Y := by
  let φ : MvPolynomial (Fin k × Fin N × Fin N) ℂ →+* ℂ :=
    (Pi.evalRingHom (fun _ : UU N k => ℂ) Y).comp (evalAlg (N := N) (k := k)).toRingHom
  have hφ : ∀ i, (Xmat (N := N) i).map φ = Y i := by
    intro i; ext a b
    simp [Xmat, φ, evalAlg_X]
  have h1 : φ (traceMv (N := N) w) = Matrix.trace (((w.map (Xmat (N := N))).prod).map φ) := by
    simp [traceMv, Matrix.trace, map_sum]
  have h2 : ((w.map (Xmat (N := N))).prod).map φ = evalWord Y w := by
    rw [← RingHom.mapMatrix_apply, map_list_prod, List.map_map]
    unfold evalWord
    congr 1
    apply List.map_congr_left
    intro i _
    exact hφ i
  have h3 : evalAlg (traceMv (N := N) w) Y = φ (traceMv (N := N) w) := rfl
  rw [h3, h1, h2]
  rfl

theorem evalWord_conj (g : (Matrix (Fin N) (Fin N) ℂ)ˣ) (Y : UU N k) (w : List (Fin k)) :
    evalWord (conjU N k (g : Matrix (Fin N) (Fin N) ℂ) ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
      Matrix (Fin N) (Fin N) ℂ) Y) w = g * evalWord Y w * ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
      Matrix (Fin N) (Fin N) ℂ) := by
  induction w with
  | nil => simp [evalWord]
  | cons a w ih =>
    have ih' : (w.map (conjU N k (g : Matrix (Fin N) (Fin N) ℂ) ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
      Matrix (Fin N) (Fin N) ℂ) Y)).prod = g * (w.map Y).prod * ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
      Matrix (Fin N) (Fin N) ℂ) := ih
    simp only [evalWord, List.map_cons, List.prod_cons, ih']
    simp [conjU, mul_assoc, Units.inv_mul_cancel_left]

theorem wordTrace_conj (g : (Matrix (Fin N) (Fin N) ℂ)ˣ) (Y : UU N k) (w : List (Fin k)) :
    wordTrace N w (conjU N k (g : Matrix (Fin N) (Fin N) ℂ) ((g⁻¹ : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
      Matrix (Fin N) (Fin N) ℂ) Y) = wordTrace N w Y := by
  unfold wordTrace
  rw [evalWord_conj, Matrix.trace_mul_comm, ← mul_assoc, Units.inv_mul, one_mul]

theorem traceMv_mem_invMv (w : List (Fin k)) : traceMv (N := N) w ∈ invMv N k := by
  rw [mem_invMv_iff]
  have : evalFun (traceMv (N := N) w) = wordTrace N w := by
    funext Y
    rw [← evalAlg_evalFun, evalAlg_traceMv]
  rw [this]
  intro g Y
  exact wordTrace_conj g Y w

/-! ### Homogeneous components -/

theorem conjSub_isHomogeneous (g g' : Matrix (Fin N) (Fin N) ℂ)
    {p : MvPolynomial (Fin k × Fin N × Fin N) ℂ} {d : ℕ} (hp : p.IsHomogeneous d) :
    (conjSub g g' p).IsHomogeneous d := by
  have := hp.aeval (n := 1)
    (fun v : Fin k × Fin N × Fin N => ∑ a, ∑ b,
      (MvPolynomial.C (g v.2.1 a * g' b v.2.2) * MvPolynomial.X (v.1, a, b) :
        MvPolynomial (Fin k × Fin N × Fin N) ℂ))
    (fun v => MvPolynomial.IsHomogeneous.sum _ _ _ fun a _ =>
      MvPolynomial.IsHomogeneous.sum _ _ _ fun b _ => (MvPolynomial.isHomogeneous_X ℂ _).C_mul _)
  simpa [conjSub] using this

theorem conjSub_homogeneousComponent (g g' : Matrix (Fin N) (Fin N) ℂ)
    (p : MvPolynomial (Fin k × Fin N × Fin N) ℂ) (d : ℕ) :
    MvPolynomial.homogeneousComponent d (conjSub g g' p) =
      conjSub g g' (MvPolynomial.homogeneousComponent d p) := by
  have hp := MvPolynomial.sum_homogeneousComponent p
  calc MvPolynomial.homogeneousComponent d (conjSub g g' p)
      = MvPolynomial.homogeneousComponent d (conjSub g g'
          (∑ i ∈ range (p.totalDegree + 1), MvPolynomial.homogeneousComponent i p)) := by rw [hp]
    _ = ∑ i ∈ range (p.totalDegree + 1), MvPolynomial.homogeneousComponent d
          (conjSub g g' (MvPolynomial.homogeneousComponent i p)) := by
        rw [map_sum, map_sum]
    _ = ∑ i ∈ range (p.totalDegree + 1),
          if d = i then conjSub g g' (MvPolynomial.homogeneousComponent i p) else 0 := by
        refine Finset.sum_congr rfl fun i _ => ?_
        exact MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule _ _).2
            (conjSub_isHomogeneous g g' (MvPolynomial.homogeneousComponent_isHomogeneous i p)))
    _ = conjSub g g' (MvPolynomial.homogeneousComponent d p) := by
        rw [Finset.sum_ite_eq]
        by_cases hd : d ∈ range (p.totalDegree + 1)
        · simp only [hd, ite_true]
        · rw [ite_cond_eq_false _ _ (eq_false hd),MvPolynomial.homogeneousComponent_eq_zero d p
            (by simpa [Nat.lt_succ_iff] using hd), map_zero]

/-! ### The headline -/

theorem mem_adjoin_of_evalFun_mem {q : MvPolynomial (Fin k × Fin N × Fin N) ℂ}
    (h : evalFun q ∈ traceAlg N k) :
    q ∈ Algebra.adjoin ℂ (Set.range (traceMv (N := N) (k := k))) := by
  have himg : (evalAlg (N := N) (k := k)) '' Set.range (traceMv (N := N) (k := k)) =
      Set.range (wordTrace N : List (Fin k) → _) := by
    rw [← Set.range_comp]
    congr 1
    funext w
    funext Y
    exact evalAlg_traceMv w Y
  have hmap := AlgHom.map_adjoin (evalAlg (N := N) (k := k)) (Set.range (traceMv (N := N) (k := k)))
  rw [himg] at hmap
  have h' : evalFun q ∈ (Algebra.adjoin ℂ (Set.range (traceMv (N := N) (k := k)))).map
      (evalAlg (N := N) (k := k)) := by
    rw [hmap]; exact h
  obtain ⟨q', hq', hq'eq⟩ := h'
  have : q' = q := by
    apply evalAlg_injective
    funext Y
    exact (congrFun hq'eq Y).trans (evalAlg_evalFun q Y).symm
  exact this ▸ hq'

/-- **Problem 4.69 (first fundamental theorem for matrix invariants).** The algebra of polynomial
functions on `k`-tuples of `N × N` complex matrices invariant under simultaneous conjugation by
`GL_N(ℂ)` is generated by the traces of words `tr (X_{i₁} ⋯ X_{i_r})`. -/
@[kb "etingof2011" "Problem 4.69, p. 68"]
theorem invMv_eq_adjoin_traceMv (N k : ℕ) :
    invMv N k = Algebra.adjoin ℂ (Set.range (traceMv (N := N) (k := k))) := by
  apply le_antisymm
  · intro p hp
    have hcomp : ∀ d, MvPolynomial.homogeneousComponent d p ∈
        Algebra.adjoin ℂ (Set.range (traceMv (N := N) (k := k))) := by
      intro d
      have hinv : MvPolynomial.homogeneousComponent d p ∈ invMv N k := by
        rw [mem_invMv] at hp ⊢
        intro g
        rw [← conjSub_homogeneousComponent, hp g]
      rw [mem_invMv_iff] at hinv
      exact mem_adjoin_of_evalFun_mem (polyFun_inv_mem
        (evalFun_mem_polyFun (MvPolynomial.homogeneousComponent_isHomogeneous d p)) hinv)
    rw [← MvPolynomial.sum_homogeneousComponent p]
    exact Subalgebra.sum_mem _ fun d _ => hcomp d
  · exact Algebra.adjoin_le (by rintro _ ⟨w, rfl⟩; exact traceMv_mem_invMv w)

