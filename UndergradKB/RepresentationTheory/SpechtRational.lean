import Mathlib.RepresentationTheory.Irreducible
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
import UndergradKB.RepresentationTheory.SpechtModules
import UndergradKB.Common.Attr

/-! # Rational realization of the irreducible representations of `S_n` (Etingof et al., Corollary 4.38)

The Young symmetrizer `c_λ` has integer coefficients, so it comes from an element `c_λ^ℚ` of `ℚ[S_n]`. The
left ideal `ℚ[S_n] c_λ^ℚ` is a `ℚ`-form of `ℂ[S_n] c_λ`: a `ℚ`-basis of it chosen among the elements `g c_λ`
stays `ℂ`-linearly independent in `ℂ[S_n]` and spans `ℂ[S_n] c_λ` over `ℂ`. In this basis every group element
acts by a rational matrix.

* `exists_rational_basis_ideal`: for any `c ∈ ℚ[G]`, the left ideal of `ℂ[G]` generated by the image of `c`
  has a `ℂ`-basis in which every `g ∈ G` acts by a rational matrix.
* `exists_rational_basis_irrep` (Corollary 4.38): every irreducible complex representation of `S_n` has a
  basis in which all the matrices of the representation are rational.
-/

namespace UndergradKB.RepresentationTheory

section Rational

variable {G : Type} [Group G] [Fintype G] [DecidableEq G]

/-- Extension of scalars `ℚ[G] → ℂ[G]` of group algebras. -/
noncomputable abbrev ratToComplex (G : Type) [Group G] :
    MonoidAlgebra ℚ G →ₐ[ℚ] MonoidAlgebra ℂ G :=
  MonoidAlgebra.mapAlgHom G (Algebra.ofId ℚ ℂ)

omit [Fintype G] [DecidableEq G] in
lemma ratToComplex_single (g : G) (r : ℚ) :
    ratToComplex G (MonoidAlgebra.single g r) = MonoidAlgebra.single g (algebraMap ℚ ℂ r) := by
  simp [ratToComplex]

open scoped Classical in
omit [DecidableEq G] in
/-- A twisted sum with rational character values comes from `ℚ[G]`. -/
lemma twistedSum_mem_range (H : Subgroup G) (χ : G →* ℂ)
    (hχ : ∀ g, ∃ q : ℚ, algebraMap ℚ ℂ q = χ g) :
    twistedSum H χ ∈ (ratToComplex G).range := by
  unfold twistedSum
  refine Subalgebra.sum_mem _ (fun g _ => ?_)
  obtain ⟨q, hq⟩ := hχ g
  refine ⟨MonoidAlgebra.single (g : G) q, ?_⟩
  show ratToComplex G _ = _
  rw [ratToComplex_single, ← hq]
  simp

/-- The Young symmetrizer of a filling is the image of an element of `ℚ[S_n]` (it has integer
coefficients). -/
lemma exists_rat_youngSymmetrizerN {la : YoungDiagram} {n : ℕ} (T : la ≃ Fin n) :
    ∃ cQ : MonoidAlgebra ℚ (Equiv.Perm (Fin n)),
      ratToComplex (Equiv.Perm (Fin n)) cQ = youngSymmetrizerN T := by
  have h1 : rowSumN T ∈ (ratToComplex (Equiv.Perm (Fin n))).range :=
    twistedSum_mem_range _ _ (fun g => ⟨1, by simp⟩)
  have h2 : colSumN T ∈ (ratToComplex (Equiv.Perm (Fin n))).range :=
    twistedSum_mem_range _ _ (fun g => ⟨((Equiv.Perm.sign g : ℤˣ) : ℤ), by simp [signChar]⟩)
  exact (Subalgebra.mul_mem _ h1 h2)

/-- Extension of scalars `ℚ → ℂ` preserves linear independence of vectors of the group algebra. -/
lemma linearIndependent_ratToComplex {ι : Type} [Fintype ι] (x : ι → MonoidAlgebra ℚ G)
    (hx : LinearIndependent ℚ x) :
    LinearIndependent ℂ (fun i => ratToComplex G (x i)) := by
  classical
  obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective
    (Finsupp.linearCombination ℚ x) (LinearMap.ker_eq_bot.2 hx)
  have hgx : ∀ j, g (x j) = Finsupp.single j 1 := fun j => by
    have := congrArg (fun h => h (Finsupp.single j 1)) hg
    simpa using this
  let Φ : ι → MonoidAlgebra ℂ G →ₗ[ℂ] ℂ := fun i =>
    { toFun := fun y => ∑ h, y.coeff h * algebraMap ℚ ℂ (g (MonoidAlgebra.single h 1) i)
      map_add' := fun a b => by simp [add_mul, Finset.sum_add_distrib]
      map_smul' := fun c a => by simp [Finset.mul_sum, mul_assoc] }
  have hΦ : ∀ i (y : MonoidAlgebra ℚ G),
      Φ i (ratToComplex G y) = algebraMap ℚ ℂ (g y i) := by
    intro i y
    induction y using MonoidAlgebra.induction_linear with
    | zero => simp
    | add a b ha hb => simp only [map_add, Finsupp.add_apply, ha, hb]
    | single h r =>
      have : (MonoidAlgebra.single h r : MonoidAlgebra ℚ G) = r • MonoidAlgebra.single h 1 := by
        simp
      rw [ratToComplex_single, this, map_smul, Finsupp.smul_apply, smul_eq_mul, map_mul]
      simp [Φ, MonoidAlgebra.coeff_single, Finsupp.single_apply]
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  have := congrArg (Φ i) hc
  simp only [map_sum, map_smul, hΦ, hgx, map_zero, Finsupp.single_apply, smul_eq_mul] at this
  simpa using this

omit [Fintype G] [DecidableEq G] in
/-- The inclusion of `RestrictScalars ℂ ℂ[G] S` into `ℂ[G]`, as a `ℂ`-linear map. -/
noncomputable def restrictIncl (S : Ideal (MonoidAlgebra ℂ G)) :
    RestrictScalars ℂ (MonoidAlgebra ℂ G) S →ₗ[ℂ] MonoidAlgebra ℂ G where
  toFun x := (RestrictScalars.addEquiv ℂ (MonoidAlgebra ℂ G) S x).1
  map_add' _ _ := by simp
  map_smul' c x := by
    rw [RestrictScalars.addEquiv_map_smul]
    simp [Algebra.smul_def]

omit [Fintype G] [DecidableEq G] in
lemma restrictIncl_injective (S : Ideal (MonoidAlgebra ℂ G)) :
    Function.Injective (restrictIncl S) := fun _ _ h =>
  (RestrictScalars.addEquiv ℂ (MonoidAlgebra ℂ G) S).injective (Subtype.ext h)

omit [Fintype G] [DecidableEq G] in
lemma restrictIncl_ofModule (S : Ideal (MonoidAlgebra ℂ G)) (g : G)
    (x : RestrictScalars ℂ (MonoidAlgebra ℂ G) S) :
    restrictIncl S (Representation.ofModule (k := ℂ) (G := G) S g x) =
      MonoidAlgebra.single g 1 * restrictIncl S x := by
  have := Representation.ofModule_asAlgebraHom_apply_apply (k := ℂ) (G := G) S
    (MonoidAlgebra.single g 1) x
  rw [Representation.asAlgebraHom_single, one_smul] at this
  rw [this]
  simp [restrictIncl]

/-- For `c ∈ ℚ[G]`, the left ideal of `ℂ[G]` generated by the image of `c` has a `ℂ`-basis in which every
group element acts by a rational matrix. -/
theorem exists_rational_basis_ideal (cQ : MonoidAlgebra ℚ G) :
    ∃ (ι : Type) (_ : Fintype ι) (_ : DecidableEq ι)
      (B : Module.Basis ι ℂ (RestrictScalars ℂ (MonoidAlgebra ℂ G)
        (Ideal.span {ratToComplex G cQ}))) (M : G → Matrix ι ι ℚ),
      ∀ g, LinearMap.toMatrix B B (Representation.ofModule (k := ℂ) (G := G)
        (Ideal.span {ratToComplex G cQ}) g) = (M g).map (algebraMap ℚ ℂ) := by
  classical
  set C := ratToComplex G cQ with hC
  set S : Ideal (MonoidAlgebra ℂ G) := Ideal.span {C} with hS
  let w : G → MonoidAlgebra ℚ G := fun g => MonoidAlgebra.single g 1 * cQ
  obtain ⟨b, hbsub, hbspan, hbli⟩ := exists_linearIndependent ℚ (Set.range w)
  have : Finite b := ((Set.finite_range w).subset hbsub).to_subtype
  let _ : Fintype b := Fintype.ofFinite b
  have hFw : ∀ h, ratToComplex G (w h) = MonoidAlgebra.single h 1 * C := fun h => by
    simp only [w, map_mul, hC]
    rw [ratToComplex_single]
    simp
  have hmem : ∀ k : b, ratToComplex G (k : MonoidAlgebra ℚ G) ∈ S := by
    rintro ⟨k, hk⟩
    obtain ⟨h, rfl⟩ := hbsub hk
    show ratToComplex G (w h) ∈ S
    rw [hFw]
    exact S.mul_mem_left _ (Ideal.subset_span rfl)
  let v : b → RestrictScalars ℂ (MonoidAlgebra ℂ G) S := fun k =>
    (RestrictScalars.addEquiv ℂ (MonoidAlgebra ℂ G) S).symm ⟨ratToComplex G k, hmem k⟩
  have hv : ∀ k, restrictIncl S (v k) = ratToComplex G (k : MonoidAlgebra ℚ G) := fun k => by
    simp [restrictIncl, v]
  have hli : LinearIndependent ℂ v := by
    refine LinearIndependent.of_comp (restrictIncl S) ?_
    have := linearIndependent_ratToComplex (fun k : b => (k : MonoidAlgebra ℚ G)) hbli
    convert this using 1
    funext k
    exact hv k
  have hF : ∀ x ∈ Submodule.span ℚ (Set.range ((↑) : b → MonoidAlgebra ℚ G)),
      ratToComplex G x ∈ Submodule.span ℂ (Set.range fun k : b => ratToComplex G (k : MonoidAlgebra ℚ G)) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span (by obtain ⟨k, rfl⟩ := hx; exact ⟨k, rfl⟩)
    | zero => simp
    | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
    | smul q x _ hx => rw [map_smul]; exact Submodule.smul_of_tower_mem _ q hx
  have hbrange : Set.range ((↑) : b → MonoidAlgebra ℚ G) = b := Subtype.range_coe
  have hwb : ∀ h, w h ∈ Submodule.span ℚ (Set.range ((↑) : b → MonoidAlgebra ℚ G)) := fun h => by
    rw [hbrange, hbspan]
    exact Submodule.subset_span ⟨h, rfl⟩
  have hspan : ⊤ ≤ Submodule.span ℂ (Set.range v) := by
    intro x _
    have hx : restrictIncl S x ∈ S := (RestrictScalars.addEquiv ℂ (MonoidAlgebra ℂ G) S x).2
    have key : restrictIncl S x ∈ Submodule.span ℂ (Set.range (restrictIncl S ∘ v)) := by
      have hrange : Set.range (restrictIncl S ∘ v) =
          Set.range fun k : b => ratToComplex G (k : MonoidAlgebra ℚ G) := by
        ext y; constructor
        · rintro ⟨k, rfl⟩; exact ⟨k, (hv k).symm⟩
        · rintro ⟨k, rfl⟩; exact ⟨k, hv k⟩
      rw [hrange]
      have hall : ∀ a : MonoidAlgebra ℂ G, a * C ∈ Submodule.span ℂ
          (Set.range fun k : b => ratToComplex G (k : MonoidAlgebra ℚ G)) := by
        intro a
        induction a using MonoidAlgebra.induction_linear with
        | zero => simp
        | add a a' h1 h2 => rw [add_mul]; exact Submodule.add_mem _ h1 h2
        | single h r =>
          have : (MonoidAlgebra.single h r : MonoidAlgebra ℂ G) * C =
              r • (ratToComplex G (w h)) := by
            rw [hFw, ← smul_mul_assoc]
            congr 1
            simp
          rw [this]
          exact Submodule.smul_mem _ _ (hF _ (hwb h))
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 hx
      rw [← ha]
      exact hall a
    rw [Set.range_comp, ← Submodule.map_span] at key
    obtain ⟨y, hy, hyx⟩ := Submodule.mem_map.1 key
    rwa [← restrictIncl_injective S hyx]
  let B : Module.Basis b ℂ (RestrictScalars ℂ (MonoidAlgebra ℂ G) S) := Module.Basis.mk hli hspan
  have hB : ∀ k, B k = v k := fun k => by simp [B]
  have hmul : ∀ (g : G) (k : b), MonoidAlgebra.single g 1 * (k : MonoidAlgebra ℚ G) ∈
      Submodule.span ℚ (Set.range ((↑) : b → MonoidAlgebra ℚ G)) := by
    rintro g ⟨k, hk⟩
    obtain ⟨h, rfl⟩ := hbsub hk
    have : MonoidAlgebra.single g (1 : ℚ) * w h = w (g * h) := by
      simp only [w, ← mul_assoc, MonoidAlgebra.single_mul_single, one_mul]
    simp only [this]
    exact hwb _
  have hex : ∀ (g : G) (j : b), ∃ m : b → ℚ,
      ∑ k, m k • (k : MonoidAlgebra ℚ G) = MonoidAlgebra.single g 1 * (j : MonoidAlgebra ℚ G) :=
    fun g j => (Submodule.mem_span_range_iff_exists_fun ℚ).1 (hmul g j)
  choose m hm using hex
  refine ⟨b, inferInstance, inferInstance, B, fun g i j => m g j i, fun g => ?_⟩
  have hact : ∀ g (j : b), Representation.ofModule (k := ℂ) (G := G) S g (B j) =
      ∑ k, algebraMap ℚ ℂ (m g j k) • B k := by
    intro g j
    apply restrictIncl_injective S
    rw [restrictIncl_ofModule, map_sum, hB]
    simp only [map_smul, hB, hv]
    have h1 : MonoidAlgebra.single g (1 : ℂ) * ratToComplex G (j : MonoidAlgebra ℚ G) =
        ratToComplex G (MonoidAlgebra.single g 1 * (j : MonoidAlgebra ℚ G)) := by
      rw [map_mul, ratToComplex_single]
      simp
    rw [h1, ← hm g j, map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_smul, algebraMap_smul]
  ext i j
  rw [LinearMap.toMatrix_apply, hact, map_sum]
  simp [Module.Basis.repr_self, Finsupp.single_apply]
  rfl

/-- **Corollary 4.38 (rationality).** Every irreducible complex representation `Y` of `S_n` can be realized
with rational matrices: there is a basis `b` of the space of `Y` such that, for every permutation `g`, the
matrix of `Y.ρ g` in `b` is the image of a rational matrix. -/
@[kb "etingof2011" "Corollary 4.38, p. 59"]
theorem exists_rational_basis_irrep (n : ℕ) (Y : IrrRep ℂ (Equiv.Perm (Fin n))) :
    ∃ (ι : Type) (_ : Fintype ι) (_ : DecidableEq ι) (b : Module.Basis ι ℂ Y.V)
      (M : Equiv.Perm (Fin n) → Matrix ι ι ℚ),
      ∀ g, LinearMap.toMatrix b b (Y.ρ g) = (M g).map (algebraMap ℚ ℂ) := by
  obtain ⟨la, ⟨e⟩⟩ := exists_equiv_spechtModule n Y
  obtain ⟨cQ, hcQ⟩ := exists_rat_youngSymmetrizerN (spechtTableau la)
  have hS : spechtModule la = Ideal.span {ratToComplex (Equiv.Perm (Fin n)) cQ} := by
    rw [hcQ]; rfl
  generalize spechtModule la = S at hS e
  subst hS
  obtain ⟨ι, _, _, B, M, hB⟩ := exists_rational_basis_ideal cQ
  refine ⟨ι, inferInstance, inferInstance, B.map e.toLinearEquiv.symm, M, fun g => ?_⟩
  ext i j
  have h := congrFun (congrFun (hB g) i) j
  rw [LinearMap.toMatrix_apply] at h
  rw [LinearMap.toMatrix_apply, ← h]
  have h2 := Representation.IntertwiningMap.isIntertwining _ _ e.toIntertwiningMap g
    (e.toLinearEquiv.symm (B j))
  simp only [Module.Basis.map_repr, Module.Basis.map_apply, LinearEquiv.symm_symm]
  have h3 : e.toLinearEquiv ((Y.ρ g) (e.toLinearEquiv.symm (B j))) =
      Representation.ofModule _ g (B j) :=
    h2.trans (congrArg _ (e.toLinearEquiv.apply_symm_apply (B j)))
  exact congrArg (fun x => B.repr x i) h3

end Rational

end UndergradKB.RepresentationTheory
