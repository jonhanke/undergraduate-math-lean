/-! # The permutation modules `U_λ` and Kostka numbers (Etingof et al., §4.14-4.15)

For a Young diagram `λ` with a filling `T : λ ≃ Fin n`, `U_λ = ℂ[S_n] a_λ` (`permIdeal T`) is the left ideal
generated by the row sum `a_λ = ∑_{g ∈ P_λ} g`; it is the permutation module `Ind_{P_λ}^{S_n} 1`.

* `finrank_hom_self`, `subsingleton_hom_of_lex`, `subsingleton_hom_of_not_rowDominance` (Proposition 4.44):
  `dim Hom(U_λ, V_λ) = 1`, and `Hom(U_λ, V_μ) = 0` for `μ < λ` lexicographically, in fact unless `λ ⊴ μ`.
* `kostka` (Definition 4.45): `K_{μλ} = dim Hom_{S_n}(U_λ, V_μ)`; `kostka_eq_zero_of_not_rowDominance`,
  `kostka_self` (§4.15 Remark).
* `character_permIdeal_eq_card_fixedBy`, `character_permIdeal_eq_coeff` (Theorem 4.46): the character of
  `U_λ` at `g` is the number of fixed points of `g` on `S_n / P_λ`, and equals the coefficient of `x^λ` in
  `∏_m (x_1^m + ⋯ + x_N^m)^{i_m}`, where `i_m` is the number of cycles of length `m` of `g`.
-/

namespace UndergradKB.RepresentationTheory

open Finset

section Core

variable {G : Type*} [Group G] [Fintype G] (H : Subgroup G)

open scoped Classical

lemma coeff_twistedSum_one (w : G) :
    (twistedSum H 1).coeff w = if w ∈ H then 1 else 0 := by
  unfold twistedSum
  rw [MonoidAlgebra.coeff_sum]
  rw [Finsupp.finsetSum_apply]
  by_cases hw : w ∈ H
  · simp only [hw, ↓reduceIte]
    rw [Finset.sum_eq_single (⟨w, hw⟩ : H)]
    · simp [MonoidAlgebra.coeff_single]
    · intro b _ hb
      have : (b : G) ≠ w := fun h => hb (Subtype.ext h)
      simp [MonoidAlgebra.coeff_single, this]
    · simp
  · simp only [hw, ↓reduceIte]
    refine Finset.sum_eq_zero fun b _ => ?_
    have : (b : G) ≠ w := fun h => hw (h ▸ b.2)
    simp [MonoidAlgebra.coeff_single, this]

lemma twistedSum_one_mul_self :
    twistedSum H 1 * twistedSum H 1 = (Nat.card H : ℂ) • twistedSum H 1 := by
  rw [twistedSum_mul_self, Nat.card_eq_fintype_card]

lemma natCard_subgroup_ne_zero : (Nat.card H : ℂ) ≠ 0 :=
  Nat.cast_ne_zero.2 Nat.card_pos.ne'

/-- The normalised idempotent `e = |H|⁻¹ ∑_{h ∈ H} h`. -/
noncomputable def avgElt : MonoidAlgebra ℂ G := (Nat.card H : ℂ)⁻¹ • twistedSum H 1

lemma avgElt_mul_self : avgElt H * avgElt H = avgElt H := by
  unfold avgElt
  rw [smul_mul_smul_comm, twistedSum_one_mul_self, smul_smul]
  have := natCard_subgroup_ne_zero H
  congr 1
  field_simp

lemma mem_span_twistedSum_iff (z : MonoidAlgebra ℂ G) :
    z ∈ Ideal.span {twistedSum H 1} ↔ z * avgElt H = z := by
  have hN := natCard_subgroup_ne_zero H
  constructor
  · intro hz
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.1 hz
    unfold avgElt
    rw [mul_smul_comm, mul_assoc, twistedSum_one_mul_self, mul_smul_comm, smul_smul,
      inv_mul_cancel₀ hN, one_smul]
  · intro hz
    rw [Ideal.mem_span_singleton']
    refine ⟨(Nat.card H : ℂ)⁻¹ • z, ?_⟩
    rw [smul_mul_assoc]
    conv_rhs => rw [← hz]
    unfold avgElt
    rw [mul_smul_comm]

lemma coeff_avgElt (w : G) : (avgElt H).coeff w = (Nat.card H : ℂ)⁻¹ * (if w ∈ H then 1 else 0) := by
  unfold avgElt
  rw [MonoidAlgebra.coeff_smul, Finsupp.smul_apply, coeff_twistedSum_one, smul_eq_mul]

/-- The ℂ-subspace `ℂ[G] a_H`, where `a_H = ∑_{h ∈ H} h`. -/
noncomputable def permSubspace : Submodule ℂ (MonoidAlgebra ℂ G) :=
  (Ideal.span {twistedSum H 1}).restrictScalars ℂ

lemma mem_permSubspace {z : MonoidAlgebra ℂ G} : z ∈ permSubspace H ↔ z * avgElt H = z :=
  mem_span_twistedSum_iff H z

lemma single_mul_mem_permSubspace (g : G) {z : MonoidAlgebra ℂ G} (hz : z ∈ permSubspace H) :
    MonoidAlgebra.single g (1 : ℂ) * z ∈ permSubspace H := by
  rw [mem_permSubspace] at hz ⊢
  rw [mul_assoc, hz]

/-- The action of `g ∈ G` on `ℂ[G] a_H` by left multiplication. -/
noncomputable def permAction (g : G) : permSubspace H →ₗ[ℂ] permSubspace H :=
  (LinearMap.mulLeft ℂ (MonoidAlgebra.single g (1 : ℂ))).restrict
    (fun _ hz => single_mul_mem_permSubspace H g hz)

theorem trace_permAction (g : G) :
    LinearMap.trace ℂ (permSubspace H) (permAction H g) =
      (Nat.card (MulAction.fixedBy (G ⧸ H) g) : ℂ) := by
  have : Module.Finite ℂ (MonoidAlgebra ℂ G) := Module.Finite.equiv (MonoidAlgebra.coeffLinearEquiv ℂ).symm
  set π : MonoidAlgebra ℂ G →ₗ[ℂ] permSubspace H :=
    (LinearMap.mulRight ℂ (avgElt H)).codRestrict (permSubspace H) (fun z => by
      rw [mem_permSubspace, LinearMap.mulRight_apply, mul_assoc, avgElt_mul_self]) with hπ
  set ι : permSubspace H →ₗ[ℂ] MonoidAlgebra ℂ G := (permSubspace H).subtype with hι
  have h1 : permAction H g = π ∘ₗ ((LinearMap.mulLeft ℂ (MonoidAlgebra.single g (1 : ℂ))) ∘ₗ ι) := by
    refine LinearMap.ext fun u => Subtype.ext ?_
    have hu := (mem_permSubspace H).1 (single_mul_mem_permSubspace H g u.2)
    simp [permAction, hπ, hι, hu]
    rfl
  rw [h1, LinearMap.trace_comp_comm']
  classical
  let b : Module.Basis G ℂ (MonoidAlgebra ℂ G) :=
    Module.Basis.ofRepr (MonoidAlgebra.coeffLinearEquiv ℂ)
  rw [LinearMap.trace_eq_matrix_trace ℂ b, Matrix.trace]
  have hd : ∀ x : G, LinearMap.toMatrix b b
      ((LinearMap.mulLeft ℂ (MonoidAlgebra.single g (1 : ℂ)) ∘ₗ ι) ∘ₗ π) x x =
      (Nat.card H : ℂ)⁻¹ * (if (g * x)⁻¹ * x ∈ H then 1 else 0) := by
    intro x
    simp only [LinearMap.toMatrix_apply]
    have hb : b x = MonoidAlgebra.single x 1 := rfl
    rw [hb]
    show (MonoidAlgebra.single g (1 : ℂ) * (MonoidAlgebra.single x (1 : ℂ) * avgElt H)).coeff x = _
    rw [← mul_assoc, MonoidAlgebra.single_mul_single, one_mul, MonoidAlgebra.coeff_single_mul_apply,
      coeff_avgElt, one_mul]
  simp only [Matrix.diag, hd]
  rw [← Finset.mul_sum]
  have hcount : (Finset.univ.filter fun x : G => (g * x)⁻¹ * x ∈ H).card =
      Nat.card H * Nat.card (MulAction.fixedBy (G ⧸ H) g) := by
    have := QuotientGroup.card_preimage_mk H (MulAction.fixedBy (G ⧸ H) g)
    rw [← this, Nat.card_eq_fintype_card, Fintype.card_subtype]
    congr 1
    ext x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Set.mem_preimage, MulAction.mem_fixedBy]
    change _ ↔ (QuotientGroup.mk (g * x) : G ⧸ H) = QuotientGroup.mk x
    rw [QuotientGroup.eq]
  rw [Finset.sum_boole, hcount]
  have := natCard_subgroup_ne_zero H
  push_cast
  field_simp

lemma span_avgElt_eq : Ideal.span {avgElt H} = Ideal.span {twistedSum H 1} := by
  have hN := natCard_subgroup_ne_zero H
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_singleton_le_iff_mem, mem_span_twistedSum_iff, avgElt_mul_self]
  · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton']
    refine ⟨(Nat.card H : ℂ) • 1, ?_⟩
    unfold avgElt
    rw [smul_mul_assoc, one_mul, smul_smul, mul_inv_cancel₀ hN, one_smul]

/-- Hom from `ℂ[G] a_H` into a module is `e M`, `e = |H|⁻¹ a_H` (Lemma 4.43 applied to the idempotent `e`). -/
lemma nonempty_hom_span_twistedSum_equiv (M : Type*) [AddCommGroup M]
    [Module (MonoidAlgebra ℂ G) M] [Module ℂ M] [IsScalarTower ℂ (MonoidAlgebra ℂ G) M] :
    Nonempty ((Ideal.span {twistedSum H 1} →ₗ[MonoidAlgebra ℂ G] M) ≃ₗ[ℂ]
      idemSubmodule ℂ M (avgElt H)) := by
  rw [← span_avgElt_eq H]
  exact ⟨homIdealSpanEquiv (avgElt_mul_self H)⟩

end Core

/-! ### Vanishing of Hom -/

section Young

variable {la mu : YoungDiagram} {n : ℕ}

/-- The row stabiliser `P_λ ≤ S_n` of a filling `T : λ ≃ Fin n`. -/
def rowStab (T : la ≃ Fin n) : Subgroup (Equiv.Perm (Fin n)) :=
  fiberSubgroup fun a : Fin n => (T.symm a : ℕ × ℕ).1

lemma rowSumN_eq_twistedSum (T : la ≃ Fin n) : rowSumN T = twistedSum (rowStab T) 1 := rfl

/-- The module `U_λ = ℂ[S_n] a_λ = Ind_{P_λ}^{S_n} 1` (as a left ideal of the group algebra). -/
@[kb "etingof2011" "Proposition 4.44, p. 60"]
noncomputable def permIdeal (T : la ≃ Fin n) : Ideal (MonoidAlgebra ℂ (Equiv.Perm (Fin n))) :=
  Ideal.span {rowSumN T}

lemma permIdeal_eq (T : la ≃ Fin n) :
    permIdeal T = Ideal.span {twistedSum (rowStab T) 1} := rfl

/-- Partial sums of row lengths: `λ ⊴ μ` (dominance order). -/
def RowDominance (la mu : YoungDiagram) : Prop :=
  ∀ k, ∑ i ∈ range k, la.rowLen i ≤ ∑ i ∈ range k, mu.rowLen i

lemma not_rowDominance_of_lex
    (hlex : ∃ k, (∀ i < k, la.rowLen i = mu.rowLen i) ∧ mu.rowLen k < la.rowLen k) :
    ¬ RowDominance la mu := by
  obtain ⟨k, hk1, hk2⟩ := hlex
  intro h
  have := h (k + 1)
  have e : ∑ i ∈ range k, la.rowLen i = ∑ i ∈ range k, mu.rowLen i :=
    sum_congr rfl (fun i hi => hk1 i (mem_range.1 hi))
  rw [sum_range_succ, sum_range_succ, e] at this
  omega

lemma exists_collision_of_not_rowDominance (Tl : la ≃ Fin n) (Tm : mu ≃ Fin n)
    (g : Equiv.Perm (Fin n)) (hd : ¬ RowDominance la mu) :
    ∃ a b : Fin n, a ≠ b ∧ (Tl.symm a : ℕ × ℕ).1 = (Tl.symm b : ℕ × ℕ).1 ∧
      (Tm.symm (g⁻¹ a) : ℕ × ℕ).2 = (Tm.symm (g⁻¹ b) : ℕ × ℕ).2 := by
  by_contra hcon
  have hnc : ∀ a b : Fin n, a ≠ b → (Tl.symm a : ℕ × ℕ).1 = (Tl.symm b : ℕ × ℕ).1 →
      (Tm.symm (g⁻¹ a) : ℕ × ℕ).2 ≠ (Tm.symm (g⁻¹ b) : ℕ × ℕ).2 :=
    fun a b hab hr hc => hcon ⟨a, b, hab, hr, hc⟩
  exact hd fun k => sum_rowLen_le_of_noCollision la mu (fun a : Fin n => (Tl.symm a : ℕ × ℕ).1)
    (fun a : Fin n => (Tm.symm (g⁻¹ a) : ℕ × ℕ).2) (fun i => card_filter_row Tl 1 i)
    (fun j => card_filter_col Tm g⁻¹ j) hnc k

/-- The dominance form of Lemma 4.41: if `λ` is not dominated by `μ` then `a_λ x b_μ = 0`. -/
theorem rowSumN_mul_mul_colSumN_of_not_rowDominance (Tl : la ≃ Fin n) (Tm : mu ≃ Fin n)
    (hd : ¬ RowDominance la mu) (x : MonoidAlgebra ℂ (Equiv.Perm (Fin n))) :
    rowSumN Tl * x * colSumN Tm = 0 := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => rw [mul_add, add_mul, hx, hy, add_zero]
  | single g r =>
    have h1 : (MonoidAlgebra.single g r : MonoidAlgebra ℂ _) = r • MonoidAlgebra.single g 1 := by
      rw [MonoidAlgebra.smul_single, smul_eq_mul, mul_one]
    obtain ⟨a, b, hab, hr, hc⟩ := exists_collision_of_not_rowDominance Tl Tm g hd
    have hconj : g⁻¹ * Equiv.swap a b * g = Equiv.swap (g⁻¹ a) (g⁻¹ b) := by
      rw [Equiv.swap_apply_apply]
      simp
    have hz : rowSumN Tl * MonoidAlgebra.single g 1 * colSumN Tm = 0 := by
      refine twistedSum_mul_single_mul_twistedSum_eq_zero _ _ (signChar _)
        (swap_mem_fiberSubgroup _ hr) ?_ ?_
      · rw [hconj]
        exact swap_mem_fiberSubgroup _ hc
      · rw [hconj, Equiv.swap_inv]
        exact signChar_swap (fun h => hab (g⁻¹.injective h))
    rw [h1, mul_smul_comm, smul_mul_assoc, hz, smul_zero]

/-- Vanishing of the `e`-part of `V_μ` when `a_λ x b_μ = 0` for all `x`. -/
lemma idemSubmodule_eq_bot_of_vanishing (Tl : la ≃ Fin n) (Tm : mu ≃ Fin n)
    (hv : ∀ x, rowSumN Tl * x * colSumN Tm = 0) (m : Ideal.span {youngSymmetrizerN Tm})
    (hm : m ∈ idemSubmodule ℂ (Ideal.span {youngSymmetrizerN Tm}) (avgElt (rowStab Tl))) :
    m = 0 := by
  rw [mem_idemSubmodule (e := avgElt (rowStab Tl)) (avgElt_mul_self _)] at hm
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.1 m.2
  have h1 : ((avgElt (rowStab Tl) • m : Ideal.span {youngSymmetrizerN Tm}) :
      MonoidAlgebra ℂ (Equiv.Perm (Fin n))) = 0 := by
    show avgElt (rowStab Tl) * (m : MonoidAlgebra ℂ (Equiv.Perm (Fin n))) = 0
    have h2 : rowSumN Tl * (y * youngSymmetrizerN Tm) = 0 := by
      unfold youngSymmetrizerN
      simpa [mul_assoc] using hv (y * rowSumN Tm)
    rw [← hy, avgElt, smul_mul_assoc, ← rowSumN_eq_twistedSum, h2, smul_zero]
  rw [hm] at h1
  exact Subtype.ext h1

/-- If `a_λ x b_μ = 0` for all `x`, then there is no nonzero module map `U_λ → V_μ`. -/
theorem subsingleton_hom_of_vanishing (Tl : la ≃ Fin n) (Tm : mu ≃ Fin n)
    (hv : ∀ x, rowSumN Tl * x * colSumN Tm = 0) :
    Subsingleton (permIdeal Tl →ₗ[MonoidAlgebra ℂ (Equiv.Perm (Fin n))]
      Ideal.span {youngSymmetrizerN Tm}) := by
  obtain ⟨e⟩ := nonempty_hom_span_twistedSum_equiv (rowStab Tl) (Ideal.span {youngSymmetrizerN Tm})
  have hs : Subsingleton (idemSubmodule ℂ (Ideal.span {youngSymmetrizerN Tm})
      (avgElt (rowStab Tl))) :=
    ⟨fun x y => Subtype.ext ((idemSubmodule_eq_bot_of_vanishing Tl Tm hv x.1 x.2).trans
      (idemSubmodule_eq_bot_of_vanishing Tl Tm hv y.1 y.2).symm)⟩
  exact e.injective.subsingleton

/-- **Proposition 4.44 (vanishing part, lexicographic form).** If `μ < λ` lexicographically, then
`Hom_{S_n}(U_λ, V_μ) = 0`. -/
@[kb "etingof2011" "Proposition 4.44, p. 60"]
theorem subsingleton_hom_of_lex (Tl : la ≃ Fin n) (Tm : mu ≃ Fin n)
    (hlex : ∃ k, (∀ i < k, la.rowLen i = mu.rowLen i) ∧ mu.rowLen k < la.rowLen k) :
    Subsingleton (permIdeal Tl →ₗ[MonoidAlgebra ℂ (Equiv.Perm (Fin n))]
      Ideal.span {youngSymmetrizerN Tm}) :=
  subsingleton_hom_of_vanishing Tl Tm (rowSumN_mul_mul_colSumN_of_lex Tl Tm hlex)

/-- Dominance form of the vanishing: `Hom_{S_n}(U_λ, V_μ) = 0` unless `λ ⊴ μ`. -/
theorem subsingleton_hom_of_not_rowDominance (Tl : la ≃ Fin n) (Tm : mu ≃ Fin n)
    (hd : ¬ RowDominance la mu) :
    Subsingleton (permIdeal Tl →ₗ[MonoidAlgebra ℂ (Equiv.Perm (Fin n))]
      Ideal.span {youngSymmetrizerN Tm}) :=
  subsingleton_hom_of_vanishing Tl Tm (rowSumN_mul_mul_colSumN_of_not_rowDominance Tl Tm hd)

/-- **Proposition 4.44 (dimension part).** `dim Hom_{S_n}(U_λ, V_λ) = 1`. -/
@[kb "etingof2011" "Proposition 4.44, p. 60"]
theorem finrank_hom_self (T : la ≃ Fin n) :
    Module.finrank ℂ (permIdeal T →ₗ[MonoidAlgebra ℂ (Equiv.Perm (Fin n))]
      Ideal.span {youngSymmetrizerN T}) = 1 := by
  have hn := card_eq_of_equiv T
  subst hn
  obtain ⟨e⟩ := nonempty_hom_span_twistedSum_equiv (rowStab T) (Ideal.span {youngSymmetrizerN T})
  refine (LinearEquiv.finrank_eq e).trans ?_
  set M := Ideal.span {youngSymmetrizerN T} with hM
  have hN := natCard_subgroup_ne_zero (rowStab T)
  let v : M := ⟨youngSymmetrizerN T, Ideal.subset_span rfl⟩
  have hv0 : v ≠ 0 := fun h => youngSymmetrizer_ne_zero T (congrArg Subtype.val h)
  have hspan : idemSubmodule ℂ M (avgElt (rowStab T)) = Submodule.span ℂ {v} := by
    ext m
    rw [Submodule.mem_span_singleton]
    constructor
    · intro hm
      have hm' := (mem_idemSubmodule (e := avgElt (rowStab T)) (avgElt_mul_self _)).1 hm
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.1 m.2
      obtain ⟨ℓ, hℓ⟩ := rowSum_mul_mul_colSum T
      have h1 : rowSumN T * (y * youngSymmetrizerN T) = ℓ (y * rowSumN T) • youngSymmetrizerN T := by
        unfold youngSymmetrizerN
        have := hℓ (y * rowSum T)
        simp only [mul_assoc, youngSymmetrizer] at this
        exact this
      refine ⟨(Nat.card (rowStab T) : ℂ)⁻¹ * ℓ (y * rowSumN T), Subtype.ext ?_⟩
      have h3 : (m : MonoidAlgebra ℂ (Equiv.Perm (Fin la.card))) =
          ((Nat.card (rowStab T) : ℂ)⁻¹ * ℓ (y * rowSumN T)) • youngSymmetrizerN T := by
        calc (m : MonoidAlgebra ℂ (Equiv.Perm (Fin la.card)))
            = ((avgElt (rowStab T) • m : M) : MonoidAlgebra ℂ (Equiv.Perm (Fin la.card))) := by
              rw [hm']
          _ = avgElt (rowStab T) * (y * youngSymmetrizerN T) := by rw [hy]; rfl
          _ = _ := by
              rw [avgElt, smul_mul_assoc, ← rowSumN_eq_twistedSum, h1, smul_smul]
      exact h3.symm
    · rintro ⟨s, rfl⟩
      have hev : avgElt (rowStab T) • v = v := Subtype.ext (by
        show avgElt (rowStab T) * youngSymmetrizerN T = youngSymmetrizerN T
        unfold avgElt youngSymmetrizerN
        rw [smul_mul_assoc, ← mul_assoc, rowSumN_eq_twistedSum, twistedSum_one_mul_self,
          smul_mul_assoc, smul_smul, inv_mul_cancel₀ hN, one_smul])
      rw [mem_idemSubmodule (e := avgElt (rowStab T)) (avgElt_mul_self _), smul_comm, hev]
  rw [hspan, finrank_span_singleton hv0]

/-! ### Kostka numbers -/

/-- The dimension of `Hom_{S_n}(U_λ, V_μ)` for fillings `T_λ`, `T_μ`.  By Schur's lemma and complete
reducibility this is the multiplicity of the irreducible `V_μ` in `U_λ`, hence the Kostka number. -/
noncomputable def kostkaDim (Tl : la ≃ Fin n) (Tm : mu ≃ Fin n) : ℕ :=
  Module.finrank ℂ (permIdeal Tl →ₗ[MonoidAlgebra ℂ (Equiv.Perm (Fin n))]
    Ideal.span {youngSymmetrizerN Tm})

/-- **Definition 4.45.** The Kostka number `K_{μλ}`: the multiplicity of the Specht module `V_μ` in
`U_λ = Ind_{P_λ}^{S_n} 1`, computed as `dim Hom_{S_n}(U_λ, V_μ)` (using the standard fillings
`spechtTableau`). -/
@[kb "etingof2011" "Definition 4.45, p. 60"]
noncomputable def kostka {n : ℕ} (mu la : DiagramsOfSize n) : ℕ :=
  kostkaDim (spechtTableau la) (spechtTableau mu)

/-- **§4.15 Remark.** `K_{μλ} = 0` unless `λ ⊴ μ` (the dominance order: partial sums of rows of `λ` are at
most those of `μ`, i.e. `μ - λ` is a sum of positive roots). -/
@[kb "etingof2011" "§4.15 Remark, p. 63"]
theorem kostka_eq_zero_of_not_rowDominance {n : ℕ} (mu la : DiagramsOfSize n)
    (h : ¬ RowDominance la.1 mu.1) : kostka mu la = 0 := by
  have := subsingleton_hom_of_not_rowDominance (spechtTableau la) (spechtTableau mu) h
  exact Module.finrank_zero_of_subsingleton

/-- Lexicographic form of the vanishing: `K_{μλ} = 0` if `μ < λ` lexicographically. -/
theorem kostka_eq_zero_of_lex {n : ℕ} (mu la : DiagramsOfSize n)
    (hlex : ∃ k, (∀ i < k, la.1.rowLen i = mu.1.rowLen i) ∧ mu.1.rowLen k < la.1.rowLen k) :
    kostka mu la = 0 :=
  kostka_eq_zero_of_not_rowDominance mu la (not_rowDominance_of_lex hlex)

/-- **§4.15 Remark / Proposition 4.44.** `K_{λλ} = 1`. -/
@[kb "etingof2011" "§4.15 Remark, p. 63"]
theorem kostka_self {n : ℕ} (la : DiagramsOfSize n) : kostka la la = 1 :=
  finrank_hom_self (spechtTableau la)

end Young

/-! ### Colourings: the cosets `S_n / P_λ` as words of content `λ` -/

section Colourings

open scoped Classical

variable {α β : Type*} [Fintype α]

/-- The number of points of `α` of colour `j` under the colouring `f`. -/
noncomputable def colourContent (f : α → β) (j : β) : ℕ := (univ.filter fun a => f a = j).card

lemma colourContent_comp_perm (f : α → β) (σ : Equiv.Perm α) (j : β) :
    colourContent (f ∘ σ) j = colourContent f j := by
  unfold colourContent
  refine Finset.card_equiv σ (fun a => ?_)
  simp

/-- Two colourings with the same content differ by a permutation of the points. -/
lemma exists_perm_comp_eq {f f' : α → β} (h : ∀ j, colourContent f j = colourContent f' j) :
    ∃ σ : Equiv.Perm α, f' ∘ σ = f := by
  have e : ∀ j, {a // f a = j} ≃ {a // f' a = j} := fun j =>
    Fintype.equivOfCardEq (by
      rw [Fintype.card_subtype, Fintype.card_subtype]
      exact h j)
  refine ⟨(Equiv.sigmaFiberEquiv f).symm.trans ((Equiv.sigmaCongrRight e).trans
    (Equiv.sigmaFiberEquiv f')), ?_⟩
  funext x
  simp only [Function.comp_apply, Equiv.trans_apply]
  have := (e (f x) ⟨x, rfl⟩).2
  simpa [Equiv.sigmaFiberEquiv] using this

/-- The fixed points of `g` on the cosets `S_α / Stab(f₀)` correspond to the `g`-invariant colourings with the
same content as `f₀`. -/
lemma card_fixedBy_quotient_fiberSubgroup (f₀ : α → β) (g : Equiv.Perm α) :
    Nat.card (MulAction.fixedBy (Equiv.Perm α ⧸ fiberSubgroup f₀) g) =
      Nat.card {f : α → β // (∀ j, colourContent f j = colourContent f₀ j) ∧ f ∘ g = f} := by
  let Φ : Equiv.Perm α ⧸ fiberSubgroup f₀ → (α → β) := fun q =>
    Quotient.liftOn' q (fun σ => f₀ ∘ ⇑σ⁻¹) (by
      intro σ τ h
      have h' : σ⁻¹ * τ ∈ fiberSubgroup f₀ := QuotientGroup.leftRel_apply.1 h
      funext i
      have := (mem_fiberSubgroup f₀ _).1 (inv_mem h') (σ⁻¹ i)
      simpa [mul_assoc] using this.symm)
  have hΦ : ∀ σ : Equiv.Perm α, Φ (QuotientGroup.mk σ) = f₀ ∘ ⇑σ⁻¹ := fun σ => rfl
  have hinj : Function.Injective Φ := by
    intro q r
    induction q using QuotientGroup.induction_on with | _ σ => ?_
    induction r using QuotientGroup.induction_on with | _ τ => ?_
    intro h
    rw [hΦ, hΦ] at h
    apply QuotientGroup.eq.2
    rw [mem_fiberSubgroup]
    intro i
    have := congrFun h (τ i)
    simp at this
    simpa using this
  have hcont : ∀ q, ∀ j, colourContent (Φ q) j = colourContent f₀ j := by
    intro q
    induction q using QuotientGroup.induction_on with | _ σ => ?_
    intro j
    rw [hΦ]
    exact colourContent_comp_perm f₀ σ⁻¹ j
  have hfix : ∀ q, g • q = q → Φ q ∘ g = Φ q := by
    intro q
    induction q using QuotientGroup.induction_on with | _ σ => ?_
    intro h
    have h' : (QuotientGroup.mk (g * σ) : Equiv.Perm α ⧸ fiberSubgroup f₀) = QuotientGroup.mk σ := h
    have h2 := congrArg Φ h'
    rw [hΦ, hΦ] at h2
    rw [hΦ]
    funext i
    have := congrFun h2 (g i)
    simp at this
    simpa using this.symm
  refine Nat.card_congr (Equiv.ofBijective
    (fun c => ⟨Φ c.1, hcont c.1, hfix c.1 (MulAction.mem_fixedBy.1 c.2)⟩) ⟨?_, ?_⟩)
  · intro c d h
    exact Subtype.ext (hinj (congrArg Subtype.val h))
  · rintro ⟨f, hf1, hf2⟩
    obtain ⟨σ, hσ⟩ := exists_perm_comp_eq hf1
    refine ⟨⟨QuotientGroup.mk σ⁻¹, MulAction.mem_fixedBy.2 ?_⟩, ?_⟩
    · show (QuotientGroup.mk (g * σ⁻¹) : Equiv.Perm α ⧸ fiberSubgroup f₀) = QuotientGroup.mk σ⁻¹
      apply hinj
      rw [hΦ, hΦ]
      funext i
      have h3 := congrFun hf2 (g⁻¹ i)
      simp at h3
      simp only [Function.comp_apply, mul_inv_rev, inv_inv, Equiv.Perm.coe_mul]
      have h4 := congrFun hσ (g⁻¹ i)
      have h5 := congrFun hσ i
      simp only [Function.comp_apply] at h4 h5
      rw [h4, h5]
      exact h3.symm
    · apply Subtype.ext
      show Φ (QuotientGroup.mk σ⁻¹) = f
      rw [hΦ, ← hσ]
      funext i
      simp

end Colourings

/-! ### Cycles of a permutation and the generating function of invariant colourings -/

section CycleGF

open scoped Classical

variable {α : Type*} [Fintype α]

/-- The orbits of the cyclic group generated by `g` on `α` (the cycles of `g`, fixed points included). -/
abbrev CycleClasses (g : Equiv.Perm α) := Quotient (Equiv.Perm.SameCycle.setoid g)

/-- The length of a cycle of `g` (the size of an orbit of `⟨g⟩`). -/
noncomputable def classSize (g : Equiv.Perm α) (q : CycleClasses g) : ℕ :=
  (univ.filter fun a : α => (Quotient.mk (Equiv.Perm.SameCycle.setoid g) a) = q).card

/-- The number `i_m` of cycles of length `m` of `g` (fixed points are cycles of length `1`). -/
noncomputable def cycleCount (g : Equiv.Perm α) (m : ℕ) : ℕ :=
  (univ.filter fun q : CycleClasses g => classSize g q = m).card

omit [Fintype α] in
lemma comp_zpow_eq {β : Type*} (f : α → β) (g : Equiv.Perm α) (hf : f ∘ g = f) (i : ℤ) :
    ∀ x : α, f ((g ^ i) x) = f x := by
  refine Int.induction_on i (fun x => by simp) (fun i ih x => ?_) (fun i ih x => ?_)
  · rw [zpow_add_one]
    simp only [Equiv.Perm.mul_apply]
    rw [ih]
    exact congrFun hf x
  · rw [zpow_sub_one]
    simp only [Equiv.Perm.mul_apply]
    rw [ih]
    have := congrFun hf (g⁻¹ x)
    simpa using this.symm

omit [Fintype α] in
lemma eq_of_sameCycle {β : Type*} (f : α → β) (g : Equiv.Perm α) (hf : f ∘ g = f) {x y : α}
    (h : g.SameCycle x y) : f x = f y := by
  obtain ⟨i, rfl⟩ := h
  exact (comp_zpow_eq f g hf i x).symm

lemma classSize_pos (g : Equiv.Perm α) (q : CycleClasses g) : 0 < classSize g q := by
  induction q using Quotient.inductionOn with | _ a => ?_
  exact Finset.card_pos.2 ⟨a, by simp⟩

lemma classSize_le (g : Equiv.Perm α) (q : CycleClasses g) : classSize g q ≤ Fintype.card α :=
  Finset.card_le_univ _

/-- A product over the cycles of `g` is the product over lengths `m` of the `i_m`-th powers. -/
lemma prod_classSize_eq {R : Type*} [CommMonoid R] (g : Equiv.Perm α) (F : ℕ → R) :
    ∏ q : CycleClasses g, F (classSize g q) =
      ∏ m ∈ Finset.Icc 1 (Fintype.card α), F m ^ cycleCount g m := by
  rw [← Finset.prod_fiberwise_of_maps_to (s := univ) (t := Finset.Icc 1 (Fintype.card α))
    (g := classSize g) (fun q _ => Finset.mem_Icc.2 ⟨classSize_pos g q, classSize_le g q⟩)]
  refine Finset.prod_congr rfl fun m _ => ?_
  rw [Finset.prod_congr rfl (g := fun _ => F m) (fun q hq => by rw [(mem_filter.1 hq).2]),
    Finset.prod_const]
  rfl

variable {β : Type*}

lemma colourContent_comp_mk (g : Equiv.Perm α) (h : CycleClasses g → β) (j : β) :
    colourContent (h ∘ (Quotient.mk (Equiv.Perm.SameCycle.setoid g))) j =
      ∑ q, if h q = j then classSize g q else 0 := by
  unfold colourContent classSize
  rw [Finset.card_filter, ← Finset.sum_fiberwise univ (Quotient.mk (Equiv.Perm.SameCycle.setoid g))]
  refine Finset.sum_congr rfl fun q _ => ?_
  rw [Finset.sum_congr rfl (g := fun _ => if h q = j then 1 else 0)]
  · rw [Finset.sum_const, smul_eq_mul]
    split_ifs <;> simp
  · intro a ha
    simp only [mem_filter, mem_univ, true_and] at ha
    simp [ha]

/-- The coefficient of `x^d` in `∏_{cycles c of g} p_{|c|}(x)` counts the `g`-invariant colourings of
content `d`. -/
theorem coeff_prod_psum_classSize [Fintype β] (g : Equiv.Perm α) (d : β →₀ ℕ) :
    (∏ q : CycleClasses g, MvPolynomial.psum β ℂ (classSize g q)).coeff d =
      ((univ.filter fun f : α → β => f ∘ g = f ∧ ∀ j, colourContent f j = d j).card : ℂ) := by
  simp only [MvPolynomial.psum]
  rw [Finset.prod_univ_sum (fun _ => (univ : Finset β))
    (fun q j => (MvPolynomial.X j ^ classSize g q : MvPolynomial β ℂ)), Fintype.piFinset_univ]
  have hmono : ∀ h : CycleClasses g → β, ∏ q, (MvPolynomial.X (h q) ^ classSize g q : MvPolynomial β ℂ) =
      MvPolynomial.monomial (∑ q, Finsupp.single (h q) (classSize g q)) 1 := by
    intro h
    rw [MvPolynomial.monomial_sum_one]
    exact prod_congr rfl fun q _ => by rw [MvPolynomial.X_pow_eq_monomial]
  simp only [hmono, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
  rw [Finset.sum_boole]
  congr 1
  refine Finset.card_bij (fun h _ => h ∘ (Quotient.mk (Equiv.Perm.SameCycle.setoid g))) ?_ ?_ ?_
  · intro h hh
    simp only [mem_filter, mem_univ, true_and] at hh ⊢
    refine ⟨?_, fun j => ?_⟩
    · funext a
      simp only [Function.comp_apply]
      congr 1
      exact Quotient.sound (Equiv.Perm.sameCycle_apply_left.2 Equiv.Perm.SameCycle.rfl)
    · rw [colourContent_comp_mk, ← hh]
      simp [Finsupp.finsetSum_apply, Finsupp.single_apply]
  · intro h1 _ h2 _ heq
    funext q
    induction q using Quotient.inductionOn with | _ a => exact congrFun heq a
  · intro f hf
    simp only [mem_filter, mem_univ, true_and] at hf
    refine ⟨Quotient.lift f (fun x y hxy => eq_of_sameCycle f g hf.1 hxy), ?_, ?_⟩
    · simp only [mem_filter, mem_univ, true_and]
      ext j
      have h1 := colourContent_comp_mk g (Quotient.lift f fun x y hxy => eq_of_sameCycle f g hf.1 hxy) j
      have h2 : (Quotient.lift f fun x y hxy => eq_of_sameCycle f g hf.1 hxy) ∘
          (Quotient.mk (Equiv.Perm.SameCycle.setoid g)) = f := rfl
      rw [h2] at h1
      rw [Finsupp.finsetSum_apply, ← hf.2 j, h1]
      exact Finset.sum_congr rfl fun q _ => Finsupp.single_apply
    · funext a
      rfl

end CycleGF

/-! ### Theorem 4.46: the character of `U_λ` -/

section Character

open scoped Classical

variable {la : YoungDiagram} {n : ℕ}

lemma rowOf_lt_of_colLen_le (T : la ≃ Fin n) {N : ℕ} (hN : la.colLen 0 ≤ N) (a : Fin n) :
    (T.symm a : ℕ × ℕ).1 < N := by
  have h1 : (T.symm a : ℕ × ℕ) ∈ la := (T.symm a).2
  have h2 : ((T.symm a : ℕ × ℕ).1, 0) ∈ la := la.up_left_mem le_rfl (Nat.zero_le _) h1
  rw [YoungDiagram.mem_iff_lt_colLen] at h2
  omega

/-- **Theorem 4.46 (fixed-point form).** The character of `U_λ = ℂ[S_n] a_λ` at `g` is the number of cosets
`x P_λ` fixed by `g`, i.e. the number of fixed points of `g` on `S_n / P_λ`. -/
@[kb "etingof2011" "Theorem 4.46, p. 60"]
theorem character_permIdeal_eq_card_fixedBy (T : la ≃ Fin n) (g : Equiv.Perm (Fin n)) :
    LinearMap.trace ℂ (permSubspace (rowStab T)) (permAction (rowStab T) g) =
      (Nat.card (MulAction.fixedBy (Equiv.Perm (Fin n) ⧸ rowStab T) g) : ℂ) :=
  trace_permAction (rowStab T) g

/-- **Theorem 4.46.** Let `λ` have at most `N` rows.  The character of `U_λ` at a permutation `g` with `i_m`
cycles of length `m` (`i_m = cycleCount g m`) is the coefficient of `x^λ = x_1^{λ_1} ⋯ x_N^{λ_N}` in
`∏_m (x_1^m + ⋯ + x_N^m)^{i_m}`. -/
@[kb "etingof2011" "Theorem 4.46, p. 60"]
theorem character_permIdeal_eq_coeff (T : la ≃ Fin n) {N : ℕ} (hN : la.colLen 0 ≤ N)
    (g : Equiv.Perm (Fin n)) :
    LinearMap.trace ℂ (permSubspace (rowStab T)) (permAction (rowStab T) g) =
      (∏ m ∈ Finset.Icc 1 n, MvPolynomial.psum (Fin N) ℂ m ^ cycleCount g m).coeff
        (Finsupp.equivFunOnFinite.symm fun j : Fin N => la.rowLen j) := by
  rw [character_permIdeal_eq_card_fixedBy]
  let f₀ : Fin n → Fin N := fun a => ⟨(T.symm a : ℕ × ℕ).1, rowOf_lt_of_colLen_le T hN a⟩
  have hP : fiberSubgroup f₀ = rowStab T := by
    ext σ
    simp only [mem_fiberSubgroup, rowStab, Fin.ext_iff, f₀]
  have h1 := card_fixedBy_quotient_fiberSubgroup f₀ g
  rw [hP] at h1
  have h3 : ∏ m ∈ Finset.Icc 1 n, MvPolynomial.psum (Fin N) ℂ m ^ cycleCount g m =
      ∏ q : CycleClasses g, MvPolynomial.psum (Fin N) ℂ (classSize g q) := by
    rw [prod_classSize_eq g (fun m => MvPolynomial.psum (Fin N) ℂ m), Fintype.card_fin]
  rw [h3, coeff_prod_psum_classSize, h1, Nat.card_eq_fintype_card, Fintype.card_subtype]
  congr 2
  have hc : ∀ j : Fin N, colourContent f₀ j = la.rowLen j := by
    intro j
    have := card_filter_row T 1 j.val
    rw [← this]
    unfold colourContent
    congr 1
    ext a
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, f₀, Fin.ext_iff]
    simp
  have hd : ∀ j : Fin N, (Finsupp.equivFunOnFinite.symm fun j : Fin N => la.rowLen j) j = la.rowLen j :=
    fun j => rfl
  ext f
  simp only [mem_filter, mem_univ, true_and, hc, hd]
  tauto

end Character

end UndergradKB.RepresentationTheory
