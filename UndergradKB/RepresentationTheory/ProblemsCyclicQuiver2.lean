import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.LinearAlgebra.Eigenspace.Triangularizable
import Mathlib.LinearAlgebra.Dual.Lemmas
import Mathlib.LinearAlgebra.Dimension.Constructions
import UndergradKB.Common.Attr
import UndergradKB.RepresentationTheory.ProblemsCyclicQuiver

/-! # Problem 5.39 (b), (c): classification of indecomposables of the cyclic quiver

The key lemma is a graded form of the Jordan chain splitting: for a nilpotent operator `X` on a
finite-dimensional space `U = V ⊕ W` exchanging the two summands, a chain of maximal length has an
`X`-invariant, grading-compatible complement.
-/

namespace UndergradKB.RepresentationTheory

open Module

section Chain

variable {k : Type*} [Field k] {U : Type*} [AddCommGroup U] [Module k U] [FiniteDimensional k U]

theorem pow_eq_zero_of_ge (X : Module.End k U) (h : ℕ) (hnil : ∀ x, (X ^ (h + 1)) x = 0) {m : ℕ}
    (hm : h + 1 ≤ m) (x : U) : (X ^ m) x = 0 := by
  have : X ^ m = X ^ (m - (h + 1)) * X ^ (h + 1) := by
    rw [← pow_add]; congr 1; omega
  rw [this, Module.End.mul_apply, hnil, map_zero]

/-- The core of the chain splitting: a chain of maximal length `h + 1` generated by `u`, together
with a functional `φ` with `φ (X^h u) = 1`, is independent and complementary to the common kernel of
`φ ∘ X^j` (`j ≤ h`). -/
theorem chain_core (X : Module.End k U) (h : ℕ) (hnil : ∀ x, (X ^ (h + 1)) x = 0) (u : U)
    (φ : U →ₗ[k] k) (hφ : φ ((X ^ h) u) = 1) :
    LinearIndependent k (fun j : Fin (h + 1) => (X ^ (j : ℕ)) u) ∧
      IsCompl (Submodule.span k (Set.range fun j : Fin (h + 1) => (X ^ (j : ℕ)) u))
        (LinearMap.ker (LinearMap.pi fun j : Fin (h + 1) => φ ∘ₗ (X ^ (j : ℕ)))) := by
  have key : ∀ g : Fin (h + 1) → k,
      (∀ j : Fin (h + 1), φ ((X ^ (j : ℕ)) (∑ i, g i • (X ^ (i : ℕ)) u)) = 0) → g = 0 := by
    intro g hg
    have step : ∀ n : ℕ, n ≤ h + 1 → ∀ i : Fin (h + 1), i.val < n → g i = 0 := by
      intro n
      induction n with
      | zero => intro _ i hi; omega
      | succ n ih =>
        intro hn i hi
        by_cases hlt : i.val < n
        · exact ih (by omega) i hlt
        · have hin : i.val = n := by omega
          have hnh : n ≤ h := by omega
          have h0 := hg ⟨h - n, by omega⟩
          simp only [map_sum, map_smul, Module.End.mul_apply, ← Module.End.mul_apply,
            ← pow_add] at h0
          rw [Finset.sum_eq_single i] at h0
          · have : h - n + i.val = h := by omega
            simp only [smul_eq_mul, this, hφ, mul_one] at h0
            exact h0
          · intro j _ hji
            rcases Nat.lt_or_ge j.val n with hj | hj
            · rw [ih (by omega) j hj, zero_smul]
            · have : h + 1 ≤ h - n + j.val := by
                have : j.val ≠ n := fun e => hji (Fin.ext (by omega))
                omega
              rw [pow_eq_zero_of_ge X h hnil this, map_zero, smul_zero]
          · intro hi'; exact absurd (Finset.mem_univ i) hi'
    funext i
    exact step (h + 1) le_rfl i i.2
  have indep : LinearIndependent k (fun j : Fin (h + 1) => (X ^ (j : ℕ)) u) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have := key g (fun j => by rw [hg, map_zero, map_zero])
    exact congrFun this i
  refine ⟨indep, ?_⟩
  set C := Submodule.span k (Set.range fun j : Fin (h + 1) => (X ^ (j : ℕ)) u) with hC
  set N := LinearMap.ker (LinearMap.pi fun j : Fin (h + 1) => φ ∘ₗ (X ^ (j : ℕ))) with hN
  have hdisj : Disjoint C N := by
    rw [Submodule.disjoint_def]
    intro x hxC hxN
    obtain ⟨g, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun k).1 hxC
    rw [hN, LinearMap.mem_ker] at hxN
    have := key g (fun j => by
      have := congrFun hxN j
      simpa using this)
    rw [this]; simp
  have hfin : Module.finrank k C = h + 1 := by
    rw [hC, finrank_span_eq_card indep]; simp
  have hrank : Module.finrank k (LinearMap.range (LinearMap.pi fun j : Fin (h + 1) =>
      φ ∘ₗ (X ^ (j : ℕ)))) ≤ h + 1 := by
    have := Submodule.finrank_le (LinearMap.range (LinearMap.pi fun j : Fin (h + 1) =>
      φ ∘ₗ (X ^ (j : ℕ))))
    simpa using this
  have hrn : Module.finrank k (LinearMap.range (LinearMap.pi fun j : Fin (h + 1) =>
      φ ∘ₗ (X ^ (j : ℕ)))) + Module.finrank k N = Module.finrank k U :=
    LinearMap.finrank_range_add_finrank_ker
      (LinearMap.pi fun j : Fin (h + 1) => φ ∘ₗ (X ^ (j : ℕ)))
  refine ⟨hdisj, ?_⟩
  rw [codisjoint_iff]
  apply Submodule.eq_top_of_finrank_eq
  have h1 := Submodule.finrank_sup_add_finrank_inf_eq C N
  rw [disjoint_iff.1 hdisj, finrank_bot] at h1
  have h2 := Submodule.finrank_le (C ⊔ N)
  omega

section Graded

variable (X P : Module.End k U) (hP : ∀ x, P (P x) = P x) (hXP : ∀ x, P (X x) = X (x - P x))

include hXP in
theorem par_even (z : U) (hz : P z = z) (j : ℕ) :
    P ((X ^ j) z) = if Even j then (X ^ j) z else 0 := by
  induction j with
  | zero => simpa using hz
  | succ j ih =>
    rw [pow_succ', Module.End.mul_apply, hXP]
    by_cases hj : Even j
    · rw [if_pos hj] at ih
      rw [ih, sub_self, map_zero, if_neg (by simpa [Nat.even_add_one] using hj)]
    · rw [if_neg hj] at ih
      rw [ih, sub_zero, if_pos (by simpa [Nat.even_add_one] using hj)]

include hXP in
theorem par_odd (z : U) (hz : P z = 0) (j : ℕ) :
    P ((X ^ j) z) = if Even j then 0 else (X ^ j) z := by
  induction j with
  | zero => simpa using hz
  | succ j ih =>
    rw [pow_succ', Module.End.mul_apply, hXP]
    by_cases hj : Even j
    · rw [if_pos hj] at ih
      rw [ih, sub_zero, if_neg (by simpa [Nat.even_add_one] using hj)]
    · rw [if_neg hj] at ih
      rw [ih, sub_self, map_zero, if_pos (by simpa [Nat.even_add_one] using hj)]

/-- Graded chain splitting. -/
theorem chain_split (X P : Module.End k U) (hP : ∀ x, P (P x) = P x)
    (hXP : ∀ x, P (X x) = X (x - P x)) (h : ℕ) (hnil : ∀ x, (X ^ (h + 1)) x = 0) (u : U)
    (hu : P u = u) (hh : (X ^ h) u ≠ 0) :
    ∃ M N : Submodule k U, IsCompl M N ∧ (∀ x ∈ M, X x ∈ M) ∧ (∀ x ∈ N, X x ∈ N) ∧
      (∀ x ∈ M, P x ∈ M) ∧ (∀ x ∈ N, P x ∈ N) ∧
      M = Submodule.span k (Set.range fun j : Fin (h + 1) => (X ^ (j : ℕ)) u) ∧
      LinearIndependent k (fun j : Fin (h + 1) => (X ^ (j : ℕ)) u) := by
  classical
  set y := (X ^ h) u with hy
  have hPy : P y = if Even h then y else 0 := par_even X P hXP u hu h
  let Q : Module.End k U := if Even h then P else LinearMap.id - P
  have hQy : Q y = y := by
    by_cases he : Even h
    · simp only [Q, if_pos he]; rw [hPy, if_pos he]
    · simp only [Q, if_neg he]; rw [LinearMap.sub_apply, hPy, if_neg he]; simp
  obtain ⟨φ0, hφ0⟩ : ∃ φ0 : Module.Dual k U, φ0 y ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hh ((Module.forall_dual_apply_eq_zero_iff k y).1 hcon)
  set φ : Module.Dual k U := (φ0 y)⁻¹ • φ0 with hφdef
  have hφ : φ y = 1 := by simp [hφdef, hφ0]
  set φ' : U →ₗ[k] k := φ ∘ₗ Q with hφ'
  have hφ'y : φ' y = 1 := by simp [hφ', hQy, hφ]
  obtain ⟨hind, hcompl⟩ := chain_core X h hnil u φ' hφ'y
  -- formula for `φ' (X^j x)`
  have hform : ∀ x j, φ' ((X ^ j) x) =
      if j % 2 = h % 2 then φ ((X ^ j) (P x)) else φ ((X ^ j) (x - P x)) := by
    intro x j
    have hz : P (P x) = P x := hP x
    have hz' : P (x - P x) = 0 := by rw [map_sub, hz, sub_self]
    have e1 := par_even X P hXP (P x) hz j
    have e2 := par_odd X P hXP (x - P x) hz' j
    have hx : x = P x + (x - P x) := by abel
    have : (X ^ j) x = (X ^ j) (P x) + (X ^ j) (x - P x) := by rw [← map_add, ← hx]
    rw [hφ', LinearMap.comp_apply, this, map_add, map_add]
    set A1 := (X ^ j) (P x) with hA1
    set A2 := (X ^ j) (x - P x) with hA2
    have hmod : (j % 2 = h % 2) ↔ (Even j ↔ Even h) := by
      rw [Nat.even_iff, Nat.even_iff]
      omega
    by_cases he : Even h <;> by_cases hj : Even j
    · have h3 : j % 2 = h % 2 := hmod.2 ⟨fun _ => he, fun _ => hj⟩
      simp only [Q, if_pos he, h3, if_true, e1, e2, if_pos hj]
      simp
    · have h3 : ¬ (j % 2 = h % 2) := fun h4 => hj ((hmod.1 h4).2 he)
      simp only [Q, if_pos he, h3, if_false, e1, e2, if_neg hj]
      simp
    · have h3 : ¬ (j % 2 = h % 2) := fun h4 => he ((hmod.1 h4).1 hj)
      simp only [Q, if_neg he, h3, if_false, LinearMap.sub_apply, LinearMap.id_apply, e1, e2, if_pos hj]
      simp
    · have h3 : j % 2 = h % 2 := hmod.2 ⟨fun h4 => absurd h4 hj, fun h4 => absurd h4 he⟩
      simp only [Q, if_neg he, h3, if_true, LinearMap.sub_apply, LinearMap.id_apply, e1, e2, if_neg hj]
      simp
  have hmemN : ∀ x, x ∈ LinearMap.ker (LinearMap.pi fun j : Fin (h + 1) => φ' ∘ₗ (X ^ (j : ℕ))) ↔
      ∀ j : Fin (h + 1), φ' ((X ^ (j : ℕ)) x) = 0 := by
    intro x
    simp [LinearMap.mem_ker, funext_iff]
  refine ⟨_, _, hcompl, ?_, ?_, ?_, ?_, rfl, hind⟩
  · -- `M` is `X`-stable
    have : Submodule.span k (Set.range fun j : Fin (h + 1) => (X ^ (j : ℕ)) u) ≤
        (Submodule.span k (Set.range fun j : Fin (h + 1) => (X ^ (j : ℕ)) u)).comap X := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_comap]; dsimp only
      rw [← Module.End.mul_apply, ← pow_succ']
      by_cases hj : (j : ℕ) + 1 < h + 1
      · exact Submodule.subset_span ⟨⟨(j : ℕ) + 1, hj⟩, rfl⟩
      · have : (j : ℕ) + 1 = h + 1 := by omega
        rw [this, hnil]; exact Submodule.zero_mem _
    exact fun x hx => this hx
  · -- `N` is `X`-stable
    intro x hx
    rw [hmemN] at hx ⊢
    intro j
    rw [← Module.End.mul_apply, ← pow_succ]
    by_cases hj : (j : ℕ) + 1 < h + 1
    · exact hx ⟨(j : ℕ) + 1, hj⟩
    · have : (j : ℕ) + 1 = h + 1 := by omega
      rw [this, hnil, map_zero]
  · -- `M` is `P`-stable
    have : Submodule.span k (Set.range fun j : Fin (h + 1) => (X ^ (j : ℕ)) u) ≤
        (Submodule.span k (Set.range fun j : Fin (h + 1) => (X ^ (j : ℕ)) u)).comap P := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_comap]; dsimp only
      rw [par_even X P hXP u hu]
      split_ifs
      · exact Submodule.subset_span ⟨j, rfl⟩
      · exact Submodule.zero_mem _
    exact fun x hx => this hx
  · -- `N` is `P`-stable
    intro x hx
    rw [hmemN] at hx ⊢
    intro j
    have h1 := hx j
    rw [hform] at h1 ⊢
    rw [hP x, sub_self, map_zero]
    split_ifs at h1 ⊢
    · exact h1
    · exact map_zero _

/-- Graded chain splitting, for a generator of either parity. -/
theorem chain_split' (X P : Module.End k U) (hP : ∀ x, P (P x) = P x)
    (hXP : ∀ x, P (X x) = X (x - P x)) (h : ℕ) (hnil : ∀ x, (X ^ (h + 1)) x = 0) (u : U)
    (hu : P u = u ∨ P u = 0) (hh : (X ^ h) u ≠ 0) :
    ∃ M N : Submodule k U, IsCompl M N ∧ (∀ x ∈ M, X x ∈ M) ∧ (∀ x ∈ N, X x ∈ N) ∧
      (∀ x ∈ M, P x ∈ M) ∧ (∀ x ∈ N, P x ∈ N) ∧
      M = Submodule.span k (Set.range fun j : Fin (h + 1) => (X ^ (j : ℕ)) u) ∧
      LinearIndependent k (fun j : Fin (h + 1) => (X ^ (j : ℕ)) u) := by
  rcases hu with hu | hu
  · exact chain_split X P hP hXP h hnil u hu hh
  · set P' : Module.End k U := LinearMap.id - P with hP'def
    have hP'x : ∀ x, P' x = x - P x := fun x => by simp [hP'def]
    have hP' : ∀ x, P' (P' x) = P' x := by
      intro x
      simp only [hP'x, map_sub, hP]; abel
    have hXP' : ∀ x, P' (X x) = X (x - P' x) := by
      intro x
      simp only [hP'x, hXP, map_sub, sub_sub_cancel]
    obtain ⟨M, N, hc, h1, h2, h3, h4, h5, h6⟩ :=
      chain_split X P' hP' hXP' h hnil u (by rw [hP'x, hu, sub_zero]) hh
    refine ⟨M, N, hc, h1, h2, fun x hx => ?_, fun x hx => ?_, h5, h6⟩
    · have := M.sub_mem hx (h3 x hx)
      rwa [hP'x, sub_sub_cancel] at this
    · have := N.sub_mem hx (h4 x hx)
      rwa [hP'x, sub_sub_cancel] at this

end Graded

end Chain

section Rep

variable {k : Type*} [Field k] {V W : Type*} [AddCommGroup V] [Module k V] [AddCommGroup W]
  [Module k W]

/-- The operator `X(v, w) = (B w, A v)` on `V ⊕ W`. -/
def cqX (A : V →ₗ[k] W) (B : W →ₗ[k] V) : Module.End k (V × W) :=
  LinearMap.prod (B ∘ₗ LinearMap.snd k V W) (A ∘ₗ LinearMap.fst k V W)

/-- The projection `(v, w) ↦ (v, 0)`. -/
def cqP (k : Type*) [Field k] (V W : Type*) [AddCommGroup V] [Module k V] [AddCommGroup W]
    [Module k W] : Module.End k (V × W) := LinearMap.inl k V W ∘ₗ LinearMap.fst k V W

@[simp] theorem cqX_apply (A : V →ₗ[k] W) (B : W →ₗ[k] V) (v : V) (w : W) :
    cqX A B (v, w) = (B w, A v) := rfl

@[simp] theorem cqP_apply (v : V) (w : W) : cqP k V W (v, w) = (v, 0) := rfl

theorem cqP_idem (x : V × W) : cqP k V W (cqP k V W x) = cqP k V W x := rfl

theorem cqXP (A : V →ₗ[k] W) (B : W →ₗ[k] V) (x : V × W) :
    cqP k V W (cqX A B x) = cqX A B (x - cqP k V W x) := by
  obtain ⟨v, w⟩ := x
  simp

theorem cqX_pow_even (A : V →ₗ[k] W) (B : W →ₗ[k] V) (i : ℕ) (v : V) (w : W) :
    (cqX A B ^ (2 * i)) (v, w) = (((B ∘ₗ A) ^ i) v, ((A ∘ₗ B) ^ i) w) := by
  induction i with
  | zero => simp
  | succ i ih =>
    rw [show 2 * (i + 1) = (2 * i + 1) + 1 by ring, pow_succ', Module.End.mul_apply,
      pow_succ', Module.End.mul_apply, ih, pow_succ' (B ∘ₗ A), pow_succ' (A ∘ₗ B)]
    simp

theorem cqX_pow_odd (A : V →ₗ[k] W) (B : W →ₗ[k] V) (i : ℕ) (v : V) :
    (cqX A B ^ (2 * i + 1)) (v, 0) = (0, A (((B ∘ₗ A) ^ i) v)) := by
  rw [pow_succ', Module.End.mul_apply, cqX_pow_even]
  simp

/-- A grading-compatible, `X`-stable splitting of `V × W` is a decomposition of the representation. -/
theorem cq_graded_decomp (A : V →ₗ[k] W) (B : W →ₗ[k] V) (M N : Submodule k (V × W))
    (hc : IsCompl M N) (hXM : ∀ x ∈ M, cqX A B x ∈ M) (hXN : ∀ x ∈ N, cqX A B x ∈ N)
    (hPM : ∀ x ∈ M, cqP k V W x ∈ M) (hPN : ∀ x ∈ N, cqP k V W x ∈ N) :
    CQDecomp A B (M.comap (LinearMap.inl k V W)) (N.comap (LinearMap.inl k V W))
      (M.comap (LinearMap.inr k V W)) (N.comap (LinearMap.inr k V W)) := by
  have hV : IsCompl (M.comap (LinearMap.inl k V W)) (N.comap (LinearMap.inl k V W)) := by
    refine ⟨?_, ?_⟩
    · rw [Submodule.disjoint_def]
      intro v hv1 hv2
      have := Submodule.disjoint_def.1 hc.disjoint (v, 0) hv1 hv2
      exact (Prod.ext_iff.1 this).1
    · rw [codisjoint_iff, eq_top_iff]
      intro v _
      have hmem : ((v, 0) : V × W) ∈ M ⊔ N := by rw [hc.sup_eq_top]; trivial
      obtain ⟨m, hm, n, hn, hmn⟩ := Submodule.mem_sup.1 hmem
      refine Submodule.mem_sup.2 ⟨m.1, ?_, n.1, ?_, ?_⟩
      · have := hPM m hm
        simpa [cqP] using this
      · have := hPN n hn
        simpa [cqP] using this
      · simpa using congrArg Prod.fst hmn
  have hW : IsCompl (M.comap (LinearMap.inr k V W)) (N.comap (LinearMap.inr k V W)) := by
    refine ⟨?_, ?_⟩
    · rw [Submodule.disjoint_def]
      intro w hw1 hw2
      have := Submodule.disjoint_def.1 hc.disjoint (0, w) hw1 hw2
      exact (Prod.ext_iff.1 this).2
    · rw [codisjoint_iff, eq_top_iff]
      intro w _
      have hmem : ((0, w) : V × W) ∈ M ⊔ N := by rw [hc.sup_eq_top]; trivial
      obtain ⟨m, hm, n, hn, hmn⟩ := Submodule.mem_sup.1 hmem
      refine Submodule.mem_sup.2 ⟨m.2, ?_, n.2, ?_, ?_⟩
      · have e : ((0 : V), m.2) = m - cqP k V W m := by ext <;> simp [cqP]
        show ((0 : V), m.2) ∈ M
        rw [e]; exact M.sub_mem hm (hPM m hm)
      · have e : ((0 : V), n.2) = n - cqP k V W n := by ext <;> simp [cqP]
        show ((0 : V), n.2) ∈ N
        rw [e]; exact N.sub_mem hn (hPN n hn)
      · simpa using congrArg Prod.snd hmn
  refine ⟨hV, hW, ?_, ?_, ?_, ?_⟩
  · intro v hv
    have := hXM _ hv
    simpa using this
  · intro v hv
    have := hXN _ hv
    simpa using this
  · intro w hw
    have := hXM _ hw
    simpa using this
  · intro w hw
    have := hXN _ hw
    simpa using this

/-- Extracting bases of `V` and `W` from a chain basis of `V × W` generated by `(v, 0)`. -/
theorem chain_bases (A : V →ₗ[k] W) (B : W →ₗ[k] V) (h p q : ℕ) (v : V)
    (ev : Fin p → Fin (h + 1)) (od : Fin q → Fin (h + 1))
    (hev : ∀ i, (ev i : ℕ) = 2 * i) (hod : ∀ i, (od i : ℕ) = 2 * i + 1)
    (hcov : ∀ j : Fin (h + 1), (∃ i, ev i = j) ∨ (∃ i, od i = j))
    (hnil : ∀ x, (cqX A B ^ (h + 1)) x = 0)
    (hli : LinearIndependent k (fun j : Fin (h + 1) => (cqX A B ^ (j : ℕ)) (v, 0)))
    (hsp : Submodule.span k (Set.range fun j : Fin (h + 1) => (cqX A B ^ (j : ℕ)) (v, 0)) = ⊤) :
    LinearIndependent k (fun i : Fin p => ((B ∘ₗ A) ^ (i : ℕ)) v) ∧
      Submodule.span k (Set.range fun i : Fin p => ((B ∘ₗ A) ^ (i : ℕ)) v) = ⊤ ∧
      LinearIndependent k (fun i : Fin q => A (((B ∘ₗ A) ^ (i : ℕ)) v)) ∧
      Submodule.span k (Set.range fun i : Fin q => A (((B ∘ₗ A) ^ (i : ℕ)) v)) = ⊤ := by
  have hevX : ∀ i : Fin p, (cqX A B ^ (ev i : ℕ)) (v, 0) = (((B ∘ₗ A) ^ (i : ℕ)) v, 0) := by
    intro i
    rw [hev, cqX_pow_even]; simp
  have hodX : ∀ i : Fin q, (cqX A B ^ (od i : ℕ)) (v, 0) = (0, A (((B ∘ₗ A) ^ (i : ℕ)) v)) := by
    intro i
    rw [hod, cqX_pow_odd]
  have hevinj : Function.Injective ev := fun i j hij => Fin.ext (by
    have := congrArg Fin.val hij; rw [hev, hev] at this; omega)
  have hodinj : Function.Injective od := fun i j hij => Fin.ext (by
    have := congrArg Fin.val hij; rw [hod, hod] at this; omega)
  refine ⟨?_, ?_, ?_, ?_⟩
  · refine LinearIndependent.of_comp (LinearMap.inl k V W) ?_
    have := hli.comp ev hevinj
    convert this using 1
    funext i
    exact (hevX i).symm
  · rw [eq_top_iff]
    intro v' _
    have hmem : ((v', 0) : V × W) ∈ Submodule.span k
        (Set.range fun j : Fin (h + 1) => (cqX A B ^ (j : ℕ)) (v, 0)) := by rw [hsp]; trivial
    have hS : Submodule.span k (Set.range fun j : Fin (h + 1) => (cqX A B ^ (j : ℕ)) (v, 0)) ≤
        (Submodule.map (LinearMap.inl k V W)
          (Submodule.span k (Set.range fun i : Fin p => ((B ∘ₗ A) ^ (i : ℕ)) v))).comap
          (cqP k V W) := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_comap]; dsimp only
      rcases hcov j with ⟨i, rfl⟩ | ⟨i, rfl⟩
      · rw [hevX]
        exact ⟨_, Submodule.subset_span ⟨i, rfl⟩, rfl⟩
      · rw [hodX]
        simp
    obtain ⟨y, hy, hyeq⟩ := hS hmem
    have : y = v' := by simpa using congrArg Prod.fst hyeq
    rwa [this] at hy
  · refine LinearIndependent.of_comp (LinearMap.inr k V W) ?_
    have := hli.comp od hodinj
    convert this using 1
    funext i
    exact (hodX i).symm
  · rw [eq_top_iff]
    intro w' _
    have hmem : ((0, w') : V × W) ∈ Submodule.span k
        (Set.range fun j : Fin (h + 1) => (cqX A B ^ (j : ℕ)) (v, 0)) := by rw [hsp]; trivial
    have hS : Submodule.span k (Set.range fun j : Fin (h + 1) => (cqX A B ^ (j : ℕ)) (v, 0)) ≤
        (Submodule.map (LinearMap.inr k V W)
          (Submodule.span k (Set.range fun i : Fin q => A (((B ∘ₗ A) ^ (i : ℕ)) v)))).comap
          (LinearMap.id - cqP k V W) := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_comap]; dsimp only
      rcases hcov j with ⟨i, rfl⟩ | ⟨i, rfl⟩
      · rw [hevX]
        simp
      · rw [hodX]
        exact ⟨_, Submodule.subset_span ⟨i, rfl⟩, by simp [cqP]⟩
    obtain ⟨y, hy, hyeq⟩ := hS hmem
    have : y = w' := by simpa [cqP] using congrArg Prod.snd hyeq
    rwa [this] at hy

theorem truncA_single_castSucc (m : ℕ) (i : Fin m) :
    truncA m (Pi.single (Fin.castSucc i) (1 : k) : Fin (m + 1) → k) = Pi.single i 1 := by
  funext l
  simp [truncA, Pi.single_apply, Fin.castSucc_inj]

theorem truncA_single_last (m : ℕ) :
    truncA m (Pi.single (Fin.last m) (1 : k) : Fin (m + 1) → k) = 0 := by
  funext l
  simp [truncA, Pi.single_apply, Fin.castSucc_ne_last]

theorem shiftB_single (m : ℕ) (j : Fin m) :
    shiftB m (Pi.single j (1 : k) : Fin m → k) = Pi.single j.succ 1 := by
  funext l
  simp only [shiftB, LinearMap.coe_mk, AddHom.coe_mk]
  by_cases h : 0 < l.val
  · rw [dif_pos h]
    obtain ⟨l', rfl⟩ := Fin.exists_succ_eq.2 (Fin.pos_iff_ne_zero.1 h)
    simp [Pi.single_apply, Fin.succ_inj]
  · rw [dif_neg h]
    have : l = 0 := Fin.ext (by rw [Fin.val_zero]; omega)
    subst this
    simp [Fin.succ_ne_zero]

end Rep

section IsoH

universe u

variable {k : Type u} [Field k] {V W : Type u} [AddCommGroup V] [Module k V] [AddCommGroup W]
  [Module k W]

/-- A chain of odd length `2m + 1` starting in `V` gives a representation isomorphic to `H_{m+1}`. -/
theorem cq_iso_H (A : V →ₗ[k] W) (B : W →ₗ[k] V) (m : ℕ) (v : V)
    (hnil : ∀ x, (cqX A B ^ (2 * m + 1)) x = 0)
    (hli : LinearIndependent k (fun j : Fin (2 * m + 1) => (cqX A B ^ (j : ℕ)) (v, 0)))
    (hsp : Submodule.span k
      (Set.range fun j : Fin (2 * m + 1) => (cqX A B ^ (j : ℕ)) (v, 0)) = ⊤) :
    Nonempty (CQIso (⟨V, W, A, B⟩ : CQRep k) (cqH m)) := by
  obtain ⟨h1, h2, h3, h4⟩ := chain_bases A B (2 * m) (m + 1) m v
    (fun i => ⟨2 * i, by omega⟩) (fun i => ⟨2 * i + 1, by omega⟩) (fun i => rfl) (fun i => rfl)
    (fun j => by
      rcases Nat.even_or_odd' j.val with ⟨i, hi | hi⟩
      · left; exact ⟨⟨i, by omega⟩, Fin.ext (by simp [hi])⟩
      · right; exact ⟨⟨i, by omega⟩, Fin.ext (by simp [hi])⟩)
    (by intro x; exact hnil x) hli hsp
  let a : Module.Basis (Fin (m + 1)) k V := Module.Basis.mk h1 h2.ge
  let b : Module.Basis (Fin m) k W := Module.Basis.mk h3 h4.ge
  have ha : ∀ i, a i = ((B ∘ₗ A) ^ (i : ℕ)) v := fun i => by simp [a]
  have hb : ∀ i, b i = A (((B ∘ₗ A) ^ (i : ℕ)) v) := fun i => by simp [b]
  have hAlast : A (((B ∘ₗ A) ^ m) v) = 0 := by
    have := hnil (v, 0)
    rw [cqX_pow_odd] at this
    simpa using congrArg Prod.snd this
  have hSa : ∀ i, a.equivFun (a i) = Pi.single i 1 := fun i => by
    ext j; simp [Module.Basis.equivFun_self, Pi.single_apply, eq_comm]
  have hSb : ∀ i, b.equivFun (b i) = Pi.single i 1 := fun i => by
    ext j; simp [Module.Basis.equivFun_self, Pi.single_apply, eq_comm]
  refine ⟨⟨a.equivFun, b.equivFun, fun v' => ?_, fun w' => ?_⟩⟩
  · -- `f ∘ A = truncA ∘ e`
    have : (b.equivFun.toLinearMap ∘ₗ A) = truncA m ∘ₗ a.equivFun.toLinearMap := by
      refine a.ext fun i => ?_
      refine Fin.lastCases ?_ (fun i => ?_) i
      · show b.equivFun (A (a (Fin.last m))) = truncA m (a.equivFun (a (Fin.last m)))
        rw [hSa, truncA_single_last, ha, Fin.val_last, hAlast, map_zero]
      · show b.equivFun (A (a i.castSucc)) = truncA m (a.equivFun (a i.castSucc))
        rw [hSa, truncA_single_castSucc, ha, Fin.val_castSucc, ← hb, hSb]
    exact congrArg (fun F => F v') this
  · have : (a.equivFun.toLinearMap ∘ₗ B) = shiftB m ∘ₗ b.equivFun.toLinearMap := by
      refine b.ext fun j => ?_
      show a.equivFun (B (b j)) = shiftB m (b.equivFun (b j))
      have e1 : B (b j) = a j.succ := by
        rw [hb, ha, Fin.val_succ, pow_succ', Module.End.mul_apply]; rfl
      rw [hSb, shiftB_single, e1, hSa]
    exact congrArg (fun F => F w') this

theorem shiftDown_single_succ (m : ℕ) (i : Fin m) :
    shiftDown (m + 1) (Pi.single i.succ (1 : k) : Fin (m + 1) → k) = Pi.single i.castSucc 1 := by
  funext l
  refine Fin.lastCases ?_ (fun l => ?_) l
  · simp [shiftDown, Pi.single_apply, Fin.castSucc_ne_last]
  · have h : (l : ℕ) + 1 < m + 1 + 0 := by have := l.2; omega
    simp only [shiftDown, LinearMap.coe_mk, AddHom.coe_mk, Fin.val_castSucc]
    rw [dif_pos (by have := l.2; omega)]
    have : (⟨(l : ℕ) + 1, by have := l.2; omega⟩ : Fin (m + 1)) = l.succ := Fin.ext (by simp)
    rw [this]
    simp [Pi.single_apply, Fin.succ_inj, Fin.castSucc_inj]

/-- A chain of even length `2m + 2` starting in `V` gives a representation isomorphic to
`E_{m+1,∞}`. -/
theorem cq_iso_Einf (A : V →ₗ[k] W) (B : W →ₗ[k] V) (m : ℕ) (v : V)
    (hnil : ∀ x, (cqX A B ^ (2 * m + 2)) x = 0)
    (hli : LinearIndependent k (fun j : Fin (2 * m + 2) => (cqX A B ^ (j : ℕ)) (v, 0)))
    (hsp : Submodule.span k
      (Set.range fun j : Fin (2 * m + 2) => (cqX A B ^ (j : ℕ)) (v, 0)) = ⊤) :
    Nonempty (CQIso (⟨V, W, A, B⟩ : CQRep k) (cqEinf m)) := by
  obtain ⟨h1, h2, h3, h4⟩ := chain_bases A B (2 * m + 1) (m + 1) (m + 1) v
    (fun i => ⟨2 * i, by omega⟩) (fun i => ⟨2 * i + 1, by omega⟩) (fun i => rfl) (fun i => rfl)
    (fun j => by
      rcases Nat.even_or_odd' j.val with ⟨i, hi | hi⟩
      · left; exact ⟨⟨i, by omega⟩, Fin.ext (by simp [hi])⟩
      · right; exact ⟨⟨i, by omega⟩, Fin.ext (by simp [hi])⟩)
    (by intro x; exact hnil x) hli hsp
  let a0 : Module.Basis (Fin (m + 1)) k V := Module.Basis.mk h1 h2.ge
  let b0 : Module.Basis (Fin (m + 1)) k W := Module.Basis.mk h3 h4.ge
  let a := a0.reindex Fin.revPerm
  let b := b0.reindex Fin.revPerm
  have ha : ∀ i, a i = ((B ∘ₗ A) ^ ((Fin.rev i : Fin (m + 1)) : ℕ)) v := fun i => by
    simp [a, a0, Module.Basis.reindex_apply]
  have hb : ∀ i, b i = A (((B ∘ₗ A) ^ ((Fin.rev i : Fin (m + 1)) : ℕ)) v) := fun i => by
    simp [b, b0, Module.Basis.reindex_apply]
  have hAB : ∀ i, A (a i) = b i := fun i => by rw [ha, hb]
  have hlast : B (b 0) = 0 := by
    have := hnil (v, 0)
    rw [show 2 * m + 2 = (2 * m + 1) + 1 by ring, pow_succ', Module.End.mul_apply,
      cqX_pow_odd] at this
    rw [hb, Fin.rev_zero, Fin.val_last]
    simpa using congrArg Prod.fst this
  have hBA : ∀ i : Fin m, B (b i.succ) = a i.castSucc := fun i => by
    rw [hb, ha, Fin.rev_succ, Fin.rev_castSucc, Fin.val_castSucc, Fin.val_succ, pow_succ',
      Module.End.mul_apply]
    rfl
  have hSa : ∀ i, a.equivFun (a i) = Pi.single i 1 := fun i => by
    ext j; simp [Module.Basis.equivFun_self, Pi.single_apply, eq_comm]
  have hSb : ∀ i, b.equivFun (b i) = Pi.single i 1 := fun i => by
    ext j; simp [Module.Basis.equivFun_self, Pi.single_apply, eq_comm]
  refine ⟨⟨a.equivFun, b.equivFun, fun v' => ?_, fun w' => ?_⟩⟩
  · have : (b.equivFun.toLinearMap ∘ₗ A) = LinearMap.id ∘ₗ a.equivFun.toLinearMap := by
      refine a.ext fun i => ?_
      show b.equivFun (A (a i)) = a.equivFun (a i)
      rw [hAB, hSb, hSa]
    exact congrArg (fun F => F v') this
  · have : (a.equivFun.toLinearMap ∘ₗ B) = shiftDown (m + 1) ∘ₗ b.equivFun.toLinearMap := by
      refine b.ext fun i => ?_
      refine Fin.cases ?_ (fun i => ?_) i
      · show a.equivFun (B (b 0)) = shiftDown (m + 1) (b.equivFun (b 0))
        rw [hlast, map_zero, hSb, shiftDown_single_zero]
      · show a.equivFun (B (b i.succ)) = shiftDown (m + 1) (b.equivFun (b i.succ))
        rw [hBA, hSb, hSa, shiftDown_single_succ]
    exact congrArg (fun F => F w') this

/-- Nilpotent indecomposables whose longest chain starts in `V`. -/
theorem cq_nil_V (R : CQRep k) [FiniteDimensional k R.V] [FiniteDimensional k R.W]
    (hind : R.Indec) (h : ℕ) (hnil : ∀ x, (cqX R.A R.B ^ (h + 1)) x = 0) (v : R.V)
    (hv : (cqX R.A R.B ^ h) (v, 0) ≠ 0) :
    (∃ m, h = 2 * m ∧ Nonempty (CQIso R (cqH m))) ∨
      (∃ m, h = 2 * m + 1 ∧ Nonempty (CQIso R (cqEinf m))) := by
  obtain ⟨M, N, hc, hXM, hXN, hPM, hPN, hMspan, hli⟩ :=
    chain_split' (cqX R.A R.B) (cqP k R.V R.W) (cqP_idem) (cqXP R.A R.B) h hnil (v, 0)
      (Or.inl rfl) hv
  have hdec := cq_graded_decomp R.A R.B M N hc hXM hXN hPM hPN
  have hu : ((v, 0) : R.V × R.W) ∈ M := by
    rw [hMspan]
    exact Submodule.subset_span ⟨⟨0, by omega⟩, by simp⟩
  have hv0 : v ≠ 0 := by
    rintro rfl
    exact hv (by rw [Prod.mk_zero_zero, map_zero])
  have hN : N = ⊥ := by
    rcases hind.2 _ _ _ _ hdec with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exfalso
      have : v ∈ M.comap (LinearMap.inl k R.V R.W) := hu
      rw [h1] at this
      exact hv0 (by simpa using this)
    · rw [Submodule.eq_bot_iff]
      intro x hx
      have hx1 : x.1 ∈ N.comap (LinearMap.inl k R.V R.W) := by
        have := hPN x hx
        simpa [cqP] using this
      have hx2 : x.2 ∈ N.comap (LinearMap.inr k R.V R.W) := by
        have e : ((0 : R.V), x.2) = x - cqP k R.V R.W x := by ext <;> simp [cqP]
        show ((0 : R.V), x.2) ∈ N
        rw [e]; exact N.sub_mem hx (hPN x hx)
      rw [h1] at hx1
      rw [h2] at hx2
      exact Prod.ext (by simpa using hx1) (by simpa using hx2)
  have hM : M = ⊤ := by
    have := hc.sup_eq_top
    rwa [hN, sup_bot_eq] at this
  have hsp : Submodule.span k (Set.range fun j : Fin (h + 1) => (cqX R.A R.B ^ (j : ℕ)) (v, 0))
      = ⊤ := by rw [← hMspan]; exact hM
  rcases Nat.even_or_odd' h with ⟨m, rfl | rfl⟩
  · left
    exact ⟨m, rfl, cq_iso_H R.A R.B m v hnil hli hsp⟩
  · right
    exact ⟨m, rfl, cq_iso_Einf R.A R.B m v hnil hli hsp⟩

/-- Composition of isomorphisms of representations. -/
def CQIso.trans {R R' R'' : CQRep k} (φ : CQIso R R') (ψ : CQIso R' R'') : CQIso R R'' where
  e := φ.e.trans ψ.e
  f := φ.f.trans ψ.f
  hA v := by simp [φ.hA, ψ.hA]
  hB w := by simp [φ.hB, ψ.hB]

/-- The identity isomorphism. -/
def CQIso.refl (R : CQRep k) : CQIso R R where
  e := LinearEquiv.refl k _
  f := LinearEquiv.refl k _
  hA _ := rfl
  hB _ := rfl

/-- Swapping the two vertices preserves isomorphisms. -/
def CQIso.swap {R R' : CQRep k} (φ : CQIso R R') : CQIso R.swap R'.swap where
  e := φ.f
  f := φ.e
  hA w := φ.hB w
  hB v := φ.hA v

/-- `(cqEinf m).swap ≅ cqE m 0`. -/
def cqEinf_swap_iso (m : ℕ) : CQIso (cqEinf (k := k) m).swap (cqE m 0) where
  e := LinearEquiv.refl k _
  f := LinearEquiv.refl k _
  hA v := by
    show shiftDown (m + 1) v =
      ((0 : k) • LinearMap.id + shiftDown (m + 1) : (Fin (m + 1) → k) →ₗ[k] _) v
    simp
  hB _ := rfl

theorem cqX_swap_pow (A : V →ₗ[k] W) (B : W →ₗ[k] V) (n : ℕ) (x : V × W) :
    (cqX B A ^ n) (LinearEquiv.prodComm k V W x) =
      LinearEquiv.prodComm k V W ((cqX A B ^ n) x) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', Module.End.mul_apply, pow_succ', Module.End.mul_apply, ih]
    obtain ⟨a, b⟩ := (cqX A B ^ n) x
    simp

theorem cqX_nilpotent (A : V →ₗ[k] W) (B : W →ₗ[k] V) (N : ℕ) (hN : (B ∘ₗ A) ^ N = 0) :
    ∀ x : V × W, (cqX A B ^ (2 * (N + 1))) x = 0 := by
  intro x
  obtain ⟨v, w⟩ := x
  rw [cqX_pow_even]
  have h1 : ((B ∘ₗ A) ^ (N + 1)) v = 0 := by rw [pow_succ, hN]; simp
  have h2 : ((A ∘ₗ B) ^ (N + 1)) w = 0 := by
    rw [pow_succ, Module.End.mul_apply]
    show ((A ∘ₗ B) ^ N) (A (B w)) = 0
    have := congrArg (fun F => F (B w)) (cq_comp_pow A B N)
    simp only [LinearMap.comp_apply, hN, LinearMap.zero_apply, map_zero] at this
    exact this.symm
  rw [h1, h2]; rfl

/-- Indecomposability is invariant under isomorphism. -/
theorem CQIso.indec {R R' : CQRep k} (φ : CQIso R R') (h : R.Indec) : R'.Indec := by
  obtain ⟨hne, hdec⟩ := h
  refine ⟨?_, fun V1 V2 W1 W2 hd => ?_⟩
  · rcases hne with hV | hW
    · left; exact (Equiv.nontrivial_congr φ.e.toEquiv).1 hV
    · right; exact (Equiv.nontrivial_congr φ.f.toEquiv).1 hW
  · obtain ⟨c1, c2, i1, i2, j1, j2⟩ := hd
    have hz : ∀ (X : Submodule k R'.V) (Y : Submodule k R'.W), X.map φ.e.symm.toLinearMap = ⊥ →
        Y.map φ.f.symm.toLinearMap = ⊥ → X = ⊥ ∧ Y = ⊥ := by
      intro X Y hX hY
      constructor
      · rw [Submodule.eq_bot_iff]
        intro x hx
        have : φ.e.symm x ∈ X.map φ.e.symm.toLinearMap := ⟨x, hx, rfl⟩
        rw [hX] at this
        simpa using this
      · rw [Submodule.eq_bot_iff]
        intro x hx
        have : φ.f.symm x ∈ Y.map φ.f.symm.toLinearMap := ⟨x, hx, rfl⟩
        rw [hY] at this
        simpa using this
    have hA : ∀ (X : Submodule k R'.V) (Y : Submodule k R'.W), (∀ v ∈ X, R'.A v ∈ Y) →
        ∀ v ∈ X.map φ.e.symm.toLinearMap, R.A v ∈ Y.map φ.f.symm.toLinearMap := by
      rintro X Y hXY v ⟨v', hv', rfl⟩
      refine ⟨R'.A v', hXY v' hv', ?_⟩
      apply φ.f.injective
      simp [φ.hA]
    have hB : ∀ (X : Submodule k R'.V) (Y : Submodule k R'.W), (∀ w ∈ Y, R'.B w ∈ X) →
        ∀ w ∈ Y.map φ.f.symm.toLinearMap, R.B w ∈ X.map φ.e.symm.toLinearMap := by
      rintro X Y hXY w ⟨w', hw', rfl⟩
      refine ⟨R'.B w', hXY w' hw', ?_⟩
      apply φ.e.injective
      simp [φ.hB]
    rcases hdec (V1.map φ.e.symm.toLinearMap) (V2.map φ.e.symm.toLinearMap)
        (W1.map φ.f.symm.toLinearMap) (W2.map φ.f.symm.toLinearMap)
        ⟨Submodule.isCompl_map φ.e.symm c1, Submodule.isCompl_map φ.f.symm c2,
          hA V1 W1 i1, hA V2 W2 i2, hB V1 W1 j1, hB V2 W2 j2⟩ with ⟨a, b⟩ | ⟨a, b⟩
    · exact Or.inl (hz V1 W1 a b)
    · exact Or.inr (hz V2 W2 a b)

/-- Problem 5.39(c) (nilpotent case): a finite-dimensional indecomposable representation with
`B ∘ A` nilpotent is isomorphic to one of `H_n`, `E_{n,∞}`, `K_n`, `E_{n,0}`. -/
@[kb "etingof2011" "Problem 5.39, p. 96"]
theorem cq_nil_classify (R : CQRep k) [FiniteDimensional k R.V] [FiniteDimensional k R.W]
    (hind : R.Indec) (hnil : ∃ N : ℕ, (R.B ∘ₗ R.A) ^ N = 0) :
    (∃ m, Nonempty (CQIso R (cqH m))) ∨ (∃ m, Nonempty (CQIso R (cqEinf m))) ∨
      (∃ m, Nonempty (CQIso R (cqK m))) ∨ (∃ m, Nonempty (CQIso R (cqE m 0))) := by
  classical
  obtain ⟨N, hN⟩ := hnil
  have hex : ∃ n : ℕ, ∀ x : R.V × R.W, (cqX R.A R.B ^ n) x = 0 :=
    ⟨_, cqX_nilpotent R.A R.B N hN⟩
  set n := Nat.find hex with hn
  have hnspec : ∀ x : R.V × R.W, (cqX R.A R.B ^ n) x = 0 := Nat.find_spec hex
  have hn0 : n ≠ 0 := by
    intro h0
    rw [h0] at hnspec
    rcases hind.1 with hV | hW
    · obtain ⟨x, hx⟩ := exists_ne (0 : R.V)
      exact hx (by simpa using congrArg Prod.fst (hnspec (x, 0)))
    · obtain ⟨x, hx⟩ := exists_ne (0 : R.W)
      exact hx (by simpa using congrArg Prod.snd (hnspec (0, x)))
  obtain ⟨h, hh⟩ : ∃ h, n = h + 1 := ⟨n - 1, by omega⟩
  have hnil' : ∀ x, (cqX R.A R.B ^ (h + 1)) x = 0 := by rw [← hh]; exact hnspec
  have hmin : ¬ ∀ x : R.V × R.W, (cqX R.A R.B ^ h) x = 0 := by
    intro hall
    have := Nat.find_min hex (show h < Nat.find hex by omega)
    exact this hall
  push Not at hmin
  obtain ⟨⟨v, w⟩, hvw⟩ := hmin
  have hsplit : (cqX R.A R.B ^ h) (v, w) = (cqX R.A R.B ^ h) (v, 0) + (cqX R.A R.B ^ h) (0, w) := by
    rw [← map_add]; simp
  by_cases hv : (cqX R.A R.B ^ h) (v, 0) = 0
  · -- the chain starts in `W`: swap
    have hw : (cqX R.A R.B ^ h) (0, w) ≠ 0 := by
      intro h0; apply hvw; rw [hsplit, hv, h0, add_zero]
    have hind' : CQIndec R.B R.A := hind.swap
    let R' : CQRep k := R.swap
    have hnil'' : ∀ x, (cqX R'.A R'.B ^ (h + 1)) x = 0 := by
      intro x
      have := cqX_swap_pow R.A R.B (h + 1) ((LinearEquiv.prodComm k R.V R.W).symm x)
      simp only [LinearEquiv.apply_symm_apply] at this
      change (cqX R.B R.A ^ (h + 1)) x = 0
      rw [this, hnil', map_zero]
    have hw' : (cqX R'.A R'.B ^ h) (w, 0) ≠ 0 := by
      have := cqX_swap_pow R.A R.B h (0, w)
      intro h0
      apply hw
      have h1 : (LinearEquiv.prodComm k R.V R.W) ((cqX R.A R.B ^ h) (0, w)) = 0 := by
        rw [← this]; exact h0
      exact (LinearEquiv.map_eq_zero_iff _).1 h1
    haveI : FiniteDimensional k R'.V := inferInstanceAs (FiniteDimensional k R.W)
    haveI : FiniteDimensional k R'.W := inferInstanceAs (FiniteDimensional k R.V)
    rcases cq_nil_V R' hind' h hnil'' w hw' with ⟨m, -, ⟨φ⟩⟩ | ⟨m, -, ⟨φ⟩⟩
    · right; right; left
      exact ⟨m, ⟨φ.swap⟩⟩
    · right; right; right
      exact ⟨m, ⟨φ.swap.trans (cqEinf_swap_iso m)⟩⟩
  · rcases cq_nil_V R hind h hnil' v hv with ⟨m, -, ⟨φ⟩⟩ | ⟨m, -, ⟨φ⟩⟩
    · left; exact ⟨m, ⟨φ⟩⟩
    · right; left; exact ⟨m, ⟨φ⟩⟩

/-- Problem 5.39(b): over an algebraically closed field, an indecomposable finite-dimensional
representation with `B ∘ A` not nilpotent is isomorphic to `E_{n,λ}` for some `λ ≠ 0`. -/
@[kb "etingof2011" "Problem 5.39, p. 96"]
theorem cq_inv_classify [IsAlgClosed k] (R : CQRep k) [FiniteDimensional k R.V]
    [FiniteDimensional k R.W] (hind : R.Indec) (hnn : ¬ ∃ N : ℕ, (R.B ∘ₗ R.A) ^ N = 0) :
    ∃ (m : ℕ) (c : k), c ≠ 0 ∧ Nonempty (CQIso R (cqE m c)) := by
  obtain ⟨N, hN0, hdec, hinjA, hinjB, hsurjA, hsurjB⟩ := cq_fitting R.A R.B
  set T : Module.End k R.V := R.B ∘ₗ R.A with hT
  have hTapp : ∀ v, T v = R.B (R.A v) := fun v => rfl
  -- the nilpotent summand vanishes
  have hker : LinearMap.ker (T ^ N) = ⊥ ∧
      LinearMap.ker ((R.A ∘ₗ R.B) ^ N : Module.End k R.W) = ⊥ := by
    rcases hind.2 _ _ _ _ hdec with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact ⟨h1, h2⟩
    · exfalso
      exact hnn ⟨N, LinearMap.range_eq_bot.1 h1⟩
  obtain ⟨c1, c2, -, -, -, -⟩ := hdec
  have hrV : LinearMap.range (T ^ N) = ⊤ := by
    have := c1.sup_eq_top; rwa [hker.1, bot_sup_eq] at this
  have hrW : LinearMap.range ((R.A ∘ₗ R.B) ^ N : Module.End k R.W) = ⊤ := by
    have := c2.sup_eq_top; rwa [hker.2, bot_sup_eq] at this
  have hAinj : Function.Injective R.A := by
    intro x y hxy
    have : x - y = 0 := hinjA (x - y) (by rw [hrV]; trivial) (by rw [map_sub, hxy, sub_self])
    exact sub_eq_zero.1 this
  have hBinj : Function.Injective R.B := by
    intro x y hxy
    have : x - y = 0 := hinjB (x - y) (by rw [hrW]; trivial) (by rw [map_sub, hxy, sub_self])
    exact sub_eq_zero.1 this
  have hBsurj : Function.Surjective R.B := fun v => by
    obtain ⟨w, -, hw⟩ := hsurjB v (by rw [hrV]; trivial)
    exact ⟨w, hw⟩
  let fB : R.W ≃ₗ[k] R.V := LinearEquiv.ofBijective R.B ⟨hBinj, hBsurj⟩
  let R0 : CQRep k := ⟨R.V, R.V, T, LinearMap.id⟩
  let φ0 : CQIso R R0 :=
    { e := LinearEquiv.refl k _
      f := fB
      hA := fun v => rfl
      hB := fun w => rfl }
  have hind0 : CQIndec T LinearMap.id := φ0.indec hind
  have hVnt : Nontrivial R.V := by
    rcases hind.1 with hV | hW
    · exact hV
    · exact (Equiv.nontrivial_congr fB.toEquiv).1 hW
  obtain ⟨lam, hlam⟩ := Module.End.exists_eigenvalue T
  obtain ⟨v, hv⟩ := hlam.exists_hasEigenvector
  have hTv : T v = lam • v := Module.End.mem_eigenspace_iff.1 hv.1
  have hv0 : v ≠ 0 := hv.2
  have hlam0 : lam ≠ 0 := by
    intro h0
    apply hv0
    rw [h0, zero_smul] at hTv
    exact hAinj (hBinj (by rw [← hTapp, hTv, map_zero, map_zero]))
  set N0 : Module.End k R.V := T - lam • 1 with hN0def
  have hN0app : ∀ x, N0 x = T x - lam • x := fun x => by simp [hN0def]
  have hcomm : Commute T N0 := by
    refine LinearMap.ext fun x => ?_
    simp [hN0def, mul_sub, sub_mul]
  obtain ⟨n0, hn0⟩ := Filter.eventually_atTop.1 N0.eventually_isCompl_ker_pow_range_pow
  set n := max n0 1 with hn
  have hn1 : 0 < n := by omega
  have cN := hn0 n (le_max_left _ _)
  have hTpow : ∀ x, T ((N0 ^ n) x) = (N0 ^ n) (T x) := fun x =>
    congrArg (fun F => F x) (hcomm.pow_right n).eq
  have hdec0 : CQDecomp T (LinearMap.id : R.V →ₗ[k] R.V) (LinearMap.ker (N0 ^ n))
      (LinearMap.range (N0 ^ n)) (LinearMap.ker (N0 ^ n)) (LinearMap.range (N0 ^ n)) := by
    refine ⟨cN, cN, ?_, ?_, fun w hw => hw, fun w hw => hw⟩
    · intro x hx
      rw [LinearMap.mem_ker] at hx ⊢
      rw [← hTpow, hx, map_zero]
    · rintro _ ⟨y, rfl⟩
      exact ⟨T y, (hTpow y).symm⟩
  have hnilN0 : ∃ t : ℕ, N0 ^ t = 0 := by
    rcases hind0.2 _ _ _ _ hdec0 with ⟨h1, -⟩ | ⟨h1, -⟩
    · exfalso
      have : v ∈ LinearMap.ker (N0 ^ n) := by
        rw [LinearMap.mem_ker]
        obtain ⟨n', hn'⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
        rw [hn', pow_succ, Module.End.mul_apply, hN0app, hTv, sub_self, map_zero]
      rw [h1] at this
      exact hv0 (by simpa using this)
    · exact ⟨n, LinearMap.range_eq_bot.1 h1⟩
  let R1 : CQRep k := ⟨R.V, R.V, N0, LinearMap.id⟩
  have hind1 : CQIndec N0 (LinearMap.id : R.V →ₗ[k] R.V) := by
    have := cq_indec_shift T (-lam) hind0
    have e : ((-lam) • LinearMap.id + T : R.V →ₗ[k] R.V) = N0 := by
      refine LinearMap.ext fun x => ?_
      simp [hN0app, neg_smul]
      abel
    rwa [e] at this
  have hfd : FiniteDimensional k R1.V := inferInstanceAs (FiniteDimensional k R.V)
  have hfd' : FiniteDimensional k R1.W := inferInstanceAs (FiniteDimensional k R.V)
  have hcls := cq_nil_classify R1 hind1 (by
    obtain ⟨t, ht⟩ := hnilN0
    exact ⟨t, by simpa [R1] using ht⟩)
  have hE : ∃ m, Nonempty (CQIso R1 (cqE m 0)) := by
    rcases hcls with ⟨m, ⟨φ⟩⟩ | ⟨m, ⟨φ⟩⟩ | ⟨m, ⟨φ⟩⟩ | h
    · exfalso
      have e1 := φ.finrank_V
      have e2 := φ.finrank_W
      have e3 : finrank k R1.V = finrank k R1.W := rfl
      simp only [Module.finrank_fin_fun] at e1 e2
      omega
    · exfalso
      have hB1 : Function.Injective R1.swap.A := fun x y h => h
      have := φ.swap.injA hB1
      have h2 := @this (Pi.single (0 : Fin (m + 1)) (1 : k)) 0 (by
        show shiftDown (m + 1) (Pi.single (0 : Fin (m + 1)) (1 : k)) = shiftDown (m + 1) 0
        rw [shiftDown_single_zero, map_zero])
      have h3 : (Pi.single (0 : Fin (m + 1)) (1 : k) : Fin (m + 1) → k) 0 =
          (0 : Fin (m + 1) → k) 0 := congrFun h2 0
      simp at h3
    · exfalso
      have e1 := φ.finrank_V
      have e2 := φ.finrank_W
      have e3 : finrank k R1.V = finrank k R1.W := rfl
      simp only [Module.finrank_fin_fun] at e1 e2
      omega
    · exact h
  obtain ⟨m, ⟨φ⟩⟩ := hE
  have hef : ∀ w, φ.e w = φ.f w := fun w => φ.hB w
  let φ1 : CQIso R0 (cqE m lam) :=
    { e := φ.e
      f := φ.f
      hA := fun v' => by
        have h1 : T v' = lam • v' + N0 v' := by rw [hN0app]; abel
        have h2 := φ.hA v'
        show φ.f (T v') = ((lam • LinearMap.id + shiftDown (m + 1) :
          (Fin (m + 1) → k) →ₗ[k] _)) (φ.e v')
        rw [h1, map_add, map_smul, ← hef v']
        have h3 : φ.f (N0 v') = ((0 : k) • LinearMap.id + shiftDown (m + 1) :
          (Fin (m + 1) → k) →ₗ[k] _) (φ.e v') := h2
        rw [h3]
        simp
      hB := fun w => φ.hB w }
  exact ⟨m, lam, hlam0, ⟨φ0.trans φ1⟩⟩

/-- Problem 5.39 (classification): over an algebraically closed field, every indecomposable
finite-dimensional representation of the cyclic quiver with two vertices is isomorphic to exactly
one of `E_{n,λ}` (`λ ∈ k`), `E_{n,∞}`, `H_n`, `K_n`. -/
@[kb "etingof2011" "Problem 5.39, p. 96"]
theorem cq_classification [IsAlgClosed k] (R : CQRep k) [FiniteDimensional k R.V]
    [FiniteDimensional k R.W] (hind : R.Indec) :
    ∃! p : CQParam k, Nonempty (CQIso R p.rep) := by
  have hex : ∃ p : CQParam k, Nonempty (CQIso R p.rep) := by
    by_cases hnil : ∃ N : ℕ, (R.B ∘ₗ R.A) ^ N = 0
    · rcases cq_nil_classify R hind hnil with ⟨m, ⟨φ⟩⟩ | ⟨m, ⟨φ⟩⟩ | ⟨m, ⟨φ⟩⟩ | ⟨m, ⟨φ⟩⟩
      · exact ⟨CQParam.H m, ⟨φ⟩⟩
      · exact ⟨CQParam.Einf m, ⟨φ⟩⟩
      · exact ⟨CQParam.K m, ⟨φ⟩⟩
      · exact ⟨CQParam.E m 0, ⟨φ⟩⟩
    · obtain ⟨m, c, -, ⟨φ⟩⟩ := cq_inv_classify R hind hnil
      exact ⟨CQParam.E m c, ⟨φ⟩⟩
  obtain ⟨p, ⟨φ⟩⟩ := hex
  exact ⟨p, ⟨φ⟩, fun q ⟨ψ⟩ => (CQParam.rep_noniso p q (φ.symm.trans ψ)).symm⟩

end IsoH

