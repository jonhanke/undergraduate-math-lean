import UndergradKB.Common.Attr

/-! # Semisimplicity of Clifford algebras (Etingof et al., Problem 2.25)

For a quadratic form `Q` on a finite dimensional complex vector space (Mathlib's `CliffordAlgebra Q`,
with `Q v` playing the role of the book's `(v, v)`), we prove:

* `isSemisimpleRing_cliffordAlgebra`: if `Q` is nondegenerate, `CliffordAlgebra Q` is semisimple.
  Route: an orthonormal basis `w i` exists over `ℂ`; the units `ι (w i)` square to one and pairwise
  anticommute, so they generate a finite group (every element is a signed ordered product, see
  `wordSet`); the group algebra of this group (semisimple by Maschke) maps onto the Clifford algebra.
* `not_isSemisimpleRing_of_mem_radical`: a nonzero radical vector `v` gives a nonzero element `ι v`
  of the Jacobson radical (indeed `ι v * x * ι v = 0` for all `x`).
* `isSemisimpleRing_cliffordAlgebra_iff`: the equivalence, part (ii) of the problem.

Not done: the structure statement of part (i) (a matrix algebra of size `2 ^ n` in dimension `2 n`,
a product of two such in dimension `2 n + 1`) and the identification of `Cl(V) / Rad` in the
degenerate case.
-/

namespace UndergradKB.RepresentationTheory

namespace CliffordSemisimple

section Generic

variable {A : Type*} [Ring A] {ι : Type*}

/-- The finite set of signed ordered products of the elements `u a`, `a` in a list. -/
def wordSet (u : ι → Aˣ) : List ι → Set Aˣ
  | [] => {1, -1}
  | a :: l => wordSet u l ∪ (fun x => u a * x) '' wordSet u l

theorem wordSet_finite (u : ι → Aˣ) (l : List ι) : (wordSet u l).Finite := by
  induction l with
  | nil => simp [wordSet]
  | cons a l ih => exact ih.union (ih.image _)

theorem one_mem_wordSet (u : ι → Aˣ) (l : List ι) : 1 ∈ wordSet u l := by
  induction l with
  | nil => simp [wordSet]
  | cons a l ih => exact Or.inl ih

theorem neg_mem_wordSet (u : ι → Aˣ) (l : List ι) {x : Aˣ} (hx : x ∈ wordSet u l) :
    -x ∈ wordSet u l := by
  induction l generalizing x with
  | nil =>
    simp only [wordSet, Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
    rcases hx with rfl | rfl <;> simp
  | cons a l ih =>
    rcases hx with hx | ⟨y, hy, rfl⟩
    · exact Or.inl (ih hx)
    · exact Or.inr ⟨-y, ih hy, by simp⟩

theorem mul_mem_wordSet (u : ι → Aˣ) (hsq : ∀ i, u i * u i = 1)
    (hanti : ∀ i j, i ≠ j → u i * u j = -(u j * u i)) (l : List ι) (hl : l.Nodup) {j : ι}
    (hj : j ∈ l) {x : Aˣ} (hx : x ∈ wordSet u l) : u j * x ∈ wordSet u l := by
  induction l generalizing x with
  | nil => simp at hj
  | cons a l ih =>
    rw [List.nodup_cons] at hl
    rcases hx with hx | ⟨y, hy, rfl⟩
    · by_cases hja : j = a
      · subst hja
        exact Or.inr ⟨x, hx, rfl⟩
      · have hjl : j ∈ l := by simpa [hja] using hj
        exact Or.inl (ih hl.2 hjl hx)
    · by_cases hja : j = a
      · subst hja
        left
        rw [← mul_assoc, hsq, one_mul]
        exact hy
      · have hjl : j ∈ l := by simpa [hja] using hj
        right
        refine ⟨-(u j * y), neg_mem_wordSet u l (ih hl.2 hjl hy), ?_⟩
        rw [← mul_assoc, hanti j a hja]
        simp [mul_assoc]

/-- A complex algebra generated by pairwise anticommuting units of square one is semisimple:
it is a quotient of the group algebra of the finite group generated by these units and `-1`. -/
theorem isSemisimpleRing_of_anticommuting [Algebra ℂ A] [Fintype ι] (u : ι → Aˣ)
    (hsq : ∀ i, u i * u i = 1) (hanti : ∀ i j, i ≠ j → u i * u j = -(u j * u i))
    (hgen : Algebra.adjoin ℂ (Set.range fun i => (u i : A)) = ⊤) : IsSemisimpleRing A := by
  classical
  let Γ : Subgroup Aˣ := Subgroup.closure (Set.range u ∪ {-1})
  have hfin : Finite Γ := by
    have hsub : (Γ : Set Aˣ) ⊆ wordSet u (Finset.univ.toList) := by
      intro x hx
      induction hx using Subgroup.closure_induction_left with
      | one => exact one_mem_wordSet _ _
      | mul_left g hg y hy ih =>
        rcases hg with ⟨j, rfl⟩ | hg
        · exact mul_mem_wordSet u hsq hanti _ (Finset.nodup_toList _) (by simp) ih
        · rw [Set.mem_singleton_iff] at hg
          subst hg
          simpa using neg_mem_wordSet u _ ih
      | inv_mul_cancel g hg y hy ih =>
        rcases hg with ⟨j, rfl⟩ | hg
        · rw [inv_eq_of_mul_eq_one_right (hsq j)]
          exact mul_mem_wordSet u hsq hanti _ (Finset.nodup_toList _) (by simp) ih
        · rw [Set.mem_singleton_iff] at hg
          subst hg
          have : (-1 : Aˣ)⁻¹ = -1 := inv_eq_of_mul_eq_one_right (by simp)
          rw [this]
          simpa using neg_mem_wordSet u _ ih
    exact ((wordSet_finite _ _).subset hsub).to_subtype
  have : NeZero (Nat.card Γ : ℂ) := ⟨by exact_mod_cast Nat.card_pos.ne'⟩
  let f : MonoidAlgebra ℂ Γ →ₐ[ℂ] A :=
    MonoidAlgebra.lift ℂ A Γ ((Units.coeHom A).comp Γ.subtype)
  have hf : Function.Surjective f := by
    rw [← AlgHom.range_eq_top, eq_top_iff, ← hgen, Algebra.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    exact ⟨MonoidAlgebra.of ℂ Γ ⟨u i, Subgroup.subset_closure (Or.inl ⟨i, rfl⟩)⟩, by simp [f]⟩
  exact RingHom.isSemisimpleRing_of_surjective f.toRingHom hf

end Generic

section Clifford

open CliffordAlgebra

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- A vector of the radical of a quadratic form on a complex space (so it is orthogonal to
everything and has `Q v = 0`) is sent to a nonzero element of the Clifford algebra which is
nilpotent of a strong kind: `z * x * z = 0` for all `x`. -/
theorem ι_mul_mul_ι_eq_zero {Q : QuadraticForm ℂ V} {v : V} (hv : v ∈ Q.radical)
    (x : CliffordAlgebra Q) : ι Q v * x * ι Q v = 0 := by
  have hp : ∀ w, QuadraticMap.polar Q v w = 0 := by
    intro w
    rw [QuadraticMap.mem_radical_iff'] at hv
    simp [QuadraticMap.polar, hv.1, hv.2 w]
  have key : ∀ y : CliffordAlgebra Q, ι Q v * y = involute y * ι Q v := by
    intro y
    induction y using CliffordAlgebra.induction with
    | algebraMap r => simp [Algebra.commutes]
    | ι w =>
      have := ι_mul_ι_add_swap (Q := Q) v w
      rw [hp, map_zero] at this
      rw [involute_ι, neg_mul]
      exact eq_neg_of_add_eq_zero_left this
    | mul a b ha hb => rw [← mul_assoc, ha, mul_assoc, hb, map_mul, mul_assoc]
    | add a b ha hb => rw [mul_add, ha, hb, map_add, add_mul]
  rw [key, mul_assoc, ι_sq_scalar, (QuadraticMap.mem_radical_iff'.1 hv).1]
  simp

/-- A nonzero vector of the radical gives a nonzero element `ι v` of the Clifford algebra. -/
theorem ι_ne_zero {Q : QuadraticForm ℂ V} {v : V} (hv : v ≠ 0) : ι Q v ≠ 0 := by
  obtain ⟨d, hd⟩ := Module.Projective.exists_dual_ne_zero ℂ hv
  intro h
  have := congrArg (CliffordAlgebra.contractLeft (Q := Q) d) h
  rw [contractLeft_ι, map_zero] at this
  exact hd ((algebraMap ℂ (CliffordAlgebra Q)).injective (by simpa using this))

/-- **Etingof Problem 2.25 (ii), one direction.** If the quadratic form has a nonzero vector in
its radical, the Clifford algebra is not semisimple: `ι v` is a nonzero element of the Jacobson
radical. -/
@[kb "etingof2011" "Problem 2.25, p. 31"]
theorem not_isSemisimpleRing_of_mem_radical {Q : QuadraticForm ℂ V} {v : V}
    (hv : v ∈ Q.radical) (h0 : v ≠ 0) : ¬ IsSemisimpleRing (CliffordAlgebra Q) := by
  intro hss
  have hmem : ι Q v ∈ Ring.jacobson (CliffordAlgebra Q) := by
    rw [← Ideal.jacobson_bot, Ideal.mem_jacobson_iff]
    intro y
    have h2 : (y * ι Q v) * (y * ι Q v) = 0 := by
      rw [mul_assoc y (ι Q v) (y * ι Q v), ← mul_assoc (ι Q v) y (ι Q v),
        ι_mul_mul_ι_eq_zero hv y, mul_zero]
    refine ⟨1 - y * ι Q v, ?_⟩
    rw [Ideal.mem_bot]
    calc (1 - y * ι Q v) * y * ι Q v + (1 - y * ι Q v) - 1
        = -((y * ι Q v) * (y * ι Q v)) := by noncomm_ring
      _ = 0 := by rw [h2, neg_zero]
  rw [IsSemisimpleRing.jacobson_eq_bot, Ideal.mem_bot] at hmem
  exact ι_ne_zero (Q := Q) h0 hmem

/-- **Etingof Problem 2.25 (i), semisimplicity.** For a nondegenerate quadratic form on a finite
dimensional complex vector space, the Clifford algebra is a semisimple ring. -/
@[kb "etingof2011" "Problem 2.25, p. 31"]
theorem isSemisimpleRing_cliffordAlgebra [FiniteDimensional ℂ V] (Q : QuadraticForm ℂ V)
    (hQ : Q.Nondegenerate) : IsSemisimpleRing (CliffordAlgebra Q) := by
  classical
  have : Invertible (2 : ℂ) := invertibleOfNonzero two_ne_zero
  have hsep : (QuadraticMap.associated (R := ℂ) Q).SeparatingLeft :=
    ((QuadraticMap.nondegenerate_associated_iff (Q := Q)).2 hQ).1
  obtain ⟨e⟩ := Q.equivalent_weightedSumSquares_of_isAlgClosed hsep
  let w : Fin (Module.finrank ℂ V) → V := fun i => e.symm (Pi.single i 1)
  have hQw : ∀ i, Q (w i) = 1 := by
    intro i
    have := e.symm.map_app (Pi.single i (1 : ℂ))
    simp [w, QuadraticMap.weightedSumSquares_apply, Pi.single_apply]
  have hpol : ∀ i j, i ≠ j → QuadraticMap.polar Q (w i) (w j) = 0 := by
    intro i j hij
    have h1 := e.symm.map_app (Pi.single i (1 : ℂ) + Pi.single j 1)
    have h2 := hQw i
    have h3 := hQw j
    have h4 : Q (w i + w j) = 2 := by
      have : w i + w j = e.symm (Pi.single i (1 : ℂ) + Pi.single j 1) := by simp [w]
      rw [this, e.symm.map_app]
      simp only [QuadraticMap.weightedSumSquares_apply, Pi.single_apply, Pi.add_apply,
        Pi.one_apply, smul_eq_mul, one_mul]
      have hs : ∀ x : Fin (Module.finrank ℂ V),
          ((if x = i then (1 : ℂ) else 0) + if x = j then 1 else 0) *
            ((if x = i then (1 : ℂ) else 0) + if x = j then 1 else 0) =
          (if x = i then (1 : ℂ) else 0) + if x = j then 1 else 0 := by
        intro x
        by_cases hxi : x = i
        · have : x ≠ j := fun h => hij (hxi.symm.trans h)
          simp [hxi, hij]
        · by_cases hxj : x = j
          · simp [hxj, hij.symm]
          · simp [hxi, hxj]
      rw [Finset.sum_congr rfl (fun x _ => hs x), Finset.sum_add_distrib]
      simp
      norm_num
    simp only [QuadraticMap.polar, h4, h2, h3]
    norm_num
  have hsq : ∀ i, ι Q (w i) * ι Q (w i) = 1 := fun i => by rw [ι_sq_scalar, hQw i, map_one]
  let u : Fin (Module.finrank ℂ V) → (CliffordAlgebra Q)ˣ := fun i =>
    ⟨ι Q (w i), ι Q (w i), hsq i, hsq i⟩
  have hspan : Submodule.span ℂ (Set.range w) = ⊤ := by
    have hb := ((Pi.basisFun ℂ (Fin (Module.finrank ℂ V))).map e.symm.toLinearEquiv).span_eq
    rw [Module.Basis.coe_map] at hb
    convert hb using 2
    ext x
    simp [w]
  have hι : ∀ x, ι Q x ∈ Algebra.adjoin ℂ (Set.range fun i => (u i : CliffordAlgebra Q)) := by
    intro x
    have hx : x ∈ Submodule.span ℂ (Set.range w) := hspan ▸ Submodule.mem_top
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨i, rfl⟩ := hy
      exact Algebra.subset_adjoin ⟨i, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | smul a x _ hx => rw [map_smul]; exact Subalgebra.smul_mem _ hx a
  refine isSemisimpleRing_of_anticommuting u (fun i => Units.ext (hsq i)) ?_ ?_
  · intro i j hij
    apply Units.ext
    have := ι_mul_ι_add_swap (Q := Q) (w i) (w j)
    rw [hpol i j hij, map_zero] at this
    simpa [u] using eq_neg_of_add_eq_zero_left this
  · rw [eq_top_iff, ← adjoin_range_ι, Algebra.adjoin_le_iff]
    rintro _ ⟨x, rfl⟩
    exact hι x

/-- **Etingof Problem 2.25 (ii).** The Clifford algebra of a quadratic form on a finite dimensional
complex space is semisimple exactly when the form is nondegenerate. -/
@[kb "etingof2011" "Problem 2.25, p. 31"]
theorem isSemisimpleRing_cliffordAlgebra_iff [FiniteDimensional ℂ V] (Q : QuadraticForm ℂ V) :
    IsSemisimpleRing (CliffordAlgebra Q) ↔ Q.Nondegenerate := by
  have : Invertible (2 : ℂ) := invertibleOfNonzero two_ne_zero
  refine ⟨fun h => ?_, isSemisimpleRing_cliffordAlgebra Q⟩
  by_contra hnd
  rw [QuadraticMap.nondegenerate_iff_radical_eq_bot, ← Ne, Submodule.ne_bot_iff] at hnd
  obtain ⟨v, hv, hv0⟩ := hnd
  exact not_isSemisimpleRing_of_mem_radical hv hv0 h

end Clifford

end CliffordSemisimple

end UndergradKB.RepresentationTheory
