import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Basic
import Mathlib.Algebra.Polynomial.Derivative
import Mathlib.RingTheory.Polynomial.Basic
import UndergradKB.Common.Attr
import UndergradKB.RepresentationTheory.WeylAlgebra
import UndergradKB.RepresentationTheory.ProblemsAlgebrasLie
import UndergradKB.RepresentationTheory.ProblemsWeyl2

/-! # Problem 1.26 (b), (c): centre and classification of irreducibles in characteristic `p`

* A faithful representation of the Weyl algebra on `k[s, t]` (`x ↦ t`, `y ↦ ∂_t + s`) proves that
  the monomials `xⁱ yʲ` form a basis over any field (no characteristic assumption).
* `weyl_center_eq_adjoin`: in characteristic `p` the centre is generated by `x^p` and `y^p`.
-/

namespace UndergradKB.RepresentationTheory

open Module

section Faithful

variable {k : Type*} [Field k]

/-- `x ↦ multiplication by the first variable`. -/
noncomputable def faithX : Module.End k (MvPolynomial (Fin 2) k) :=
  LinearMap.mulLeft k (MvPolynomial.X 0)

/-- `y ↦ ∂/∂(first variable) + multiplication by the second variable`. -/
noncomputable def faithY : Module.End k (MvPolynomial (Fin 2) k) where
  toFun f := MvPolynomial.pderiv 0 f + MvPolynomial.X 1 * f
  map_add' f g := by simp [mul_add]; abel
  map_smul' c f := by simp [smul_add, mul_smul_comm]

theorem faithY_apply (f : MvPolynomial (Fin 2) k) :
    faithY f = MvPolynomial.pderiv 0 f + MvPolynomial.X 1 * f := rfl

theorem faithX_apply (f : MvPolynomial (Fin 2) k) : faithX f = MvPolynomial.X 0 * f := rfl

theorem faithY_mul_faithX : (faithY : Module.End k (MvPolynomial (Fin 2) k)) * faithX =
    faithX * faithY + 1 := by
  refine LinearMap.ext fun f => ?_
  simp only [Module.End.mul_apply, LinearMap.add_apply, faithX_apply, faithY_apply,
    Derivation.leibniz, MvPolynomial.pderiv_X_self, smul_eq_mul, Module.End.one_apply]
  ring

/-- A faithful representation of the Weyl algebra over any field. -/
noncomputable def weylRepF : WeylAlgebra k →ₐ[k] Module.End k (MvPolynomial (Fin 2) k) :=
  weylLift faithX faithY faithY_mul_faithX

theorem faithY_pow_one (j : ℕ) :
    (faithY ^ j : Module.End k (MvPolynomial (Fin 2) k)) 1 = MvPolynomial.X 1 ^ j := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [pow_succ', Module.End.mul_apply, ih, faithY_apply, Derivation.leibniz_pow]
    simp [MvPolynomial.pderiv_X, pow_succ']

theorem faithX_pow_apply (i : ℕ) (f : MvPolynomial (Fin 2) k) :
    (faithX ^ i : Module.End k (MvPolynomial (Fin 2) k)) f = MvPolynomial.X 0 ^ i * f := by
  induction i with
  | zero => simp
  | succ i ih => rw [pow_succ', Module.End.mul_apply, ih, faithX_apply, pow_succ', mul_assoc]

theorem weylRepF_monomial (i j : ℕ) :
    weylRepF (weylX k ^ i * weylY k ^ j) 1 = MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ j := by
  rw [map_mul, map_pow, map_pow, Module.End.mul_apply]
  have hx : weylRepF (weylX k) = faithX := weylLift_x _ _ _
  have hy : weylRepF (weylY k) = faithY := weylLift_y _ _ _
  rw [hx, hy, faithY_pow_one, faithX_pow_apply]

/-- The monomials `xⁱ yʲ` are linearly independent in the Weyl algebra over any field. -/
@[kb "etingof2011" "Problem 1.26, p. 12"]
theorem weyl_linearIndependent_any :
    LinearIndependent k (fun p : ℕ × ℕ => weylX k ^ p.1 * weylY k ^ p.2) := by
  let f : WeylAlgebra k →ₗ[k] MvPolynomial (Fin 2) k :=
    { toFun := fun z => weylRepF z 1
      map_add' := by intros; simp
      map_smul' := by intros; simp }
  refine LinearIndependent.of_comp f ?_
  let e : ℕ × ℕ → (Fin 2 →₀ ℕ) := fun p => Finsupp.single 0 p.1 + Finsupp.single 1 p.2
  have he : Function.Injective e := by
    intro p q h
    have h0 := DFunLike.congr_fun h 0
    have h1 := DFunLike.congr_fun h 1
    simp [e] at h0 h1
    exact Prod.ext h0 h1
  have := (MvPolynomial.basisMonomials (Fin 2) k).linearIndependent.comp e he
  convert this using 1
  funext ⟨i, j⟩
  show weylRepF (weylX k ^ i * weylY k ^ j) 1 = _
  rw [weylRepF_monomial]
  show _ = MvPolynomial.basisMonomials (Fin 2) k (e (i, j))
  rw [MvPolynomial.coe_basisMonomials]
  show _ = MvPolynomial.monomial (Finsupp.single 0 i + Finsupp.single 1 j) 1
  rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul,
    mul_one]

/-- The monomial basis `xⁱ yʲ` of the Weyl algebra over any field. -/
noncomputable def weylBasisAny : Module.Basis (ℕ × ℕ) k (WeylAlgebra k) :=
  Module.Basis.mk weyl_linearIndependent_any weyl_span.ge

theorem weylBasisAny_apply (p : ℕ × ℕ) :
    weylBasisAny (k := k) p = weylX k ^ p.1 * weylY k ^ p.2 := by
  simp [weylBasisAny]

end Faithful

section Center

variable {k : Type*} [Field k]

/-- `z ↦ z x - x z` on the Weyl algebra. -/
noncomputable def wAdX : WeylAlgebra k →ₗ[k] WeylAlgebra k :=
  LinearMap.mulRight k (weylX k) - LinearMap.mulLeft k (weylX k)

/-- `z ↦ y z - z y` on the Weyl algebra. -/
noncomputable def wAdY : WeylAlgebra k →ₗ[k] WeylAlgebra k :=
  LinearMap.mulLeft k (weylY k) - LinearMap.mulRight k (weylY k)

theorem wAdX_apply (z : WeylAlgebra k) : wAdX z = z * weylX k - weylX k * z := rfl
theorem wAdY_apply (z : WeylAlgebra k) : wAdY z = weylY k * z - z * weylY k := rfl

theorem wAdX_basis (a c : ℕ) :
    wAdX (weylBasisAny (k := k) (a, c)) = (c : k) • weylBasisAny (k := k) (a, c - 1) := by
  rw [wAdX_apply, weylBasisAny_apply, weylBasisAny_apply]
  simp only
  rw [mul_assoc, y_pow_mul_x_of_rel _ _ weylY_mul_weylX c, mul_add, ← mul_assoc,
    ← (Commute.self_pow (weylX k) a).eq, mul_assoc, add_sub_cancel_left, mul_smul_comm,
    ← Nat.cast_smul_eq_nsmul k]

theorem wAdY_basis (a c : ℕ) :
    wAdY (weylBasisAny (k := k) (a, c)) = (a : k) • weylBasisAny (k := k) (a - 1, c) := by
  rw [wAdY_apply, weylBasisAny_apply, weylBasisAny_apply]
  simp only
  rw [← mul_assoc, y_mul_x_pow _ _ weylY_mul_weylX, add_mul, mul_assoc (weylX k ^ a) (weylY k)
    (weylY k ^ c), ← pow_succ', mul_assoc (weylX k ^ a) (weylY k ^ c) (weylY k), ← pow_succ,
    add_sub_cancel_left, smul_mul_assoc, ← Nat.cast_smul_eq_nsmul k]

theorem repr_wAdX (z : WeylAlgebra k) (i j : ℕ) :
    weylBasisAny.repr (wAdX z) (i, j) = ((j : k) + 1) * weylBasisAny.repr z (i, j + 1) := by
  have : (Finsupp.lapply (i, j) ∘ₗ (weylBasisAny (k := k)).repr.toLinearMap ∘ₗ wAdX) =
      ((j : k) + 1) • (Finsupp.lapply (i, j + 1) ∘ₗ (weylBasisAny (k := k)).repr.toLinearMap) := by
    refine weylBasisAny.ext fun ⟨a, c⟩ => ?_
    simp only [LinearMap.comp_apply, wAdX_basis, LinearEquiv.coe_coe, map_smul,
      Basis.repr_self, Finsupp.lapply_apply, LinearMap.smul_apply,
      Finsupp.single_apply, smul_eq_mul, Prod.mk.injEq]
    by_cases h : a = i ∧ c = j + 1
    · obtain ⟨rfl, rfl⟩ := h
      simp
    · rw [if_neg h, mul_zero]
      split_ifs with h2
      · obtain ⟨h2a, h2b⟩ := h2
        rcases Nat.eq_zero_or_pos c with hc | hc
        · simp [hc]
        · exact absurd ⟨by omega, by omega⟩ h
      · simp
  exact congrArg (fun f => f z) this

theorem repr_wAdY (z : WeylAlgebra k) (i j : ℕ) :
    weylBasisAny.repr (wAdY z) (i, j) = ((i : k) + 1) * weylBasisAny.repr z (i + 1, j) := by
  have : (Finsupp.lapply (i, j) ∘ₗ (weylBasisAny (k := k)).repr.toLinearMap ∘ₗ wAdY) =
      ((i : k) + 1) • (Finsupp.lapply (i + 1, j) ∘ₗ (weylBasisAny (k := k)).repr.toLinearMap) := by
    refine weylBasisAny.ext fun ⟨a, c⟩ => ?_
    simp only [LinearMap.comp_apply, wAdY_basis, LinearEquiv.coe_coe, map_smul,
      Basis.repr_self, Finsupp.lapply_apply, LinearMap.smul_apply,
      Finsupp.single_apply, smul_eq_mul, Prod.mk.injEq]
    by_cases h : a = i + 1 ∧ c = j
    · obtain ⟨rfl, rfl⟩ := h
      simp
    · rw [if_neg h, mul_zero]
      split_ifs with h2
      · obtain ⟨h2a, h2b⟩ := h2
        rcases Nat.eq_zero_or_pos a with hc | hc
        · simp [hc]
        · exact absurd ⟨by omega, by omega⟩ h
      · simp
  exact congrArg (fun f => f z) this

/-- An element commuting with both generators commutes with everything. -/
theorem commute_of_commute_gens (c : WeylAlgebra k) (hx : Commute c (weylX k))
    (hy : Commute c (weylY k)) (z : WeylAlgebra k) : Commute c z := by
  have hz : z ∈ Submodule.span k (Set.range fun p : ℕ × ℕ => weylX k ^ p.1 * weylY k ^ p.2) := by
    rw [weyl_span]; trivial
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨⟨i, j⟩, rfl⟩ := hz
    exact (hx.pow_right i).mul_right (hy.pow_right j)
  | zero => exact Commute.zero_right c
  | add a b _ _ ha hb => exact ha.add_right hb
  | smul r a _ ha => exact ha.smul_right r

variable {p : ℕ} [Fact p.Prime] [CharP k p]

/-- Problem 1.26(b): in characteristic `p`, the centre of the Weyl algebra is generated by `x^p`
and `y^p`. -/
@[kb "etingof2011" "Problem 1.26, p. 12"]
theorem weyl_center_eq_adjoin :
    Subalgebra.center k (WeylAlgebra k) = Algebra.adjoin k {weylX k ^ p, weylY k ^ p} := by
  have hp := (Fact.out : p.Prime).pos
  apply le_antisymm
  · intro z hz
    rw [Subalgebra.mem_center_iff] at hz
    have h1 : wAdX z = 0 := by rw [wAdX_apply, hz (weylX k), sub_self]
    have h2 : wAdY z = 0 := by rw [wAdY_apply, hz (weylY k), sub_self]
    -- support lies in `p ℤ × p ℤ`
    have hj : ∀ i j, ¬ p ∣ j → weylBasisAny.repr z (i, j) = 0 := by
      intro i j hj
      obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by
        have : j ≠ 0 := fun h => hj (h ▸ dvd_zero p)
        omega⟩
      have := repr_wAdX z i j'
      rw [h1] at this
      simp only [map_zero, Finsupp.coe_zero, Pi.zero_apply] at this
      have hne : ((j' : k) + 1) ≠ 0 := by
        rw [← Nat.cast_add_one]
        exact fun h => hj ((CharP.cast_eq_zero_iff k p _).1 h)
      exact (mul_eq_zero.1 this.symm).resolve_left hne
    have hi : ∀ i j, ¬ p ∣ i → weylBasisAny.repr z (i, j) = 0 := by
      intro i j hi
      obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by
        have : i ≠ 0 := fun h => hi (h ▸ dvd_zero p)
        omega⟩
      have := repr_wAdY z i' j
      rw [h2] at this
      simp only [map_zero, Finsupp.coe_zero, Pi.zero_apply] at this
      have hne : ((i' : k) + 1) ≠ 0 := by
        rw [← Nat.cast_add_one]
        exact fun h => hi ((CharP.cast_eq_zero_iff k p _).1 h)
      exact (mul_eq_zero.1 this.symm).resolve_left hne
    have hsum := (weylBasisAny (k := k)).linearCombination_repr z
    rw [← hsum, Finsupp.linearCombination_apply, Finsupp.sum]
    refine Subalgebra.sum_mem _ fun q hq => ?_
    refine Subalgebra.smul_mem _ ?_ _
    have hq' := Finsupp.mem_support_iff.1 hq
    obtain ⟨a, ha⟩ : p ∣ q.1 := by_contra fun h => hq' (hi _ _ h)
    obtain ⟨b, hb⟩ : p ∣ q.2 := by_contra fun h => hq' (hj _ _ h)
    rw [weylBasisAny_apply, ha, hb, pow_mul, pow_mul]
    exact Subalgebra.mul_mem _ (Subalgebra.pow_mem _ (Algebra.subset_adjoin (by simp)) _)
      (Subalgebra.pow_mem _ (Algebra.subset_adjoin (by simp)) _)
  · refine Algebra.adjoin_le ?_
    obtain ⟨hx, hy⟩ := weyl_pow_central (k := k) (p := p)
    rintro _ (rfl | rfl)
    · rw [SetLike.mem_coe, Subalgebra.mem_center_iff]
      exact fun b => (commute_of_commute_gens _ (Commute.pow_left (Commute.refl _) p) hx b).eq.symm
    · rw [SetLike.mem_coe, Subalgebra.mem_center_iff]
      exact fun b => (commute_of_commute_gens _ hy (Commute.pow_left (Commute.refl _) p) b).eq.symm

end Center

section Iso

open Polynomial

variable {k : Type*} [Field k] {p : ℕ} [Fact p.Prime] [CharP k p]

omit [Fact p.Prime] [CharP k p] in
theorem X_pow_mem_degreeLT (n : ℕ) (hn : n < p) : (X ^ n : k[X]) ∈ degreeLT k p := by
  rw [mem_degreeLT]; exact (degree_X_pow_le n).trans_lt (by exact_mod_cast hn)

/-- The monomial `tⁿ` as an element of `k[t]_{<p}` (zero for `n ≥ p`). -/
noncomputable def gP (k : Type*) [Field k] (p : ℕ) (n : ℕ) : WeylPSpace k p :=
  if h : n < p then ⟨X ^ n, X_pow_mem_degreeLT n h⟩ else 0

theorem gP_val (n : ℕ) (hn : n < p) : (gP k p n).1 = X ^ n := by
  simp [gP, hn]

theorem weylXV_gP (a : k) (n : ℕ) (hn : n + 1 < p) :
    weylXV a (gP k p n) = gP k p (n + 1) := by
  refine Subtype.ext ?_
  rw [gP_val (n + 1) hn]
  have := weylXV_X_pow a n hn (X_pow_mem_degreeLT n (by omega)) (X_pow_mem_degreeLT (n + 1) hn)
  rw [gP, dif_pos (by omega)]
  exact congrArg Subtype.val this

theorem weylXV_gP_last (a : k) (n : ℕ) (hn : n + 1 = p) :
    weylXV a (gP k p n) = a • gP k p 0 := by
  have hp := (Fact.out : p.Prime).pos
  refine Subtype.ext ?_
  show weylXp p a (gP k p n).1 = (a • gP k p 0).1
  rw [gP_val n (by omega)]
  have h0 : (a • gP k p 0).1 = a • (1 : k[X]) := by
    show a • (gP k p 0).1 = _
    rw [gP_val 0 hp]; simp
  rw [h0, weylXp_apply, coeff_X_pow, if_pos (by omega), ← hn, pow_succ']
  simp [smul_eq_C_mul]

theorem weylYV_gP (b : k) (n : ℕ) (hn : n < p) :
    weylYV b (gP k p n) = (n : k) • gP k p (n - 1) + b • gP k p n := by
  refine Subtype.ext ?_
  show weylYp b (gP k p n).1 = ((n : k) • gP k p (n - 1) + b • gP k p n).1
  rw [gP_val n hn, weylYp_apply]
  show _ = (n : k) • (gP k p (n - 1)).1 + b • (gP k p n).1
  rw [gP_val n hn, gP_val (n - 1) (by omega), derivative_X_pow]
  simp only [smul_eq_C_mul]

theorem ext_gP {M : Type*} [AddCommGroup M] [Module k M] {F G : WeylPSpace k p →ₗ[k] M}
    (h : ∀ n < p, F (gP k p n) = G (gP k p n)) : F = G := by
  refine LinearMap.ext fun f => ?_
  have hp := (Fact.out : p.Prime).pos
  have hf := mem_degreeLT.1 f.2
  have hnd : f.1.natDegree < p := by
    rcases eq_or_ne f.1 0 with h0 | h0
    · rw [h0]; simpa using hp
    · exact (natDegree_lt_iff_degree_lt h0).2 hf
  have : f = ∑ i ∈ Finset.range p, f.1.coeff i • gP k p i := by
    refine Subtype.ext ?_
    rw [Submodule.coe_sum]
    conv_lhs => rw [as_sum_range' f.1 p hnd]
    refine Finset.sum_congr rfl fun i hi => ?_
    show _ = (f.1.coeff i • gP k p i).1
    rw [Submodule.coe_smul, gP_val i (Finset.mem_range.1 hi)]
    simp [smul_eq_C_mul, C_mul_X_pow_eq_monomial]
  rw [this, map_sum, map_sum]
  exact Finset.sum_congr rfl fun i hi => by rw [map_smul, map_smul, h i (Finset.mem_range.1 hi)]

/-- If a linear map intertwines two representations on the generators, it intertwines them
everywhere. -/
theorem intertwine_all {V₁ V₂ : Type*} [AddCommGroup V₁] [Module k V₁] [AddCommGroup V₂]
    [Module k V₂] (ρ₁ : WeylAlgebra k →ₐ[k] Module.End k V₁)
    (ρ₂ : WeylAlgebra k →ₐ[k] Module.End k V₂) (φ : V₁ →ₗ[k] V₂)
    (hx : φ ∘ₗ ρ₁ (weylX k) = ρ₂ (weylX k) ∘ₗ φ) (hy : φ ∘ₗ ρ₁ (weylY k) = ρ₂ (weylY k) ∘ₗ φ)
    (z : WeylAlgebra k) : φ ∘ₗ ρ₁ z = ρ₂ z ∘ₗ φ := by
  have hpow : ∀ (F : Module.End k V₁) (G : Module.End k V₂), φ ∘ₗ F = G ∘ₗ φ →
      ∀ n : ℕ, φ ∘ₗ (F ^ n) = (G ^ n) ∘ₗ φ := by
    intro F G h n
    induction n with
    | zero => rw [pow_zero, pow_zero]; rfl
    | succ n ih =>
      rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
        ← LinearMap.comp_assoc, h, LinearMap.comp_assoc, ih, ← LinearMap.comp_assoc]
  let S : Submodule k (WeylAlgebra k) :=
    { carrier := {z | φ ∘ₗ ρ₁ z = ρ₂ z ∘ₗ φ}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at *
        rw [map_add, map_add, LinearMap.comp_add, LinearMap.add_comp, ha, hb]
      zero_mem' := by simp
      smul_mem' := fun c z hz => by
        simp only [Set.mem_setOf_eq] at *
        rw [map_smul, map_smul, LinearMap.comp_smul, LinearMap.smul_comp, hz] }
  have hle : (⊤ : Submodule k (WeylAlgebra k)) ≤ S := by
    rw [← weyl_span]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨⟨i, j⟩, rfl⟩
    show φ ∘ₗ ρ₁ (weylX k ^ i * weylY k ^ j) = ρ₂ (weylX k ^ i * weylY k ^ j) ∘ₗ φ
    rw [map_mul, map_pow, map_pow, map_mul, map_pow, map_pow, Module.End.mul_eq_comp,
      Module.End.mul_eq_comp, ← LinearMap.comp_assoc, hpow _ _ hx i, LinearMap.comp_assoc,
      hpow _ _ hy j, LinearMap.comp_assoc]
  exact hle (Submodule.mem_top (x := z))

/-- A subspace stable under `x` and `y` is stable under the whole Weyl algebra. -/
theorem stable_all {V : Type*} [AddCommGroup V] [Module k V]
    (ρ : WeylAlgebra k →ₐ[k] Module.End k V) (W : Submodule k V)
    (hx : ∀ w ∈ W, ρ (weylX k) w ∈ W) (hy : ∀ w ∈ W, ρ (weylY k) w ∈ W) :
    ∀ z : WeylAlgebra k, ∀ w ∈ W, ρ z w ∈ W := by
  intro z
  have hpowW : ∀ F : Module.End k V, (∀ w ∈ W, F w ∈ W) → ∀ n : ℕ, ∀ w ∈ W, (F ^ n) w ∈ W := by
    intro F hF n
    induction n with
    | zero => intro w hw; simpa using hw
    | succ n ih => intro w hw; rw [pow_succ', Module.End.mul_apply]; exact hF _ (ih w hw)
  let S : Submodule k (WeylAlgebra k) :=
    { carrier := {z | ∀ w ∈ W, ρ z w ∈ W}
      add_mem' := fun ha hb w hw => by simpa using W.add_mem (ha w hw) (hb w hw)
      zero_mem' := fun w hw => by simp
      smul_mem' := fun c z hz w hw => by simpa using W.smul_mem c (hz w hw) }
  have hle : (⊤ : Submodule k (WeylAlgebra k)) ≤ S := by
    rw [← weyl_span]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨⟨i, j⟩, rfl⟩ w hw
    show ρ (weylX k ^ i * weylY k ^ j) w ∈ W
    rw [map_mul, map_pow, map_pow, Module.End.mul_apply]
    exact hpowW _ hx i _ (hpowW _ hy j w hw)
  exact fun w hw => hle (Submodule.mem_top (x := z)) w hw

section Classify

variable [IsAlgClosed k] {V : Type*} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
  [Nontrivial V]

/-- Problem 1.26(c): over an algebraically closed field of characteristic `p`, every irreducible
finite-dimensional representation of the Weyl algebra is isomorphic to one of the `p`-dimensional
representations `weylRepP a b`. -/
@[kb "etingof2011" "Problem 1.26, p. 12"]
theorem weyl_irrep_iso (ρ : WeylAlgebra k →ₐ[k] Module.End k V)
    (hirr : ∀ W : Submodule k V, (∀ z : WeylAlgebra k, ∀ w ∈ W, ρ z w ∈ W) → W = ⊥ ∨ W = ⊤) :
    ∃ (a b : k) (e : WeylPSpace k p ≃ₗ[k] V),
      ∀ (z : WeylAlgebra k) (w : WeylPSpace k p), e (weylRepP (p := p) a b z w) = ρ z (e w) := by
  have hp := (Fact.out : p.Prime).pos
  set X := ρ (weylX k) with hXdef
  set Y := ρ (weylY k) with hYdef
  have hirr' : ∀ W : Submodule k V, (∀ w ∈ W, X w ∈ W) → (∀ w ∈ W, Y w ∈ W) → W = ⊥ ∨ W = ⊤ :=
    fun W hx hy => hirr W (stable_all ρ W hx hy)
  have hrel : Y * X = X * Y + 1 := by
    rw [hXdef, hYdef, ← map_mul, ← map_mul, ← map_one ρ, ← map_add, weylY_mul_weylX]
  obtain ⟨β, hβ⟩ := Module.End.exists_eigenvalue Y
  obtain ⟨v, hv⟩ := hβ.exists_hasEigenvector
  have hYv : Y v = β • v := Module.End.mem_eigenspace_iff.1 hv.1
  have hv0 : v ≠ 0 := hv.2
  obtain ⟨a, ha⟩ := exists_scalar_of_commute X Y (X ^ p) hirr'
    (Commute.self_pow X p).eq.symm
    (by
      have := (weyl_pow_central (k := k) (p := p)).1.map ρ
      rw [map_pow] at this
      exact this.eq)
  have hXp : (X ^ p) v = a • v := by rw [ha]; simp
  -- the map `φ`
  let φ : WeylPSpace k p →ₗ[k] V :=
    ∑ i : Fin p, ((lcoeff k (i : ℕ)).comp (Submodule.subtype _)).smulRight ((X ^ (i : ℕ)) v)
  have hφ : ∀ n < p, φ (gP k p n) = (X ^ n) v := by
    intro n hn
    simp only [φ, LinearMap.sum_apply, LinearMap.smulRight_apply, LinearMap.comp_apply,
      Submodule.subtype_apply, lcoeff_apply, gP_val n hn, coeff_X_pow]
    rw [Finset.sum_eq_single ⟨n, hn⟩]
    · simp
    · intro i _ hi
      have : (i : ℕ) ≠ n := fun h => hi (Fin.ext h)
      simp [this]
    · simp
  have hxint : φ ∘ₗ (weylRepP (p := p) a β (weylX k)) = X ∘ₗ φ := by
    rw [weylRepP_x]
    refine ext_gP fun n hn => ?_
    simp only [LinearMap.comp_apply]
    rcases Nat.lt_or_ge (n + 1) p with h | h
    · rw [weylXV_gP a n h, hφ _ h, hφ _ hn, pow_succ', Module.End.mul_apply]
    · rw [weylXV_gP_last a n (by omega), map_smul, hφ 0 hp, hφ n hn]
      have : (X ^ p) v = X ((X ^ n) v) := by
        rw [show p = n + 1 by omega, pow_succ', Module.End.mul_apply]
      rw [← this, hXp]; simp
  have hyint : φ ∘ₗ (weylRepP (p := p) a β (weylY k)) = Y ∘ₗ φ := by
    rw [weylRepP_y]
    refine ext_gP fun n hn => ?_
    simp only [LinearMap.comp_apply]
    rw [weylYV_gP β n hn, map_add, map_smul, map_smul, hφ _ (by omega), hφ _ hn]
    have h := congrArg (fun F => F v) (y_mul_x_pow X Y hrel n)
    simp only [Module.End.mul_apply, LinearMap.add_apply, LinearMap.smul_apply, hYv,
      map_smul] at h
    rw [h, ← Nat.cast_smul_eq_nsmul k]
    abel
  have hall := intertwine_all (weylRepP (p := p) a β) ρ φ hxint hyint
  have hall' : ∀ z w, φ (weylRepP (p := p) a β z w) = ρ z (φ w) := fun z w =>
    congrArg (fun F => F w) (hall z)
  have hφ0 : φ (gP k p 0) = v := by rw [hφ 0 hp]; simp
  have hinj : Function.Injective φ := by
    rw [← LinearMap.ker_eq_bot]
    rcases weylRepP_irreducible a β (LinearMap.ker φ) (fun z w hw => by
      rw [LinearMap.mem_ker] at hw ⊢; rw [hall', hw, map_zero]) with h | h
    · exact h
    · exfalso
      have : gP k p 0 ∈ LinearMap.ker φ := by rw [h]; trivial
      rw [LinearMap.mem_ker, hφ0] at this
      exact hv0 this
  have hsurj : Function.Surjective φ := by
    rw [← LinearMap.range_eq_top]
    rcases hirr (LinearMap.range φ) (fun z w hw => by
      obtain ⟨u, rfl⟩ := hw
      exact ⟨weylRepP (p := p) a β z u, hall' z u⟩) with h | h
    · exfalso
      have : v ∈ LinearMap.range φ := ⟨gP k p 0, hφ0⟩
      rw [h] at this
      exact hv0 (by simpa using this)
    · exact h
  exact ⟨a, β, LinearEquiv.ofBijective φ ⟨hinj, hsurj⟩, fun z w => hall' z w⟩

end Classify

theorem weylXV_pow_gP (a : k) (n j : ℕ) (h : n + j < p) :
    (weylXV a ^ j) (gP k p n) = gP k p (n + j) := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [pow_succ', Module.End.mul_apply, ih (by omega), ← add_assoc, weylXV_gP a _ (by omega)]

theorem weylXV_pow_p (a : k) : (weylXV a ^ p : Module.End k (WeylPSpace k p)) = a • 1 := by
  have hp := (Fact.out : p.Prime).pos
  refine ext_gP fun n hn => ?_
  have e2 : (weylXV a ^ p : Module.End k (WeylPSpace k p)) =
      weylXV a ^ n * (weylXV a * weylXV a ^ (p - n - 1)) := by
    rw [← pow_succ', ← pow_add]; congr 1; omega
  rw [e2, Module.End.mul_apply, Module.End.mul_apply, weylXV_pow_gP a n (p - n - 1) (by omega),
    weylXV_gP_last a _ (by omega), map_smul]
  have : weylXV a ^ n = (weylXV a ^ n : Module.End k (WeylPSpace k p)) := rfl
  have h2 := weylXV_pow_gP a 0 n (by omega)
  rw [zero_add] at h2
  rw [h2]
  simp

/-- Isomorphic representations `weylRepP a b ≅ weylRepP a' b'` have the same parameters. -/
@[kb "etingof2011" "Problem 1.26, p. 12"]
theorem weylRepP_iso_unique [IsAlgClosed k] (a b a' b' : k)
    (e : WeylPSpace k p ≃ₗ[k] WeylPSpace k p)
    (he : ∀ (z : WeylAlgebra k) (w : WeylPSpace k p),
      e (weylRepP (p := p) a b z w) = weylRepP (p := p) a' b' z (e w)) : a = a' ∧ b = b' := by
  have hp := (Fact.out : p.Prime).pos
  have hg0 : gP k p 0 ≠ 0 := by
    intro h
    have := congrArg Subtype.val h
    rw [gP_val 0 hp] at this
    simp at this
  have hu : e (gP k p 0) ≠ 0 := fun h => hg0 (e.injective (by rw [h, map_zero]))
  have hxe : ∀ (j : ℕ) (w : WeylPSpace k p), e ((weylXV a ^ j) w) = (weylXV a' ^ j) (e w) := by
    intro j
    induction j with
    | zero => intro w; simp
    | succ j ih =>
      intro w
      rw [pow_succ', pow_succ', Module.End.mul_apply, Module.End.mul_apply]
      have := he (weylX k) ((weylXV a ^ j) w)
      rw [weylRepP_x, weylRepP_x] at this
      rw [this, ih]
  constructor
  · have h1 := hxe p (gP k p 0)
    rw [weylXV_pow_p, weylXV_pow_p] at h1
    simp only [LinearMap.smul_apply, Module.End.one_apply, map_smul] at h1
    exact smul_left_injective k hu h1
  · have h1 := he (weylY k) (gP k p 0)
    rw [weylRepP_y, weylRepP_y, weylYV_gP b 0 hp] at h1
    simp only [Nat.cast_zero, zero_smul, zero_add, map_smul] at h1
    set u := e (gP k p 0) with hudef
    have hu1 : (weylYV b' u).1 = (b • u).1 := by rw [← h1]
    have h3 : derivative u.1 = (b - b') • u.1 := by
      have : derivative u.1 + b' • u.1 = b • u.1 := hu1
      rw [_root_.sub_smul, eq_sub_iff_add_eq]; exact this
    have h4 : ∀ n : ℕ, derivative^[n] u.1 = (b - b') ^ n • u.1 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [Function.iterate_succ_apply', ih]
        rw [map_smul, h3, smul_smul, pow_succ]
    have h5 := h4 p
    rw [iterate_derivative_eq_zero_of_degree_lt (mem_degreeLT.1 u.2)] at h5
    have h6 : (b - b') ^ p = 0 := by
      by_contra hne
      have := (smul_eq_zero.1 h5.symm).resolve_left hne
      exact hu (Subtype.ext this)
    exact sub_eq_zero.1 (pow_eq_zero_iff hp.ne' |>.1 h6)
end Iso

