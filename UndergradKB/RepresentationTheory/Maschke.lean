import Mathlib.RepresentationTheory.Maschke
import Mathlib.RingTheory.SimpleModule.Basic
import UndergradKB.Common.Attr

/-! # The converse of Maschke's theorem (Etingof et al., Proposition 3.2)

Maschke's theorem (`MonoidAlgebra.Submodule.exists_isCompl`, the `IsSemisimpleRing` instance) says that the group
algebra `k[G]` of a finite group is semisimple when the characteristic of `k` does not divide the order of `G`.
Here: the converse. The proof is the book's: the element `s = ∑ g` spans a two-sided ideal with `s * s = |G| • s`;
if `|G| = 0` in `k` that ideal squares to zero, so it is not generated by an idempotent, contradicting semisimplicity.
-/

namespace UndergradKB.RepresentationTheory

open MonoidAlgebra

variable {k G : Type*} [Field k] [Group G] [Fintype G]

/-- The sum of all group elements in the group algebra. -/
noncomputable def groupSum (k G : Type*) [Field k] [Group G] [Fintype G] : k[G] :=
  ∑ g : G, of k G g

theorem of_mul_groupSum (h : G) : of k G h * groupSum k G = groupSum k G := by
  simp only [groupSum, Finset.mul_sum, of_apply, single_mul_single, mul_one]
  exact Fintype.sum_bijective _ (Group.mulLeft_bijective h) _ _ (fun _ ↦ rfl)

theorem groupSum_mul_of (h : G) : groupSum k G * of k G h = groupSum k G := by
  simp only [groupSum, Finset.sum_mul, of_apply, single_mul_single, mul_one]
  exact Fintype.sum_bijective _ (Group.mulRight_bijective h) _ _ (fun _ ↦ rfl)

/-- Multiplying `∑ g` by any element on the left gives a scalar multiple of `∑ g`. -/
theorem exists_mul_groupSum (x : k[G]) : ∃ c : k, x * groupSum k G = c • groupSum k G := by
  induction x using MonoidAlgebra.induction_on with
  | of m => exact ⟨1, by rw [of_mul_groupSum, one_smul]⟩
  | add x y hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    exact ⟨a + b, by rw [add_mul, ha, hb, add_smul]⟩
  | smul r x hx =>
    obtain ⟨a, ha⟩ := hx
    exact ⟨r * a, by rw [smul_mul_assoc, ha, smul_smul]⟩

/-- Multiplying `∑ g` by any element on the right gives a scalar multiple of `∑ g`. -/
theorem exists_groupSum_mul (x : k[G]) : ∃ c : k, groupSum k G * x = c • groupSum k G := by
  induction x using MonoidAlgebra.induction_on with
  | of m => exact ⟨1, by rw [groupSum_mul_of, one_smul]⟩
  | add x y hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    exact ⟨a + b, by rw [mul_add, ha, hb, add_smul]⟩
  | smul r x hx =>
    obtain ⟨a, ha⟩ := hx
    exact ⟨r * a, by rw [mul_smul_comm, ha, smul_smul]⟩

theorem groupSum_mul_groupSum :
    groupSum k G * groupSum k G = (Fintype.card G : k) • groupSum k G := by
  have : groupSum k G * groupSum k G = ∑ g : G, groupSum k G * of k G g := by
    rw [← Finset.mul_sum]; rfl
  rw [this]
  simp only [groupSum_mul_of, Finset.sum_const, Finset.card_univ, Nat.cast_smul_eq_nsmul]

theorem groupSum_ne_zero : groupSum k G ≠ 0 := by
  intro h
  have := congrArg (fun x : k[G] ↦ x.coeff 1) h
  classical
  simp only [groupSum, coeff_sum, of_apply, coeff_single] at this
  simp at this

/-- **Etingof et al., Proposition 3.2** (converse of Maschke's theorem): if the group algebra `k[G]` of a finite
group is semisimple, then the characteristic of `k` does not divide the order of `G`. -/
@[kb "etingof2011" "Proposition 3.2, p. 33"]
theorem card_ne_zero_of_isSemisimpleRing [IsSemisimpleRing k[G]] : (Fintype.card G : k) ≠ 0 := by
  intro hG
  obtain ⟨e, he, hspan⟩ := IsSemisimpleRing.ideal_eq_span_idempotent (Ideal.span {groupSum k G})
  have hmem : e ∈ Ideal.span {groupSum k G} := hspan ▸ Ideal.subset_span rfl
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hmem
  obtain ⟨c, hc⟩ := exists_groupSum_mul a
  have h0 : a * groupSum k G = 0 := by
    rw [← he.eq, mul_assoc, ← mul_assoc (groupSum k G), hc, smul_mul_assoc, groupSum_mul_groupSum,
      hG, zero_smul, smul_zero, mul_zero]
  rw [h0, Ideal.span_singleton_eq_bot.mpr rfl] at hspan
  exact groupSum_ne_zero (Ideal.span_singleton_eq_bot.mp hspan)

/-- **Etingof et al., Theorem 3.1 together with Proposition 3.2**: for a finite group `G`, the group algebra `k[G]` is
semisimple if and only if the characteristic of `k` does not divide the order of `G`. -/
@[kb "etingof2011" "Theorem 3.1, p. 33"]
theorem isSemisimpleRing_iff_card_ne_zero : IsSemisimpleRing k[G] ↔ (Fintype.card G : k) ≠ 0 := by
  refine ⟨fun _ ↦ card_ne_zero_of_isSemisimpleRing, fun h ↦ ?_⟩
  have : NeZero (Nat.card G : k) := ⟨by rwa [Nat.card_eq_fintype_card]⟩
  infer_instance

end UndergradKB.RepresentationTheory
