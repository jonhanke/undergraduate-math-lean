import Mathlib.Analysis.SpecialFunctions.Trigonometric.Inverse
import Mathlib.Logic.Relation
import UndergradKB.Common.Attr
import UndergradKB.RepresentationTheory.DehnPolyhedra

/-!
# Etingof et al., Problem 1.51 (c): the cube and the regular tetrahedron are not scissors-congruent

With polyhedra recorded by their faces (`DehnPolyhedra.lean`): the Dehn invariant is unchanged by rigid motions,
the cube has invariant zero and the regular tetrahedron a nonzero one. Hence the cube and the tetrahedron are not
related by straight cuts (whose plane contains no edge of the piece being cut), rigid motions of pieces, and the
reverse operations (gluing).
-/

namespace UndergradKB.RepresentationTheory

open Real TensorProduct MeasureTheory InnerProductGeometry

/-! ### Rigid motions -/

/-- The rigid motion `x ↦ Q x + b`. -/
noncomputable def motion (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b : Space3) : Space3 ≃ᵢ Space3 :=
  Q.toIsometryEquiv.trans (IsometryEquiv.addRight b)

lemma motion_apply (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b x : Space3) : motion Q b x = Q x + b := rfl

/-- The image of a face under the rigid motion `x ↦ Q x + b`. -/
noncomputable def Face.move (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b : Space3) (h : Face) : Face :=
  ⟨Q h.normal, h.offset + inner ℝ (Q h.normal) b⟩

lemma Face.inner_move (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b x : Space3) (h : Face) :
    inner ℝ (h.move Q b).normal (motion Q b x) - (h.move Q b).offset = inner ℝ h.normal x - h.offset := by
  simp only [Face.move, motion_apply, inner_add_right, LinearIsometryEquiv.inner_map_map]
  ring

lemma Face.preimage_half_move (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b : Space3) (h : Face) :
    motion Q b ⁻¹' (h.move Q b).half = h.half := by
  ext x
  simp only [Set.mem_preimage, Face.half, Set.mem_setOf_eq, ← sub_nonpos (a := inner ℝ _ _),
    Face.inner_move]

lemma Face.preimage_plane_move (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b : Space3) (h : Face) :
    motion Q b ⁻¹' (h.move Q b).plane = h.plane := by
  ext x
  simp only [Set.mem_preimage, Face.plane, Set.mem_setOf_eq, ← sub_eq_zero (a := inner ℝ _ _),
    Face.inner_move]

lemma preimage_cell_move (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b : Space3) (l : List Face) :
    motion Q b ⁻¹' cell (l.map (Face.move Q b)) = cell l := by
  ext x
  simp only [cell, Set.mem_preimage, Set.mem_setOf_eq, List.mem_map, forall_exists_index, and_imp,
    forall_apply_eq_imp_iff₂]
  refine forall₂_congr fun h _ => ?_
  rw [← Set.mem_preimage, Face.preimage_half_move]

lemma facePairs_map (f : Face → Face) (l : List Face) :
    facePairs (l.map f) = (facePairs l).map (Prod.map f f) := by
  induction l with
  | nil => rfl
  | cons h t ih => simp [facePairs, ih, List.map_map, Function.comp_def]

lemma dehnTerm_move (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b : Space3) (l : List Face) (h k : Face) :
    dehnTerm (cell (l.map (Face.move Q b))) (h.move Q b) (k.move Q b) = dehnTerm (cell l) h k := by
  have hlen : edgeLength (cell (l.map (Face.move Q b))) (h.move Q b) (k.move Q b) = edgeLength (cell l) h k := by
    rw [edgeLength, edgeLength, ← Set.image_preimage_eq (cell _ ∩ _ ∩ _) (motion Q b).surjective,
      (motion Q b).hausdorffMeasure_image]
    simp only [Set.preimage_inter, preimage_cell_move, Face.preimage_plane_move]
  have hang : dihedral (h.move Q b) (k.move Q b) = dihedral h k := by
    simp only [dihedral, Face.move]
    rw [show (Q h.normal) = Q.toLinearIsometry h.normal from rfl,
      show (Q k.normal) = Q.toLinearIsometry k.normal from rfl, LinearIsometry.angle_map]
  rw [dehnTerm, dehnTerm, hlen, hang]

/-- The Dehn invariant is unchanged by rigid motions. -/
@[kb "etingof2011" "Problem 1.51, p. 19"]
theorem polyDehn_move (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b : Space3) (l : List Face) :
    polyDehn (l.map (Face.move Q b)) = polyDehn l := by
  rw [polyDehn_eq, polyDehn_eq, facePairs_map, List.map_map]
  congr 1
  refine List.map_congr_left fun p _ => ?_
  exact dehnTerm_move Q b l p.1 p.2

/-! ### Scissors congruence -/

/-- One step of cutting and moving pieces: cut a bounded piece by a plane containing no edge of it, move a piece
rigidly, or reorder the pieces. -/
inductive ScissorsStep : List (List Face) → List (List Face) → Prop
  | cut (l : List Face) (m : Face) (rest : List (List Face)) (hb : Bornology.IsBounded (cell l))
      (hnull : ∀ h ∈ l, ∀ k ∈ l, LinearIndependent ℝ ![h.normal, k.normal] →
        μH[1] (cell l ∩ h.plane ∩ k.plane ∩ m.plane) = 0) :
      ScissorsStep (l :: rest) ((l ++ [m]) :: (l ++ [m.neg]) :: rest)
  | move (l : List Face) (Q : Space3 ≃ₗᵢ[ℝ] Space3) (b : Space3) (rest : List (List Face)) :
      ScissorsStep (l :: rest) (l.map (Face.move Q b) :: rest)
  | perm {L L' : List (List Face)} : L.Perm L' → ScissorsStep L L'

/-- Scissors congruence of collections of pieces: the equivalence relation generated by the steps (so gluing, the
reverse of cutting, is allowed). -/
def ScissorsCongruent (L L' : List (List Face)) : Prop := Relation.EqvGen ScissorsStep L L'

/-- The total Dehn invariant of a collection of pieces. -/
noncomputable def totalDehn (L : List (List Face)) : DehnSpace := (L.map polyDehn).sum

lemma totalDehn_step {L L' : List (List Face)} (h : ScissorsStep L L') : totalDehn L = totalDehn L' := by
  cases h with
  | cut l m rest hb hnull =>
    simp only [totalDehn, List.map_cons, List.sum_cons, polyDehn_cut hb m hnull, add_assoc]
  | move l Q b rest => simp only [totalDehn, List.map_cons, List.sum_cons, polyDehn_move]
  | perm hp => exact (hp.map _).sum_eq

/-- **Etingof et al., Problem 1.51 (a), consequence.** Scissors-congruent collections have equal Dehn invariants. -/
@[kb "etingof2011" "Problem 1.51, p. 19"]
theorem totalDehn_eq_of_scissorsCongruent {L L' : List (List Face)} (h : ScissorsCongruent L L') :
    totalDehn L = totalDehn L' := by
  induction h with
  | rel _ _ h => exact totalDehn_step h
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

end UndergradKB.RepresentationTheory
