import Mathlib.Algebra.Module.Projective
import Mathlib.RingTheory.Artinian.Ring
import UndergradKB.Common.Attr
import UndergradKB.RepresentationTheory.AlgebrasSemisimple
import UndergradKB.RepresentationTheory.ModulesChapter7

/-! # Projective modules attached to simple modules (Etingof et al., Theorem 7.6)

Let `A` be a finite-dimensional algebra over an algebraically closed field `k` and let `V₁, …, Vₙ` be a complete list
of its simple modules up to isomorphism.  Using the density theorem (so that `A → ∏ End_k Vᵢ` is onto with the
radical as kernel), a rank one idempotent in the `i`-th factor, and lifting of idempotents modulo the nilpotent
radical (Proposition 7.3), we construct an idempotent `e` of `A` such that the left ideal `A e` is projective and
`dim Hom_A(A e, Vⱼ) = δᵢⱼ`.

Not formalized: uniqueness and indecomposability of such a projective `Pᵢ`, the decomposition
`A ≅ ⊕ (dim Vᵢ) Pᵢ`, and the classification of indecomposable finitely generated projectives.
-/

namespace UndergradKB.RepresentationTheory

open Module

section LeftIdeal

variable {A : Type*} [Ring A] {e : A}

/-- The left ideal generated by an idempotent is a projective module (a direct summand of `A`). -/
theorem projective_span_idempotent (he : IsIdempotentElem e) : Module.Projective A (Ideal.span {e}) := by
  let P : Ideal A := Ideal.span {e}
  let s : A →ₗ[A] P := (LinearMap.toSpanSingleton A A e).codRestrict P
    (fun a => by simpa using Submodule.smul_mem P a (Submodule.mem_span_singleton_self e))
  refine Module.Projective.of_split P.subtype s ?_
  refine LinearMap.ext fun p => ?_
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 p.2
  refine Subtype.ext ?_
  change p.1 • e = p.1
  rw [← ha]
  simp only [smul_eq_mul, mul_assoc, he.eq]

variable {k : Type*} [Field k] [Algebra k A] {M : Type*} [AddCommGroup M] [Module A M] [Module k M]
  [IsScalarTower k A M]

/-- `Hom_A(A e, M)` has the same dimension as `e M`, for an idempotent `e`. -/
theorem finrank_hom_span_idempotent (he : IsIdempotentElem e) :
    finrank k (Ideal.span {e} →ₗ[A] M) = finrank k (LinearMap.range (Algebra.lsmul k k M e)) := by
  let P : Ideal A := Ideal.span {e}
  have heP : e ∈ P := Submodule.mem_span_singleton_self e
  let Φ : (P →ₗ[A] M) →ₗ[k] M :=
    { toFun := fun φ => φ ⟨e, heP⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hinj : Function.Injective Φ := by
    intro φ ψ h
    refine LinearMap.ext fun p => ?_
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 p.2
    have hp : p = a • (⟨e, heP⟩ : P) := Subtype.ext ha.symm
    rw [hp, map_smul, map_smul]
    exact congrArg (a • ·) h
  have hrange : LinearMap.range Φ = LinearMap.range (Algebra.lsmul k k M e) := by
    ext m
    constructor
    · rintro ⟨φ, rfl⟩
      refine ⟨φ ⟨e, heP⟩, ?_⟩
      have h1 : e • (⟨e, heP⟩ : P) = ⟨e, heP⟩ := Subtype.ext he.eq
      have h2 : e • φ ⟨e, heP⟩ = φ ⟨e, heP⟩ := by rw [← map_smul, h1]
      exact h2
    · rintro ⟨y, rfl⟩
      let ψ : P →ₗ[A] M := (LinearMap.toSpanSingleton A M (e • y)).comp P.subtype
      refine ⟨ψ, ?_⟩
      change e • (e • y) = _
      simp [smul_smul, he.eq]
  rw [← hrange, LinearMap.finrank_range_of_inj hinj]

end LeftIdeal

section Family

universe u

variable {k : Type u} {A : Type u} [Field k] [IsAlgClosed k] [Ring A] [Algebra k A] [FiniteDimensional k A]
  {ι : Type*} [Fintype ι] [DecidableEq ι] {V : ι → Type u} [∀ i, AddCommGroup (V i)]
  [∀ i, Module A (V i)] [∀ i, Module k (V i)] [∀ i, IsScalarTower k A (V i)]
  [∀ i, IsSimpleModule A (V i)] [∀ i, FiniteDimensional k (V i)]

/-- **Etingof et al., Theorem 7.6 (existence part)**: for a finite-dimensional algebra over an algebraically
closed field with complete list `V₁, …, Vₙ` of simple modules, for each `i` there is an idempotent `e` such that
the left ideal `A e` is a projective module with `dim Hom_A(A e, Vⱼ) = δᵢⱼ`. -/
@[kb "etingof2011" "Theorem 7.6, p. 107"]
theorem exists_projective_finrank_hom_eq_ite
    (hV : ∀ i j, i ≠ j → IsEmpty (V i ≃ₗ[A] V j))
    (hcomp : ∀ (S : Type u) [AddCommGroup S] [Module A S] [IsSimpleModule A S],
      ∃ i, Nonempty (S ≃ₗ[A] V i))
    (i : ι) :
    ∃ e : A, IsIdempotentElem e ∧ Module.Projective A (Ideal.span {e}) ∧
      ∀ j, finrank k (Ideal.span {e} →ₗ[A] V j) = if j = i then 1 else 0 := by
  classical
  have : IsArtinianRing A := IsArtinianRing.of_finite k A
  let f : A →+* ∀ j, Module.End k (V j) := (actionPi k A V).toRingHom
  have hker : ∀ x ∈ RingHom.ker f, IsNilpotent x := by
    intro x hx
    have hx0 : actionPi k A V x = 0 := hx
    have hxr : x ∈ algebraRadical A := (actionPi_eq_zero_iff hcomp x).1 hx0
    obtain ⟨n, hn⟩ := isNilpotent_algebraRadical A
    refine ⟨n, ?_⟩
    have := Ideal.pow_mem_pow hxr n
    rw [hn] at this
    exact (Submodule.mem_bot A).1 this
  have : Nontrivial (V i) := IsSimpleModule.nontrivial A (V i)
  obtain ⟨v, hv⟩ := exists_ne (0 : V i)
  obtain ⟨l, hl⟩ := Module.Projective.exists_dual_eq_one k hv
  let E : Module.End k (V i) := l.smulRight v
  have hE : IsIdempotentElem E := by
    refine LinearMap.ext fun w => ?_
    simp [E, hl, Module.End.mul_eq_comp]
  let b : ∀ j, Module.End k (V j) := Pi.single i E
  have hb' : IsIdempotentElem b := by
    funext j
    by_cases h : j = i
    · subst h
      simpa [b] using hE.eq
    · simp [b, h]
  have hb : b ∈ f.range := by
    obtain ⟨a, ha⟩ := density_pi_surjective (k := k) (A := A) hV b
    exact ⟨a, ha⟩
  obtain ⟨⟨e, he, hfe⟩, _⟩ := idempotent_lift_and_conjugate f hker hb hb'
  refine ⟨e, he, projective_span_idempotent he, fun j => ?_⟩
  rw [finrank_hom_span_idempotent (k := k) he]
  have h : Algebra.lsmul k k (V j) e = b j := congr_fun hfe j
  rw [h]
  by_cases hj : j = i
  · subst hj
    have hbj : b j = E := by simp [b]
    have hrange : LinearMap.range (b j) = k ∙ v := by
      rw [hbj]
      ext m
      constructor
      · rintro ⟨w, rfl⟩
        exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self v)
      · intro hm
        obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hm
        exact ⟨c • v, by simp [E, hl]⟩
    rw [hrange, finrank_span_singleton hv]
    simp
  · have hbj : b j = 0 := by simp [b, hj]
    rw [hbj]
    simp [hj]

end Family

end UndergradKB.RepresentationTheory
