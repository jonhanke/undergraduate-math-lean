import Mathlib.Algebra.Lie.Sl2
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.LinearAlgebra.Eigenspace.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.Tactic.Module
import UndergradKB.Common.Attr

/-! # Representations of sl(2): relations, Casimir, primitive vectors (Etingof et al., Problem 1.55)

Operator-level treatment: a triple `h e f` in a `k`-algebra `A` with the defining relations of `sl₂`
(`IsSl2Rel`; unlike Mathlib's `IsSl2Triple` it does not require `h ≠ 0`, so the trivial module is
included).  A Lie module over a Lie algebra `L` with an `IsSl2Triple` gives such operators
(`isSl2Rel_toEnd`).

* `casimir`: the element `e f + f e + h²/2`; it commutes with `e`, `f`, `h` (Problem 1.55(g)).
* Primitive (highest-weight) vectors `v` of weight `n`: `h v = n v`, `e v = 0`; the weight is a
  natural number in a finite-dimensional module, the vectors `fⁱ v` (`i ≤ n`) are linearly independent
  and form a basis of the submodule they span, with the explicit matrix coefficients
  (Problem 1.55(a)-(f)).
* The Casimir acts on such a submodule by the scalar `n (n + 2) / 2` (Problem 1.55(h)).
* Classification (Theorem 1.1, Problem 1.55): an irreducible finite-dimensional representation over
  an algebraically closed field of characteristic zero is generated by a primitive vector
  (`IsSl2Rel.exists_highest_weight`); two irreducibles of the same dimension are isomorphic
  (`exists_linearEquiv_of_finrank_eq`); the standard module `k^(n+1)` with explicit matrices
  (`stdH`, `stdE`, `stdF`) satisfies the relations and is irreducible (`isSl2Rel_std`,
  `isIrreducibleRep_std`); `irreducible_classification` packages these.
* Not included: complete reducibility of arbitrary finite-dimensional modules, Clebsch-Gordan.
-/

namespace UndergradKB.RepresentationTheory.Sl2

open Module

variable (k : Type*) {A : Type*} [Field k] [Ring A] [Algebra k A]

/-- The defining relations of `sl₂` for three elements of an associative `k`-algebra. -/
structure IsSl2Rel (h e f : A) : Prop where
  ef : e * f - f * e = h
  he : h * e - e * h = (2 : k) • e
  hf : h * f - f * h = -((2 : k) • f)

/-- The Casimir element `e f + f e + h² / 2`. -/
noncomputable def casimir (h e f : A) : A := e * f + f * e + (2⁻¹ : k) • (h * h)

variable {k} {h e f : A}

namespace IsSl2Rel

lemma he' (r : IsSl2Rel k h e f) : h * e = e * h + (2 : k) • e := by
  rw [← r.he]; abel

lemma hf' (r : IsSl2Rel k h e f) : h * f = f * h - (2 : k) • f := by
  rw [sub_eq_add_neg, ← r.hf]; abel

lemma ef' (r : IsSl2Rel k h e f) : e * f = f * e + h := by
  rw [← r.ef]; abel

lemma fe' (r : IsSl2Rel k h e f) : f * e = e * f - h := by
  rw [← r.ef]; abel

/-- The Chevalley-type symmetry exchanging `e` and `f` (and negating `h`). -/
lemma symm (r : IsSl2Rel k h e f) : IsSl2Rel k (-h) f e where
  ef := by rw [← r.ef]; abel
  he := by
    have h1 : -h * f - f * (-h) = -(h * f - f * h) := by noncomm_ring
    rw [h1, r.hf, neg_neg]
  hf := by
    have h2 : -h * e - e * (-h) = -(h * e - e * h) := by noncomm_ring
    rw [h2, r.he]

lemma casimir_commute_e [CharZero k] (r : IsSl2Rel k h e f) :
    Commute (casimir k h e f) e := by
  unfold casimir
  have e1 : e * (e * f) = e * (f * e) + e * h := by rw [r.ef', mul_add]
  have e2 : f * (e * e) = e * (f * e) - e * h - (2:k) • e := by
    calc f * (e * e) = (f * e) * e := by rw [mul_assoc]
      _ = (e * f - h) * e := by rw [r.fe']
      _ = _ := by rw [sub_mul, mul_assoc, r.he']; abel
  have e3 : h * (h * e) = e * (h * h) + (4:k) • (e * h) + (4:k) • e := by
    rw [r.he', mul_add, mul_smul_comm, ← mul_assoc, r.he']
    simp only [add_mul, smul_mul_assoc, mul_assoc, smul_add, smul_smul]
    module
  unfold Commute SemiconjBy
  simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, mul_assoc]
  rw [e1, e2, e3]
  module

lemma casimir_commute_h (r : IsSl2Rel k h e f) : Commute (casimir k h e f) h := by
  unfold casimir
  have a : h * (e * f) = e * f * h := by
    calc h * (e * f) = (h * e) * f := by rw [mul_assoc]
      _ = (e * h + (2:k) • e) * f := by rw [r.he']
      _ = e * (h * f) + (2:k) • (e * f) := by rw [add_mul, smul_mul_assoc, mul_assoc]
      _ = e * (f * h - (2:k) • f) + (2:k) • (e * f) := by rw [r.hf']
      _ = e * f * h := by rw [mul_sub, mul_smul_comm, mul_assoc]; abel
  have b : h * (f * e) = f * e * h := by
    calc h * (f * e) = (h * f) * e := by rw [mul_assoc]
      _ = (f * h - (2:k) • f) * e := by rw [r.hf']
      _ = f * (h * e) - (2:k) • (f * e) := by rw [sub_mul, smul_mul_assoc, mul_assoc]
      _ = f * (e * h + (2:k) • e) - (2:k) • (f * e) := by rw [r.he']
      _ = f * e * h := by rw [mul_add, mul_smul_comm, mul_assoc]; abel
  unfold Commute SemiconjBy
  simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, mul_assoc] at a b ⊢
  rw [a, b]

lemma casimir_commute_f [CharZero k] (r : IsSl2Rel k h e f) : Commute (casimir k h e f) f := by
  have := r.symm.casimir_commute_e
  unfold casimir at this ⊢
  rwa [add_comm (f * e), mul_neg, neg_mul, neg_neg] at this

/-- Problem 1.55(g): the Casimir element `e f + f e + h² / 2` commutes with `e`, `f` and `h`, for
any triple satisfying the relations of `sl₂` in an associative algebra over a field of
characteristic zero. -/
@[kb "etingof2011" "Problem 1.55(g)-(k), p. 21"]
theorem casimir_central [CharZero k] (r : IsSl2Rel k h e f) :
    Commute (casimir k h e f) e ∧ Commute (casimir k h e f) f ∧ Commute (casimir k h e f) h :=
  ⟨r.casimir_commute_e, r.casimir_commute_f, r.casimir_commute_h⟩

end IsSl2Rel

section Rep

attribute [local instance 100] LieRing.ofAssociativeRing

variable {V : Type*} [AddCommGroup V] [Module k V] {h e f : Module.End k V}

/-- A primitive (highest-weight) vector of weight `μ`: a nonzero vector killed by `e` and an
eigenvector of `h` with eigenvalue `μ`. -/
structure IsPrimitive (h e : Module.End k V) (v : V) (μ : k) : Prop where
  ne_zero : v ≠ 0
  h_apply : h v = μ • v
  e_apply : e v = 0

/-- Irreducibility of a representation given by operators `h e f`: the space is nonzero and the
only subspaces invariant under all three operators are `0` and the whole space. -/
structure IsIrreducibleRep (h e f : Module.End k V) : Prop where
  nontrivial : Nontrivial V
  eq_bot_or_top : ∀ W : Submodule k V, (∀ x ∈ W, h x ∈ W) → (∀ x ∈ W, e x ∈ W) →
    (∀ x ∈ W, f x ∈ W) → W = ⊥ ∨ W = ⊤

namespace IsSl2Rel

lemma ef_apply (r : IsSl2Rel k h e f) (x : V) : e (f x) = f (e x) + h x := by
  simpa using congrArg (fun T => T x) r.ef'

lemma hf_apply (r : IsSl2Rel k h e f) (x : V) : h (f x) = f (h x) - (2 : k) • f x := by
  simpa using congrArg (fun T => T x) r.hf'

lemma he_apply (r : IsSl2Rel k h e f) (x : V) : h (e x) = e (h x) + (2 : k) • e x := by
  simpa using congrArg (fun T => T x) r.he'

/-- Mathlib's `IsSl2Triple` from the relations, when `h ≠ 0`. -/
lemma toTriple (r : IsSl2Rel k h e f) (hne : h ≠ 0) : IsSl2Triple h e f where
  h_ne_zero := hne
  lie_e_f := by rw [Ring.lie_def]; exact r.ef
  lie_h_e_nsmul := by rw [Ring.lie_def, r.he, two_smul, two_nsmul]
  lie_h_f_nsmul := by rw [Ring.lie_def, r.hf, two_smul, two_nsmul]

variable {v : V} {μ : k}

/-- The action of `h` on the vectors `fⁱ v` above a primitive vector (Problem 1.55(b)). -/
lemma h_pow_f (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) (i : ℕ) :
    h ((f ^ i) v) = (μ - 2 * i) • (f ^ i) v := by
  induction i with
  | zero => simpa using hv.h_apply
  | succ i ih =>
    rw [pow_succ', mul_apply_eq_comp, r.hf_apply, ih, map_smul]
    push_cast
    module

/-- The action of `e` on the vectors `fⁱ v` above a primitive vector (Problem 1.55(b)). -/
lemma e_pow_f_succ (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) (i : ℕ) :
    e ((f ^ (i + 1)) v) = (((i : k) + 1) * (μ - i)) • (f ^ i) v := by
  induction i with
  | zero => simp [r.ef_apply, hv.e_apply, hv.h_apply]
  | succ i ih =>
    have this : f ((f ^ i) v) = (f ^ (i + 1)) v := by rw [pow_succ', mul_apply_eq_comp]
    rw [pow_succ' f (i + 1), mul_apply_eq_comp, r.ef_apply, ih, map_smul, r.h_pow_f hv,
      this]
    push_cast
    module

section FD

variable [FiniteDimensional k V] [CharZero k]

omit [FiniteDimensional k V] [CharZero k] in
lemma weight_zero_of_h_eq_zero (hz : h = 0) (hv : IsPrimitive h e v μ) : μ = 0 := by
  have : μ • v = 0 := by rw [← hv.h_apply, hz]; rfl
  exact (smul_eq_zero.mp this).resolve_right hv.ne_zero

omit [FiniteDimensional k V] in
lemma e_f_eq_zero_of_h_eq_zero (r : IsSl2Rel k h e f) (hz : h = 0) : e = 0 ∧ f = 0 := by
  have h1 : (2 : k) • e = 0 := by rw [← r.he, hz]; simp
  have h2 : (2 : k) • f = 0 := by
    have := r.hf
    rw [hz] at this
    simpa using this.symm
  exact ⟨(smul_eq_zero.mp h1).resolve_left two_ne_zero, (smul_eq_zero.mp h2).resolve_left two_ne_zero⟩

/-- Problem 1.55(a): the weight of a primitive vector in a finite-dimensional module is a natural
number (Mathlib's `IsSl2Triple.HasPrimitiveVectorWith.exists_nat`, extended to the case `h = 0`). -/
lemma exists_nat_weight (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) :
    ∃ n : ℕ, μ = n := by
  by_cases hz : h = 0
  · exact ⟨0, by simpa using weight_zero_of_h_eq_zero hz hv⟩
  · have t := r.toTriple hz
    have P : t.HasPrimitiveVectorWith v μ :=
      ⟨hv.ne_zero, by simpa using hv.h_apply, by simpa using hv.e_apply⟩
    exact P.exists_nat

omit [FiniteDimensional k V] in
lemma f_pow_ne_zero (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) {n : ℕ} (hn : μ = n)
    {i : ℕ} (hi : i ≤ n) : (f ^ i) v ≠ 0 := by
  by_cases hz : h = 0
  · have h0 : μ = 0 := weight_zero_of_h_eq_zero hz hv
    have : n = 0 := by
      rw [h0] at hn
      exact_mod_cast hn.symm
    have : i = 0 := by omega
    simpa [this] using hv.ne_zero
  · have t := r.toTriple hz
    have P : t.HasPrimitiveVectorWith v μ :=
      ⟨hv.ne_zero, by simpa using hv.h_apply, by simpa using hv.e_apply⟩
    exact P.pow_toEnd_f_ne_zero_of_eq_nat hn hi

lemma f_pow_succ_eq_zero (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) {n : ℕ} (hn : μ = n) :
    (f ^ (n + 1)) v = 0 := by
  by_cases hz : h = 0
  · have h0 : μ = 0 := weight_zero_of_h_eq_zero hz hv
    have : n = 0 := by
      rw [h0] at hn
      exact_mod_cast hn.symm
    simp [this, (e_f_eq_zero_of_h_eq_zero r hz).2]
  · have t := r.toTriple hz
    have P : t.HasPrimitiveVectorWith v μ :=
      ⟨hv.ne_zero, by simpa using hv.h_apply, by simpa using hv.e_apply⟩
    exact P.pow_toEnd_f_eq_zero_of_eq_nat hn

lemma f_pow_eq_zero_of_lt (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) {n : ℕ} (hn : μ = n)
    {i : ℕ} (hi : n < i) : (f ^ i) v = 0 := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le (Nat.succ_le_of_lt hi)
  rw [add_comm, pow_add, mul_apply_eq_comp, r.f_pow_succ_eq_zero hv hn, map_zero]

omit [FiniteDimensional k V] in
/-- Problem 1.55(c): the vectors `fⁱ v`, `0 ≤ i ≤ n`, above a primitive vector of weight `n` are
linearly independent (they are `h`-eigenvectors with distinct eigenvalues `n - 2 i`). -/
lemma linearIndependent_f_pow (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) {n : ℕ}
    (hn : μ = n) : LinearIndependent k (fun i : Fin (n + 1) => (f ^ (i : ℕ)) v) := by
  refine Module.End.eigenvectors_linearIndependent' h (fun i : Fin (n + 1) => μ - 2 * (i : ℕ))
    ?_ _ fun i => ⟨Module.End.mem_eigenspace_iff.mpr (r.h_pow_f hv i),
      r.f_pow_ne_zero hv hn (Nat.lt_succ_iff.mp i.2)⟩
  intro i j hij
  have : ((i : ℕ) : k) = ((j : ℕ) : k) := by
    have := congrArg (fun x => (μ - x) / 2) hij
    simp only [sub_sub_cancel] at this
    linear_combination (-1 : k) * hij / 2
  exact Fin.ext (by exact_mod_cast this)

/-- Problem 1.55(b)-(c), explicit matrices: above a primitive vector `v` of weight `n`, with
`bᵢ = fⁱ v`, one has `h bᵢ = (n - 2 i) bᵢ`, `f bᵢ = bᵢ₊₁`, `f bₙ = 0`, `e b₀ = 0` and
`e bᵢ₊₁ = (i + 1) (n - i) bᵢ`. -/
@[kb "etingof2011" "Problem 1.55(a)-(f), p. 20"]
theorem matrix_coefficients (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) {n : ℕ}
    (hn : μ = n) :
    (∀ i : ℕ, h ((f ^ i) v) = ((n : k) - 2 * i) • (f ^ i) v) ∧
      (∀ i : ℕ, f ((f ^ i) v) = (f ^ (i + 1)) v) ∧ (f ^ (n + 1)) v = 0 ∧ e v = 0 ∧
      (∀ i : ℕ, e ((f ^ (i + 1)) v) = (((i : k) + 1) * ((n : k) - i)) • (f ^ i) v) := by
  subst hn
  exact ⟨r.h_pow_f hv, fun i => by rw [pow_succ', mul_apply_eq_comp], r.f_pow_succ_eq_zero hv rfl,
    hv.e_apply, r.e_pow_f_succ hv⟩

/-- A primitive vector exists in every nonzero finite-dimensional module over an algebraically
closed field of characteristic zero (Problem 1.55(a), Mathlib's `exists_hasPrimitiveVectorWith`). -/
lemma exists_primitive [IsAlgClosed k] [Nontrivial V] (r : IsSl2Rel k h e f) :
    ∃ (v : V) (μ : k), IsPrimitive h e v μ := by
  by_cases hz : h = 0
  · obtain ⟨v, hv⟩ := exists_ne (0 : V)
    exact ⟨v, 0, hv, by simp [hz], by simp [(e_f_eq_zero_of_h_eq_zero r hz).1]⟩
  · obtain ⟨μ, v, -, P⟩ := (r.toTriple hz).exists_hasPrimitiveVectorWith (R := k) (M := V)
    exact ⟨v, μ, P.ne_zero, by simpa using P.lie_h, by simpa using P.lie_e⟩

omit [FiniteDimensional k V] [CharZero k] in
/-- A nonzero irreducible representation is generated by `fⁱ v` for any primitive vector `v`. -/
lemma span_f_pow_eq_top (r : IsSl2Rel k h e f) (hirr : IsIrreducibleRep h e f)
    (hv : IsPrimitive h e v μ) :
    Submodule.span k (Set.range fun i : ℕ => (f ^ i) v) = ⊤ := by
  set W := Submodule.span k (Set.range fun i : ℕ => (f ^ i) v) with hW
  have key : ∀ T : Module.End k V, (∀ i : ℕ, T ((f ^ i) v) ∈ W) → ∀ x ∈ W, T x ∈ W := by
    intro T hT x hx
    have : W ≤ W.comap T := Submodule.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hT i)
    exact this hx
  have hmem : ∀ i : ℕ, (f ^ i) v ∈ W := fun i => Submodule.subset_span ⟨i, rfl⟩
  have hf : ∀ i : ℕ, f ((f ^ i) v) = (f ^ (i + 1)) v := fun i => by
    rw [pow_succ', mul_apply_eq_comp]
  have := hirr.eq_bot_or_top W
    (key h fun i => by rw [r.h_pow_f hv]; exact W.smul_mem _ (hmem i))
    (key e fun i => by
      cases i with
      | zero => simp [hv.e_apply]
      | succ j => rw [r.e_pow_f_succ hv]; exact W.smul_mem _ (hmem j))
    (key f fun i => by rw [hf]; exact hmem _)
  refine this.resolve_left fun h0 => hv.ne_zero ?_
  have hv0 : v ∈ W := by simpa using hmem 0
  rw [h0] at hv0
  simpa using hv0

/-- A basis `fⁱ v`, `0 ≤ i ≤ n`, of a module generated by a primitive vector `v` of weight `n`
(Problem 1.55(c)). -/
noncomputable def primBasis (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) {n : ℕ} (hn : μ = n)
    (hspan : Submodule.span k (Set.range fun i : ℕ => (f ^ i) v) = ⊤) :
    Basis (Fin (n + 1)) k V :=
  Basis.mk (r.linearIndependent_f_pow hv hn) (by
    rw [← hspan]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    by_cases hi : i ≤ n
    · exact Submodule.subset_span ⟨⟨i, by omega⟩, rfl⟩
    · change (f ^ i) v ∈ Submodule.span k (Set.range fun j : Fin (n + 1) => (f ^ (j : ℕ)) v)
      rw [r.f_pow_eq_zero_of_lt hv hn (by omega)]
      exact zero_mem _)

lemma primBasis_apply (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) {n : ℕ} (hn : μ = n)
    (hspan : Submodule.span k (Set.range fun i : ℕ => (f ^ i) v) = ⊤) (i : Fin (n + 1)) :
    r.primBasis hv hn hspan i = (f ^ (i : ℕ)) v := by
  simp [primBasis]

/-- Problem 1.55(c): the module generated by a primitive vector of weight `n` has dimension
`n + 1`. -/
lemma finrank_eq_of_cyclic (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) {n : ℕ} (hn : μ = n)
    (hspan : Submodule.span k (Set.range fun i : ℕ => (f ^ i) v) = ⊤) :
    Module.finrank k V = n + 1 := by
  rw [Module.finrank_eq_card_basis (r.primBasis hv hn hspan)]
  simp

omit [FiniteDimensional k V] in
/-- The Casimir element acts on a primitive vector of weight `μ` by `μ (μ + 2) / 2`. -/
lemma casimir_apply_primitive (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) :
    casimir k h e f v = (μ * (μ + 2) / 2) • v := by
  unfold casimir
  simp only [LinearMap.add_apply, LinearMap.smul_apply, mul_apply_eq_comp]
  rw [r.ef_apply, hv.e_apply, map_zero, hv.h_apply, map_smul, hv.h_apply]
  module

omit [FiniteDimensional k V] in
lemma casimir_apply_f_pow (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ) (i : ℕ) :
    casimir k h e f ((f ^ i) v) = (μ * (μ + 2) / 2) • (f ^ i) v := by
  have hc : Commute (casimir k h e f) (f ^ i) := r.casimir_commute_f.pow_right i
  have := congrArg (fun T => T v) hc.eq
  simp only [mul_apply_eq_comp] at this
  rw [this, r.casimir_apply_primitive hv, map_smul]

omit [FiniteDimensional k V] in
/-- Problem 1.55(h): on a module generated by a primitive vector of weight `μ`, the Casimir element
is the scalar `μ (μ + 2) / 2`. -/
@[kb "etingof2011" "Problem 1.55(g)-(k), p. 21"]
theorem casimir_eq_smul_one (r : IsSl2Rel k h e f) (hv : IsPrimitive h e v μ)
    (hspan : Submodule.span k (Set.range fun i : ℕ => (f ^ i) v) = ⊤) :
    casimir k h e f = (μ * (μ + 2) / 2) • (1 : Module.End k V) :=
  LinearMap.ext_on hspan (by
    rintro _ ⟨i, rfl⟩
    simpa using r.casimir_apply_f_pow hv i)

/-- Problems 1.55(a)-(f), existence part: a nonzero irreducible finite-dimensional module over an
algebraically closed field of characteristic zero is generated by a primitive vector `v` of natural
weight `n`, has dimension `n + 1`, basis `fⁱ v`, and the Casimir acts by `n (n + 2) / 2`. -/
@[kb "etingof2011" "Problem 1.55(a)-(f), p. 20"]
theorem exists_highest_weight [IsAlgClosed k] (r : IsSl2Rel k h e f)
    (hirr : IsIrreducibleRep h e f) :
    ∃ (v : V) (n : ℕ), IsPrimitive h e v (n : k) ∧
      Submodule.span k (Set.range fun i : ℕ => (f ^ i) v) = ⊤ ∧ Module.finrank k V = n + 1 ∧
      casimir k h e f = ((n : k) * (n + 2) / 2) • (1 : Module.End k V) := by
  have := hirr.nontrivial
  obtain ⟨v, μ, hv⟩ := r.exists_primitive
  obtain ⟨n, rfl⟩ := r.exists_nat_weight hv
  have hspan := r.span_f_pow_eq_top hirr hv
  exact ⟨v, n, hv, hspan, r.finrank_eq_of_cyclic hv rfl hspan, r.casimir_eq_smul_one hv hspan⟩

end FD

end IsSl2Rel

/-- A Lie module over a Lie algebra `L` with an `sl₂`-triple `h, e, f` gives operators on the module
satisfying the relations of `sl₂`. -/
theorem isSl2Rel_toEnd {L M : Type*} [LieRing L] [LieAlgebra k L] [AddCommGroup M] [Module k M]
    [LieRingModule L M] [LieModule k L M] {h e f : L} (t : IsSl2Triple h e f) :
    IsSl2Rel k (LieModule.toEnd k L M h) (LieModule.toEnd k L M e) (LieModule.toEnd k L M f) where
  ef := by
    have := (LieModule.toEnd k L M).map_lie e f
    rw [t.lie_e_f, Ring.lie_def] at this
    exact this.symm
  he := by
    have := (LieModule.toEnd k L M).map_lie h e
    rw [t.lie_h_e_nsmul, map_nsmul, Ring.lie_def, two_nsmul] at this
    rw [← this, two_smul]
  hf := by
    have := (LieModule.toEnd k L M).map_lie h f
    rw [t.lie_h_f_nsmul, map_neg, map_nsmul, Ring.lie_def, two_nsmul] at this
    rw [← this, two_smul]

end Rep

section Uniqueness

variable {V W : Type*} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
  {h e f : Module.End k V} {h' e' f' : Module.End k W}
  [FiniteDimensional k V] [FiniteDimensional k W] [CharZero k] [IsAlgClosed k]

/-- Problem 1.55(e)-(f), uniqueness: two irreducible finite-dimensional representations of the
relations of `sl₂` over an algebraically closed field of characteristic zero, of the same dimension,
are isomorphic by a linear equivalence intertwining `h`, `e` and `f`. -/
@[kb "etingof2011" "Problem 1.55(a)-(f), p. 20"]
theorem exists_linearEquiv_of_finrank_eq (r : IsSl2Rel k h e f) (hirr : IsIrreducibleRep h e f)
    (r' : IsSl2Rel k h' e' f') (hirr' : IsIrreducibleRep h' e' f')
    (hdim : Module.finrank k V = Module.finrank k W) :
    ∃ φ : V ≃ₗ[k] W, (∀ x, φ (h x) = h' (φ x)) ∧ (∀ x, φ (e x) = e' (φ x)) ∧
      ∀ x, φ (f x) = f' (φ x) := by
  obtain ⟨v, n, hv, hs, hd, -⟩ := r.exists_highest_weight hirr
  obtain ⟨v', n', hv', hs', hd', -⟩ := r'.exists_highest_weight hirr'
  have hnn : n = n' := by omega
  subst hnn
  obtain ⟨b, hb⟩ : ∃ b : Basis (Fin (n + 1)) k V, ∀ i, b i = (f ^ (i : ℕ)) v :=
    ⟨r.primBasis hv rfl hs, r.primBasis_apply hv rfl hs⟩
  obtain ⟨b', hb'⟩ : ∃ b : Basis (Fin (n + 1)) k W, ∀ i, b i = (f' ^ (i : ℕ)) v' :=
    ⟨r'.primBasis hv' rfl hs', r'.primBasis_apply hv' rfl hs'⟩
  have hφ : ∀ i : ℕ, (b.equiv b' (Equiv.refl _)) ((f ^ i) v) = (f' ^ i) v' := by
    intro i
    by_cases hi : i ≤ n
    · have := b.equiv_apply (⟨i, by omega⟩ : Fin (n + 1)) b' (Equiv.refl _)
      simpa [hb, hb'] using this
    · rw [r.f_pow_eq_zero_of_lt hv rfl (by omega), r'.f_pow_eq_zero_of_lt hv' rfl (by omega),
        map_zero]
  have hf : ∀ i : ℕ, ∀ {U : Type _} [AddCommGroup U] [Module k U] (g : Module.End k U) (u : U),
      g ((g ^ i) u) = (g ^ (i + 1)) u := fun i U _ _ g u => by
    rw [pow_succ', mul_apply_eq_comp]
  set φ := b.equiv b' (Equiv.refl _) with hφdef
  refine ⟨φ, ?_, ?_, ?_⟩
  · have : φ.toLinearMap ∘ₗ h = h' ∘ₗ φ.toLinearMap := b.ext fun i => by
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, hb]
      rw [r.h_pow_f hv, map_smul, hφ, r'.h_pow_f hv']
    exact fun x => LinearMap.congr_fun this x
  · have : φ.toLinearMap ∘ₗ e = e' ∘ₗ φ.toLinearMap := b.ext fun i => by
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, hb]
      rcases i with ⟨_ | j, hj⟩
      · have h0 : φ v = v' := by simpa using hφ 0
        simp [hv.e_apply, h0, hv'.e_apply]
      · simp only
        rw [r.e_pow_f_succ hv, map_smul, hφ, hφ, r'.e_pow_f_succ hv']
    exact fun x => LinearMap.congr_fun this x
  · have : φ.toLinearMap ∘ₗ f = f' ∘ₗ φ.toLinearMap := b.ext fun i => by
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, hb]
      rw [hf (i : ℕ) f v, hφ, hφ, pow_succ', mul_apply_eq_comp]
    exact fun x => LinearMap.congr_fun this x

end Uniqueness

section Standard

variable (n : ℕ)

/-- The `i`-th coordinate of a vector of `Fin (n + 1) → k`, extended by zero to all `i : ℕ`. -/
def co (w : Fin (n + 1) → k) (i : ℕ) : k := if hi : i < n + 1 then w ⟨i, hi⟩ else 0

variable (k) in
/-- The extended coordinate as a linear functional. -/
def coL (i : ℕ) : (Fin (n + 1) → k) →ₗ[k] k where
  toFun w := co n w i
  map_add' x y := by unfold co; split_ifs <;> simp
  map_smul' c x := by unfold co; split_ifs <;> simp

variable (k)

/-- The operator `h` on the standard module `k^(n+1)`: diagonal with entries `n - 2 j`. -/
noncomputable def stdH : Module.End k (Fin (n + 1) → k) :=
  LinearMap.pi fun j : Fin (n + 1) => ((n : k) - 2 * (j : ℕ)) • coL k n (j : ℕ)

/-- The operator `e` on the standard module: `e b_j = j (n + 1 - j) b_{j-1}`. -/
noncomputable def stdE : Module.End k (Fin (n + 1) → k) :=
  LinearMap.pi fun j : Fin (n + 1) =>
    ((((j : ℕ) : k) + 1) * ((n : k) - (j : ℕ))) • coL k n ((j : ℕ) + 1)

/-- The operator `f` on the standard module: `f b_j = b_{j+1}` (and `f b_n = 0`). -/
noncomputable def stdF : Module.End k (Fin (n + 1) → k) :=
  LinearMap.pi fun j : Fin (n + 1) => if (j : ℕ) = 0 then 0 else coL k n ((j : ℕ) - 1)

variable {k n}

lemma co_fin (w : Fin (n + 1) → k) (j : Fin (n + 1)) : co n w j = w j := by
  simp only [co, j.2, ↓reduceDIte]

lemma co_of_ge (w : Fin (n + 1) → k) {i : ℕ} (hi : n + 1 ≤ i) : co n w i = 0 := by
  simp [co, not_lt.mpr hi]

lemma stdH_apply (w : Fin (n + 1) → k) (j : Fin (n + 1)) :
    stdH k n w j = ((n : k) - 2 * (j : ℕ)) * w j := by
  simp [stdH, coL, co_fin]

lemma stdE_apply (w : Fin (n + 1) → k) (j : Fin (n + 1)) :
    stdE k n w j = ((((j : ℕ) : k) + 1) * ((n : k) - (j : ℕ))) * co n w ((j : ℕ) + 1) := by
  simp [stdE, coL]

lemma stdF_apply (w : Fin (n + 1) → k) (j : Fin (n + 1)) :
    stdF k n w j = if (j : ℕ) = 0 then 0 else co n w ((j : ℕ) - 1) := by
  by_cases hj : (j : ℕ) = 0
  · simp only [stdF, LinearMap.pi_apply, hj, ↓reduceIte, LinearMap.zero_apply]
  · simp only [stdF, LinearMap.pi_apply, hj, ↓reduceIte]
    rfl

lemma co_stdH (w : Fin (n + 1) → k) (i : ℕ) :
    co n (stdH k n w) i = ((n : k) - 2 * i) * co n w i := by
  by_cases hi : i < n + 1
  · have := stdH_apply w ⟨i, hi⟩
    simpa [co, hi] using this
  · simp [co, hi]

lemma co_stdE (w : Fin (n + 1) → k) (i : ℕ) :
    co n (stdE k n w) i = (((i : k) + 1) * ((n : k) - i)) * co n w (i + 1) := by
  by_cases hi : i < n + 1
  · have := stdE_apply w ⟨i, hi⟩
    simpa [co, hi] using this
  · rw [co_of_ge w (by omega)]
    simp [co, hi]

lemma co_stdF (w : Fin (n + 1) → k) (i : ℕ) :
    co n (stdF k n w) i = if i = 0 ∨ n + 1 ≤ i then 0 else co n w (i - 1) := by
  by_cases hi : i < n + 1
  · rw [co]
    simp only [hi, ↓reduceDIte]
    rw [stdF_apply]
    by_cases h0 : i = 0
    · simp [h0]
    · have h1 : ¬(i = 0 ∨ n + 1 ≤ i) := by omega
      rw [if_neg h0, if_neg h1]
  · simp [co, hi, not_lt.mp hi]

variable (k n) in
/-- The standard operators satisfy the relations of `sl₂`. -/
theorem isSl2Rel_std : IsSl2Rel k (stdH k n) (stdE k n) (stdF k n) where
  ef := by
    refine LinearMap.ext fun w => funext fun ⟨j, hj⟩ => ?_
    have hco : co n w j = w ⟨j, hj⟩ := co_fin w ⟨j, hj⟩
    simp only [LinearMap.sub_apply, mul_apply_eq_comp, Pi.sub_apply, stdE_apply, stdF_apply,
      stdH_apply, co_stdF, co_stdE]
    rcases j with _ | j
    · by_cases hn : n = 0
      · subst hn; simp
      · simp [hn, hco]
    · by_cases hjn : j + 1 < n
      · have : ¬(j + 1 + 1 = 0 ∨ n + 1 ≤ j + 1 + 1) := by omega
        simp only [this, ↓reduceIte]
        simp only [Nat.add_sub_cancel, Nat.succ_ne_zero, ↓reduceIte, hco]
        push_cast
        ring
      · have hn : n = j + 1 := by omega
        subst hn
        rw [if_pos (Or.inr le_rfl)]
        simp only [Nat.add_sub_cancel, Nat.succ_ne_zero, ↓reduceIte, hco]
        push_cast
        ring
  he := by
    refine LinearMap.ext fun w => funext fun ⟨j, hj⟩ => ?_
    simp only [LinearMap.sub_apply, mul_apply_eq_comp, Pi.sub_apply, LinearMap.smul_apply,
      Pi.smul_apply, stdE_apply, stdH_apply, co_stdH, smul_eq_mul]
    push_cast
    ring
  hf := by
    refine LinearMap.ext fun w => funext fun ⟨j, hj⟩ => ?_
    simp only [LinearMap.sub_apply, mul_apply_eq_comp, Pi.sub_apply, LinearMap.neg_apply,
      LinearMap.smul_apply, Pi.neg_apply, Pi.smul_apply, stdF_apply, stdH_apply, co_stdH,
      smul_eq_mul]
    rcases j with _ | j
    · simp
    · simp only [Nat.add_sub_cancel, Nat.succ_ne_zero, ↓reduceIte]
      push_cast
      ring

variable (k n) in
/-- The standard basis vector `b_i` of `k^(n+1)`, indexed by a natural number (zero if `i > n`). -/
def bv (i : ℕ) : Fin (n + 1) → k := fun j => if (j : ℕ) = i then 1 else 0

lemma co_bv (i m : ℕ) : co n (bv k n i) m = if m = i ∧ m < n + 1 then 1 else 0 := by
  by_cases hm : m < n + 1
  · simp [co, hm, bv]
  · simp [co, hm]

lemma stdF_bv (i : ℕ) : stdF k n (bv k n i) = bv k n (i + 1) := by
  funext ⟨j, hj⟩
  rw [stdF_apply]
  by_cases h0 : j = 0
  · simp [h0, bv]
  · have : j - 1 < n + 1 := by omega
    simp only [co_bv, bv]
    have e1 : (j - 1 = i ∧ j - 1 < n + 1) ↔ j = i + 1 := by omega
    simp only [h0, ↓reduceIte, e1]

lemma stdE_bv {i : ℕ} (hi : i < n) :
    stdE k n (bv k n (i + 1)) = (((i : k) + 1) * ((n : k) - i)) • bv k n i := by
  funext ⟨j, hj⟩
  rw [stdE_apply, co_bv]
  simp only [bv, Pi.smul_apply, smul_eq_mul]
  by_cases hji : j = i
  · subst hji
    have : j + 1 = j + 1 ∧ j + 1 < n + 1 := ⟨rfl, by omega⟩
    simp [this]
  · have : ¬(j + 1 = i + 1 ∧ j + 1 < n + 1) := by omega
    simp [hji]

/-- Every `h`-eigenvector of the standard module is a multiple of a basis vector. -/
lemma eq_smul_bv_of_eigen [CharZero k] {y : Fin (n + 1) → k} {c : k} (hy : y ≠ 0)
    (hc : stdH k n y = c • y) : ∃ (j : ℕ) (a : k), j < n + 1 ∧ a ≠ 0 ∧ y = a • bv k n j := by
  obtain ⟨j0, hj0⟩ := Function.ne_iff.mp hy
  have key : ∀ j : Fin (n + 1), ((n : k) - 2 * (j : ℕ)) * y j = c * y j := fun j => by
    have := congrFun hc j
    rwa [stdH_apply, Pi.smul_apply, smul_eq_mul] at this
  have hc0 : c = (n : k) - 2 * (j0 : ℕ) := by
    have := key j0
    exact (mul_right_cancel₀ hj0 this).symm
  refine ⟨j0, y j0, j0.2, hj0, funext fun j => ?_⟩
  simp only [bv, Pi.smul_apply, smul_eq_mul]
  by_cases hj : (j : ℕ) = j0
  · rw [if_pos hj, mul_one, Fin.ext hj]
  · rw [if_neg hj, mul_zero]
    by_contra hyj
    have := key j
    rw [hc0] at this
    have h2 := mul_right_cancel₀ hyj this
    have : ((j : ℕ) : k) = ((j0 : ℕ) : k) := by linear_combination (-1 / 2 : k) * h2
    exact hj (by exact_mod_cast this)

/-- Problem 1.55, existence part: the standard module `k^(n+1)` is irreducible over an
algebraically closed field of characteristic zero. -/
@[kb "etingof2011" "Problem 1.55(a)-(f), p. 20"]
theorem isIrreducibleRep_std [IsAlgClosed k] [CharZero k] :
    IsIrreducibleRep (stdH k n) (stdE k n) (stdF k n) where
  nontrivial := inferInstance
  eq_bot_or_top W hH hE hF := by
    by_cases hW : W = ⊥
    · exact Or.inl hW
    right
    obtain ⟨w, hwW, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hW
    have : Nontrivial W := ⟨⟨⟨w, hwW⟩, 0, fun h => hw0 (congrArg Subtype.val h)⟩⟩
    obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue ((stdH k n).restrict hH)
    obtain ⟨x, hx⟩ := hc.exists_hasEigenvector
    have hxe := congrArg Subtype.val (Module.End.mem_eigenspace_iff.mp hx.1)
    simp only [LinearMap.coe_restrict_apply, SetLike.val_smul] at hxe
    have hx0 : (x : Fin (n + 1) → k) ≠ 0 := fun h => hx.2 (Subtype.ext h)
    obtain ⟨j0, a, hj0n, ha, hya⟩ := eq_smul_bv_of_eigen hx0 hxe
    have hbj0 : bv k n j0 ∈ W := by
      have : a⁻¹ • (x : Fin (n + 1) → k) ∈ W := W.smul_mem _ x.2
      rwa [hya, smul_smul, inv_mul_cancel₀ ha, one_smul] at this
    have hdown : ∀ i : ℕ, i ≤ n → bv k n i ∈ W → bv k n 0 ∈ W := by
      intro i
      induction i with
      | zero => intro _ h; exact h
      | succ i ih =>
        intro hi hmem
        refine ih (by omega) ?_
        have h1 := hE _ hmem
        rw [stdE_bv (by omega)] at h1
        have hne : (((i : k) + 1) * ((n : k) - i)) ≠ 0 := by
          have : ((n : k) - i) = ((n - i : ℕ) : k) := by
            rw [Nat.cast_sub (by omega)]
          rw [this]
          exact mul_ne_zero (by exact_mod_cast Nat.succ_ne_zero i)
            (by exact_mod_cast (by omega : n - i ≠ 0))
        have := W.smul_mem (((i : k) + 1) * ((n : k) - i))⁻¹ h1
        rwa [smul_smul, inv_mul_cancel₀ hne, one_smul] at this
    have hup : ∀ i : ℕ, i ≤ n → bv k n i ∈ W := by
      intro i
      induction i with
      | zero => intro _; exact hdown j0 (by omega) hbj0
      | succ i ih =>
        intro hi
        have := hF _ (ih (by omega))
        rwa [stdF_bv] at this
    refine (Submodule.eq_top_iff'.mpr fun y => ?_)
    have hy : y = ∑ j : Fin (n + 1), y j • bv k n (j : ℕ) := by
      funext m
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, bv]
      rw [Finset.sum_eq_single m]
      · simp
      · intro b _ hb
        have : ¬((m : ℕ) = (b : ℕ)) := fun h => hb (Fin.ext h.symm)
        simp [this]
      · simp
    rw [hy]
    exact Submodule.sum_mem _ fun j _ => W.smul_mem _ (hup j (by omega))

end Standard

universe u

/-- Theorem 1.1 (existence and uniqueness of the irreducibles of each dimension), operator form:
over an algebraically closed field of characteristic zero, for each `n` the standard module
`k^(n+1)` with the explicit operators `stdH`, `stdE`, `stdF` is an irreducible representation of the
relations of `sl₂` of dimension `n + 1`, and every irreducible finite-dimensional representation of
dimension `n + 1` is isomorphic to it.  (Together with `IsSl2Rel.exists_highest_weight`, every
irreducible has such a dimension.)  The complete reducibility part of the theorem is not included. -/
@[kb "etingof2011" "Theorem 1.1, p. 5"]
theorem irreducible_classification [IsAlgClosed k] [CharZero k] (n : ℕ) :
    IsIrreducibleRep (stdH k n) (stdE k n) (stdF k n) ∧
      Module.finrank k (Fin (n + 1) → k) = n + 1 ∧
      ∀ {V : Type u} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
        (h e f : Module.End k V), IsSl2Rel k h e f → IsIrreducibleRep h e f →
        Module.finrank k V = n + 1 →
        ∃ φ : (Fin (n + 1) → k) ≃ₗ[k] V, (∀ x, φ (stdH k n x) = h (φ x)) ∧
          (∀ x, φ (stdE k n x) = e (φ x)) ∧ ∀ x, φ (stdF k n x) = f (φ x) := by
  refine ⟨isIrreducibleRep_std, by simp, ?_⟩
  intro V _ _ _ h e f r hirr hdim
  exact exists_linearEquiv_of_finrank_eq (isSl2Rel_std k n) isIrreducibleRep_std r hirr
    (by simpa using hdim.symm)
end UndergradKB.RepresentationTheory.Sl2
