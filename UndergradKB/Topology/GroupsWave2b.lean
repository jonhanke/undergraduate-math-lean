import UndergradKB.Common.Attr

/-!
# Wave 2: discrete subgroups of `ℝⁿ` (Morris, Appendix 5, Proposition A5.5.8 and Corollary A5.5.9)

The parallelotope argument showing that a discrete subgroup `G` of rank `p`, with `a₁, …, a_p ∈ G` a basis
of its real span, is generated by the finitely many points of `G` in the parallelotope spanned by the
`aᵢ` and lies in their rational span; and the criterion for when `gp {a₁, …, a_p, b}` is discrete.
-/

open Set Finset Module
open scoped BigOperators

namespace UndergradKB.Topology

section Parallelotope

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Bridging definition for the closed parallelotope of Morris, Proposition A5.5.8 (TP-544): the set
`{∑ rᵢ aᵢ : -1 ≤ rᵢ ≤ 1}` with centre `0` and basis vectors `a₁, …, a_p`. -/
def parallelotope {p : ℕ} (a : Fin p → E) : Set E :=
  {x | ∃ r : Fin p → ℝ, (∀ i, -1 ≤ r i ∧ r i ≤ 1) ∧ ∑ i, r i • a i = x}

theorem isCompact_parallelotope {p : ℕ} (a : Fin p → E) : IsCompact (parallelotope a) := by
  have h : parallelotope a =
      (fun r : Fin p → ℝ => ∑ i, r i • a i) '' Set.pi univ (fun _ => Icc (-1 : ℝ) 1) := by
    ext x
    simp [parallelotope, Pi.le_def, forall_and]
  rw [h]
  refine (isCompact_univ_pi fun _ => isCompact_Icc).image ?_
  fun_prop

theorem mem_parallelotope_self {p : ℕ} (a : Fin p → E) (i : Fin p) : a i ∈ parallelotope a := by
  refine ⟨Pi.single i 1, fun j => ?_, ?_⟩
  · by_cases h : j = i
    · subst h; simp
    · simp [h]
  · simp [Pi.single_apply]

/-- Part of Morris, Proposition A5.5.8 (TP-544): a discrete subgroup meets the parallelotope in a
finite set. -/
theorem discrete_subgroup_inter_parallelotope_finite (G : AddSubgroup E) [DiscreteTopology G]
    {p : ℕ} (a : Fin p → E) : ((G : Set E) ∩ parallelotope a).Finite := by
  have hcl : IsClosed (G : Set E) := AddSubgroup.isClosed_of_discreteTopology
  have hc : IsCompact ((G : Set E) ∩ parallelotope a) :=
    (isCompact_parallelotope a).inter_left hcl
  have hd : DiscreteTopology ((G : Set E) ∩ parallelotope a : Set E) :=
    DiscreteTopology.of_subset (s := (G : Set E)) inferInstance inter_subset_left
  exact hc.finite (isDiscrete_iff_discreteTopology.2 hd)

/-- Morris, Topology Without Tears, Proposition A5.5.8 (TP-544). Let `G` be a discrete subgroup of a real
normed space (e.g. `ℝⁿ`) and `a₁, …, a_p ∈ G` a basis of its real span. Then `G ∩ P` is finite for the
parallelotope `P` spanned by the `aᵢ`, the group generated by `G ∩ P` is `G`, and every point of `G` is a
rational combination of the `aᵢ`. -/
@[kb "morris2024" "Proposition A5.5.8, p. 541"]
theorem discrete_subgroup_parallelotope (G : AddSubgroup E) [DiscreteTopology G] {p : ℕ}
    (a : Fin p → E) (hli : LinearIndependent ℝ a) (haG : ∀ i, a i ∈ G)
    (hspan : Submodule.span ℝ (G : Set E) = Submodule.span ℝ (Set.range a)) :
    ((G : Set E) ∩ parallelotope a).Finite ∧
      AddSubgroup.closure ((G : Set E) ∩ parallelotope a) = G ∧
      ∀ x ∈ G, ∃ q : Fin p → ℚ, x = ∑ i, (q i : ℝ) • a i := by
  have hfin := discrete_subgroup_inter_parallelotope_finite G a
  -- coordinates of an element of `G`
  have hcoord : ∀ x ∈ G, ∃ t : Fin p → ℝ, ∑ i, t i • a i = x := by
    intro x hx
    have : x ∈ Submodule.span ℝ (Set.range a) := hspan ▸ Submodule.subset_span hx
    exact (Submodule.mem_span_range_iff_exists_fun ℝ).1 this
  -- the reduced points lie in `G ∩ P`
  have hz : ∀ (t : Fin p → ℝ), ∑ i, t i • a i ∈ G → ∀ m : ℕ,
      ∑ i, Int.fract ((m : ℝ) * t i) • a i ∈ (G : Set E) ∩ parallelotope a := by
    intro t ht m
    refine ⟨?_, ⟨fun i => Int.fract ((m : ℝ) * t i), fun i => ⟨?_, ?_⟩, rfl⟩⟩
    · have e : ∑ i, Int.fract ((m : ℝ) * t i) • a i =
          m • (∑ i, t i • a i) - ∑ i, ⌊(m : ℝ) * t i⌋ • a i := by
        rw [Finset.smul_sum, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Int.fract, sub_smul, mul_smul, Nat.cast_smul_eq_nsmul ℝ, Int.cast_smul_eq_zsmul ℝ]
      show _ ∈ G
      rw [e]
      exact sub_mem (nsmul_mem ht m) (sum_mem fun i _ => zsmul_mem (haG i) _)
    · have := Int.fract_nonneg ((m : ℝ) * t i); linarith
    · have := Int.fract_lt_one ((m : ℝ) * t i); linarith
  refine ⟨hfin, ?_, ?_⟩
  · refine le_antisymm ((AddSubgroup.closure_le G).2 inter_subset_left) fun x hx => ?_
    obtain ⟨t, rfl⟩ := hcoord x hx
    have h1 := hz t hx 1
    have e : ∑ i, t i • a i =
        ∑ i, Int.fract ((1 : ℕ) * t i) • a i + ∑ i, ⌊t i⌋ • a i := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Int.cast_smul_eq_zsmul ℝ, ← add_smul]
      simp
    rw [e]
    refine add_mem (AddSubgroup.subset_closure h1) (sum_mem fun i _ => zsmul_mem ?_ _)
    exact AddSubgroup.subset_closure ⟨haG i, mem_parallelotope_self a i⟩
  · intro x hx
    obtain ⟨t, rfl⟩ := hcoord x hx
    obtain ⟨h, k, hhk, hzz⟩ := Set.Finite.exists_lt_map_eq_of_forall_mem
      (f := fun m : ℕ => ∑ i, Int.fract ((m : ℝ) * t i) • a i) (hz t hx) hfin
    have hsub : ∑ i, (Int.fract ((h : ℝ) * t i) - Int.fract ((k : ℝ) * t i)) • a i = 0 := by
      simp only [sub_smul, Finset.sum_sub_distrib]
      exact sub_eq_zero.2 hzz
    have hcz := Fintype.linearIndependent_iff.1 hli _ hsub
    have hne : ((k : ℝ) - h) ≠ 0 := by
      have : (h : ℝ) < k := by exact_mod_cast hhk
      linarith
    refine ⟨fun i => ((⌊(k : ℝ) * t i⌋ - ⌊(h : ℝ) * t i⌋ : ℤ) : ℚ) / ((k : ℚ) - h), ?_⟩
    refine Finset.sum_congr rfl fun i _ => ?_
    congr 1
    have hi := hcz i
    simp only [Int.fract] at hi
    rw [eq_comm]
    push_cast
    rw [div_eq_iff hne]
    linarith

/-- Morris, Topology Without Tears, Proposition A5.5.8 (TP-544), the finiteness and generation parts
for `ℝⁿ = EuclideanSpace ℝ (Fin n)`. -/
@[kb "morris2024" "Proposition A5.5.8, p. 541"]
theorem discrete_subgroup_euclidean_parallelotope {n : ℕ} (G : AddSubgroup (EuclideanSpace ℝ (Fin n)))
    [DiscreteTopology G] {p : ℕ} (a : Fin p → EuclideanSpace ℝ (Fin n)) (hli : LinearIndependent ℝ a)
    (haG : ∀ i, a i ∈ G)
    (hspan : Submodule.span ℝ (G : Set (EuclideanSpace ℝ (Fin n))) = Submodule.span ℝ (Set.range a)) :
    ((G : Set (EuclideanSpace ℝ (Fin n))) ∩ parallelotope a).Finite ∧
      AddSubgroup.closure ((G : Set (EuclideanSpace ℝ (Fin n))) ∩ parallelotope a) = G ∧
      ∀ x ∈ G, ∃ q : Fin p → ℚ, x = ∑ i, (q i : ℝ) • a i :=
  discrete_subgroup_parallelotope G a hli haG hspan

end Parallelotope

section Corollary

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Coordinate functionals for a linearly independent family in a finite-dimensional real normed
space: a continuous linear map to `Fin p → ℝ` sending `aᵢ` to the `i`-th unit vector. -/
theorem exists_coordinate_map [FiniteDimensional ℝ E] {p : ℕ} {a : Fin p → E}
    (hli : LinearIndependent ℝ a) :
    ∃ g : E →L[ℝ] (Fin p → ℝ), ∀ t : Fin p → ℝ, g (∑ i, t i • a i) = t := by
  let B := Basis.span hli
  obtain ⟨g, hg⟩ := LinearMap.exists_extend (B.equivFun.toLinearMap)
  refine ⟨LinearMap.toContinuousLinearMap g, fun t => ?_⟩
  have hB : ∀ i, g (a i) = Pi.single i 1 := by
    intro i
    have := LinearMap.congr_fun hg (B i)
    funext j
    have h2 := congrFun this j
    simpa [B, Pi.single_apply, Finsupp.single_apply, eq_comm] using h2
  simp only [LinearMap.coe_toContinuousLinearMap', map_sum, map_smul, hB]
  funext j
  simp [Pi.single_apply]

/-- Morris, Topology Without Tears, Corollary A5.5.9 (TP-545). Let `a₁, …, a_p` be linearly independent
vectors of `ℝⁿ` (here a finite-dimensional real normed space) and `b = ∑ tᵢ aᵢ`. Then the group
generated by `a₁, …, a_p, b` is discrete if and only if all the `tᵢ` are rational. -/
@[kb "morris2024" "Corollary A5.5.9, p. 541"]
theorem discrete_closure_iff_rational [FiniteDimensional ℝ E] {p : ℕ} (a : Fin p → E)
    (hli : LinearIndependent ℝ a) (t : Fin p → ℝ) :
    DiscreteTopology (AddSubgroup.closure (Set.range a ∪ {∑ i, t i • a i})) ↔
      ∀ i, ∃ q : ℚ, t i = q := by
  set b : E := ∑ i, t i • a i with hb
  obtain ⟨g, hg⟩ := exists_coordinate_map hli
  have hga : ∀ i, g (a i) = Pi.single i 1 := fun i => by
    have h1 := hg (Pi.single i 1)
    have e : ∑ j, (Pi.single i (1 : ℝ) : Fin p → ℝ) j • a j = a i := by
      simp [Pi.single_apply]
    rwa [e] at h1
  have hgb : g b = t := hg t
  have hspan : ∀ y ∈ AddSubgroup.closure (Set.range a ∪ {b}),
      y ∈ Submodule.span ℝ (Set.range a) := by
    intro y hy
    have : AddSubgroup.closure (Set.range a ∪ {b}) ≤
        (Submodule.span ℝ (Set.range a)).toAddSubgroup := by
      rw [AddSubgroup.closure_le]
      rintro y (⟨i, rfl⟩ | rfl)
      · exact Submodule.subset_span ⟨i, rfl⟩
      · exact sum_mem fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    exact this hy
  constructor
  · intro hd
    have hG : DiscreteTopology (AddSubgroup.closure (Set.range a ∪ {b})) := hd
    set G := AddSubgroup.closure (Set.range a ∪ {b}) with hGdef
    have haG : ∀ i, a i ∈ G := fun i => AddSubgroup.subset_closure (Or.inl ⟨i, rfl⟩)
    have hbG : b ∈ G := AddSubgroup.subset_closure (Or.inr rfl)
    have hsp : Submodule.span ℝ (G : Set E) = Submodule.span ℝ (Set.range a) := by
      refine le_antisymm (Submodule.span_le.2 fun y hy => hspan y hy) ?_
      exact Submodule.span_mono (by rintro _ ⟨i, rfl⟩; exact haG i)
    obtain ⟨-, -, hrat⟩ := discrete_subgroup_parallelotope G a hli haG hsp
    obtain ⟨q, hq⟩ := hrat b hbG
    intro i
    refine ⟨q i, ?_⟩
    have h2 : g b = fun i => (q i : ℝ) := by
      rw [hq]; exact hg (fun i => (q i : ℝ))
    rw [hgb] at h2
    exact congrFun h2 i
  · intro hrat
    choose q hq using hrat
    set d : ℕ := ∏ i, (q i).den with hd
    have hdpos : 0 < d := Finset.prod_pos fun i _ => (q i).den_pos
    have hdR : (0 : ℝ) < d := by exact_mod_cast hdpos
    let L : AddSubgroup E :=
      { carrier := {y | ∀ i, ∃ n : ℤ, (d : ℝ) * g y i = n}
        zero_mem' := fun i => ⟨0, by simp⟩
        add_mem' := fun {y z} hy hz i => by
          obtain ⟨n, hn⟩ := hy i
          obtain ⟨m, hm⟩ := hz i
          exact ⟨n + m, by simp [mul_add, hn, hm]⟩
        neg_mem' := fun {y} hy i => by
          obtain ⟨n, hn⟩ := hy i
          exact ⟨-n, by simp [hn]⟩ }
    have hle : AddSubgroup.closure (Set.range a ∪ {b}) ≤ L := by
      rw [AddSubgroup.closure_le]
      rintro y (⟨j, rfl⟩ | rfl)
      · intro i
        refine ⟨if i = j then d else 0, ?_⟩
        rw [hga]
        by_cases h : i = j
        · simp [h]
        · simp [h]
      · intro i
        have hden : (q i).den ∣ d := Finset.dvd_prod_of_mem _ (Finset.mem_univ i)
        obtain ⟨c, hc⟩ := hden
        refine ⟨c * (q i).num, ?_⟩
        have hnum : (q i : ℝ) * ((q i).den : ℝ) = (q i).num := by
          exact_mod_cast congrArg (fun r : ℚ => (r : ℝ)) (Rat.mul_den_eq_num (q i))
        show (d : ℝ) * g b i = _
        rw [hgb, hq i, hc]
        push_cast
        rw [← hnum]
        ring
    let S : Set E := {y | ∀ i, |g y i| < 1 / d}
    have hSopen : IsOpen S := by
      simp only [S, Set.ofPred_forall]
      exact isOpen_iInter_of_finite fun i =>
        isOpen_lt (continuous_abs.comp ((continuous_apply i).comp g.continuous)) continuous_const
    have hzero : ∀ y ∈ AddSubgroup.closure (Set.range a ∪ {b}), y ∈ S → y = 0 := by
      intro y hy hyS
      have hyL := hle hy
      have hcoord : ∀ i, g y i = 0 := by
        intro i
        obtain ⟨n, hn⟩ := hyL i
        have h1 := hyS i
        have h2 : |(n : ℝ)| < 1 := by
          have : |(d : ℝ) * g y i| < 1 := by
            rw [abs_mul, abs_of_pos hdR]
            calc (d : ℝ) * |g y i| < d * (1 / d) := by gcongr
              _ = 1 := by field_simp
          rwa [hn] at this
        have hn0 : n = 0 := by
          have : |n| < 1 := by exact_mod_cast h2
          have := abs_lt.1 this
          omega
        rw [hn0] at hn
        simpa [hdR.ne'] using hn
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 (hspan y hy)
      have : c = 0 := by
        have := hg c
        rw [hc] at this
        rw [← this]
        funext i
        exact hcoord i
      rw [← hc, this]
      simp
    refine discreteTopology_of_isOpen_singleton_zero ?_
    have : ({0} : Set (AddSubgroup.closure (Set.range a ∪ {b}))) =
        Subtype.val ⁻¹' S := by
      ext y
      constructor
      · rintro rfl
        intro i
        simpa using one_div_pos.2 hdR
      · intro hy
        exact Subtype.ext (hzero y.1 y.2 hy)
    rw [this]
    exact hSopen.preimage continuous_subtype_val

end Corollary

end UndergradKB.Topology
