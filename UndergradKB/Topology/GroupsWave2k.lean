import UndergradKB.Topology.ClosedSubgroupsRn
import UndergradKB.Topology.GroupsWave2e
import Mathlib.GroupTheory.FiniteAbelian.Basic
import UndergradKB.Common.Attr

/-!
# Wave 2: quotients of `ℝⁿ × ℤᵐ` by closed subgroups (Morris, Appendix 5.5, Corollary A5.5.17)

From the splitting theorem A5.5.16: `ℝⁿ × ℤᵐ = V × F'` with `G = (G ∩ V) × (G ∩ F')`, so the quotient is
`V / (G ∩ V) × F' / (G ∩ F')`.
-/

open Set

namespace UndergradKB.Topology

open ClosedSubgroupsRn

section Quotients

variable {A B : Type*} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
  [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]

/-- A topological isomorphism carrying a subgroup onto another induces one of the quotients. -/
theorem quotient_equiv_of_equiv (e : A ≃ₜ+ B) (P : AddSubgroup A) (Q : AddSubgroup B)
    (h : ∀ x, x ∈ P ↔ e x ∈ Q) : Nonempty ((A ⧸ P) ≃ₜ+ (B ⧸ Q)) := by
  let φ : A →+ B ⧸ Q := (QuotientAddGroup.mk' Q).comp e.toAddEquiv.toAddMonoidHom
  have hc : Continuous φ := QuotientAddGroup.continuous_mk.comp e.continuous
  have ho : IsOpenMap φ := QuotientAddGroup.isOpenMap_coe.comp e.toHomeomorph.isOpenMap
  have hs : Function.Surjective φ := fun y => by
    obtain ⟨b, rfl⟩ := QuotientAddGroup.mk_surjective y
    exact ⟨e.symm b, by
      show (QuotientAddGroup.mk (e (e.symm b)) : B ⧸ Q) = _
      rw [ContinuousAddEquiv.apply_symm_apply]⟩
  exact quotient_equiv P φ hc ho hs (fun x => by
    rw [h x]
    exact (QuotientAddGroup.eq_zero_iff (e x)).symm)

/-- The quotient of a product by a product of subgroups. -/
theorem quotient_prod_equiv (P₁ : AddSubgroup A) (P₂ : AddSubgroup B) :
    Nonempty (((A × B) ⧸ P₁.prod P₂) ≃ₜ+ ((A ⧸ P₁) × (B ⧸ P₂))) := by
  let φ : A × B →+ (A ⧸ P₁) × (B ⧸ P₂) :=
    (QuotientAddGroup.mk' P₁).prodMap (QuotientAddGroup.mk' P₂)
  have hc : Continuous φ :=
    (QuotientAddGroup.continuous_mk.comp continuous_fst).prodMk
      (QuotientAddGroup.continuous_mk.comp continuous_snd)
  have ho : IsOpenMap φ := QuotientAddGroup.isOpenMap_coe.prodMap QuotientAddGroup.isOpenMap_coe
  have hs : Function.Surjective φ := fun y => by
    obtain ⟨a, ha⟩ := QuotientAddGroup.mk_surjective y.1
    obtain ⟨b, hb⟩ := QuotientAddGroup.mk_surjective y.2
    exact ⟨(a, b), Prod.ext ha hb⟩
  exact quotient_equiv (P₁.prod P₂) φ hc ho hs (fun x => by
    rw [AddSubgroup.mem_prod]
    show _ ↔ (((x.1 : A) : A ⧸ P₁), ((x.2 : B) : B ⧸ P₂)) = 0
    rw [Prod.mk_eq_zero, QuotientAddGroup.eq_zero_iff, QuotientAddGroup.eq_zero_iff])

end Quotients

section Main

variable {n m : ℕ}

/-- Morris, Topology Without Tears, Corollary A5.5.17 (TP-549), quotient part. If `G` is a closed subgroup of
`ℝⁿ × ℤᵐ`, then `(ℝⁿ × ℤᵐ) ⧸ G` is topologically isomorphic to `ℝ^c × T^d × D` with `c + d ≤ n` and `D` a
discrete abelian group generated by at most `m` elements. -/
@[kb "morris2024" "Corollary A5.5.17, p. 547"]
theorem quotient_closedSubgroup_real_pow_prod_int_pow (G : AddSubgroup ((Fin n → ℝ) × (Fin m → ℤ)))
    (hG : IsClosed (G : Set ((Fin n → ℝ) × (Fin m → ℤ)))) :
    ∃ (c d : ℕ) (D : Type) (_ : AddCommGroup D) (_ : TopologicalSpace D),
      c + d ≤ n ∧ DiscreteTopology D ∧ AddGroup.FG D ∧
        (∃ S : Finset D, S.card ≤ m ∧ AddSubgroup.closure (S : Set D) = ⊤) ∧
        Nonempty ((((Fin n → ℝ) × (Fin m → ℤ)) ⧸ G) ≃ₜ+
          (((Fin c → ℝ) × (Fin d → AddCircle (1 : ℝ))) × D)) := by
  classical
  have hdiv : ∀ k : ℕ, 0 < k → ∀ v : Fin n → ℝ, ∃ w, k • w = v := fun k hk v =>
    ⟨(k : ℝ)⁻¹ • v, by
      rw [← Nat.cast_smul_eq_nsmul ℝ, smul_smul, mul_inv_cancel₀ (by exact_mod_cast hk.ne'), one_smul]⟩
  obtain ⟨F', ⟨iso⟩, hFd, e, he1, he2⟩ := closedSubgroup_prod_divisible_free hdiv G hG
  let Gv : AddSubgroup (Fin n → ℝ) := G.comap (AddMonoidHom.inl _ _)
  let Gf : AddSubgroup F' := G.comap F'.subtype
  have hGv : IsClosed (Gv : Set (Fin n → ℝ)) :=
    hG.preimage (continuous_id.prodMk continuous_const)
  let P : AddSubgroup ((Fin n → ℝ) × F') := Gv.prod Gf
  have hP : e '' (P : Set _) = (G : Set _) := by
    rw [← he2]
    rfl
  have hmem : ∀ x, x ∈ P ↔ e x ∈ G := by
    intro x
    constructor
    · intro hx
      have : e x ∈ e '' (P : Set _) := ⟨x, hx, rfl⟩
      rw [hP] at this
      exact this
    · intro hx
      have : e x ∈ e '' (P : Set _) := by rw [hP]; exact hx
      obtain ⟨y, hy, hyx⟩ := this
      have : y = x := e.injective hyx
      rw [← this]; exact hy
  obtain ⟨E1⟩ := quotient_equiv_of_equiv e P G hmem
  obtain ⟨E2⟩ := quotient_prod_equiv Gv Gf
  obtain ⟨c, d, hcd, ⟨E3⟩⟩ := quotient_closed_subgroup_equiv Gv hGv
  haveI : DiscreteTopology (F' ⧸ Gf) := QuotientAddGroup.discreteTopology (isOpen_discrete _)
  have hfg : AddGroup.FG (F' ⧸ Gf) := by
    haveI : AddGroup.FG (Fin m → ℤ) := Module.Finite.iff_addGroup_fg.1 inferInstance
    exact AddGroup.fg_of_surjective (f := (QuotientAddGroup.mk' Gf).comp iso.toAddMonoidHom)
      (fun y => by
        obtain ⟨f, rfl⟩ := QuotientAddGroup.mk_surjective y
        obtain ⟨z, hz⟩ := iso.surjective f
        exact ⟨z, by simp [hz]⟩)
  have hn : c + d ≤ n := by simpa using hcd
  -- the images of the `m` basis vectors generate `F' ⧸ Gf`
  let π : (Fin m → ℤ) →+ F' ⧸ Gf := (QuotientAddGroup.mk' Gf).comp iso.toAddMonoidHom
  have hπ : Function.Surjective π := fun y => by
    obtain ⟨f, rfl⟩ := QuotientAddGroup.mk_surjective y
    obtain ⟨z, hz⟩ := iso.surjective f
    exact ⟨z, by simp [π, hz]⟩
  let S : Finset (F' ⧸ Gf) := Finset.univ.image fun i : Fin m => π (Pi.single i 1)
  have hS : AddSubgroup.closure (S : Set (F' ⧸ Gf)) = ⊤ := by
    rw [eq_top_iff]
    rintro y -
    obtain ⟨z, rfl⟩ := hπ y
    have hz : z = ∑ i, z i • (Pi.single i 1 : Fin m → ℤ) := by
      funext j
      simp [Finset.sum_apply, Pi.single_apply]
    rw [hz, map_sum]
    refine AddSubgroup.sum_mem _ fun i _ => ?_
    rw [map_zsmul]
    exact AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (by simp [S])) _
  have hScard : S.card ≤ m := by
    simpa using Finset.card_image_le (s := Finset.univ) (f := fun i : Fin m => π (Pi.single i 1))
  exact ⟨c, d, F' ⧸ Gf, inferInstance, inferInstance, hn, inferInstance, hfg, ⟨S, hScard, hS⟩,
    ⟨E1.symm.trans (E2.trans (prodCAE E3 (ContinuousAddEquiv.refl _)))⟩⟩

end Main

end UndergradKB.Topology
