import UndergradKB.Common.Attr

/-!
# Topological groups (Morris, Topology Without Tears, Appendix 5, sections A5.1 to A5.4)

Basic properties of topological groups: homogeneity, symmetric neighbourhoods, the closure of the
identity, locally compact subgroups, subgroups generated by neighbourhoods, quotients, products,
divisible groups, and the Baire argument for countable locally compact groups.
Everything is stated for Mathlib's `IsTopologicalGroup`.
-/

open Set Filter Topology Pointwise

namespace UndergradKB.Topology

section Homogeneous

/-- A space is homogeneous when any two points are exchanged by a self-homeomorphism. -/
def IsHomogeneousSpace (X : Type*) [TopologicalSpace X] : Prop :=
  ∀ x y : X, ∃ f : X ≃ₜ X, f x = y

/-- Morris, Topology Without Tears, Definition A5.1.6 (TP-507). Every topological group is a
homogeneous space (left translation by `y * x⁻¹` carries `x` to `y`). -/
@[kb "morris2024" "Definition A5.1.6, p. 516"]
theorem isHomogeneousSpace_of_isTopologicalGroup (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] : IsHomogeneousSpace G :=
  fun x y => ⟨Homeomorph.mulLeft (y * x⁻¹), by simp⟩

/-- Characterisation of homogeneity through a transitive group of homeomorphisms. -/
@[kb "morris2024" "Definition A5.1.6, p. 516"]
theorem isHomogeneousSpace_iff_exists_homeo_one (X : Type*) [TopologicalSpace X] :
    IsHomogeneousSpace X ↔ ∀ x y : X, ∃ f : X ≃ₜ X, f x = y := Iff.rfl

end Homogeneous

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- Morris, Topology Without Tears, Proposition A5.1.8 (TP-509). Every neighbourhood `U` of the
identity contains an open symmetric neighbourhood `V` of the identity with `V * V ⊆ U`. -/
@[kb "morris2024" "Proposition A5.1.8, p. 516"]
theorem exists_isOpen_symm_mul_subset {U : Set G} (hU : U ∈ 𝓝 (1 : G)) :
    ∃ V : Set G, IsOpen V ∧ (1 : G) ∈ V ∧ V⁻¹ = V ∧ V * V ⊆ U := by
  obtain ⟨W, hWo, hW1, hW⟩ := exists_open_nhds_one_mul_subset hU
  refine ⟨W ∩ W⁻¹, hWo.inter hWo.inv, ⟨hW1, by simpa using hW1⟩, ?_, ?_⟩
  · rw [Set.inter_inv, inv_inv, Set.inter_comm]
  · exact (Set.mul_subset_mul Set.inter_subset_left Set.inter_subset_left).trans hW

/-- Morris, Topology Without Tears, Corollary A5.2.6 (i) (TP-514). The closure of `{1}` is a
closed normal subgroup, and it is contained in every closed subgroup. -/
@[kb "morris2024" "Corollary A5.2.6, p. 521"]
theorem closure_one_isClosed_normal_least :
    IsClosed (closure ({1} : Set G)) ∧
      ((⊥ : Subgroup G).topologicalClosure : Set G) = closure ({1} : Set G) ∧
      (⊥ : Subgroup G).topologicalClosure.Normal ∧
      ∀ H : Subgroup G, IsClosed (H : Set G) → (⊥ : Subgroup G).topologicalClosure ≤ H := by
  refine ⟨isClosed_closure, by simp [Subgroup.topologicalClosure],
    Subgroup.is_normal_topologicalClosure _, ?_⟩
  intro H hH
  exact Subgroup.topologicalClosure_minimal _ bot_le hH

/-- Morris, Topology Without Tears, Corollary A5.2.6 (ii) (TP-514). The closure of `{g}` is the
coset `g * closure {1}` (and also `closure {1} * g`). -/
@[kb "morris2024" "Corollary A5.2.6, p. 521"]
theorem closure_singleton_eq_mul_closure_one (g : G) :
    closure ({g} : Set G) = (fun x => g * x) '' closure ({1} : Set G) ∧
      closure ({g} : Set G) = (fun x => x * g) '' closure ({1} : Set G) := by
  constructor
  · rw [show ({g} : Set G) = (Homeomorph.mulLeft g) '' {1} by simp, ← Homeomorph.image_closure]
    rfl
  · rw [show ({g} : Set G) = (Homeomorph.mulRight g) '' {1} by simp, ← Homeomorph.image_closure]
    rfl

omit [IsTopologicalGroup G] in
/-- Morris, Topology Without Tears, Corollary A5.2.6 (iii) (TP-514). In a Hausdorff group the
closure of `{1}` is `{1}`. -/
@[kb "morris2024" "Corollary A5.2.6, p. 521"]
theorem closure_one_eq_singleton [T1Space G] : closure ({1} : Set G) = {1} :=
  closure_singleton

/-- Morris, Topology Without Tears, Proposition A5.2.8 (TP-516). A locally compact subgroup of a
Hausdorff topological group is closed. -/
@[kb "morris2024" "Proposition A5.2.8, p. 522"]
theorem isClosed_subgroup_of_locallyCompactSpace [T2Space G] (H : Subgroup G)
    [LocallyCompactSpace H] : IsClosed (H : Set G) := by
  obtain ⟨K, hK1, -, hKc⟩ := LocallyCompactSpace.local_compact_nhds (1 : H) Set.univ univ_mem
  rw [mem_nhds_subtype] at hK1
  obtain ⟨u, hu, huK⟩ := hK1
  have hKc' : IsCompact (Subtype.val '' K) := hKc.image continuous_subtype_val
  refine H.isClosed_of_isLocallyClosedAt (x := 1) H.one_mem ?_
  rw [isLocallyClosedAt_iff_exists_inter_closure_subset]
  refine ⟨interior u, interior_mem_nhds.2 hu, fun y ⟨hyW, hyc⟩ => ?_⟩
  have h1 : interior u ∩ (H : Set G) ⊆ Subtype.val '' K := by
    rintro z ⟨hz, hzH⟩
    exact ⟨⟨z, hzH⟩, huK (interior_subset hz : z ∈ u), rfl⟩
  have h2 : y ∈ closure (interior u ∩ (H : Set G)) := isOpen_interior.inter_closure ⟨hyW, hyc⟩
  have h3 := closure_minimal h1 hKc'.isClosed h2
  obtain ⟨z, -, rfl⟩ := h3
  exact z.2

/-- Morris, Topology Without Tears, Proposition A5.2.8 (TP-516), the discrete case: a discrete
subgroup of a Hausdorff topological group is closed. -/
@[kb "morris2024" "Proposition A5.2.8, p. 522"]
theorem isClosed_subgroup_of_discreteTopology [T2Space G] (H : Subgroup G)
    [DiscreteTopology H] : IsClosed (H : Set G) :=
  Subgroup.isClosed_of_discreteTopology

/-- The subgroup `Subgroup.closure U` generated by a neighbourhood `U` of `1` is open. -/
theorem isOpen_closure_of_mem_nhds_one {U : Set G} (hU : U ∈ 𝓝 (1 : G)) :
    IsOpen (Subgroup.closure U : Set G) :=
  Subgroup.isOpen_of_mem_nhds _ (Filter.mem_of_superset hU Subgroup.subset_closure)

omit [TopologicalSpace G] [IsTopologicalGroup G] in
private lemma inv_mem_pow_of_symm {U : Set G} (hU : U⁻¹ = U) :
    ∀ (n : ℕ) {x : G}, x ∈ U ^ n → x⁻¹ ∈ U ^ n := by
  intro n
  induction n with
  | zero => intro x hx; simpa [Set.mem_one] using hx
  | succ n ih =>
    intro x hx
    rw [pow_succ] at hx
    obtain ⟨y, hy, z, hz, rfl⟩ := hx
    rw [pow_succ', mul_inv_rev]
    refine Set.mul_mem_mul ?_ (ih hy)
    rw [← hU]
    simpa using hz

/-- Morris, Topology Without Tears, Proposition A5.2.9 (TP-517). For a symmetric neighbourhood `U`
of `1`, the union of the powers `U ^ n` (`n ≥ 1`) is an open and closed subgroup of `G`; in
fact it is the subgroup generated by `U`. -/
@[kb "morris2024" "Proposition A5.2.9, p. 522"]
theorem exists_subgroup_eq_iUnion_pow_isOpen_isClosed {U : Set G} (hU : U ∈ 𝓝 (1 : G))
    (hsymm : U⁻¹ = U) :
    ∃ H : Subgroup G, (H : Set G) = ⋃ n : ℕ, U ^ (n + 1) ∧ H = Subgroup.closure U ∧
      IsOpen (H : Set G) ∧ IsClosed (H : Set G) := by
  have hU1 : (1 : G) ∈ U := mem_of_mem_nhds hU
  have key : (Subgroup.closure U : Set G) = ⋃ n : ℕ, U ^ (n + 1) := by
    apply Set.Subset.antisymm
    · intro x hx
      induction hx using Subgroup.closure_induction with
      | mem x hx => exact Set.mem_iUnion.2 ⟨0, by simpa using hx⟩
      | one => exact Set.mem_iUnion.2 ⟨0, by simp [hU1]⟩
      | mul x y _ _ hx hy =>
        obtain ⟨a, ha⟩ := Set.mem_iUnion.1 hx
        obtain ⟨b, hb⟩ := Set.mem_iUnion.1 hy
        refine Set.mem_iUnion.2 ⟨a + b + 1, ?_⟩
        have : a + b + 1 + 1 = (a + 1) + (b + 1) := by omega
        rw [this, pow_add]
        exact Set.mul_mem_mul ha hb
      | inv x _ hx =>
        obtain ⟨a, ha⟩ := Set.mem_iUnion.1 hx
        exact Set.mem_iUnion.2 ⟨a, inv_mem_pow_of_symm hsymm _ ha⟩
    · refine Set.iUnion_subset fun n x hx => ?_
      have hsub : U ^ (n + 1) ⊆ (Subgroup.closure U : Set G) := by
        clear hx x
        induction n with
        | zero => simp
        | succ n ih =>
          intro x hx
          rw [pow_succ] at hx
          obtain ⟨y, hy, z, hz, rfl⟩ := hx
          exact Subgroup.mul_mem _ (ih hy) (Subgroup.subset_closure hz)
      exact hsub hx
  have hopen := isOpen_closure_of_mem_nhds_one hU
  exact ⟨Subgroup.closure U, key, rfl, hopen, Subgroup.isClosed_of_isOpen _ hopen⟩

/-- Morris, Topology Without Tears, Corollary A5.2.10 (TP-518). In a connected topological group
every neighbourhood `U` of `1` generates the group, and `G = ⋃ n, U ^ (n + 1)`. -/
@[kb "morris2024" "Corollary A5.2.10, p. 523"]
theorem iUnion_pow_eq_univ_of_connectedSpace [ConnectedSpace G] {U : Set G} (hU : U ∈ 𝓝 (1 : G)) :
    (⋃ n : ℕ, U ^ (n + 1)) = Set.univ ∧ Subgroup.closure U = ⊤ := by
  obtain ⟨V, hVo, hV1, hVs, hVU⟩ := exists_isOpen_symm_mul_subset hU
  have hVU' : V ⊆ U := fun v hv => hVU ⟨v, hv, 1, hV1, by simp⟩
  obtain ⟨H, hH, hHeq, hHo, hHc⟩ :=
    exists_subgroup_eq_iUnion_pow_isOpen_isClosed (hVo.mem_nhds hV1) hVs
  have hHtop : H = ⊤ := by
    have := IsClopen.eq_univ ⟨hHc, hHo⟩ ⟨1, H.one_mem⟩
    exact_mod_cast this
  have hall : (⋃ n : ℕ, V ^ (n + 1)) = Set.univ := by
    rw [← hH, hHtop]; rfl
  refine ⟨?_, ?_⟩
  · apply Set.eq_univ_of_univ_subset
    rw [← hall]
    exact Set.iUnion_mono fun n => (by gcongr : V ^ (n + 1) ⊆ U ^ (n + 1))
  · rw [eq_top_iff, ← hHtop, hHeq]
    exact Subgroup.closure_mono hVU'

/-- Morris, Topology Without Tears, Definition A5.2.11 (TP-519). A topological group is compactly
generated if it is generated, as a group, by a compact subset. -/
def IsCompactlyGeneratedGroup (G : Type*) [Group G] [TopologicalSpace G] : Prop :=
  ∃ K : Set G, IsCompact K ∧ Subgroup.closure K = ⊤

omit [IsTopologicalGroup G] in
/-- Morris, Topology Without Tears, Example A5.2.12 (ii) (TP-519). Every compact group is compactly
generated. -/
@[kb "morris2024" "Example A5.2.12, p. 523"]
theorem isCompactlyGeneratedGroup_of_compactSpace [CompactSpace G] :
    IsCompactlyGeneratedGroup G :=
  ⟨Set.univ, isCompact_univ, by
    rw [eq_top_iff]; intro x _; exact Subgroup.subset_closure trivial⟩

/-- Morris, Topology Without Tears, Corollary A5.2.13 (TP-519). A connected locally compact group
is compactly generated (by any compact neighbourhood of `1`). -/
@[kb "morris2024" "Corollary A5.2.13, p. 523"]
theorem isCompactlyGeneratedGroup_of_connected_locallyCompact [ConnectedSpace G]
    [LocallyCompactSpace G] : IsCompactlyGeneratedGroup G := by
  obtain ⟨K, hKc, hK⟩ := exists_compact_mem_nhds (1 : G)
  exact ⟨K, hKc, (iUnion_pow_eq_univ_of_connectedSpace hK).2⟩

/-- Morris, Topology Without Tears, §A5.12 (TP-639). A locally compact group is compactly generated
iff it is generated by a compact neighbourhood of `1`. -/
@[kb "morris2024" "Definition (compactly generated LCA-group, §A5.12), p. 583"]
theorem isCompactlyGeneratedGroup_iff_exists_compact_nhds [LocallyCompactSpace G] :
    IsCompactlyGeneratedGroup G ↔ ∃ K : Set G, IsCompact K ∧ K ∈ 𝓝 (1 : G) ∧
      Subgroup.closure K = ⊤ := by
  constructor
  · rintro ⟨K, hK, hgen⟩
    obtain ⟨V, hVc, hV⟩ := exists_compact_mem_nhds (1 : G)
    refine ⟨K ∪ V, hK.union hVc, Filter.mem_of_superset hV Set.subset_union_right, ?_⟩
    rw [eq_top_iff, ← hgen]
    exact Subgroup.closure_mono Set.subset_union_left
  · rintro ⟨K, hK, -, hgen⟩
    exact ⟨K, hK, hgen⟩

/-- Morris, Topology Without Tears, Proposition A5.2.22 (TP-523). For a normal subgroup `N`, the
quotient `G ⧸ N` is discrete iff `N` is open. -/
@[kb "morris2024" "Proposition A5.2.22, p. 526"]
theorem discreteTopology_quotient_iff (N : Subgroup G) [N.Normal] :
    DiscreteTopology (G ⧸ N) ↔ IsOpen (N : Set G) :=
  QuotientGroup.discreteTopology_iff

/-- Morris, Topology Without Tears, Proposition A5.2.22 (TP-523). For a normal subgroup `N`, the
quotient `G ⧸ N` is Hausdorff iff `N` is closed. -/
@[kb "morris2024" "Proposition A5.2.22, p. 526"]
theorem t2Space_quotient_iff (N : Subgroup G) [N.Normal] :
    T2Space (G ⧸ N) ↔ IsClosed (N : Set G) := by
  constructor
  · intro h
    exact QuotientGroup.t1Space_iff.1 inferInstance
  · intro h
    have : IsClosed (N : Set G) := h
    infer_instance

section Products

variable {ι : Type*} (X : ι → Type*) [∀ i, Group (X i)] [∀ i, TopologicalSpace (X i)]

/-- Morris, Topology Without Tears, Proposition A5.3.2 (TP-525), first part: a product of
topological groups is a topological group. -/
@[kb "morris2024" "Proposition A5.3.2, p. 530"]
theorem isTopologicalGroup_pi [∀ i, IsTopologicalGroup (X i)] :
    IsTopologicalGroup (∀ i, X i) := inferInstance

/-- The restricted direct product of groups (Morris, Topology Without Tears, §A5.3): the subgroup
of the product of elements equal to `1` in all but finitely many coordinates. Its topology is the
subspace topology from the product. -/
def restrictedDirectProduct : Subgroup (∀ i, X i) where
  carrier := {g | {i | g i ≠ 1}.Finite}
  mul_mem' := by
    intro a b ha hb
    refine (ha.union hb).subset ?_
    intro i hi
    by_contra h
    simp only [Set.mem_union, Set.mem_ofPred_eq, not_or, not_not] at h
    exact hi (by simp [h.1, h.2])
  one_mem' := by simp
  inv_mem' := by
    intro a ha
    refine ha.subset ?_
    intro i hi
    simpa using hi

/-- Morris, Topology Without Tears, Proposition A5.3.2 (TP-525), second part: the restricted
direct product of topological groups is dense in the product. -/
@[kb "morris2024" "Proposition A5.3.2, p. 530"]
theorem dense_restrictedDirectProduct :
    Dense (restrictedDirectProduct X : Set (∀ i, X i)) := by
  classical
  intro g
  rw [mem_closure_iff]
  intro U hU hgU
  obtain ⟨I, u, hu, hsub⟩ := isOpen_pi_iff.1 hU g hgU
  refine ⟨fun i => if i ∈ I then g i else 1, hsub ?_, ?_⟩
  · intro i hi
    show (if i ∈ I then g i else 1) ∈ u i
    rw [ite_eq_left (Finset.mem_coe.1 hi)]
    exact (hu i (Finset.mem_coe.1 hi)).2
  · refine (I.finite_toSet).subset ?_
    intro i hi
    by_contra h
    exact hi (ite_eq_right (fun h' => h (Finset.mem_coe.2 h')))

end Products

section Pi

variable {ι : Type*} (X : ι → Type*) [∀ i, TopologicalSpace (X i)] [∀ i, Nonempty (X i)]

/-- Morris, Topology Without Tears, Proposition A5.3.3 (i) (TP-526). A product of (nonempty)
spaces is locally compact iff every factor is locally compact and all but finitely many factors
are compact. -/
@[kb "morris2024" "Proposition A5.3.3, p. 531"]
theorem locallyCompactSpace_pi_iff :
    LocallyCompactSpace (∀ i, X i) ↔
      (∀ i, LocallyCompactSpace (X i)) ∧ {i | ¬ CompactSpace (X i)}.Finite := by
  classical
  constructor
  · intro h
    refine ⟨fun i => ?_, ?_⟩
    · have hs : Function.Surjective (fun f : ∀ i, X i => f i) := fun a =>
        ⟨Function.update (fun j => Classical.arbitrary (X j)) i a, by simp⟩
      exact (IsOpenQuotientMap.mk hs (continuous_apply i) (isOpenMap_eval i)).locallyCompactSpace
    · let x₀ : ∀ i, X i := fun i => Classical.arbitrary (X i)
      obtain ⟨K, hKn, -, hKc⟩ := LocallyCompactSpace.local_compact_nhds x₀ Set.univ univ_mem
      rw [nhds_pi, Filter.mem_pi] at hKn
      obtain ⟨I, hI, t, ht, hsub⟩ := hKn
      refine hI.subset ?_
      intro i hi
      by_contra hiI
      apply hi
      rw [← isCompact_univ_iff]
      have : (Set.univ : Set (X i)) ⊆ (fun f => f i) '' K := by
        intro a _
        refine ⟨Function.update x₀ i a, hsub ?_, by simp⟩
        intro j hj
        have hji : j ≠ i := fun e => hiI (e ▸ hj)
        simpa [Function.update_of_ne hji] using mem_of_mem_nhds (ht j)
      exact (Set.univ_subset_iff.1 this) ▸ hKc.image (continuous_apply i)
  · rintro ⟨hlc, hfin⟩
    refine ⟨fun t n hn => ?_⟩
    rw [nhds_pi, Filter.mem_pi] at hn
    obtain ⟨I, hI, n', hn', hsub⟩ := hn
    choose n'' hn'' hsub' hc using fun i =>
      LocallyCompactSpace.local_compact_nhds (t i) (n' i) (hn' i)
    refine ⟨(I ∪ {i | ¬ CompactSpace (X i)}).pi n'', ?_, ?_, ?_⟩
    · exact (set_pi_mem_nhds_iff (hI.union hfin) _).mpr fun i _ => hn'' i
    · exact fun z hz => hsub fun i hi => hsub' i (hz i (Or.inl hi))
    · rw [← Set.univ_pi_ite]
      refine isCompact_univ_pi fun i => ?_
      by_cases hi : i ∈ I ∪ {i | ¬ CompactSpace (X i)}
      · rw [ite_eq_left hi]
        exact hc i
      · rw [ite_eq_right hi]
        simp only [Set.mem_union, Set.mem_ofPred_eq, not_or, not_not] at hi
        exact hi.2.isCompact_univ

end Pi

section Divisible

/-- Divisibility in the book's sense (Definition A5.3.4): every element of `D` has an `n`-th
"root" (here additively, `n • x = d`) for each positive integer `n`. -/
def IsDivisibleGroup (D : Type*) [AddCommGroup D] : Prop :=
  ∀ (n : ℕ), 0 < n → ∀ d : D, ∃ x : D, n • x = d

/-- Morris, Topology Without Tears, Proposition A5.3.6 (TP-528), additive form. A homomorphism
from a subgroup `H` of an abelian group `A` into a divisible abelian group `D` extends to a
homomorphism on all of `A`. -/
@[kb "morris2024" "Proposition A5.3.6, p. 531"]
theorem exists_addMonoidHom_extension {A D : Type*} [AddCommGroup A] [AddCommGroup D]
    (hD : IsDivisibleGroup D) (H : AddSubgroup A) (φ : H →+ D) :
    ∃ Φ : A →+ D, ∀ h : H, Φ h = φ h := by
  classical
  let inst : DivisibleBy D ℤ :=
    { div := fun d n =>
        if hp : 0 < n then Classical.choose (hD n.toNat (by omega) d)
        else if hq : n < 0 then -Classical.choose (hD (-n).toNat (by omega) d)
        else 0
      div_zero := fun d => by simp
      div_cancel := fun {n} d hn => by
        by_cases hp : 0 < n
        · have h := Classical.choose_spec (hD n.toNat (by omega) d)
          simp only [hp, dite_true]
          rw [← natCast_zsmul, Int.toNat_of_nonneg hp.le] at h
          exact h
        · have hq : n < 0 := by omega
          have h := Classical.choose_spec (hD (-n).toNat (by omega) d)
          rw [← natCast_zsmul, Int.toNat_of_nonneg (by omega)] at h
          simp only [hp, hq, dite_false, dite_true]
          rw [smul_neg, ← neg_smul]
          exact h }
  have hB : Module.Baer ℤ D := Module.Baer.of_divisible D
  obtain ⟨Φ, hΦ⟩ := hB.extension_property_addMonoidHom H.subtype H.subtype_injective φ
  exact ⟨Φ, fun h => by simpa using congrArg (fun f => f h) hΦ⟩

end Divisible

section Baire

/-- Morris, Topology Without Tears, Corollary A5.4.3 (TP-535). A countable locally compact
Hausdorff topological group has the discrete topology (Baire category). -/
@[kb "morris2024" "Corollary A5.4.3, p. 535"]
theorem discreteTopology_of_countable_locallyCompact [Countable G] [LocallyCompactSpace G]
    [T2Space G] : DiscreteTopology G := by
  obtain ⟨x, hx⟩ := nonempty_interior_of_iUnion_of_closed (X := G) (ι := G)
    (f := fun x => ({x} : Set G)) (fun x => isClosed_singleton)
    (Set.eq_univ_of_forall fun z => Set.mem_iUnion.2 ⟨z, rfl⟩)
  obtain ⟨y, hy⟩ := hx
  have hxy : y = x := by simpa using interior_subset hy
  subst hxy
  have hopen : IsOpen ({y} : Set G) := by
    have : interior ({y} : Set G) = {y} :=
      Set.Subset.antisymm interior_subset (by simpa using hy)
    rw [← this]; exact isOpen_interior
  apply discreteTopology_of_isOpen_singleton_one
  have := (Homeomorph.mulLeft y⁻¹).isOpen_image.2 hopen
  simpa using this

end Baire

end UndergradKB.Topology
