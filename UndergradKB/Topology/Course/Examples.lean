/-! # Course layer, Morris: central examples and remarks of Chapters 1-11

Thin theorems for the examples and remarks of Morris, *Topology Without Tears*, that state a real
mathematical fact (they were not rows of the checklist).
-/

open _root_.Topology

namespace UndergradKB.Topology.Course

open Set Filter TopologicalSpace Metric

section Examples

/-- The collection of half-open intervals `[a, b)` of the real line. -/
def halfOpenIntervals : Set (Set ℝ) := {s | ∃ a b : ℝ, a < b ∧ s = Ico a b}

/-- Morris, Topology Without Tears, Example 2.3.1. The half-open intervals `[a, b)` form a basis of a
topology on `ℝ` (the one they generate). -/
@[kb "morris2024" "Example 2.3.1, p. 63"]
theorem morris_ex_2_3_1_a : @IsTopologicalBasis ℝ (generateFrom halfOpenIntervals) halfOpenIntervals := by
  refine @IsTopologicalBasis.mk ℝ (generateFrom halfOpenIntervals) _ ?_ ?_ rfl
  · rintro _ ⟨a, b, hab, rfl⟩ _ ⟨c, d, hcd, rfl⟩ x ⟨⟨hax, hxb⟩, ⟨hcx, hxd⟩⟩
    refine ⟨Ico (max a c) (min b d), ⟨max a c, min b d, ?_, rfl⟩, ⟨?_, ?_⟩, ?_⟩
    · exact lt_of_le_of_lt (max_le_iff.2 ⟨hax, hcx⟩) (lt_min_iff.2 ⟨hxb, hxd⟩)
    · exact max_le_iff.2 ⟨hax, hcx⟩
    · exact lt_min_iff.2 ⟨hxb, hxd⟩
    · intro y ⟨h1, h2⟩
      exact ⟨⟨(le_max_left _ _).trans h1, h2.trans_le (min_le_left _ _)⟩,
        ⟨(le_max_right _ _).trans h1, h2.trans_le (min_le_right _ _)⟩⟩
  · refine eq_univ_of_forall fun x => ⟨Ico x (x + 1), ⟨x, x + 1, by linarith, rfl⟩, ?_⟩
    exact ⟨le_rfl, by linarith⟩

/-- Morris, Topology Without Tears, Example 2.3.1. The topology generated by the half-open intervals is
strictly finer than the euclidean topology: every euclidean open set is open in it, but `[0, 1)` is not
euclidean open. -/
@[kb "morris2024" "Example 2.3.1, p. 63"]
theorem morris_ex_2_3_1_b :
    (∀ s : Set ℝ, IsOpen s → IsOpen[generateFrom halfOpenIntervals] s) ∧
    ¬ (∀ s : Set ℝ, IsOpen[generateFrom halfOpenIntervals] s → IsOpen s) := by
  constructor
  · intro s hs
    rw [@isOpen_iff_forall_mem_open ℝ (generateFrom halfOpenIntervals)]
    intro x hx
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hs x hx
    refine ⟨Ico x (x + ε), ?_, isOpen_generateFrom_of_mem ⟨x, x + ε, by linarith, rfl⟩,
      ⟨le_rfl, by linarith⟩⟩
    intro y hy
    apply hball
    rw [mem_ball, Real.dist_eq, abs_lt]
    constructor <;> linarith [hy.1, hy.2]
  · intro h
    have hopen : IsOpen (Ico (0 : ℝ) 1) :=
      h _ (isOpen_generateFrom_of_mem ⟨0, 1, one_pos, rfl⟩)
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hopen 0 ⟨le_rfl, one_pos⟩
    have : -(ε / 2) ∈ ball (0 : ℝ) ε := by
      rw [mem_ball, Real.dist_eq, abs_lt]
      constructor <;> linarith
    have := (hball this).1
    linarith

/-- Morris, Topology Without Tears, Example 3.1.3. A discrete space has no limit points: the set of limit
points of any subset is empty. -/
@[kb "morris2024" "Example 3.1.3, p. 75"]
theorem morris_ex_3_1_3 {X : Type*} [TopologicalSpace X] [DiscreteTopology X] (A : Set X) :
    derivedSet A = ∅ := by
  ext x
  simp only [mem_derivedSet, accPt_iff_nhds, mem_empty_iff_false, iff_false, not_forall]
  exact ⟨{x}, (isOpen_discrete _).mem_nhds rfl, fun ⟨y, hy, hne⟩ => hne hy.1⟩

/-- Morris, Topology Without Tears, Example 3.1.4. Every point of `[a, b)` is a limit point of `[a, b)`,
and so is `b`. -/
@[kb "morris2024" "Example 3.1.4, p. 75"]
theorem morris_ex_3_1_4 {a b : ℝ} (h : a < b) : Icc a b ⊆ derivedSet (Ico a b) := by
  intro x hx
  rw [mem_derivedSet, accPt_principal_iff_nhdsWithin]
  rcases hx.2.lt_or_eq with hlt | heq
  · have : NeBot (𝓝[Ioo x b] x) := by
      rw [nhdsWithin_Ioo_eq_nhdsGT hlt]; infer_instance
    exact this.mono (nhdsWithin_mono _ fun y hy => ⟨⟨hx.1.trans hy.1.le, hy.2⟩, hy.1.ne'⟩)
  · have hb : b = x := heq.symm
    subst hb
    have : NeBot (𝓝[Ioo a b] b) := by
      rw [nhdsWithin_Ioo_eq_nhdsLT h]; infer_instance
    exact this.mono (nhdsWithin_mono _ fun y hy => ⟨⟨hy.1.le, hy.2⟩, hy.2.ne⟩)

/-- Morris, Topology Without Tears, Example 3.1.5. In an indiscrete space every point is a limit point of a
subset with at least two points. -/
@[kb "morris2024" "Example 3.1.5, p. 75"]
theorem morris_ex_3_1_5 {X : Type*} [TopologicalSpace X] [IndiscreteTopology X] (A : Set X)
    {a b : X} (ha : a ∈ A) (hb : b ∈ A) (hab : a ≠ b) : derivedSet A = univ := by
  refine eq_univ_of_forall fun x => ?_
  rw [mem_derivedSet, accPt_iff_nhds]
  intro U hU
  rw [IndiscreteTopology.nhds_eq] at hU
  have hU' : U = univ := by simpa using hU
  subst hU'
  by_cases hx : x = a
  · exact ⟨b, ⟨mem_univ _, hb⟩, fun h => hab (hx.symm.trans h.symm)⟩
  · exact ⟨a, ⟨mem_univ _, ha⟩, fun h => hx h.symm⟩

/-- Morris, Topology Without Tears, Example 3.1.14. In a discrete space the only dense subset is the whole
space. -/
@[kb "morris2024" "Example 3.1.14, p. 79"]
theorem morris_ex_3_1_14 {X : Type*} [TopologicalSpace X] [DiscreteTopology X] (A : Set X) :
    Dense A ↔ A = univ := by
  rw [dense_iff_closure_eq, (isClosed_discrete A).closure_eq]

/-- Morris, Topology Without Tears, Example 4.3.1. The interval `[0, 2]` is not homeomorphic to the
subspace `[0, 1] ∪ [2, 3]` of `ℝ`. -/
@[kb "morris2024" "Example 4.3.1, p. 102"]
theorem morris_ex_4_3_1 : IsEmpty (Icc (0 : ℝ) 2 ≃ₜ (Icc (0 : ℝ) 1 ∪ Icc 2 3 : Set ℝ)) := by
  refine ⟨fun e => ?_⟩
  have h1 : PreconnectedSpace (Icc (0 : ℝ) 2) := Subtype.preconnectedSpace isPreconnected_Icc
  have h2 : PreconnectedSpace (Icc (0 : ℝ) 1 ∪ Icc 2 3 : Set ℝ) := by
    rw [preconnectedSpace_iff_univ]
    have hcont : ContinuousOn (e : Icc (0 : ℝ) 2 → (Icc (0 : ℝ) 1 ∪ Icc 2 3 : Set ℝ)) univ :=
      e.continuous.continuousOn
    have := IsPreconnected.image (isPreconnected_univ (α := Icc (0 : ℝ) 2)) _ hcont
    rwa [image_univ, e.surjective.range_eq] at this
  have h3 : IsPreconnected (Icc (0 : ℝ) 1 ∪ Icc 2 3) := isPreconnected_iff_preconnectedSpace.2 h2
  have h4 := h3.ordConnected
  have h5 : Icc (1 : ℝ) 2 ⊆ Icc (0 : ℝ) 1 ∪ Icc 2 3 :=
    h4.out (Or.inl ⟨zero_le_one, le_rfl⟩) (Or.inr ⟨le_rfl, by norm_num⟩)
  have := h5 (show (3 / 2 : ℝ) ∈ Icc (1 : ℝ) 2 from ⟨by norm_num, by norm_num⟩)
  rcases this with h | h <;> norm_num [mem_Icc] at h

/-- Morris, Topology Without Tears, Example 5.1.6. The step-like function equal to `x - 1` for `x ≤ 3` and
`(x + 5) / 2` for `x > 3` is not continuous. -/
@[kb "morris2024" "Example 5.1.6, p. 113"]
theorem morris_ex_5_1_6 : ¬ Continuous (fun x : ℝ => if x ≤ 3 then x - 1 else (x + 5) / 2) := by
  intro hc
  have h1 : Tendsto (fun x : ℝ => (x + 5) / 2) (𝓝[>] 3) (𝓝 4) := by
    have : Tendsto (fun x : ℝ => (x + 5) / 2) (𝓝 3) (𝓝 ((3 + 5) / 2)) :=
      ((continuous_id.add continuous_const).div_const 2).tendsto 3
    norm_num at this
    exact this.mono_left nhdsWithin_le_nhds
  have h2 : Tendsto (fun x : ℝ => if x ≤ 3 then x - 1 else (x + 5) / 2) (𝓝[>] 3) (𝓝 4) :=
    h1.congr' (eventually_nhdsWithin_of_forall fun x hx => by
      simp [not_le.2 (show (3 : ℝ) < x from hx)])
  have h3 : Tendsto (fun x : ℝ => if x ≤ 3 then x - 1 else (x + 5) / 2) (𝓝[>] 3) (𝓝 2) := by
    have := (hc.continuousAt (x := 3)).tendsto.mono_left (nhdsWithin_le_nhds (s := Ioi (3 : ℝ)))
    have e2 : (if (3 : ℝ) ≤ 3 then (3 : ℝ) - 1 else (3 + 5) / 2) = 2 := by norm_num
    simpa only [e2] using this
  have := tendsto_nhds_unique h2 h3
  norm_num at this

/-- Morris, Topology Without Tears, Example 6.3.3. The sequence `1/10, 1/100, ...` is a Cauchy sequence in
the open interval `(0, 1)` that has no limit in `(0, 1)`. -/
@[kb "morris2024" "Example 6.3.3, p. 150"]
theorem morris_ex_6_3_3 :
    ∃ u : ℕ → Ioo (0 : ℝ) 1, CauchySeq u ∧ ¬ ∃ l, Tendsto u atTop (𝓝 l) := by
  have hpos : ∀ n : ℕ, (0 : ℝ) < (1 / 10) ^ (n + 1) := fun n => by positivity
  have hlt : ∀ n : ℕ, (1 / 10 : ℝ) ^ (n + 1) < 1 := fun n =>
    pow_lt_one₀ (by norm_num) (by norm_num) (Nat.succ_ne_zero n)
  have hlim : Tendsto (fun n : ℕ => (1 / 10 : ℝ) ^ (n + 1)) atTop (𝓝 0) :=
    (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)).comp (tendsto_add_atTop_nat 1)
  refine ⟨fun n => ⟨(1 / 10) ^ (n + 1), hpos n, hlt n⟩, ?_, ?_⟩
  · rw [Metric.cauchySeq_iff']
    intro ε hε
    exact Metric.cauchySeq_iff'.1 hlim.cauchySeq ε hε
  · rintro ⟨l, hl⟩
    rw [tendsto_subtype_rng] at hl
    have := tendsto_nhds_unique hl hlim
    have := l.2.1
    simp_all

/-- Morris, Topology Without Tears, Remark 6.3.14. Completeness is not a topological property: `ℝ` is
complete and homeomorphic to the bounded interval `(-1, 1)`, which is not complete. -/
@[kb "morris2024" "Remark 6.3.14, p. 154"]
theorem morris_rem_6_3_14 :
    Nonempty (Ioo (-1 : ℝ) 1 ≃ₜ ℝ) ∧ CompleteSpace ℝ ∧ ¬ CompleteSpace (Ioo (-1 : ℝ) 1) := by
  refine ⟨⟨(orderIsoIooNegOneOne ℝ).symm.toHomeomorph⟩, inferInstance, fun h => ?_⟩
  have hc : IsClosed (Ioo (-1 : ℝ) 1) := (completeSpace_coe_iff_isComplete.1 h).isClosed
  have h0 : (-1 : ℝ) ∈ closure (Ioo (-1 : ℝ) 1) := by
    rw [closure_Ioo (by norm_num)]; exact ⟨le_rfl, by norm_num⟩
  rw [hc.closure_eq] at h0
  exact lt_irrefl _ h0.1

/-- Morris, Topology Without Tears, Example 6.3.26. The sequence spaces `ℓ¹`, `ℓ²` and `ℓ^∞` of real
sequences are complete (Banach spaces). -/
@[kb "morris2024" "Example 6.3.26, p. 160"]
theorem morris_ex_6_3_26 :
    CompleteSpace (lp (fun _ : ℕ => ℝ) 1) ∧ CompleteSpace (lp (fun _ : ℕ => ℝ) 2) ∧
      CompleteSpace (lp (fun _ : ℕ => ℝ) ⊤) :=
  ⟨inferInstance, inferInstance, inferInstance⟩

/-- Morris, Topology Without Tears, Remark 6.5.13. The rationals form a first category (meagre) subset of
`ℝ`, whereas the set of irrationals is not meagre, i.e. is of second category. -/
@[kb "morris2024" "Remark 6.5.13, p. 168"]
theorem morris_rem_6_5_13 :
    IsMeagre (range ((↑) : ℚ → ℝ)) ∧ ¬ IsMeagre {x : ℝ | Irrational x} := by
  refine ⟨?_, not_isMeagre_of_isGδ_of_dense IsGδ.setOfPred_irrational dense_irrational⟩
  have : range ((↑) : ℚ → ℝ) = ⋃ q : ℚ, {(q : ℝ)} := by ext; simp
  rw [this]
  refine isMeagre_iUnion fun q => IsNowhereDense.isMeagre ?_
  rw [isClosed_singleton.isNowhereDense_iff]
  simp

/-- Morris, Topology Without Tears, Example 7.1.2. The set `(0, ∞)` is not compact in `ℝ`. -/
@[kb "morris2024" "Example 7.1.2, p. 177"]
theorem morris_ex_7_1_2 : ¬ IsCompact (Ioi (0 : ℝ)) := by
  intro h
  have h0 : (0 : ℝ) ∈ closure (Ioi (0 : ℝ)) := by
    rw [closure_Ioi (0 : ℝ)]; exact Set.mem_Ici.2 le_rfl
  rw [h.isClosed.closure_eq] at h0
  exact absurd (mem_Ioi.1 h0) (lt_irrefl _)

/-- Morris, Topology Without Tears, Example 8.2.2. On any set the discrete topology is the finest and the
indiscrete topology the coarsest: every topology lies between them, every set is open in the first, and
only `∅` and the whole set are open in the second. -/
@[kb "morris2024" "Example 8.2.2, p. 199"]
theorem morris_ex_8_2_2 (X : Type*) :
    (∀ s : Set X, IsOpen[(⊥ : TopologicalSpace X)] s) ∧
    (∀ s : Set X, IsOpen[(⊤ : TopologicalSpace X)] s ↔ s = ∅ ∨ s = univ) ∧
    ∀ t : TopologicalSpace X, (⊥ : TopologicalSpace X) ≤ t ∧ t ≤ ⊤ :=
  ⟨fun _ => trivial, TopologicalSpace.isOpen_top_iff,
    fun _ => ⟨bot_le, le_top⟩⟩

/-- Morris, Topology Without Tears, Example 2.2.4. The singletons form a basis of a discrete space. -/
@[kb "morris2024" "Example 2.2.4, p. 57"]
theorem morris_ex_2_2_4 (X : Type*) [TopologicalSpace X] [DiscreteTopology X] :
    IsTopologicalBasis {s : Set X | ∃ x, s = {x}} :=
  isTopologicalBasis_singletons X

/-- Morris, Topology Without Tears, Example 9.4.2. The rationals are dense in `ℝ`. -/
@[kb "morris2024" "Example 9.4.2, p. 237"]
theorem morris_ex_9_4_2 : Dense (range ((↑) : ℚ → ℝ)) :=
  Rat.denseRange_cast

/-- Morris, Topology Without Tears, Example 9.4.3. Every countable topological space is separable. -/
@[kb "morris2024" "Example 9.4.3, p. 237"]
theorem morris_ex_9_4_3 (X : Type*) [TopologicalSpace X] [Countable X] : SeparableSpace X :=
  inferInstance

/-- Morris, Topology Without Tears, Remark 9.4.9. Every Hausdorff space is a T1 space. -/
@[kb "morris2024" "Remark 9.4.9, p. 240"]
theorem morris_rem_9_4_9 (X : Type*) [TopologicalSpace X] [T2Space X] : T1Space X :=
  inferInstance

/-- Morris, Topology Without Tears, Example 9.4.15. The open intervals with rational endpoints form a
countable basis of the euclidean topology on `ℝ`, which is therefore second countable. -/
@[kb "morris2024" "Example 9.4.15, p. 242"]
theorem morris_ex_9_4_15 :
    IsTopologicalBasis {s : Set ℝ | ∃ a b : ℚ, a < b ∧ s = Ioo (a : ℝ) b} ∧
      SecondCountableTopology ℝ := by
  refine ⟨?_, inferInstance⟩
  convert Real.isTopologicalBasis_Ioo_rat using 1
  ext s
  simp only [mem_iUnion, mem_singleton_iff, mem_ofPred_eq, exists_prop]

/-- Morris, Topology Without Tears, Example 9.4.16. An uncountable discrete space is not second
countable. -/
@[kb "morris2024" "Example 9.4.16, p. 242"]
theorem morris_ex_9_4_16 (X : Type*) [TopologicalSpace X] [DiscreteTopology X] [Uncountable X] :
    ¬ SecondCountableTopology X := by
  intro h
  obtain ⟨s, hs, hd⟩ := exists_countable_dense X
  rw [morris_ex_3_1_14] at hd
  subst hd
  exact not_countable (countable_univ_iff.1 hs)

/-- Morris, Topology Without Tears, Remark 9.6.6. An open ball in a real normed space is homeomorphic to
the whole space. -/
@[kb "morris2024" "Remark 9.6.6, p. 257"]
theorem morris_rem_9_6_6 {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (c : E) {r : ℝ}
    (hr : 0 < r) : Nonempty (E ≃ₜ ball c r) :=
  ⟨((Homeomorph.Set.univ E).symm.trans
      (Homeomorph.setCongr (OpenPartialHomeomorph.univBall_source c r).symm)).trans
    ((OpenPartialHomeomorph.univBall c r).toHomeomorphSourceTarget.trans
      (Homeomorph.setCongr (OpenPartialHomeomorph.univBall_target c hr)))⟩

/-- Morris, Topology Without Tears, Example 9.2.3. The box topology on the countable product `ℝ^ω` (basic
sets: products of open sets with no restriction on the coordinates) is not compact. -/
@[kb "morris2024" "Example 9.2.3, p. 226"]
theorem morris_ex_9_2_3 :
    ¬ @CompactSpace (ℕ → ℝ)
      (generateFrom {s | ∃ U : ℕ → Set ℝ, (∀ i, IsOpen (U i)) ∧ s = Set.pi univ U}) := by
  intro hc
  letI : TopologicalSpace (ℕ → ℝ) :=
    generateFrom {s | ∃ U : ℕ → Set ℝ, (∀ i, IsOpen (U i)) ∧ s = Set.pi univ U}
  have hopen : ∀ z : ℕ → ℤ, IsOpen (Set.pi univ fun i => Ioo ((z i : ℝ) - 1) (z i + 1)) :=
    fun z => isOpen_generateFrom_of_mem ⟨_, fun i => isOpen_Ioo, rfl⟩
  have hcover : (univ : Set (ℕ → ℝ)) ⊆
      ⋃ z : ℕ → ℤ, Set.pi univ fun i => Ioo ((z i : ℝ) - 1) (z i + 1) := by
    intro x _
    refine mem_iUnion.2 ⟨fun i => ⌊x i⌋, fun i _ => ⟨?_, ?_⟩⟩
    · linarith [Int.floor_le (x i)]
    · linarith [Int.lt_floor_add_one (x i)]
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover _ hopen hcover
  obtain ⟨g, hg⟩ := Infinite.exists_notMem_finset t
  have := ht (mem_univ (fun i => (g i : ℝ)))
  simp only [mem_iUnion] at this
  obtain ⟨z, hz, hmem⟩ := this
  apply hg
  have : g = z := by
    funext i
    have h := hmem i (mem_univ i)
    rcases h with ⟨h1, h2⟩
    have a : (z i : ℝ) - 1 < g i := h1
    have b : (g i : ℝ) < z i + 1 := h2
    have a' : z i - 1 < g i := by exact_mod_cast a
    have b' : g i < z i + 1 := by exact_mod_cast b
    omega
  rwa [this]

/-- Morris, Topology Without Tears, Example 11.1.11. The circle (the quotient `ℝ/ℤ`) is a quotient space of
the interval `[0, 1]`. -/
@[kb "morris2024" "Example 11.1.11, p. 342"]
theorem morris_ex_11_1_11 :
    IsQuotientMap (fun t : Icc (0 : ℝ) 1 => ((t : ℝ) : AddCircle (1 : ℝ))) := by
  have : Fact ((0 : ℝ) < 1) := ⟨one_pos⟩
  have hcont : Continuous (fun t : Icc (0 : ℝ) 1 => ((t : ℝ) : AddCircle (1 : ℝ))) :=
    (AddCircle.continuous_mk' 1).comp continuous_subtype_val
  have hsurj : Function.Surjective (fun t : Icc (0 : ℝ) 1 => ((t : ℝ) : AddCircle (1 : ℝ))) := by
    intro y
    obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective y
    refine ⟨⟨Int.fract x, Int.fract_nonneg x, (Int.fract_lt_one x).le⟩, ?_⟩
    have h0 : ((⌊x⌋ : ℝ) : AddCircle (1 : ℝ)) = 0 := (AddCircle.coe_eq_zero_iff 1).2 ⟨⌊x⌋, by simp⟩
    show ((Int.fract x : ℝ) : AddCircle (1 : ℝ)) = (x : AddCircle (1 : ℝ))
    rw [Int.fract, AddCircle.coe_sub, h0, sub_zero]
  exact (hcont.isClosedMap).isQuotientMap hcont hsurj

end Examples

