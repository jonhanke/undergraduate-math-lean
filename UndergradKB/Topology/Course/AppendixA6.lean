import Mathlib.Order.Filter.Ultrafilter.Basic
import Mathlib.Order.Filter.Ultrafilter.Cardinality
import Mathlib.Order.Filter.AtTopBot.Basic
import Mathlib.Order.Filter.Cofinite
import Mathlib.Topology.Ultrafilter
import Mathlib.Topology.ClusterPt
import Mathlib.Topology.Separation.Hausdorff
import Mathlib.Topology.Compactness.Compact
import Mathlib.Topology.Constructions
import Mathlib.Topology.ContinuousOn
import UndergradKB.Common.Attr

/-!
# Course layer: Morris, Appendix 6 (filters and nets)

Thin wrappers of Mathlib results in the terms of Morris, *Topology Without Tears*.
Mathlib orders filters by `F ≤ G` iff `F` is finer than `G` (every set of `G` lies in `F`).
-/

open Set Filter
open scoped Topology

namespace UndergradKB.Topology.Course

/-- Morris, Topology Without Tears, Definition A6.1.1 (TP-642). A filter is closed under finite
intersections and supersets, and is proper iff it does not contain the empty set. -/
@[kb "morris2024" "Definition A6.1.1, p. 621"]
theorem morris_A6_1_1 {X : Type*} (F : Filter X) :
    (∀ s t, s ∈ F → t ∈ F → s ∩ t ∈ F) ∧ (∀ s t, s ∈ F → s ⊆ t → t ∈ F) ∧
      (F.NeBot ↔ ∅ ∉ F) :=
  ⟨fun _ _ hs ht => inter_mem hs ht, fun _ _ hs hst => mem_of_superset hs hst,
    by rw [neBot_iff, ne_eq, ← empty_mem_iff_bot]⟩

/-- Morris, Topology Without Tears, Remark A6.1.2 (TP-643). The intersection of all members of a
filter is its kernel; the filter is free when this intersection is empty. -/
@[kb "morris2024" "Remark A6.1.2, p. 622"]
theorem morris_A6_1_2 {X : Type*} (F : Filter X) : ⋂₀ F.sets = F.ker :=
  rfl

/-- Morris, Topology Without Tears, Example A6.1.3 (TP-644). Principal, cofinite, neighbourhood
and image filters have the expected membership description. -/
@[kb "morris2024" "Example A6.1.3, p. 622"]
theorem morris_A6_1_3 {X Y : Type*} [TopologicalSpace X] (S : Set X) (x : X) (s : Set X)
    (f : X → Y) (F : Filter X) (u : Set Y) :
    (s ∈ (𝓟 S : Filter X) ↔ S ⊆ s) ∧ (s ∈ (cofinite : Filter X) ↔ sᶜ.Finite) ∧
      (s ∈ 𝓝 x ↔ ∃ U, U ⊆ s ∧ IsOpen U ∧ x ∈ U) ∧ (u ∈ Filter.map f F ↔ f ⁻¹' u ∈ F) :=
  ⟨mem_principal, mem_cofinite, mem_nhds_iff.trans (by grind), Iff.rfl⟩

/-- Morris, Topology Without Tears, Example A6.1.3 (TP-644). The cofinite (Fréchet) filter of an
infinite set is a proper filter. -/
@[kb "morris2024" "Example A6.1.3, p. 622"]
theorem morris_A6_1_3_cofinite (X : Type*) [Infinite X] : (cofinite : Filter X).NeBot :=
  inferInstance

/-- Morris, Topology Without Tears, Proposition A6.1.4 (TP-645). A family of sets lies in a proper
filter iff it has the finite intersection property. -/
@[kb "morris2024" "Proposition A6.1.4, p. 623"]
theorem morris_A6_1_4 {X : Type*} (S : Set (Set X)) :
    (∃ F : Filter X, F.NeBot ∧ S ⊆ F.sets) ↔ ∀ T ⊆ S, T.Finite → (⋂₀ T).Nonempty := by
  constructor
  · rintro ⟨F, hF, hS⟩ T hT hfin
    exact nonempty_of_mem (sInter_mem hfin |>.2 fun t ht => hS (hT ht))
  · intro h
    exact ⟨generate S, generate_neBot_iff.2 h, fun s hs => GenerateSets.basic hs⟩

/-- Morris, Topology Without Tears, Definition A6.1.5 (TP-646). The filter generated by a family
consists of the supersets of finite intersections of members. -/
@[kb "morris2024" "Definition A6.1.5, p. 623"]
theorem morris_A6_1_5 {X : Type*} (S : Set (Set X)) (s : Set X) :
    s ∈ generate S ↔ ∃ T ⊆ S, T.Finite ∧ ⋂₀ T ⊆ s :=
  mem_generate_iff

/-- Morris, Topology Without Tears, Remark A6.1.7 (TP-646). The generated filter is the coarsest
filter containing the family. -/
@[kb "morris2024" "Remark A6.1.7, p. 624"]
theorem morris_A6_1_7 {X : Type*} (S : Set (Set X)) (F : Filter X) :
    F ≤ generate S ↔ S ⊆ F.sets :=
  le_generate_iff

/-- Morris, Topology Without Tears, Definition A6.1.6 (TP-647). A filter `F₁` is finer than `F₂`
when every member of `F₂` is a member of `F₁`. -/
@[kb "morris2024" "Definition A6.1.6, p. 623"]
theorem morris_A6_1_6 {X : Type*} (F₁ F₂ : Filter X) : F₁ ≤ F₂ ↔ ∀ s ∈ F₂, s ∈ F₁ :=
  Iff.rfl

/-- Morris, Topology Without Tears, Definition A6.1.8 (TP-648). An ultrafilter is a proper filter
with no strictly finer proper filter. -/
@[kb "morris2024" "Definition A6.1.8, p. 624"]
theorem morris_A6_1_8 {X : Type*} (F : Filter X) :
    (∃ U : Ultrafilter X, (U : Filter X) = F) ↔
      F.NeBot ∧ ∀ G : Filter X, G.NeBot → G ≤ F → G = F := by
  constructor
  · rintro ⟨U, rfl⟩
    exact ⟨U.neBot, fun G hG hle => U.unique hle⟩
  · rintro ⟨hF, h⟩
    exact ⟨⟨F, hF, fun G hG hle => (h G hG hle).ge⟩, rfl⟩

/-- Morris, Topology Without Tears, Remark A6.1.9 (TP-649). The sets containing a given point form
an ultrafilter. -/
@[kb "morris2024" "Remark A6.1.9, p. 624"]
theorem morris_A6_1_9 {X : Type*} (x : X) (s : Set X) :
    s ∈ (pure x : Ultrafilter X) ↔ x ∈ s :=
  Iff.rfl

/-- Morris, Topology Without Tears, Proposition A6.1.10 (TP-650). Ultrafilter lemma: every proper
filter is contained in an ultrafilter. -/
@[kb "morris2024" "Proposition A6.1.10, p. 625"]
theorem morris_A6_1_10 {X : Type*} (F : Filter X) [F.NeBot] :
    ∃ U : Ultrafilter X, (U : Filter X) ≤ F :=
  Ultrafilter.exists_le F

/-- Morris, Topology Without Tears, Remark A6.1.11 (TP-651). On an infinite set there is a free
ultrafilter, one containing all cofinite sets and no finite set. -/
@[kb "morris2024" "Remark A6.1.11, p. 625"]
theorem morris_A6_1_11 (X : Type*) [Infinite X] :
    ∃ U : Ultrafilter X, (U : Filter X) ≤ cofinite ∧ ∀ x, U ≠ pure x := by
  refine ⟨hyperfilter X, hyperfilter_le_cofinite, fun x h => ?_⟩
  have h1 : ({x} : Set X)ᶜ ∈ hyperfilter X :=
    hyperfilter_le_cofinite (mem_cofinite.2 (by simp))
  have h2 : ({x} : Set X) ∈ hyperfilter X := by
    rw [h]
    exact rfl
  exact (Ultrafilter.compl_mem_iff_notMem.1 h1) h2

/-- Morris, Topology Without Tears, Corollary A6.1.12 (TP-652). A family with the finite
intersection property lies in an ultrafilter. -/
@[kb "morris2024" "Corollary A6.1.12, p. 626"]
theorem morris_A6_1_12 {X : Type*} (S : Set (Set X))
    (h : ∀ T : Finset (Set X), (T : Set (Set X)) ⊆ S → (⋂₀ (T : Set (Set X))).Nonempty) :
    ∃ U : Ultrafilter X, S ⊆ U.sets :=
  Ultrafilter.exists_ultrafilter_of_finite_inter_nonempty S h

/-- Morris, Topology Without Tears, Corollary A6.1.13 (TP-653). If a union lies in an ultrafilter
then one of the pieces does; in particular a set or its complement does. -/
@[kb "morris2024" "Corollary A6.1.13, p. 626"]
theorem morris_A6_1_13 {X : Type*} (U : Ultrafilter X) (A B : Set X) :
    (A ∪ B ∈ U → A ∈ U ∨ B ∈ U) ∧ (A ∈ U ∨ Aᶜ ∈ U) :=
  ⟨Ultrafilter.union_mem_iff.1, by
    by_cases h : A ∈ U
    · exact Or.inl h
    · exact Or.inr (Ultrafilter.compl_mem_iff_notMem.2 h)⟩

/-- Morris, Topology Without Tears, Proposition A6.1.14 (TP-654). A proper filter is an
ultrafilter iff for every set it contains the set or its complement. -/
@[kb "morris2024" "Proposition A6.1.14, p. 626"]
theorem morris_A6_1_14 {X : Type*} (F : Filter X) :
    (∃ U : Ultrafilter X, (U : Filter X) = F) ↔ F.NeBot ∧ ∀ A : Set X, A ∈ F ∨ Aᶜ ∈ F := by
  constructor
  · rintro ⟨U, rfl⟩
    refine ⟨U.neBot, fun A => ?_⟩
    by_cases h : A ∈ U
    · exact Or.inl h
    · exact Or.inr (Ultrafilter.compl_mem_iff_notMem.2 h)
  · rintro ⟨hF, h⟩
    refine ⟨Ultrafilter.ofComplNotMemIff F fun s => ⟨fun hs => ?_, fun hs => ?_⟩, rfl⟩
    · exact (h s).resolve_right hs
    · exact Filter.compl_notMem hs

/-- Morris, Topology Without Tears, Corollary A6.1.16 (TP-656). The image of an ultrafilter under
a map is an ultrafilter. -/
@[kb "morris2024" "Corollary A6.1.16, p. 627"]
theorem morris_A6_1_16 {X Y : Type*} (f : X → Y) (U : Ultrafilter X) :
    ∃ V : Ultrafilter Y, (V : Filter Y) = Filter.map f U :=
  ⟨U.map f, Ultrafilter.coe_map f U⟩

/-- Morris, Topology Without Tears, Definition A6.1.19 (TP-658). A filter converges to `x` iff it
contains every neighbourhood of `x`, iff it is finer than the neighbourhood filter; the
neighbourhood filter converges to `x`. -/
@[kb "morris2024" "Definition A6.1.19, p. 629"]
theorem morris_A6_1_19 {X : Type*} [TopologicalSpace X] (F : Filter X) (x : X) :
    (F ≤ 𝓝 x ↔ ∀ U ∈ 𝓝 x, U ∈ F) ∧ (𝓝 x ≤ 𝓝 x) :=
  ⟨Iff.rfl, le_rfl⟩

/-- Morris, Topology Without Tears, Proposition A6.1.22 (TP-659). A space is Hausdorff iff a
(proper) filter converges to at most one point. -/
@[kb "morris2024" "Proposition A6.1.22, p. 629"]
theorem morris_A6_1_22_a {X : Type*} [TopologicalSpace X] :
    T2Space X ↔ ∀ (x y : X) (F : Filter X), F.NeBot → F ≤ 𝓝 x → F ≤ 𝓝 y → x = y :=
  ⟨fun h _ _ _ hF h1 h2 => t2_iff_nhds.1 h (hF.mono (le_inf h1 h2)),
    fun h => t2_iff_nhds.2 fun hne => h _ _ _ hne inf_le_left inf_le_right⟩

/-- Morris, Topology Without Tears, Proposition A6.1.22 (TP-659). A space is Hausdorff iff an
ultrafilter converges to at most one point. -/
@[kb "morris2024" "Proposition A6.1.22, p. 629"]
theorem morris_A6_1_22_b {X : Type*} [TopologicalSpace X] :
    T2Space X ↔ ∀ (x y : X) (U : Ultrafilter X), (U : Filter X) ≤ 𝓝 x → (U : Filter X) ≤ 𝓝 y →
      x = y :=
  t2_iff_ultrafilter

/-- Morris, Topology Without Tears, Corollary A6.1.24 (TP-661). A space is compact iff every
ultrafilter converges. -/
@[kb "morris2024" "Corollary A6.1.24, p. 631"]
theorem morris_A6_1_24 {X : Type*} [TopologicalSpace X] :
    CompactSpace X ↔ ∀ U : Ultrafilter X, ∃ x, (U : Filter X) ≤ 𝓝 x := by
  rw [← isCompact_univ_iff, isCompact_iff_ultrafilter_le_nhds]
  simp

/-- Morris, Topology Without Tears, Theorem A6.1.25 (TP-662). Tychonoff: a product of compact
spaces is compact. -/
@[kb "morris2024" "Theorem A6.1.25, p. 632"]
theorem morris_A6_1_25_a {ι : Type*} {X : ι → Type*} [∀ i, TopologicalSpace (X i)]
    (h : ∀ i, CompactSpace (X i)) : CompactSpace (∀ i, X i) :=
  inferInstance

/-- Morris, Topology Without Tears, Theorem A6.1.25 (TP-662). If a product of nonempty spaces is
compact, so is each factor. -/
@[kb "morris2024" "Theorem A6.1.25, p. 632"]
theorem morris_A6_1_25_b {ι : Type*} {X : ι → Type*} [∀ i, TopologicalSpace (X i)]
    [∀ i, Nonempty (X i)] (h : CompactSpace (∀ i, X i)) (i : ι) : CompactSpace (X i) := by
  classical
  have hs : Function.Surjective (fun f : ∀ j, X j => f i) := fun y =>
    ⟨Function.update (fun j => Classical.arbitrary (X j)) i y, by simp⟩
  have := isCompact_range (continuous_apply i : Continuous fun f : (∀ j, X j) => f i)
  rw [hs.range_eq] at this
  exact ⟨this⟩

/-- Morris, Topology Without Tears, Proposition A6.1.27 (TP-663). Continuity of a map in terms of
neighbourhoods, filters, convergent filters and convergent ultrafilters. -/
@[kb "morris2024" "Proposition A6.1.27, p. 635"]
theorem morris_A6_1_27 {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y) :
    (Continuous f ↔ ∀ x, ∀ V ∈ 𝓝 (f x), f ⁻¹' V ∈ 𝓝 x) ∧
      (Continuous f ↔ ∀ x, Filter.map f (𝓝 x) ≤ 𝓝 (f x)) ∧
      (Continuous f ↔ ∀ x (F : Filter X), F ≤ 𝓝 x → Filter.map f F ≤ 𝓝 (f x)) ∧
      (Continuous f ↔ ∀ x (U : Ultrafilter X), (U : Filter X) ≤ 𝓝 x →
        (U.map f : Filter Y) ≤ 𝓝 (f x)) := by
  refine ⟨continuous_iff_continuousAt, continuous_iff_continuousAt, ?_, ?_⟩
  · refine ⟨fun h x F hF => (h.continuousAt (x := x)).tendsto.mono_left hF, fun h => ?_⟩
    exact continuous_iff_continuousAt.2 fun x => h x _ le_rfl
  · exact continuous_iff_ultrafilter

/-- Morris, Topology Without Tears, Proposition A6.1.28 (TP-664). A set is open iff it belongs to
the neighbourhood filter of each of its points. -/
@[kb "morris2024" "Proposition A6.1.28, p. 636"]
theorem morris_A6_1_28_a {X : Type*} [TopologicalSpace X] (s : Set X) :
    IsOpen s ↔ ∀ x ∈ s, s ∈ 𝓝 x :=
  isOpen_iff_mem_nhds

/-- Morris, Topology Without Tears, Proposition A6.1.28 (TP-664). A set is open iff it belongs to
every filter converging to a point of it. -/
@[kb "morris2024" "Proposition A6.1.28, p. 636"]
theorem morris_A6_1_28_b {X : Type*} [TopologicalSpace X] (s : Set X) :
    IsOpen s ↔ ∀ x ∈ s, ∀ F : Filter X, F ≤ 𝓝 x → s ∈ F :=
  ⟨fun h x hx F hF => hF (isOpen_iff_mem_nhds.1 h x hx),
    fun h => isOpen_iff_mem_nhds.2 fun x hx => h x hx _ le_rfl⟩

/-- Morris, Topology Without Tears, Proposition A6.1.28 (TP-664). A set is open iff it belongs to
every ultrafilter converging to a point of it. -/
@[kb "morris2024" "Proposition A6.1.28, p. 636"]
theorem morris_A6_1_28_c {X : Type*} [TopologicalSpace X] (s : Set X) :
    IsOpen s ↔ ∀ x ∈ s, ∀ U : Ultrafilter X, (U : Filter X) ≤ 𝓝 x → s ∈ U :=
  isOpen_iff_ultrafilter

/-- Morris, Topology Without Tears, Corollary A6.1.29 (TP-665). A set is closed iff for each point
outside it, the complement belongs to every filter converging to that point. -/
@[kb "morris2024" "Corollary A6.1.29, p. 636"]
theorem morris_A6_1_29_a {X : Type*} [TopologicalSpace X] (s : Set X) :
    IsClosed s ↔ ∀ x ∉ s, ∀ F : Filter X, F ≤ 𝓝 x → sᶜ ∈ F := by
  rw [← isOpen_compl_iff, morris_A6_1_28_b]
  rfl

/-- Morris, Topology Without Tears, Corollary A6.1.29 (TP-665). A set is closed iff it contains
every limit of an ultrafilter containing it. -/
@[kb "morris2024" "Corollary A6.1.29, p. 636"]
theorem morris_A6_1_29_b {X : Type*} [TopologicalSpace X] (s : Set X) :
    IsClosed s ↔ ∀ x (U : Ultrafilter X), (U : Filter X) ≤ 𝓝 x → s ∈ U → x ∈ s :=
  isClosed_iff_ultrafilter

/-- Morris, Topology Without Tears, Definition A6.2.1 (TP-668). A nonempty family of nonempty
sets, any two of which contain a third inside their intersection, generates a proper filter whose
members are the supersets of members of the family. -/
@[kb "morris2024" "Definition A6.2.1, p. 641"]
theorem morris_A6_2_1 {X : Type*} (B : Set (Set X)) (hne : B.Nonempty)
    (hb : ∀ b ∈ B, b.Nonempty) (hdir : ∀ b₁ ∈ B, ∀ b₂ ∈ B, ∃ b₃ ∈ B, b₃ ⊆ b₁ ∩ b₂) :
    ∃ F : Filter X, F.NeBot ∧ ∀ s, s ∈ F ↔ ∃ b ∈ B, b ⊆ s := by
  let FB : FilterBasis X := ⟨B, hne, fun {x y} hx hy => hdir x hx y hy⟩
  have hF : ∀ s, s ∈ FB.filter ↔ ∃ b ∈ B, b ⊆ s := fun s => FilterBasis.mem_filter_iff FB
  refine ⟨FB.filter, ?_, hF⟩
  rw [neBot_iff, ne_eq, ← empty_mem_iff_bot, hF]
  rintro ⟨b, hbB, hsub⟩
  exact (hb b hbB).ne_empty (subset_empty_iff.1 hsub)

/-- Morris, Topology Without Tears, Proposition A6.2.14 (TP-670). A filter with filterbase `B`
converges to `x` iff every neighbourhood of `x` contains a member of `B`. -/
@[kb "morris2024" "Proposition A6.2.14, p. 644"]
theorem morris_A6_2_14 {X : Type*} [TopologicalSpace X] (F : Filter X) (B : Set (Set X))
    (h : F.HasBasis (· ∈ B) id) (x : X) :
    F ≤ 𝓝 x ↔ ∀ U ∈ 𝓝 x, ∃ b ∈ B, b ⊆ U := by
  simp only [Filter.le_def, h.mem_iff, id]

/-- Morris, Topology Without Tears, Proposition A6.2.11 (TP-671). A point is in the closure of `S`
iff some proper filter containing `S` converges to it. -/
@[kb "morris2024" "Proposition A6.2.11, p. 643"]
theorem morris_A6_2_11 {X : Type*} [TopologicalSpace X] (S : Set X) (x : X) :
    x ∈ closure S ↔ ∃ F : Filter X, F.NeBot ∧ S ∈ F ∧ F ≤ 𝓝 x := by
  constructor
  · intro h
    rw [mem_closure_iff_nhdsWithin_neBot] at h
    exact ⟨𝓝[S] x, h, self_mem_nhdsWithin, nhdsWithin_le_nhds⟩
  · rintro ⟨F, hne, hS, hF⟩
    exact mem_closure_iff_clusterPt.2 (hne.mono (le_inf hF (le_principal_iff.2 hS)))

/-- Morris, Topology Without Tears, Corollary A6.2.12 (TP-672). A set is closed iff it contains
every limit of a proper filter containing it. -/
@[kb "morris2024" "Corollary A6.2.12, p. 644"]
theorem morris_A6_2_12 {X : Type*} [TopologicalSpace X] (S : Set X) :
    IsClosed S ↔ ∀ (x : X) (F : Filter X), F.NeBot → S ∈ F → F ≤ 𝓝 x → x ∈ S := by
  constructor
  · intro h x F hne hS hF
    exact h.closure_subset ((morris_A6_2_11 S x).2 ⟨F, hne, hS, hF⟩)
  · intro h
    exact closure_subset_iff_isClosed.1 fun x hx => by
      obtain ⟨F, hne, hS, hF⟩ := (morris_A6_2_11 S x).1 hx
      exact h x F hne hS hF

/-- Morris, Topology Without Tears, Definition A6.2.15 (TP-673). A cluster point of a filter is a
point each neighbourhood of which meets every member of the filter; every limit is a cluster
point. -/
@[kb "morris2024" "Definition A6.2.15, p. 644"]
theorem morris_A6_2_15 {X : Type*} [TopologicalSpace X] (F : Filter X) (x : X) :
    (ClusterPt x F ↔ ∀ U ∈ 𝓝 x, ∀ V ∈ F, (U ∩ V).Nonempty) ∧
      (F.NeBot → F ≤ 𝓝 x → ClusterPt x F) :=
  ⟨clusterPt_iff_nonempty, fun _ h => ClusterPt.of_le_nhds h⟩

/-- Morris, Topology Without Tears, Proposition A6.2.17 (TP-674). A point is a cluster point of a
filter iff some proper filter finer than it converges to the point. -/
@[kb "morris2024" "Proposition A6.2.17, p. 645"]
theorem morris_A6_2_17 {X : Type*} [TopologicalSpace X] (F : Filter X) (x : X) :
    ClusterPt x F ↔ ∃ G : Filter X, G.NeBot ∧ G ≤ F ∧ G ≤ 𝓝 x := by
  constructor
  · intro h
    obtain ⟨u, h1, h2⟩ := clusterPt_iff_ultrafilter.1 h
    exact ⟨u, u.neBot, h1, h2⟩
  · rintro ⟨G, hG, h1, h2⟩
    exact hG.mono (le_inf h2 h1)

/-- Morris, Topology Without Tears, Proposition A6.2.20 (TP-675). A space is compact iff every
proper filter has a cluster point. -/
@[kb "morris2024" "Proposition A6.2.20, p. 647"]
theorem morris_A6_2_20 {X : Type*} [TopologicalSpace X] :
    CompactSpace X ↔ ∀ F : Filter X, F.NeBot → ∃ x, ClusterPt x F := by
  constructor
  · intro _ F _
    exact exists_clusterPt_of_compactSpace F
  · intro h
    rw [morris_A6_1_24]
    intro U
    obtain ⟨x, hx⟩ := h U inferInstance
    exact ⟨x, Ultrafilter.clusterPt_iff.1 hx⟩

/-- Morris, Topology Without Tears, Corollary A6.2.21 (TP-675). A space is compact iff every
proper filter has a finer proper filter converging to some point. -/
@[kb "morris2024" "Corollary A6.2.21, p. 647"]
theorem morris_A6_2_21 {X : Type*} [TopologicalSpace X] :
    CompactSpace X ↔
      ∀ F : Filter X, F.NeBot → ∃ x, ∃ G : Filter X, G.NeBot ∧ G ≤ F ∧ G ≤ 𝓝 x := by
  rw [morris_A6_2_20]
  simp only [morris_A6_2_17]

/-- Morris, Topology Without Tears, Proposition A6.2.22 (TP-676). A map is continuous iff it sends
filters converging to `x` to filters converging to `f x`; continuous maps preserve convergence. -/
@[kb "morris2024" "Proposition A6.2.22, p. 648"]
theorem morris_A6_2_22 {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y) :
    (Continuous f ↔ ∀ x (F : Filter X), F ≤ 𝓝 x → Filter.map f F ≤ 𝓝 (f x)) :=
  (morris_A6_1_27 f).2.2.1

/-- Morris, Topology Without Tears, Definition A6.3.1 (TP-677). A directed set is a partial order
in which any two elements have a common upper bound. -/
@[kb "morris2024" "Definition A6.3.1, p. 650"]
theorem morris_A6_3_1 (α : Type*) [PartialOrder α] :
    IsDirectedOrder α ↔ ∀ a b : α, ∃ c, a ≤ c ∧ b ≤ c :=
  ⟨fun h => h.directed, fun h => ⟨h⟩⟩

/-- Morris, Topology Without Tears, Definition A6.3.5 (TP-679). A net converges to `a` iff it is
eventually in every neighbourhood of `a`. -/
@[kb "morris2024" "Definition A6.3.5, p. 651"]
theorem morris_A6_3_5 {ι X : Type*} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι]
    [TopologicalSpace X] (x : ι → X) (a : X) :
    Tendsto x atTop (𝓝 a) ↔ ∀ U ∈ 𝓝 a, ∃ i, ∀ j, i ≤ j → x j ∈ U := by
  simp only [tendsto_def, mem_atTop_sets, mem_preimage]

/-- Morris, Topology Without Tears, Definition A6.3.8 (TP-679). A net is eventually in a set iff it
lies in the set from some index on. -/
@[kb "morris2024" "Definition A6.3.8, p. 651"]
theorem morris_A6_3_8 {ι X : Type*} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι]
    (x : ι → X) (S : Set X) :
    (∀ᶠ j in atTop, x j ∈ S) ↔ ∃ i, ∀ j, i ≤ j → x j ∈ S :=
  eventually_atTop

/-- Morris, Topology Without Tears, Definition A6.3.9 (TP-679). A net is frequently in a set iff
for every index there is a later index at which it lies in the set. -/
@[kb "morris2024" "Definition A6.3.9, p. 651"]
theorem morris_A6_3_9 {ι X : Type*} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι]
    (x : ι → X) (S : Set X) :
    (∃ᶠ j in atTop, x j ∈ S) ↔ ∀ i, ∃ j, i ≤ j ∧ x j ∈ S :=
  frequently_atTop

/-- Morris, Topology Without Tears, Proposition A6.3.15 (TP-682). The tails of a net form a
filterbase, and convergence of the net equals convergence of the associated filter. -/
@[kb "morris2024" "Proposition A6.3.15, p. 653"]
theorem morris_A6_3_15 {ι X : Type*} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι]
    [TopologicalSpace X] (x : ι → X) (a : X) :
    (Filter.map x atTop).HasBasis (fun _ : ι => True) (fun i => x '' Ici i) ∧
      (Tendsto x atTop (𝓝 a) ↔ Filter.map x atTop ≤ 𝓝 a) :=
  ⟨atTop_basis.map x, Iff.rfl⟩

/-- Morris, Topology Without Tears, Definition A6.3.25 (TP-688). A cluster point of a net: every
neighbourhood contains terms of arbitrarily large index; every limit is a cluster point. -/
@[kb "morris2024" "Definition A6.3.25, p. 656"]
theorem morris_A6_3_25 {ι X : Type*} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι]
    [TopologicalSpace X] (x : ι → X) (a : X) :
    (MapClusterPt a atTop x ↔ ∀ U ∈ 𝓝 a, ∀ i, ∃ j, i ≤ j ∧ x j ∈ U) ∧
      (Tendsto x atTop (𝓝 a) → MapClusterPt a atTop x) := by
  refine ⟨?_, fun h => h.mapClusterPt⟩
  simp only [mapClusterPt_iff_frequently, frequently_atTop]

/-- Morris, Topology Without Tears, Proposition A6.4.11 (TP-703). An infinite set of cardinality
`m` has exactly `2 ^ (2 ^ m)` ultrafilters. -/
@[kb "morris2024" "Proposition A6.4.11, p. 670"]
theorem morris_A6_4_11 (α : Type*) [Infinite α] :
    Cardinal.mk (Ultrafilter α) = 2 ^ (2 ^ Cardinal.mk α : Cardinal) :=
  Cardinal.mk_ultrafilter_of_infinite

