import Mathlib.Algebra.Module.ZLattice.Basic
import Mathlib.GroupTheory.FiniteAbelian.Basic
import UndergradKB.Common.Attr

/-!
# Structure of some abelian groups (Morris, Appendix 5)

Discrete subgroups of a finite-dimensional real vector space (Theorem A5.5.10), using Mathlib's
`ZLattice` results for the full-rank case on the real span of the subgroup; and the finite case of the
structure theorem for abelian groups of bounded exponent (Theorem A5.11.11).
-/

open Module Submodule

namespace UndergradKB.Topology

/-- Morris, Topology Without Tears, Theorem A5.5.10 (TP-544). A discrete subgroup `G` of a
finite-dimensional real vector space (for instance `ℝⁿ`) of rank `p = dim (span G)` is generated by `p`
linearly independent vectors of `G`, and is topologically isomorphic to `ℤ ^ p`. -/
@[kb "morris2024" "Theorem A5.5.10, p. 542"]
theorem discrete_subgroup_generated_by_independent {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] (G : Submodule ℤ E) [DiscreteTopology G] :
    ∃ b : Fin (finrank ℝ (span ℝ (G : Set E))) → E, LinearIndependent ℝ b ∧ (∀ i, b i ∈ G) ∧
      span ℤ (Set.range b) = G ∧
      ∃ e : G ≃ₗ[ℤ] (Fin (finrank ℝ (span ℝ (G : Set E))) → ℤ),
        Continuous e ∧ Continuous e.symm := by
  classical
  let F : Submodule ℝ E := span ℝ (G : Set E)
  have hle : G ≤ F.restrictScalars ℤ := fun x hx => subset_span hx
  let L : Submodule ℤ F := comap (F.restrictScalars ℤ).subtype G
  let f := Submodule.comapSubtypeEquivOfLe hle
  have hdisc : DiscreteTopology L := by
    let e : G ≃L[ℤ] L :=
      ⟨f.symm, continuous_of_discreteTopology, Isometry.continuous fun _ ↦ congrFun rfl⟩
    exact e.toHomeomorph.discreteTopology
  have hZ : IsZLattice ℝ L :=
    ⟨eq_top_iff.mpr (span_span_coe_preimage.symm.le.trans (span_mono (fun x hx => hx)))⟩
  have hfin : Module.Finite ℤ L := ZLattice.module_finite ℝ L
  have hfree : Module.Free ℤ L := ZLattice.module_free ℝ L
  have hcard : Fintype.card (Module.Free.ChooseBasisIndex ℤ L) = finrank ℝ F := by
    rw [← finrank_eq_card_chooseBasisIndex, ZLattice.rank ℝ L]
  let bL : Basis (Fin (finrank ℝ F)) ℤ L :=
    (Module.Free.chooseBasis ℤ L).reindex (Fintype.equivFinOfCardEq hcard)
  let B : Basis (Fin (finrank ℝ F)) ℝ F := bL.ofZLatticeBasis ℝ L
  have hB : ∀ i, B i = ((bL i : L) : F) := fun i => by simp [B]
  have hli : LinearIndependent ℝ (fun i => ((bL i : L) : F)) := by
    have h : (fun i => ((bL i : L) : F)) = ⇑B := funext fun i => (hB i).symm
    rw [h]
    exact B.linearIndependent
  refine ⟨fun i => (((bL i : L) : F) : E), hli.map' F.subtype (ker_subtype F), ?_, ?_, ?_⟩
  · intro i
    exact (bL i).2
  · refine le_antisymm (span_le.2 ?_) ?_
    · rintro _ ⟨i, rfl⟩
      exact (bL i).2
    · intro x hx
      let y : L := ⟨⟨x, subset_span hx⟩, hx⟩
      have hy : y ∈ span ℤ (Set.range bL) := by
        rw [bL.span_eq]
        trivial
      have key : ∀ z (hz : z ∈ span ℤ (Set.range bL)),
          (((z : L) : F) : E) ∈ span ℤ (Set.range fun i => (((bL i : L) : F) : E)) := by
        intro z hz
        induction hz using Submodule.span_induction with
        | mem z h =>
          obtain ⟨i, rfl⟩ := h
          exact subset_span ⟨i, rfl⟩
        | zero => exact zero_mem _
        | add a b _ _ ha hb => exact add_mem ha hb
        | smul a z _ hz => exact smul_mem _ a hz
      exact key y hy
  · refine ⟨f.symm.trans bL.equivFun, continuous_of_discreteTopology, continuous_of_discreteTopology⟩

/-- Morris, Topology Without Tears, Theorem A5.11.11 (TP-593), finite case only. A finite abelian group
is a (finite, hence restricted) direct sum of finite cyclic groups. The case of an infinite abelian
group of bounded exponent is not proved here. -/
@[kb "morris2024" "Theorem A5.11.11, p. 580"]
theorem finite_abelian_group_directSum_cyclic (G : Type*) [AddCommGroup G] [Finite G] :
    ∃ (ι : Type) (_ : Fintype ι) (p : ι → ℕ) (_ : ∀ i, (p i).Prime) (e : ι → ℕ),
      Nonempty (G ≃+ DirectSum ι fun i => ZMod (p i ^ e i)) :=
  AddCommGroup.equiv_directSum_zmod_of_finite G

end UndergradKB.Topology
