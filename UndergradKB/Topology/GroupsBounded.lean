import Mathlib.Algebra.Module.ZMod
import Mathlib.LinearAlgebra.Basis.VectorSpace
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Data.Fintype.Sum
import Mathlib.FieldTheory.Finite.Basic
import UndergradKB.Common.Attr

/-!
# Abelian groups of bounded exponent are direct sums of cyclic groups: the `p`-group step

Morris, *Topology Without Tears* (2024), Theorem A5.11.11 (`morris2024`), after Prüfer and Baer.
`IsCycBasisOn S y` says that the nonzero elements `y i` of the subgroup `S` of an abelian group generate `S`
and are independent: `S` is the internal direct sum of the cyclic subgroups `⟨y i⟩`.  Here: if `p^(k+1) S = 0`
and `p S` has such a family, so has `S` (Kaplansky's argument: lift the generators, complete with a basis of a
complement of their `p`-torsion part in the socle of `S`).  By induction on `k`, a `p`-group of bounded exponent
has such a family.
-/

universe u

open Function

namespace UndergradKB.Topology

/-- `S` is the internal direct sum of the cyclic subgroups generated by the nonzero elements `y i`. -/
def IsCycBasisOn {G : Type u} [AddCommGroup G] {ι : Type*} (S : AddSubgroup G) (y : ι → G) : Prop :=
  (∀ i, y i ∈ S ∧ y i ≠ 0) ∧ S ≤ AddSubgroup.closure (Set.range y) ∧
    ∀ (t : Finset ι) (c : ι → ℤ), ∑ i ∈ t, c i • y i = 0 → ∀ i ∈ t, c i • y i = 0

section PGroup

variable (p : ℕ) [hp : Fact p.Prime]

theorem zmod_smul_val {M : Type*} [AddCommGroup M] [Module (ZMod p) M] (a : ZMod p) (m : M) :
    a • m = a.val • m := by
  have : NeZero p := ⟨hp.out.ne_zero⟩
  calc a • m = ((a.val : ℕ) : ZMod p) • m := by rw [ZMod.natCast_zmod_val]
    _ = a.val • m := Nat.cast_smul_eq_nsmul (ZMod p) _ _

end PGroup

/-- Extension of a linearly independent family in a vector space to a basis, in elementwise form
(a complement of the span, with a basis). -/
theorem exists_complement_basis {K : Type*} [Field K] {V : Type u} [AddCommGroup V] [Module K V]
    {ι : Type*} (s : ι → V) (hs : LinearIndependent K s) :
    ∃ (κ : Type u) (z : κ → V), (∀ j, z j ≠ 0) ∧
      (∀ v, ∃ (t : Finset ι) (u : Finset κ) (a : ι → K) (b : κ → K),
        v = ∑ i ∈ t, a i • s i + ∑ j ∈ u, b j • z j) ∧
      (∀ (t : Finset ι) (u : Finset κ) (a : ι → K) (b : κ → K),
        ∑ i ∈ t, a i • s i + ∑ j ∈ u, b j • z j = 0 → (∀ i ∈ t, a i = 0) ∧ ∀ j ∈ u, b j = 0) := by
  classical
  obtain ⟨C, hAC⟩ := Submodule.exists_isCompl (Submodule.span K (Set.range s))
  let bC := Module.Basis.ofVectorSpace K ↥C
  refine ⟨_, fun j => ((bC j : C) : V), fun j h => bC.ne_zero j (Subtype.ext h), ?_, ?_⟩
  · intro v
    have hv : v ∈ Submodule.span K (Set.range s) ⊔ C := by rw [hAC.sup_eq_top]; trivial
    obtain ⟨a, ha, c, hc, rfl⟩ := Submodule.mem_sup.mp hv
    obtain ⟨f, hf⟩ := (Finsupp.mem_span_range_iff_exists_finsupp).mp ha
    have hcC : (⟨c, hc⟩ : C) ∈ Submodule.span K (Set.range bC) := by rw [bC.span_eq]; trivial
    obtain ⟨g, hg⟩ := (Finsupp.mem_span_range_iff_exists_finsupp).mp hcC
    refine ⟨f.support, g.support, f, g, ?_⟩
    congr 1
    · rw [← hf, Finsupp.sum]
    · have := congrArg (fun r : C => (r : V)) hg
      simp only [Finsupp.sum, Submodule.coe_sum, Submodule.coe_smul] at this
      rw [← this]
  · intro t u a b hab
    have hα : ∑ i ∈ t, a i • s i ∈ Submodule.span K (Set.range s) :=
      Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    let γ : C := ∑ j ∈ u, b j • bC j
    have hγ : (γ : V) = ∑ j ∈ u, b j • ((bC j : C) : V) := by
      simp [γ]
    have hsum : ∑ i ∈ t, a i • s i = -(γ : V) := by
      rw [hγ]; exact eq_neg_of_add_eq_zero_left hab
    have hmem : ∑ i ∈ t, a i • s i ∈ Submodule.span K (Set.range s) ⊓ C :=
      ⟨hα, by rw [hsum]; exact C.neg_mem γ.2⟩
    rw [hAC.inf_eq_bot, Submodule.mem_bot] at hmem
    have hγ0 : γ = 0 := by
      apply Subtype.ext
      rw [hγ]
      have : (γ : V) = -(∑ i ∈ t, a i • s i) := by rw [hsum, neg_neg]
      rw [← hγ, this, hmem, neg_zero]
      rfl
    have h1 := linearIndependent_iff'.mp hs t a hmem
    have h2 := linearIndependent_iff'.mp bC.linearIndependent u b hγ0
    exact ⟨h1, h2⟩

section PGroup

variable (p : ℕ) [hp : Fact p.Prime]

/-- Elementwise form over the integers, for an elementary abelian `p`-group. -/
theorem exists_socle_extension {V : Type u} [AddCommGroup V] (hV : ∀ v : V, p • v = 0) {ι : Type u}
    (s : ι → V) (hs : ∀ (t : Finset ι) (d : ι → ℤ), ∑ i ∈ t, d i • s i = 0 → ∀ i ∈ t, (p : ℤ) ∣ d i) :
    ∃ (κ : Type u) (z : κ → V), (∀ j, z j ≠ 0) ∧
      (∀ v, ∃ (t : Finset ι) (u : Finset κ) (a : ι → ℤ) (b : κ → ℤ),
        v = ∑ i ∈ t, a i • s i + ∑ j ∈ u, b j • z j) ∧
      (∀ (t : Finset ι) (u : Finset κ) (a : ι → ℤ) (b : κ → ℤ),
        ∑ i ∈ t, a i • s i + ∑ j ∈ u, b j • z j = 0 → (∀ i ∈ t, (p : ℤ) ∣ a i) ∧ ∀ j ∈ u, (p : ℤ) ∣ b j) := by
  classical
  have : NeZero p := ⟨hp.out.ne_zero⟩
  let _ : Module (ZMod p) V := AddCommGroup.zmodModule hV
  have hLI : LinearIndependent (ZMod p) s := by
    rw [linearIndependent_iff']
    intro t g hg i hi
    have h1 : ∑ i ∈ t, ((g i).val : ℤ) • s i = 0 := by
      rw [← hg]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [natCast_zsmul, zmod_smul_val p]
    have h2 := hs t _ h1 i hi
    rw [← ZMod.natCast_zmod_val (g i), ZMod.natCast_eq_zero_iff]
    exact_mod_cast h2
  obtain ⟨κ, z, hz, h1, h2⟩ := exists_complement_basis (K := ZMod p) s hLI
  refine ⟨κ, z, hz, ?_, ?_⟩
  · intro v
    obtain ⟨t, u, a, b, hv⟩ := h1 v
    refine ⟨t, u, fun i => ((a i).val : ℤ), fun j => ((b j).val : ℤ), ?_⟩
    rw [hv]
    congr 1
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [natCast_zsmul, zmod_smul_val p]
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [natCast_zsmul, zmod_smul_val p]
  · intro t u a b hab
    have hab' : ∑ i ∈ t, (a i : ZMod p) • s i + ∑ j ∈ u, (b j : ZMod p) • z j = 0 := by
      rw [← hab]
      congr 1
      · exact Finset.sum_congr rfl fun i _ => Int.cast_smul_eq_zsmul _ _ _
      · exact Finset.sum_congr rfl fun i _ => Int.cast_smul_eq_zsmul _ _ _
    obtain ⟨e1, e2⟩ := h2 t u _ _ hab'
    exact ⟨fun i hi => (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp (e1 i hi),
      fun j hj => (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp (e2 j hj)⟩

/-- Kaplansky's step. -/
theorem cycBasis_step {G : Type u} [AddCommGroup G] (k : ℕ) (S T : AddSubgroup G)
    (hTS : ∀ s ∈ S, p • s ∈ T) (hTS' : ∀ t ∈ T, ∃ s ∈ S, t = p • s)
    (hk : ∀ s ∈ S, p ^ (k + 1) • s = 0) {ι : Type u} {y : ι → G} (hy : IsCycBasisOn T y) :
    ∃ (κ : Type u) (z : κ → G), IsCycBasisOn S z := by
  classical
  have : NeZero p := ⟨hp.out.ne_zero⟩
  obtain ⟨hy1, hy2, hy3⟩ := hy
  have hx : ∀ i, ∃ s ∈ S, y i = p • s := fun i => hTS' (y i) (hy1 i).1
  choose x hxS hxy using hx
  have hxne : ∀ i, x i ≠ 0 := fun i h => (hy1 i).2 (by rw [hxy i, h, smul_zero])
  -- orders of the generators
  have hdvd : ∀ i, addOrderOf (y i) ∣ p ^ k := fun i => by
    rw [addOrderOf_dvd_iff_nsmul_eq_zero, hxy i, ← mul_nsmul', ← pow_succ]
    exact hk _ (hxS i)
  have hpo : ∀ i, p ∣ addOrderOf (y i) := fun i => by
    obtain ⟨a, -, ha⟩ := (Nat.dvd_prime_pow hp.out).mp (hdvd i)
    rcases Nat.eq_zero_or_pos a with rfl | hapos
    · refine absurd ?_ (hy1 i).2
      have h1 : addOrderOf (y i) = 1 := by simpa using ha
      have := addOrderOf_nsmul_eq_zero (y i)
      rwa [h1, one_nsmul] at this
    · rw [ha]; exact dvd_pow_self p hapos.ne'
  have hopos : ∀ i, 0 < addOrderOf (y i) := fun i => Nat.pos_of_dvd_of_pos (hdvd i) (pow_pos hp.out.pos _)
  -- the socle elements `s i = (ord y_i / p) • y_i = ord y_i • x_i`
  obtain ⟨q, hq⟩ : ∃ q : ι → ℕ, ∀ i, addOrderOf (y i) = p * q i :=
    ⟨fun i => addOrderOf (y i) / p, fun i => (Nat.mul_div_cancel' (hpo i)).symm⟩
  have hqpos : ∀ i, 0 < q i := fun i => by
    have := hopos i
    rw [hq i] at this
    exact Nat.pos_of_ne_zero fun h => by rw [h] at this; simp at this
  have hsp : ∀ i, p • (q i • y i) = 0 := fun i => by
    rw [← mul_nsmul', ← hq i]; exact addOrderOf_nsmul_eq_zero _
  have hsx : ∀ i, q i • y i = addOrderOf (y i) • x i := fun i => by
    rw [hq i, mul_comm p, mul_nsmul', ← hxy i]
  -- independence of the socle elements
  have KI : ∀ (t : Finset ι) (d : ι → ℤ), ∑ i ∈ t, d i • (q i • y i) = 0 → ∀ i ∈ t, (p : ℤ) ∣ d i := by
    intro t d hsum i hi
    have h1 : ∑ i ∈ t, (d i * q i) • y i = 0 := by
      rw [← hsum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [mul_smul, natCast_zsmul]
    have h2 := hy3 t (fun i => d i * q i) h1 i hi
    have h3 : (addOrderOf (y i) : ℤ) ∣ d i * q i := addOrderOf_dvd_iff_zsmul_eq_zero.mpr h2
    rw [hq i] at h3
    push_cast at h3
    have hq0 : (q i : ℤ) ≠ 0 := by exact_mod_cast (hqpos i).ne'
    rw [mul_comm (p : ℤ), mul_comm (d i)] at h3
    exact (Int.dvd_of_mul_dvd_mul_left hq0 h3)
  -- the socle `R` of `S`
  let R : AddSubgroup G :=
    { carrier := {g | g ∈ S ∧ p • g = 0}
      zero_mem' := ⟨S.zero_mem, smul_zero _⟩
      add_mem' := fun ha hb => ⟨S.add_mem ha.1 hb.1, by rw [smul_add, ha.2, hb.2, add_zero]⟩
      neg_mem' := fun ha => ⟨S.neg_mem ha.1, by rw [smul_neg, ha.2, neg_zero]⟩ }
  have hRp : ∀ r : R, p • r = 0 := fun r => Subtype.ext (by simpa using r.2.2)
  have hsS : ∀ i, q i • y i ∈ S := fun i => by rw [hsx i]; exact S.nsmul_mem (hxS i) _
  let s' : ι → R := fun i => ⟨q i • y i, hsS i, hsp i⟩
  have KI' : ∀ (t : Finset ι) (d : ι → ℤ), ∑ i ∈ t, d i • s' i = 0 → ∀ i ∈ t, (p : ℤ) ∣ d i := by
    intro t d hd
    apply KI t d
    have := congrArg R.subtype hd
    rw [map_sum, map_zero] at this
    rw [← this]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_zsmul]
    rfl
  obtain ⟨κ, z, hz0, h1, h2⟩ := exists_socle_extension p hRp s' KI'
  have hp0 : ∀ (v : G) (m : ℤ), p • v = 0 → ((p : ℤ) * m) • v = 0 := fun v m h => by
    rw [mul_comm, mul_smul, natCast_zsmul, h, smul_zero]
  refine ⟨ι ⊕ κ, Sum.elim x (fun j => ((z j : R) : G)), ?_, ?_, ?_⟩
  · rintro (i | j)
    · exact ⟨hxS i, hxne i⟩
    · exact ⟨(z j).2.1, fun h => hz0 j (Subtype.ext h)⟩
  · -- generation
    set N := AddSubgroup.closure (Set.range (Sum.elim x (fun j => ((z j : R) : G)))) with hN
    have hxN : ∀ i, x i ∈ N := fun i => AddSubgroup.subset_closure ⟨Sum.inl i, rfl⟩
    have hzN : ∀ j, ((z j : R) : G) ∈ N := fun j => AddSubgroup.subset_closure ⟨Sum.inr j, rfl⟩
    have hRN : ∀ r : R, (r : G) ∈ N := by
      intro r
      obtain ⟨t, u, a, b, hr⟩ := h1 r
      have := congrArg R.subtype hr
      rw [map_add, map_sum, map_sum] at this
      change (r : G) = _ at this
      rw [this]
      refine N.add_mem (N.sum_mem fun i _ => ?_) (N.sum_mem fun j _ => ?_)
      · rw [map_zsmul]
        exact N.zsmul_mem (by
          show q i • y i ∈ N
          rw [hsx i]; exact N.nsmul_mem (hxN i) _) _
      · rw [map_zsmul]
        exact N.zsmul_mem (hzN j) _
    have hlift : ∀ t ∈ AddSubgroup.closure (Set.range y),
        ∃ w ∈ AddSubgroup.closure (Set.range x), p • w = t := by
      intro t ht
      induction ht using AddSubgroup.closure_induction with
      | mem a ha =>
        obtain ⟨i, rfl⟩ := ha
        exact ⟨x i, AddSubgroup.subset_closure ⟨i, rfl⟩, (hxy i).symm⟩
      | zero => exact ⟨0, AddSubgroup.zero_mem _, smul_zero _⟩
      | add a b _ _ ha hb =>
        obtain ⟨wa, hwa, rfl⟩ := ha
        obtain ⟨wb, hwb, rfl⟩ := hb
        exact ⟨wa + wb, AddSubgroup.add_mem _ hwa hwb, smul_add _ _ _⟩
      | neg a _ ha =>
        obtain ⟨wa, hwa, rfl⟩ := ha
        exact ⟨-wa, AddSubgroup.neg_mem _ hwa, smul_neg _ _⟩
    have hxcl : AddSubgroup.closure (Set.range x) ≤ S :=
      (AddSubgroup.closure_le S).mpr (by rintro _ ⟨i, rfl⟩; exact hxS i)
    have hxcl' : AddSubgroup.closure (Set.range x) ≤ N :=
      (AddSubgroup.closure_le N).mpr (by rintro _ ⟨i, rfl⟩; exact hxN i)
    intro g hg
    obtain ⟨w, hw, hpw⟩ := hlift _ (hy2 (hTS g hg))
    have hr : g - w ∈ R := ⟨S.sub_mem hg (hxcl hw), by rw [smul_sub, hpw, sub_self]⟩
    have := N.add_mem (hxcl' hw) (hRN ⟨g - w, hr⟩)
    simpa using this
  · -- independence
    intro F c hF
    rw [Finset.sum_sum_eq_sum_toLeft_add_sum_toRight] at hF
    simp only [Sum.elim_inl, Sum.elim_inr] at hF
    have hFy : ∑ i ∈ F.toLeft, c (Sum.inl i) • y i = 0 := by
      have := congrArg (fun v => p • v) hF
      simp only [smul_add, smul_zero, Finset.smul_sum] at this
      have e1 : ∀ i ∈ F.toLeft, p • c (Sum.inl i) • x i = c (Sum.inl i) • y i := fun i _ => by
        rw [smul_comm, hxy i]
      have e2 : ∀ j ∈ F.toRight, p • c (Sum.inr j) • ((z j : R) : G) = 0 := fun j _ => by
        rw [smul_comm]
        have := hRp (z j)
        have h' : p • ((z j : R) : G) = 0 := by simpa using congrArg (fun r : R => (r : G)) this
        rw [h', smul_zero]
      rw [Finset.sum_congr rfl e1, Finset.sum_eq_zero e2, add_zero] at this
      exact this
    have hcy := hy3 _ _ hFy
    have hdv : ∀ i ∈ F.toLeft, (addOrderOf (y i) : ℤ) ∣ c (Sum.inl i) := fun i hi =>
      addOrderOf_dvd_iff_zsmul_eq_zero.mpr (hcy i hi)
    set e : ι → ℤ := fun i => c (Sum.inl i) / (addOrderOf (y i) : ℤ) with he
    have hce : ∀ i ∈ F.toLeft, c (Sum.inl i) • x i = e i • (q i • y i) := by
      intro i hi
      have : c (Sum.inl i) = (addOrderOf (y i) : ℤ) * e i := (Int.mul_ediv_cancel' (hdv i hi)).symm
      rw [hsx i, this, mul_comm, mul_smul, natCast_zsmul]
    have hrel : ∑ i ∈ F.toLeft, e i • s' i + ∑ j ∈ F.toRight, c (Sum.inr j) • z j = 0 := by
      apply R.subtype_injective
      rw [map_add, map_sum, map_sum, map_zero]
      have e3 : ∑ i ∈ F.toLeft, R.subtype (e i • s' i) = ∑ i ∈ F.toLeft, c (Sum.inl i) • x i := by
        refine Finset.sum_congr rfl fun i hi => ?_
        rw [map_zsmul, hce i hi]
        rfl
      have e4 : ∑ j ∈ F.toRight, R.subtype (c (Sum.inr j) • z j) =
          ∑ j ∈ F.toRight, c (Sum.inr j) • ((z j : R) : G) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_zsmul]
        rfl
      rw [e3, e4]
      exact hF
    obtain ⟨hA, hB⟩ := h2 _ _ _ _ hrel
    rintro (i | j) hu
    · have hi : i ∈ F.toLeft := Finset.mem_toLeft.mpr hu
      obtain ⟨m, hm⟩ := hA i hi
      show c (Sum.inl i) • x i = 0
      rw [hce i hi, hm]
      exact hp0 _ m (hsp i)
    · have hj : j ∈ F.toRight := Finset.mem_toRight.mpr hu
      obtain ⟨m, hm⟩ := hB j hj
      show c (Sum.inr j) • ((z j : R) : G) = 0
      rw [hm]
      refine hp0 _ m ?_
      simpa using congrArg (fun r : R => (r : G)) (hRp (z j))

end PGroup

end UndergradKB.Topology
