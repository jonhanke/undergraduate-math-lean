/-!
# Subgroups of `ℝ`, the circle and `ℝⁿ` (Morris, Topology Without Tears, Appendix 5, section A5.5)

Closed subgroups of the real line, the subgroup generated by two reals, Hausdorff quotients of `ℝ`,
closed subgroups of the circle, and subgroups of `ℝⁿ` generated by independent vectors.
-/

open Set Filter Topology

namespace UndergradKB.Topology

/-- Morris, Topology Without Tears, Proposition A5.5.2 (TP-539). A closed subgroup of `ℝ` is
`{0}`, `ℝ`, or `aℤ` for some `a > 0`. -/
@[kb "morris2024" "Proposition A5.5.2, p. 539"]
theorem addSubgroup_real_eq_bot_or_top_or_zmultiples (H : AddSubgroup ℝ) (hH : IsClosed (H : Set ℝ)) :
    H = ⊥ ∨ H = ⊤ ∨ ∃ a : ℝ, 0 < a ∧ H = AddSubgroup.zmultiples a := by
  rcases AddSubgroup.dense_or_isCyclic H with hd | hc
  · right; left
    have := dense_iff_closure_eq.1 hd
    rw [hH.closure_eq] at this
    exact AddSubgroup.coe_eq_univ.1 this
  · obtain ⟨g, hg⟩ := (AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq _).1 hc
    by_cases h0 : g = 0
    · left; rw [← hg, h0]; exact AddSubgroup.zmultiples_zero_eq_bot
    · right; right
      refine ⟨|g|, abs_pos.2 h0, ?_⟩
      rw [← hg]
      rcases abs_choice g with h | h
      · rw [h]
      · rw [h, AddSubgroup.zmultiples_neg]

/-- A subgroup of `ℝ` lying inside `cℤ` (`c ≠ 0`) is closed. -/
theorem isClosed_of_le_zmultiples {G : AddSubgroup ℝ} {c : ℝ} (hc : c ≠ 0)
    (hG : G ≤ AddSubgroup.zmultiples c) : IsClosed (G : Set ℝ) := by
  have hZ : IsClosed (AddSubgroup.zmultiples c : Set ℝ) := AddSubgroup.isClosed_of_discreteTopology
  rcases AddSubgroup.dense_or_isCyclic G with hd | hcyc
  · exfalso
    have h1 : (AddSubgroup.zmultiples c : Set ℝ) = Set.univ := by
      apply Set.eq_univ_of_univ_subset
      have := dense_iff_closure_eq.1 hd
      rw [← this, ← hZ.closure_eq]
      exact closure_mono hG
    have hmem : c / 2 ∈ (AddSubgroup.zmultiples c : Set ℝ) := by rw [h1]; trivial
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 hmem
    rw [zsmul_eq_mul] at hk
    have h2 : c * (2 * k - 1) = 0 := by linarith
    rcases mul_eq_zero.1 h2 with h | h
    · exact hc h
    · have : (2 * k : ℤ) = 1 := by
        have : ((2 * k : ℤ) : ℝ) = 1 := by push_cast; linarith
        exact_mod_cast this
      omega
  · obtain ⟨g, hg⟩ := (AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq _).1 hcyc
    rw [← hg]
    exact AddSubgroup.isClosed_of_discreteTopology

/-- Morris, Topology Without Tears, Corollary A5.5.3 (TP-540). For real numbers `a, b`, the subgroup
of `ℝ` generated by `a` and `b` is closed iff `a` and `b` are rationally dependent, that is,
`n a = m b` for integers `n, m` not both zero. (The condition "not both zero" is implicit in the
book: with `n = m = 0` every pair would qualify.) -/
@[kb "morris2024" "Corollary A5.5.3, p. 539"]
theorem isClosed_closure_pair_iff (a b : ℝ) :
    IsClosed (AddSubgroup.closure ({a, b} : Set ℝ) : Set ℝ) ↔
      ∃ n m : ℤ, (n ≠ 0 ∨ m ≠ 0) ∧ (n : ℝ) * a = (m : ℝ) * b := by
  constructor
  · intro h
    have ha : a ∈ AddSubgroup.closure ({a, b} : Set ℝ) := AddSubgroup.subset_closure (by simp)
    have hb : b ∈ AddSubgroup.closure ({a, b} : Set ℝ) := AddSubgroup.subset_closure (by simp)
    rcases addSubgroup_real_eq_bot_or_top_or_zmultiples _ h with h0 | h1 | ⟨c, hc, h2⟩
    · rw [h0] at ha hb
      rw [AddSubgroup.mem_bot] at ha hb
      exact ⟨1, 0, Or.inl one_ne_zero, by simp [ha, hb]⟩
    · exfalso
      apply Cardinal.not_countable_real
      have : (Set.univ : Set ℝ) ⊆ Set.range (fun p : ℤ × ℤ => p.1 • a + p.2 • b) := by
        intro x _
        have hx : x ∈ AddSubgroup.closure ({a, b} : Set ℝ) := by rw [h1]; trivial
        obtain ⟨m, n, hmn⟩ := AddSubgroup.mem_closure_pair.1 hx
        exact ⟨(m, n), hmn⟩
      exact (Set.countable_range _).mono this
    · rw [h2] at ha hb
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 ha
      obtain ⟨l, hl⟩ := AddSubgroup.mem_zmultiples_iff.1 hb
      by_cases hkl : l = 0 ∧ k = 0
      · refine ⟨1, 0, Or.inl one_ne_zero, ?_⟩
        rw [← hk, ← hl, hkl.1, hkl.2]; simp
      · refine ⟨l, k, ?_, ?_⟩
        · by_contra hh
          push Not at hh
          exact hkl hh
        · rw [← hk, ← hl, zsmul_eq_mul, zsmul_eq_mul]; ring
  · rintro ⟨n, m, hnm, h⟩
    by_cases hab : a = 0 ∧ b = 0
    · have : AddSubgroup.closure ({a, b} : Set ℝ) = ⊥ := by
        rw [eq_bot_iff, AddSubgroup.closure_le]
        intro x hx
        rcases hx with rfl | rfl
        · simp [hab.1]
        · simp [hab.2]
      rw [this]
      exact isClosed_singleton
    · have key : ∃ c : ℝ, c ≠ 0 ∧ a ∈ AddSubgroup.zmultiples c ∧ b ∈ AddSubgroup.zmultiples c := by
        by_cases hn : n = 0
        · have hm : m ≠ 0 := by tauto
          have hb : b = 0 := by
            subst hn
            have : (m : ℝ) * b = 0 := by simpa using h.symm
            rcases mul_eq_zero.1 this with h' | h'
            · exact absurd (by exact_mod_cast h') hm
            · exact h'
          have ha : a ≠ 0 := fun h' => hab ⟨h', hb⟩
          exact ⟨a, ha, AddSubgroup.mem_zmultiples a, by rw [hb]; exact zero_mem _⟩
        · by_cases hm : m = 0
          · have ha : a = 0 := by
              subst hm
              have : (n : ℝ) * a = 0 := by simpa using h
              rcases mul_eq_zero.1 this with h' | h'
              · exact absurd (by exact_mod_cast h') hn
              · exact h'
            have hb : b ≠ 0 := fun h' => hab ⟨ha, h'⟩
            exact ⟨b, hb, by rw [ha]; exact zero_mem _, AddSubgroup.mem_zmultiples b⟩
          · have hb0 : b ≠ 0 := by
              intro hb
              rw [hb, mul_zero] at h
              have : a = 0 := by
                rcases mul_eq_zero.1 h with h' | h'
                · exact absurd (by exact_mod_cast h') hn
                · exact h'
              exact hab ⟨this, hb⟩
            have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast hn
            refine ⟨b / n, div_ne_zero hb0 hn', ⟨m, ?_⟩, ⟨n, ?_⟩⟩
            · show _ • _ = _; rw [zsmul_eq_mul]
              field_simp
              linarith
            · show _ • _ = _; rw [zsmul_eq_mul]; field_simp
      obtain ⟨c, hc, hac, hbc⟩ := key
      refine isClosed_of_le_zmultiples hc ?_
      rw [AddSubgroup.closure_le]
      rintro x (rfl | rfl)
      · exact hac
      · exact hbc

/-- Morris, Topology Without Tears, Corollary A5.5.5 (TP-541). Every Hausdorff quotient `ℝ ⧸ N`
by a subgroup `N` other than `{0}` and `ℝ` is topologically isomorphic to the circle group.
(The book's "proper" must exclude the trivial subgroup `N = {0}`, whose quotient is `ℝ` itself.) -/
@[kb "morris2024" "Corollary A5.5.5, p. 539"]
theorem exists_homeomorph_circle_of_t2Space_quotient (N : AddSubgroup ℝ) (hN0 : N ≠ ⊥)
    (hN1 : N ≠ ⊤) [T2Space (ℝ ⧸ N)] :
    ∃ e : (ℝ ⧸ N) ≃ₜ Circle, ∀ x y, e (x + y) = e x * e y := by
  have hcl : IsClosed (N : Set ℝ) := QuotientAddGroup.t1Space_iff.1 inferInstance
  rcases addSubgroup_real_eq_bot_or_top_or_zmultiples N hcl with h | h | ⟨a, ha, rfl⟩
  · exact absurd h hN0
  · exact absurd h hN1
  · refine ⟨(AddCircle.homeomorphCircle ha.ne' : AddCircle a ≃ₜ Circle), fun x y => ?_⟩
    simp only [AddCircle.homeomorphCircle_apply]
    exact AddCircle.toCircle_add x y

/-- Morris, Topology Without Tears, Corollary A5.5.6 (TP-542), for the model `ℝ / ℤ` of the
circle group. Every proper closed subgroup of `AddCircle (1 : ℝ)` is finite. -/
@[kb "morris2024" "Corollary A5.5.6, p. 540"]
theorem finite_of_isClosed_addSubgroup_addCircle (H : AddSubgroup (AddCircle (1 : ℝ)))
    (hH : IsClosed (H : Set (AddCircle (1 : ℝ)))) (hne : H ≠ ⊤) : (H : Set (AddCircle (1 : ℝ))).Finite := by
  let P : AddSubgroup ℝ := H.comap (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ)))
  have hPc : IsClosed (P : Set ℝ) :=
    hH.preimage (QuotientAddGroup.continuous_mk (N := AddSubgroup.zmultiples (1 : ℝ)))
  have hone : (1 : ℝ) ∈ P := by
    show QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ)) 1 ∈ H
    have : QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ)) 1 = 0 :=
      (QuotientAddGroup.eq_zero_iff _).2 (AddSubgroup.mem_zmultiples _)
    rw [this]; exact H.zero_mem
  have hPtop : P ≠ ⊤ := by
    intro htop
    apply hne
    rw [eq_top_iff]
    intro x _
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective x
    have : y ∈ P := by rw [htop]; trivial
    exact this
  rcases addSubgroup_real_eq_bot_or_top_or_zmultiples P hPc with h | h | ⟨a, ha, hP⟩
  · rw [h] at hone
    exact absurd (AddSubgroup.mem_bot.1 hone) one_ne_zero
  · exact absurd h hPtop
  · rw [hP] at hone
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 hone
    rw [zsmul_eq_mul] at hk
    have hk0 : k ≠ 0 := by rintro rfl; simp at hk
    have hkpos : 0 < k := by
      by_contra hh
      have : (k : ℝ) < 0 := by exact_mod_cast lt_of_le_of_ne (not_lt.1 hh) hk0
      nlinarith
    have hkR : (0 : ℝ) < k := by exact_mod_cast hkpos
    have ha' : a = 1 / k := by field_simp; linarith
    refine (Set.finite_range (fun r : Fin k.toNat =>
      ((r : ℕ) / (k : ℝ) : ℝ) )).image (fun x : ℝ => (x : AddCircle (1 : ℝ))) |>.subset ?_
    intro x hx
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective x
    have hyP : y ∈ P := hx
    rw [hP] at hyP
    obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.1 hyP
    rw [zsmul_eq_mul, ha'] at hj
    refine ⟨((j % k).toNat : ℝ) / k, ⟨⟨(j % k).toNat, ?_⟩, ?_⟩, ?_⟩
    · have := Int.emod_lt_of_pos j hkpos
      omega
    · simp
    · have hdecomp : (j : ℝ) = (j / k : ℤ) * k + (j % k : ℤ) := by
        have h : k * (j / k) + j % k = j := Int.mul_ediv_add_emod j k
        have h' : (j : ℝ) = ((k * (j / k) + j % k : ℤ) : ℝ) := by rw [h]
        push_cast at h'
        linarith
      have hnn : ((j % k).toNat : ℝ) = ((j % k : ℤ) : ℝ) := by
        exact_mod_cast Int.toNat_of_nonneg (Int.emod_nonneg j hk0)
      rw [hnn]
      have hy : y = ((j / k : ℤ) : ℝ) + ((j % k : ℤ) : ℝ) / k := by
        rw [← hj]
        field_simp
        linarith
      rw [hy]
      have hz : (((j / k : ℤ) : ℝ) : AddCircle (1 : ℝ)) = 0 := by
        rw [QuotientAddGroup.eq_zero_iff]
        exact ⟨j / k, by simp⟩
      rw [AddCircle.coe_add, hz, zero_add]

/-- Morris, Topology Without Tears, Corollary A5.5.6 (TP-542), for the circle group `Circle`.
Every proper closed subgroup of the unit circle is finite. -/
@[kb "morris2024" "Corollary A5.5.6, p. 540"]
theorem finite_of_isClosed_subgroup_circle (H : Subgroup Circle) (hH : IsClosed (H : Set Circle))
    (hne : H ≠ ⊤) : (H : Set Circle).Finite := by
  let e : AddCircle (1 : ℝ) ≃ₜ Circle := AddCircle.homeomorphCircle one_ne_zero
  have he : ∀ x y, e (x + y) = e x * e y := fun x y => by
    simp only [e, AddCircle.homeomorphCircle_apply]; exact AddCircle.toCircle_add x y
  have he0 : e 0 = 1 := by simp only [e, AddCircle.homeomorphCircle_apply]; exact AddCircle.toCircle_zero
  have heneg : ∀ x, e (-x) = (e x)⁻¹ := fun x => by
    simp only [e, AddCircle.homeomorphCircle_apply]; exact AddCircle.toCircle_neg x
  let H' : AddSubgroup (AddCircle (1 : ℝ)) :=
    { carrier := e ⁻¹' (H : Set Circle)
      zero_mem' := by show e 0 ∈ H; rw [he0]; exact H.one_mem
      add_mem' := by
        intro x y hx hy
        show e (x + y) ∈ H
        rw [he]; exact H.mul_mem hx hy
      neg_mem' := by
        intro x hx
        show e (-x) ∈ H
        rw [heneg]; exact H.inv_mem hx }
  have hH'c : IsClosed (H' : Set (AddCircle (1 : ℝ))) := hH.preimage e.continuous
  have hH'ne : H' ≠ ⊤ := by
    intro htop
    apply hne
    rw [eq_top_iff]
    intro z _
    obtain ⟨x, rfl⟩ := e.surjective z
    have : x ∈ H' := by rw [htop]; trivial
    exact this
  have := finite_of_isClosed_addSubgroup_addCircle H' hH'c hH'ne
  refine (this.image e).subset ?_
  intro z hz
  obtain ⟨x, rfl⟩ := e.surjective z
  exact ⟨x, hz, rfl⟩

/-- Morris, Topology Without Tears, Proposition A5.5.7 (TP-543). If `v₁, …, vₘ` are linearly
independent vectors in a finite-dimensional real normed space, the map `ℤᵐ → E`,
`c ↦ ∑ cᵢ vᵢ`, is a topological embedding (with `ℤᵐ` discrete) and a group homomorphism whose
range is the subgroup generated by the `vᵢ`; so that subgroup is topologically isomorphic
to `ℤᵐ`. -/
@[kb "morris2024" "Proposition A5.5.7, p. 540"]
theorem isEmbedding_intCombination_of_linearIndependent {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {m : ℕ} (v : Fin m → E)
    (hv : LinearIndependent ℝ v) :
    Topology.IsEmbedding (fun c : Fin m → ℤ => ∑ i, c i • v i) ∧
      Set.range (fun c : Fin m → ℤ => ∑ i, c i • v i) =
        (AddSubgroup.closure (Set.range v) : Set E) := by
  constructor
  · have hinj : LinearMap.ker (Fintype.linearCombination ℝ v) = ⊥ := by
      rw [LinearMap.ker_eq_bot]
      exact linearIndependent_iff_injective_fintypeLinearCombination.1 hv
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective (Fintype.linearCombination ℝ v) hinj
    have hgc : Continuous g := LinearMap.continuous_of_finiteDimensional g
    have hcomp : (g ∘ fun c : Fin m → ℤ => ∑ i, c i • v i) = fun c i => (c i : ℝ) := by
      funext c
      have := LinearMap.congr_fun hg (fun i => (c i : ℝ))
      simp only [LinearMap.comp_apply, LinearMap.id_apply] at this
      rw [Function.comp_apply]
      convert this using 2
      simp [Fintype.linearCombination_apply, Int.cast_smul_eq_zsmul]
    have hF : Continuous (fun c : Fin m → ℤ => ∑ i, c i • v i) := continuous_of_discreteTopology
    have hemb : Topology.IsEmbedding (fun c : Fin m → ℤ => fun i => (c i : ℝ)) :=
      Topology.IsEmbedding.piMap fun _ => Int.isClosedEmbedding_coe_real.isEmbedding
    have hind : Topology.IsInducing (fun c : Fin m → ℤ => ∑ i, c i • v i) :=
      Topology.IsInducing.of_comp hF hgc (by rw [hcomp]; exact hemb.isInducing)
    refine ⟨hind, ?_⟩
    intro c d hcd
    have h1 := congrFun hcomp c
    have h2 := congrFun hcomp d
    simp only [Function.comp_apply] at h1 h2
    have h3 : (fun i => (c i : ℝ)) = fun i => (d i : ℝ) := by
      rw [← h1, ← h2]; exact congrArg g hcd
    funext i
    exact_mod_cast congrFun h3 i
  · ext x
    constructor
    · rintro ⟨c, rfl⟩
      refine sum_mem fun i _ => ?_
      exact AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_range_self i)) _
    · intro hx
      induction hx using AddSubgroup.closure_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        exact ⟨Pi.single i 1, by simp [Pi.single_apply]⟩
      | zero => exact ⟨0, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨c, rfl⟩ := hx
        obtain ⟨d, rfl⟩ := hy
        exact ⟨c + d, by simp [add_smul, Finset.sum_add_distrib]⟩
      | neg x _ hx =>
        obtain ⟨c, rfl⟩ := hx
        exact ⟨-c, by simp [neg_smul]⟩

/-- Morris, Topology Without Tears, Proposition A5.5.7 (TP-543) in the book's setting `ℝⁿ`: the
subgroup of `ℝⁿ` generated by `m` linearly independent vectors is topologically isomorphic
to `ℤᵐ`. -/
@[kb "morris2024" "Proposition A5.5.7, p. 540"]
theorem isEmbedding_intCombination_real_pi {n m : ℕ} (v : Fin m → (Fin n → ℝ))
    (hv : LinearIndependent ℝ v) :
    Topology.IsEmbedding (fun c : Fin m → ℤ => ∑ i, c i • v i) ∧
      Set.range (fun c : Fin m → ℤ => ∑ i, c i • v i) =
        (AddSubgroup.closure (Set.range v) : Set (Fin n → ℝ)) :=
  isEmbedding_intCombination_of_linearIndependent v hv

end UndergradKB.Topology
