/-!
# Wave 2: local homomorphisms, free abelian groups, closed subgroups of `V × F` (Morris, Appendix 5)

* Lemma A5.5.24: the image of the extension is the subgroup generated by the image of the local
  homomorphism, and it is open when that image is a neighbourhood of `0`.
* Definition A5.5.14: free abelian groups as restricted direct sums of copies of `ℤ`.

-/

open Set Filter Module
open scoped Topology

universe u

namespace UndergradKB.Topology

/-! ### Lemma A5.5.24: the image of the extension (TP-553) -/

section LocalHomRange

open Metric

variable {E G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [AddCommGroup G]
  [TopologicalSpace G] [IsTopologicalAddGroup G] {r : ℝ} {f : E → G}

/-- Any additive extension `F` of a local homomorphism `f` from the ball `B(0,r)` has range equal to the
subgroup generated by `f '' B(0,r)`. -/
theorem range_eq_closure_of_extends (hr : 0 < r) (F : E →+ G)
    (hF : ∀ x ∈ ball (0 : E) r, F x = f x) :
    F.range = AddSubgroup.closure (f '' ball (0 : E) r) := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    obtain ⟨k, hk0, hk⟩ := exists_admissible hr ‖x‖
    have hmem : (k : ℝ)⁻¹ • x ∈ ball (0 : E) r :=
      (show admissible r k x from ⟨hk0, hk⟩).inv_mem hr
    have hk' : (0 : ℝ) < k := by exact_mod_cast hk0
    have e : k • ((k : ℝ)⁻¹ • x) = x := by
      rw [← Nat.cast_smul_eq_nsmul ℝ, smul_smul, mul_inv_cancel₀ hk'.ne', one_smul]
    have h1 : F x = k • F ((k : ℝ)⁻¹ • x) := by rw [← map_nsmul, e]
    rw [h1, hF _ hmem]
    exact nsmul_mem (AddSubgroup.subset_closure (Set.mem_image_of_mem f hmem)) k
  · rw [AddSubgroup.closure_le]
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨x, hF x hx⟩

/-- Morris, Topology Without Tears, Lemma A5.5.24 (TP-553), the surjectivity part. A continuous local
homomorphism `f` on the ball `B(0,r)` of a real normed space into an abelian topological group extends to
a continuous homomorphism `F` which maps `E` onto the subgroup generated by `f '' B(0,r)`; if that image
is a neighbourhood of `0` (e.g. `f` maps the ball onto a neighbourhood `U` of `0`), this is the open subgroup
generated by `U`. -/
@[kb "morris2024" "Lemma A5.5.24, p. 548"]
theorem IsLocalAddHom.exists_extension_range (hr : 0 < r) (h : IsLocalAddHom r f)
    (hc : ContinuousOn f (ball (0 : E) r)) :
    ∃ F : E →+ G, Continuous F ∧ (∀ x ∈ ball (0 : E) r, F x = f x) ∧
      F.range = AddSubgroup.closure (f '' ball (0 : E) r) ∧
      (f '' ball (0 : E) r ∈ 𝓝 (0 : G) → IsOpen (F.range : Set G)) := by
  obtain ⟨F, hFc, hF⟩ := h.exists_extension hr hc
  have hrange := range_eq_closure_of_extends hr F hF
  refine ⟨F, hFc, hF, hrange, fun hU => ?_⟩
  refine AddSubgroup.isOpen_of_mem_nhds F.range (g := 0) ?_
  rw [hrange]
  exact mem_of_superset hU AddSubgroup.subset_closure

end LocalHomRange

/-! ### Free abelian groups (TP-548, Definition A5.5.14) -/

section Free

/-- Morris, Topology Without Tears, Definition A5.5.14 (TP-548). An abelian group is free (in Mathlib's
sense, `Module.Free ℤ`) if and only if it is isomorphic to a restricted direct sum `S →₀ ℤ` of copies of `ℤ`,
the basis being the set of generators of the cyclic summands. -/
@[kb "morris2024" "Definition A5.5.14, p. 545"]
theorem moduleFree_int_iff_finsupp (F : Type u) [AddCommGroup F] :
    Module.Free ℤ F ↔ ∃ S : Type u, Nonempty (F ≃+ (S →₀ ℤ)) := by
  constructor
  · intro h
    exact ⟨Module.Free.ChooseBasisIndex ℤ F, ⟨(Module.Free.chooseBasis ℤ F).repr.toAddEquiv⟩⟩
  · rintro ⟨S, ⟨e⟩⟩
    exact Module.Free.of_equiv e.toIntLinearEquiv.symm

end Free

end UndergradKB.Topology

