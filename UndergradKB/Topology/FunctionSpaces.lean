import Mathlib.Topology.CompactOpen
import Mathlib.Topology.UniformSpace.Equicontinuity
import Mathlib.Topology.Compactness.Compact
import UndergradKB.Common.Attr

/-!
# Function spaces: k-topology, joint continuity and Ascoli (Morris, Appendix 5, Section 6)

Topologies on subsets `G ⊆ F ^ E`: the `p`-topology is the subspace topology of the product topology
(Mathlib's `Pi` topology) and the `k`-topology is the compact-open topology, here introduced for an
arbitrary set of functions `G` as a bridging definition.
-/

open Filter Topology Set Uniformity

set_option linter.unusedSectionVars false

namespace UndergradKB.Topology

section KTopology

variable {E F : Type*} [TopologicalSpace E] [TopologicalSpace F]

set_option warn.classDefReducibility false in
/-- Morris, Topology Without Tears, Definition A5.6.4(b). The `k`-topology (compact-open topology) on
a set `G` of functions `E → F`, generated by the sets `{g | g(K) ⊆ U}` with `K` compact and `U` open. -/
def kTopology (G : Set (E → F)) : TopologicalSpace G :=
  TopologicalSpace.generateFrom
    {S | ∃ (K : Set E) (U : Set F), IsCompact K ∧ IsOpen U ∧ S = {g : G | g.1 '' K ⊆ U}}

/-- Morris, Topology Without Tears, Proposition A5.6.6 (TP-559). A jointly continuous topology `τ` on
`G ⊆ F ^ E` (the evaluation map `G × E → F` is continuous) is finer than the `k`-topology. (In
Mathlib's order on topologies, finer is `≤`.) -/
@[kb "morris2024" "Proposition A5.6.6, p. 554"]
theorem le_kTopology_of_jointly_continuous {G : Set (E → F)} (τ : TopologicalSpace G)
    (h : @Continuous (G × E) F (@instTopologicalSpaceProd G E τ inferInstance) _
      fun p => p.1.1 p.2) :
    τ ≤ kTopology G := by
  refine le_generateFrom ?_
  rintro _ ⟨K, U, hK, hU, rfl⟩
  let _ := τ
  rw [isOpen_iff_mem_nhds]
  intro f hf
  have hn : IsOpen ((fun p : G × E => p.1.1 p.2) ⁻¹' U) := hU.preimage h
  have hsub : ({f} : Set G) ×ˢ K ⊆ (fun p : G × E => p.1.1 p.2) ⁻¹' U := by
    rintro ⟨g, x⟩ ⟨hg, hx⟩
    have : g = f := hg
    subst this
    exact hf ⟨x, hx, rfl⟩
  obtain ⟨u, v, hu, hv, hfu, hKv, huv⟩ := generalized_tube_lemma isCompact_singleton hK hn hsub
  refine mem_of_superset (hu.mem_nhds (hfu (mem_singleton f))) ?_
  intro g hg
  rintro _ ⟨x, hx, rfl⟩
  exact huv (show (g, x) ∈ u ×ˢ v from ⟨hg, hKv hx⟩)

/-- Morris, Topology Without Tears, Proposition A5.6.6 (TP-559). Form of the same statement with
Mathlib's compact-open topology: for a set `G` of continuous maps, a jointly continuous topology on `G`
is finer than the topology induced from `C(E, F)` with its compact-open topology. -/
@[kb "morris2024" "Proposition A5.6.6, p. 554"]
theorem le_induced_compactOpen_of_jointly_continuous {G : Set C(E, F)} (τ : TopologicalSpace G)
    (h : @Continuous (G × E) F (@instTopologicalSpaceProd G E τ inferInstance) _
      fun p => p.1.1 p.2) :
    τ ≤ TopologicalSpace.induced Subtype.val ContinuousMap.compactOpen := by
  let _ := τ
  rw [← continuous_iff_le_induced]
  exact ContinuousMap.continuous_of_continuous_uncurry (fun g : G => g.1) h

/-- Morris, Topology Without Tears, Proposition A5.6.7 (TP-560). A set `G` of continuous maps is
`k`-compact if (a) `G` is closed in `C(E, F)`, (b) for each `x` the closure of `{g x | g ∈ G}` is
compact, and (c) the `p`-topology on the `p`-closure of `G` in `F ^ E` is jointly continuous. -/
@[kb "morris2024" "Proposition A5.6.7, p. 554"]
theorem isCompact_of_closed_pointwise_compact_jointly_continuous {G : Set C(E, F)}
    (hG : IsClosed G) (hb : ∀ x, IsCompact (closure ((fun g : C(E, F) => g x) '' G)))
    (hc : Continuous fun p : closure (((↑) : C(E, F) → E → F) '' G) × E => p.1.1 p.2) :
    IsCompact G := by
  set A : Set (E → F) := closure (((↑) : C(E, F) → E → F) '' G) with hA
  have hcont : ∀ h : A, Continuous h.1 := fun h =>
    hc.comp (continuous_const.prodMk continuous_id : Continuous fun x : E => (h, x))
  let ι : A → C(E, F) := fun h => ⟨h.1, hcont h⟩
  have hι : Continuous ι := ContinuousMap.continuous_of_continuous_uncurry ι hc
  have h1 : A ⊆ Set.pi univ (fun x => closure ((fun g : C(E, F) => g x) '' G)) := by
    refine closure_minimal ?_ (isClosed_set_pi fun x _ => isClosed_closure)
    rintro _ ⟨g, hg, rfl⟩ x -
    exact subset_closure ⟨g, hg, rfl⟩
  have hAc : IsCompact A := (isCompact_univ_pi hb).of_isClosed_subset isClosed_closure h1
  have : CompactSpace A := isCompact_iff_compactSpace.1 hAc
  have hsub : G ⊆ range ι := fun g hg =>
    ⟨⟨g, subset_closure ⟨g, hg, rfl⟩⟩, ContinuousMap.ext fun x => rfl⟩
  exact (isCompact_range hι).of_isClosed_subset hG hsub

end KTopology

section Equicontinuity

variable {E F : Type*} [TopologicalSpace E] [UniformSpace F]

/-- Morris, Topology Without Tears, Proposition A5.6.9 (TP-562). If a set `G` of functions is
equicontinuous at `x₀`, so is its closure in the product topology `F ^ E` (the `p`-closure). -/
@[kb "morris2024" "Proposition A5.6.9, p. 555"]
theorem equicontinuousAt_closure {G : Set (E → F)} {x₀ : E} (h : G.EquicontinuousAt x₀) :
    (closure G).EquicontinuousAt x₀ :=
  Set.EquicontinuousAt.closure h

/-- Morris, Topology Without Tears, Proposition A5.6.9 (TP-562). Form for a subset of `C(E, F)`:
equicontinuity of the family at `x₀` passes to the `p`-closure in `F ^ E`. -/
@[kb "morris2024" "Proposition A5.6.9, p. 555"]
theorem equicontinuousAt_closure_of_continuousMap {G : Set C(E, F)} {x₀ : E}
    (h : EquicontinuousAt (fun g : G => (g : E → F)) x₀) :
    (closure (((↑) : C(E, F) → E → F) '' G)).EquicontinuousAt x₀ := by
  refine Set.EquicontinuousAt.closure ?_
  intro U hU
  filter_upwards [h U hU] with x hx
  rintro ⟨_, g, hg, rfl⟩
  exact hx ⟨g, hg⟩

/-- Morris, Topology Without Tears, Proposition A5.6.10 (TP-562). On an equicontinuous set `G` of
functions the `p`-topology (the subspace topology from `F ^ E`) is jointly continuous. -/
@[kb "morris2024" "Proposition A5.6.10, p. 555"]
theorem continuous_eval_of_equicontinuous {G : Set (E → F)} (h : G.Equicontinuous) :
    Continuous fun p : G × E => p.1.1 p.2 := by
  rw [continuous_iff_continuousAt]
  rintro ⟨g₀, x₀⟩
  refine fun S hS => ?_
  obtain ⟨V, hV, hVS⟩ := UniformSpace.mem_nhds_iff.1 hS
  obtain ⟨W, hW, hsymm, hWV⟩ := comp_symm_mem_uniformity_sets hV
  have hcont : Continuous fun g : G => g.1 x₀ := (continuous_apply x₀).comp continuous_subtype_val
  have h1 : ∀ᶠ p : G × E in 𝓝 (g₀, x₀), (g₀.1 x₀, p.1.1 x₀) ∈ W :=
    (continuous_fst.tendsto (g₀, x₀)).eventually
      ((hcont.tendsto g₀).eventually (mem_nhds_left _ hW))
  have h2 : ∀ᶠ p : G × E in 𝓝 (g₀, x₀), ∀ i : G, (i.1 x₀, i.1 p.2) ∈ W :=
    (continuous_snd.tendsto (g₀, x₀)).eventually (h x₀ W hW)
  rw [mem_map]
  filter_upwards [h1, h2] with p hp1 hp2
  exact hVS (hWV ⟨_, hsymm.symm _ _ (hp2 p.1), hsymm.symm _ _ hp1⟩)

/-- Morris, Topology Without Tears, Theorem A5.6.11 (Ascoli), obtained from Propositions A5.6.7, A5.6.9
and A5.6.10 (TP-560, TP-562). A closed equicontinuous set `G ⊆ C(E, F)` with relatively compact
orbits `{g x | g ∈ G}` is compact in the compact-open topology. -/
@[kb "morris2024" "Theorem A5.6.11, p. 555"]
theorem isCompact_of_closed_equicontinuous {G : Set C(E, F)} (hG : IsClosed G)
    (hb : ∀ x, IsCompact (closure ((fun g : C(E, F) => g x) '' G)))
    (hE : Equicontinuous (fun g : G => (g : E → F))) : IsCompact G := by
  refine isCompact_of_closed_pointwise_compact_jointly_continuous hG hb ?_
  exact continuous_eval_of_equicontinuous (fun x₀ => equicontinuousAt_closure_of_continuousMap (hE x₀))

end Equicontinuity

end UndergradKB.Topology
