import Mathlib.Topology.Algebra.Group.Basic
import Mathlib.Topology.Connected.Basic
import Mathlib.Topology.Constructions
import Mathlib.GroupTheory.Commutator.Basic
import UndergradKB.Common.Attr

/-! # The commutator subgroup of a connected group is connected (Morris, Theorem A5.0.30, part)

* `isConnected_closure_of_isPreconnected`: in a topological group, the subgroup generated by a
  preconnected set containing `1` is connected.
* `isConnected_commutator` (Morris, Theorem A5.0.30, first assertion, TP-502): the commutator
  subgroup `G'` of a connected topological group is connected.  No compactness is needed for this
  part.  The remaining assertions of the theorem for connected compact groups (every element of `G'` is
  a commutator, `G'` is closed, `G'' = G'`) rest on Goto's commutator theorem and the structure of
  compact Lie groups, which are not in Mathlib.
-/

open Set Topology
open scoped commutatorElement

namespace UndergradKB.Topology

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- In a topological group, the subgroup generated by a preconnected set containing `1` is
connected: it equals the connected component of `1` in itself. -/
theorem isConnected_closure_of_isPreconnected {S : Set G} (hS : IsPreconnected S) (h1 : (1 : G) ∈ S) :
    IsConnected (Subgroup.closure S : Set G) := by
  set H := Subgroup.closure S
  set C := connectedComponentIn (H : Set G) 1
  have hCH : C ⊆ H := connectedComponentIn_subset _ _
  have h1C : (1 : G) ∈ C := mem_connectedComponentIn H.one_mem
  have hCconn : IsPreconnected C := isPreconnected_connectedComponentIn
  -- `C` is a subgroup
  let K : Subgroup G :=
    { carrier := C
      one_mem' := h1C
      mul_mem' := by
        intro x y hx hy
        have hxH : x ∈ H := hCH hx
        have hsub : (fun z => x * z) '' C ⊆ connectedComponentIn (H : Set G) x := by
          refine (hCconn.image (fun z => x * z)
            (continuous_const.mul continuous_id).continuousOn).subset_connectedComponentIn
            ⟨1, h1C, mul_one x⟩ ?_
          rintro _ ⟨z, hz, rfl⟩
          exact H.mul_mem hxH (hCH hz)
        rw [← connectedComponentIn_eq hx] at hsub
        exact hsub ⟨y, hy, rfl⟩
      inv_mem' := by
        intro x hx
        have hsub : (fun z => z⁻¹) '' C ⊆ C := by
          refine (hCconn.image (fun z => z⁻¹) continuous_inv.continuousOn).subset_connectedComponentIn
            ⟨1, h1C, inv_one⟩ ?_
          rintro _ ⟨z, hz, rfl⟩
          exact H.inv_mem (hCH hz)
        exact hsub ⟨x, hx, rfl⟩ }
  have hSC : S ⊆ C := hS.subset_connectedComponentIn h1 (Subgroup.subset_closure)
  have hHK : H ≤ K := (Subgroup.closure_le K).2 hSC
  have hHC : (H : Set G) = C := Subset.antisymm (fun x hx => hHK hx) hCH
  rw [hHC]
  exact ⟨⟨1, h1C⟩, hCconn⟩

/-- **Morris, Theorem A5.0.30 (TP-502), first assertion.**  The commutator subgroup `G'` of a
connected topological group (in particular of a connected compact group) is connected. -/
@[kb "morris2024" "Theorem A5.0.30, p. 511"]
theorem isConnected_commutator [ConnectedSpace G] : IsConnected (commutator G : Set G) := by
  rw [commutator_eq_closure]
  refine isConnected_closure_of_isPreconnected ?_ (one_mem_commutatorSet G)
  have : commutatorSet G = range (fun p : G × G => p.1 * p.2 * p.1⁻¹ * p.2⁻¹) := by
    ext g; simp [commutatorSet, commutatorElement_def]
  rw [this]
  exact isPreconnected_range (((continuous_fst.mul continuous_snd).mul continuous_fst.inv).mul
    continuous_snd.inv)

end UndergradKB.Topology
