import UndergradKB.Topology.LCASeparation
import Mathlib.Topology.Algebra.Group.Quotient
import UndergradKB.Common.Attr

/-!
# Lattices in compactly generated locally compact abelian groups (TP-598, book form)

Morris, *Topology Without Tears*, Proposition A5.12.5: if a locally compact Hausdorff abelian group
`G` is algebraically generated by a compact symmetric neighbourhood `V` of the identity, then `G` has
a closed subgroup `A` topologically isomorphic to `ℤⁿ` for some `n`, with `G / A` compact and
`V ∩ A = {1}`.

Wave 2 proved the form used for Theorem A5.12.6 (`LCA.exists_discrete_cocompact`). Here we keep track
of a free basis of the discrete subgroup through the same induction (Weil's lemma: the closure of a
cyclic subgroup is compact, or the cyclic subgroup is closed, discrete and infinite), and then use
the book's trick: replacing the basis `a₁, …, aₙ` by `a₁ʳ, …, aₙʳ` for a large `r` makes the subgroup
meet `V` only in `1` (the finitely many points of `A ∩ V` have coordinates of size `< r`), while
`G / A` stays compact (the new subgroup has finite index in the old one).
-/

open Topology Set Pointwise

set_option linter.unusedSectionVars false

namespace UndergradKB.Topology

namespace LCA

universe u

section Lattice

variable {G : Type*} [CommGroup G]

/-- The homomorphism `ℤⁿ → G`, `k ↦ ∏ aᵢ ^ kᵢ`, determined by `a₁, …, aₙ`. -/
def latticeHom {n : ℕ} (a : Fin n → G) : Multiplicative (Fin n → ℤ) →* G where
  toFun k := ∏ i, a i ^ (Multiplicative.toAdd k i)
  map_one' := by simp
  map_mul' k l := by
    simp only [toAdd_mul, Pi.add_apply, zpow_add]
    exact Finset.prod_mul_distrib

theorem latticeHom_apply {n : ℕ} (a : Fin n → G) (k : Multiplicative (Fin n → ℤ)) :
    latticeHom a k = ∏ i, a i ^ (Multiplicative.toAdd k i) := rfl

/-- `latticeHom` for `Fin.cons h a` splits off the first coordinate. -/
theorem latticeHom_cons {n : ℕ} (h : G) (a : Fin n → G) (k : Multiplicative (Fin (n + 1) → ℤ)) :
    latticeHom (Fin.cons h a : Fin (n + 1) → G) k =
      h ^ (Multiplicative.toAdd k 0) *
        latticeHom a (Multiplicative.ofAdd (Fin.tail (Multiplicative.toAdd k))) := by
  rw [latticeHom_apply, Fin.prod_univ_succ]
  rfl

/-- The vector `(j, k₁, …, kₙ)`. -/
def consVec {n : ℕ} (j : ℤ) (k : Multiplicative (Fin n → ℤ)) : Multiplicative (Fin (n + 1) → ℤ) :=
  Multiplicative.ofAdd (Fin.cons j (Multiplicative.toAdd k))

theorem latticeHom_cons_consVec {n : ℕ} (h : G) (a : Fin n → G) (j : ℤ)
    (k : Multiplicative (Fin n → ℤ)) :
    latticeHom (Fin.cons h a : Fin (n + 1) → G) (consVec j k) = h ^ j * latticeHom a k := by
  rw [latticeHom_cons]
  rfl

/-- `latticeHom` of the `r`-th powers is `latticeHom` of `r` times the vector. -/
theorem latticeHom_pow {n : ℕ} (a : Fin n → G) (r : ℕ) (k : Multiplicative (Fin n → ℤ)) :
    latticeHom (fun i => a i ^ r) k = latticeHom a (k ^ r) := by
  simp only [latticeHom_apply, toAdd_pow]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [nsmul_eq_mul, ← zpow_natCast, ← zpow_mul]
  rfl

end Lattice

variable {G : Type u} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G] [T2Space G]
  [LocallyCompactSpace G]

/-- The inductive core of Proposition A5.12.5 with a free basis: if `G = V · ⟨g₁, …, g_m⟩` with `V`
compact, there are `a₁, …, aₙ` such that `k ↦ ∏ aᵢ ^ kᵢ` is injective with discrete image `A`, and
`G = C · A` for a compact set `C`. -/
theorem exists_lattice_cocompact : ∀ (m : ℕ) (G : Type u) [CommGroup G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] [LocallyCompactSpace G] (V : Set G), IsCompact V →
    ∀ g : Fin m → G, (∀ y : G, ∃ v ∈ V, ∃ w ∈ Subgroup.closure (Set.range g), y = v * w) →
    ∃ (n : ℕ) (a : Fin n → G), Function.Injective (latticeHom a) ∧
      DiscreteTopology (latticeHom a).range ∧
      ∃ C : Set G, IsCompact C ∧ ∀ y, ∃ c ∈ C, ∃ b ∈ (latticeHom a).range, y = c * b := by
  intro m
  induction m with
  | zero =>
    intro G _ _ _ _ _ V hV g hg
    refine ⟨0, Fin.elim0, fun k l _ => Subsingleton.elim k l, ?_, V, hV, fun y => ?_⟩
    · have : Subsingleton (latticeHom (Fin.elim0 : Fin 0 → G)).range := by
        refine ⟨fun ⟨x, k, hk⟩ ⟨y, l, hl⟩ => Subtype.ext ?_⟩
        simp only [← hk, ← hl, latticeHom_apply, Finset.univ_eq_empty, Finset.prod_empty]
      infer_instance
    obtain ⟨v, hv, w, hw, rfl⟩ := hg y
    have hw1 : w = 1 := by
      rw [Set.range_eq_empty g, Subgroup.closure_empty, Subgroup.mem_bot] at hw
      exact hw
    exact ⟨v, hv, 1, one_mem _, by simp [hw1]⟩
  | succ m ih =>
    intro G _ _ _ _ _ V hV g hg
    set h := g (Fin.last m)
    set g' : Fin m → G := fun i => g i.castSucc
    have hcl : ∀ w ∈ Subgroup.closure (Set.range g),
        ∃ w' ∈ Subgroup.closure (Set.range g'), ∃ n : ℤ, w = w' * h ^ n := by
      intro w hw
      have hle : Subgroup.closure (Set.range g) ≤
          Subgroup.closure (Set.range g') ⊔ Subgroup.zpowers h := by
        rw [Subgroup.closure_le]
        rintro _ ⟨i, rfl⟩
        induction i using Fin.lastCases with
        | last => exact Subgroup.mem_sup_right (Subgroup.mem_zpowers h)
        | cast j => exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨j, rfl⟩)
      obtain ⟨w', hw', z, hz, rfl⟩ := Subgroup.mem_sup.1 (hle hw)
      obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hz
      exact ⟨w', hw', n, rfl⟩
    have hcompact_case : IsCompact (closure (Subgroup.zpowers h : Set G)) →
        ∃ (n : ℕ) (a : Fin n → G), Function.Injective (latticeHom a) ∧
          DiscreteTopology (latticeHom a).range ∧
          ∃ C : Set G, IsCompact C ∧ ∀ y, ∃ c ∈ C, ∃ b ∈ (latticeHom a).range, y = c * b := by
      intro hS
      refine ih G (V * closure (Subgroup.zpowers h : Set G)) (hV.mul hS) g' (fun y => ?_)
      obtain ⟨v, hv, w, hw, rfl⟩ := hg y
      obtain ⟨w', hw', n, rfl⟩ := hcl w hw
      refine ⟨v * h ^ n, Set.mul_mem_mul hv (subset_closure (Subgroup.zpow_mem_zpowers h n)),
        w', hw', ?_⟩
      rw [mul_comm w', mul_assoc]
    rcases LCA.weil_mul h with hS | ⟨hZc, hZd⟩
    · exact hcompact_case hS
    by_cases hfin : IsOfFinOrder h
    · apply hcompact_case
      have hfinite : (Subgroup.zpowers h : Set G).Finite := by
        have : Finite (Subgroup.zpowers h) := hfin.finite_zpowers
        exact Set.toFinite _
      rw [hfinite.isClosed.closure_eq]
      exact hfinite.isCompact
    have hinj : Function.Injective (fun n : ℤ => h ^ n) := injective_zpow_iff_not_isOfFinOrder.2 hfin
    set Z := Subgroup.zpowers h
    have : DiscreteTopology Z := hZd
    have : IsClosed (Z : Set G) := hZc
    have hhZ : ((h : G) : G ⧸ Z) = 1 := (QuotientGroup.eq_one_iff _).2 (Subgroup.mem_zpowers _)
    have hV'' : IsCompact (QuotientGroup.mk '' V : Set (G ⧸ Z)) :=
      hV.image QuotientGroup.continuous_mk
    have hcover : ∀ y' : G ⧸ Z, ∃ v ∈ (QuotientGroup.mk '' V : Set (G ⧸ Z)),
        ∃ w ∈ Subgroup.closure (Set.range fun i => (g' i : G ⧸ Z)), y' = v * w := by
      intro y'
      obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective y'
      obtain ⟨v, hv, w, hw, rfl⟩ := hg y
      obtain ⟨w', hw', n, rfl⟩ := hcl w hw
      refine ⟨QuotientGroup.mk v, ⟨v, hv, rfl⟩, QuotientGroup.mk w', ?_, ?_⟩
      · have : (Subgroup.closure (Set.range g')).map (QuotientGroup.mk' Z) =
            Subgroup.closure (Set.range fun i => (g' i : G ⧸ Z)) := by
          rw [MonoidHom.map_closure, ← Set.range_comp]
          rfl
        rw [← this]
        exact ⟨w', hw', rfl⟩
      · simp only [QuotientGroup.mk_mul, QuotientGroup.mk_zpow, hhZ, one_zpow, mul_one]
    obtain ⟨n', a', ha'inj, ha'd, C', hC'c, hC'⟩ :=
      ih (G ⧸ Z) _ hV'' (fun i => (g' i : G ⧸ Z)) hcover
    -- lift the basis
    let a'' : Fin n' → G := fun i => (a' i).out
    have ha'' : ∀ i, ((a'' i : G) : G ⧸ Z) = a' i := fun i => QuotientGroup.out_eq' (a' i)
    have hmk : ∀ k, ((latticeHom a'' k : G) : G ⧸ Z) = latticeHom a' k := by
      intro k
      simp only [latticeHom_apply]
      rw [← QuotientGroup.mk'_apply, map_prod]
      refine Finset.prod_congr rfl fun i _ => ?_
      rw [map_zpow, QuotientGroup.mk'_apply, ha'']
    let a : Fin (n' + 1) → G := Fin.cons h a''
    have hsplit : ∀ k : Multiplicative (Fin (n' + 1) → ℤ), latticeHom a k =
        h ^ (Multiplicative.toAdd k 0) *
          latticeHom a'' (Multiplicative.ofAdd (Fin.tail (Multiplicative.toAdd k))) :=
      fun k => latticeHom_cons h a'' k
    have hrange : (latticeHom a).range = (latticeHom a').range.comap (QuotientGroup.mk' Z) := by
      ext y
      constructor
      · rintro ⟨k, rfl⟩
        refine ⟨Multiplicative.ofAdd (Fin.tail (Multiplicative.toAdd k)), ?_⟩
        rw [QuotientGroup.mk'_apply, hsplit, QuotientGroup.mk_mul, QuotientGroup.mk_zpow, hhZ,
          one_zpow, one_mul, hmk]
      · rintro ⟨k', hk'⟩
        have hq : ((latticeHom a'' k')⁻¹ * y : G) ∈ Z := by
          rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_mul, QuotientGroup.mk_inv, hmk]
          rw [QuotientGroup.mk'_apply] at hk'
          rw [hk', inv_mul_cancel]
        obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.1 hq
        refine ⟨consVec j k', ?_⟩
        rw [latticeHom_cons_consVec, hj, mul_comm, mul_inv_cancel_left]
    refine ⟨n' + 1, a, ?_, ?_, ?_⟩
    · -- injectivity
      rw [injective_iff_map_eq_one]
      intro k hk
      have hk' : latticeHom a' (Multiplicative.ofAdd (Fin.tail (Multiplicative.toAdd k))) = 1 := by
        have := congrArg (fun y : G => (y : G ⧸ Z)) hk
        simp only [hsplit, QuotientGroup.mk_mul, QuotientGroup.mk_zpow, hhZ, one_zpow, one_mul,
          hmk, QuotientGroup.mk_one] at this
        exact this
      have htail := (injective_iff_map_eq_one _).1 ha'inj _ hk'
      have htail' : Fin.tail (Multiplicative.toAdd k) = 0 := by
        have := congrArg Multiplicative.toAdd htail
        simpa using this
      have hrest : latticeHom a'' (Multiplicative.ofAdd (Fin.tail (Multiplicative.toAdd k))) = 1 := by
        rw [htail']
        exact map_one _
      rw [hsplit, hrest, mul_one] at hk
      have h0 : Multiplicative.toAdd k 0 = 0 := hinj (by simpa using hk)
      apply Multiplicative.toAdd.injective
      funext i
      refine Fin.cases ?_ (fun j => ?_) i
      · simpa using h0
      · have := congrFun htail' j
        simpa [Fin.tail] using this
    · rw [hrange]
      exact LCA.discreteTopology_comap _
    · obtain ⟨C, hCc, hCC'⟩ := LCA.exists_isCompact_lift Z hC'c
      refine ⟨C, hCc, fun y => ?_⟩
      obtain ⟨c', hc', b', hb', hy⟩ := hC' (y : G ⧸ Z)
      obtain ⟨c, hc, hcc'⟩ := hCC' hc'
      refine ⟨c, hc, c⁻¹ * y, ?_, by group⟩
      rw [hrange]
      show ((c⁻¹ * y : G) : G ⧸ Z) ∈ (latticeHom a').range
      rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, hy, hcc', inv_mul_cancel_left]
      exact hb'

section Book

variable {G : Type u} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G] [T2Space G]
  [LocallyCompactSpace G]

/-- First step of the proof of Proposition A5.12.5: if `G` is generated by a compact neighbourhood
`V` of `1` closed under inverses, then `G = V · ⟨g₁, …, g_m⟩` for finitely many `gᵢ` (those with
`V V ⊆ ⋃ gᵢ V`). -/
theorem exists_fin_generators (V : Set G) (hVc : IsCompact V) (hVn : V ∈ 𝓝 (1 : G))
    (hVinv : ∀ y ∈ V, y⁻¹ ∈ V) (hgen : Subgroup.closure V = ⊤) :
    ∃ (m : ℕ) (g : Fin m → G), ∀ y : G, ∃ v ∈ V, ∃ w ∈ Subgroup.closure (Set.range g),
      y = v * w := by
  classical
  have hV1 : (1 : G) ∈ V := mem_of_mem_nhds hVn
  obtain ⟨t, ht⟩ := (hVc.mul hVc).elim_nhds_subcover' (fun y _ => (fun z => y⁻¹ * z) ⁻¹' V)
    (fun y _ => (continuous_const.mul continuous_id).continuousAt.preimage_mem_nhds
      (by simpa using hVn))
  let F : Finset G := t.image (↑)
  have hFV : ∀ y ∈ V * V, ∃ f ∈ (F : Set G), ∃ v ∈ V, y = f * v := by
    intro y hy
    obtain ⟨f, hft, hyf⟩ := Set.mem_iUnion₂.1 (ht hy)
    exact ⟨f, Finset.mem_coe.2 (Finset.mem_image_of_mem _ hft), (f : G)⁻¹ * y, hyf,
      (mul_inv_cancel_left _ _).symm⟩
  have hgenF : ∀ z ∈ Subgroup.closure V, ∃ v ∈ V, ∃ w ∈ Subgroup.closure (F : Set G),
      z = v * w := by
    intro z hz
    induction hz using Subgroup.closure_induction with
    | mem z hz => exact ⟨z, hz, 1, one_mem _, (mul_one z).symm⟩
    | one => exact ⟨1, hV1, 1, one_mem _, (mul_one 1).symm⟩
    | mul a b _ _ ha hb =>
      obtain ⟨v1, hv1, w1, hw1, rfl⟩ := ha
      obtain ⟨v2, hv2, w2, hw2, rfl⟩ := hb
      obtain ⟨f, hf, v3, hv3, h3⟩ := hFV (v1 * v2) (Set.mul_mem_mul hv1 hv2)
      refine ⟨v3, hv3, f * (w1 * w2), mul_mem (Subgroup.subset_closure hf) (mul_mem hw1 hw2), ?_⟩
      calc v1 * w1 * (v2 * w2) = (v1 * v2) * (w1 * w2) := by ac_rfl
        _ = v3 * (f * (w1 * w2)) := by rw [h3]; ac_rfl
    | inv a _ ha =>
      obtain ⟨v, hv, w, hw, rfl⟩ := ha
      exact ⟨v⁻¹, hVinv v hv, w⁻¹, inv_mem hw, by rw [mul_inv]⟩
  refine ⟨F.card, fun i => (F.equivFin.symm i : G), fun y => ?_⟩
  have hrange : Set.range (fun i => (F.equivFin.symm i : G)) = (F : Set G) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (F.equivFin.symm i).2
    · intro hy
      exact ⟨F.equivFin ⟨y, hy⟩, by simp⟩
  rw [hrange]
  exact hgenF y (hgen ▸ Subgroup.mem_top y)

/-- Morris, Topology Without Tears, Proposition A5.12.5 (TP-598). Let `G` be a locally compact
Hausdorff abelian group generated (algebraically) by a compact symmetric neighbourhood `V` of the
identity. Then `G` has a closed subgroup `A` topologically isomorphic to `ℤⁿ` for some `n ≥ 0`, such
that `G / A` is compact and `V ∩ A = {1}`. -/
@[kb "morris2024" "Proposition A5.12.5, p. 583"]
theorem exists_closedSubgroup_int_pow_cocompact (V : Set G) (hVc : IsCompact V)
    (hVn : V ∈ 𝓝 (1 : G)) (hVsymm : V⁻¹ = V) (hgen : Subgroup.closure V = ⊤) :
    ∃ (n : ℕ) (A : Subgroup G), Nonempty (A ≃ₜ* Multiplicative (Fin n → ℤ)) ∧
      IsClosed (A : Set G) ∧ CompactSpace (G ⧸ A) ∧ V ∩ (A : Set G) = {1} := by
  classical
  have hVinv : ∀ y ∈ V, y⁻¹ ∈ V := fun y hy => by
    rw [← hVsymm]
    exact Set.inv_mem_inv.2 hy
  obtain ⟨m, g, hg⟩ := exists_fin_generators V hVc hVn hVinv hgen
  obtain ⟨n, a, hinj, hdisc, C, hCc, hC⟩ := exists_lattice_cocompact m G V hVc g hg
  set L := latticeHom a with hL
  have hAcl : IsClosed (L.range : Set G) := Subgroup.isClosed_of_discreteTopology
  -- the coordinates of the finitely many points of `A ∩ V` are bounded
  let T : Set (Multiplicative (Fin n → ℤ)) := {k | L k ∈ V}
  have hT : T.Finite := by
    let K : Set L.range := (↑) ⁻¹' V
    have hK : K.Finite :=
      (hAcl.isClosedEmbedding_subtypeVal.isCompact_preimage hVc).finite_of_discrete
    let e := MonoidHom.ofInjective hinj
    have : T = e ⁻¹' K := by
      ext k
      simp [T, K, e, MonoidHom.ofInjective_apply]
    rw [this]
    exact hK.preimage e.injective.injOn
  obtain ⟨B, hB⟩ := (hT.image fun k => ∑ i, (Multiplicative.toAdd k i).natAbs).bddAbove
  have hBi : ∀ k ∈ T, ∀ i, (Multiplicative.toAdd k i).natAbs ≤ B := by
    intro k hk i
    refine le_trans ?_ (hB ⟨k, hk, rfl⟩)
    exact Finset.single_le_sum (f := fun i => (Multiplicative.toAdd k i).natAbs)
      (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
  set r : ℕ := B + 1 with hr
  have hr0 : (0 : ℤ) < r := by positivity
  -- the subgroup generated by the `r`-th powers of the basis
  set L2 := latticeHom fun i => a i ^ r with hL2
  have hL2L : ∀ k, L2 k = L (k ^ r) := fun k => latticeHom_pow a r k
  have hinj2 : Function.Injective L2 := by
    intro k l hkl
    rw [hL2L, hL2L] at hkl
    have h1 := congrArg Multiplicative.toAdd (hinj hkl)
    simp only [toAdd_pow] at h1
    apply Multiplicative.toAdd.injective
    funext i
    have h2 := congrFun h1 i
    simp only [Pi.smul_apply, nsmul_eq_mul] at h2
    exact mul_left_cancel₀ hr0.ne' h2
  have hsub : (L2.range : Set G) ⊆ L.range := by
    rintro _ ⟨k, rfl⟩
    exact ⟨k ^ r, (hL2L k).symm⟩
  have hdisc2 : DiscreteTopology L2.range := DiscreteTopology.of_subset hdisc hsub
  have hcl2 : IsClosed (L2.range : Set G) := Subgroup.isClosed_of_discreteTopology
  refine ⟨n, L2.range, ⟨?_⟩, hcl2, ?_, ?_⟩
  · -- a bijective homomorphism between discrete groups is a topological isomorphism
    let e2 := (MonoidHom.ofInjective hinj2).symm
    exact { e2 with
      continuous_toFun := continuous_of_discreteTopology
      continuous_invFun := continuous_of_discreteTopology }
  · -- `G / A` is the image of the compact set `C F`, `F` the finite set of `L s`, `0 ≤ sᵢ < r`
    let S : Set (Multiplicative (Fin n → ℤ)) :=
      Multiplicative.toAdd ⁻¹' Set.pi Set.univ fun _ => Set.Ico (0 : ℤ) r
    have hS : S.Finite := by
      have : (Set.pi Set.univ fun _ : Fin n => Set.Ico (0 : ℤ) r).Finite :=
        Set.Finite.pi fun _ => Set.finite_Ico _ _
      exact this.preimage Multiplicative.toAdd.injective.injOn
    have hCF : IsCompact (C * L '' S) := hCc.mul (hS.image L).isCompact
    refine isCompact_univ_iff.1 ((hCF.image QuotientGroup.continuous_mk).of_isClosed_subset
      isClosed_univ fun q _ => ?_)
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective q
    obtain ⟨c, hc, b, ⟨k, rfl⟩, rfl⟩ := hC y
    let s : Multiplicative (Fin n → ℤ) :=
      Multiplicative.ofAdd fun i => Multiplicative.toAdd k i % (r : ℤ)
    let p : Multiplicative (Fin n → ℤ) :=
      Multiplicative.ofAdd fun i => Multiplicative.toAdd k i / (r : ℤ)
    have hks : k = s * p ^ r := by
      apply Multiplicative.toAdd.injective
      funext i
      simp only [s, p, toAdd_mul, toAdd_pow, toAdd_ofAdd, Pi.add_apply, nsmul_eq_mul]
      rw [Int.emod_def]
      simp only [Pi.mul_apply, Pi.natCast_apply]
      ring
    have hsS : s ∈ S := by
      intro i _
      exact ⟨Int.emod_nonneg _ hr0.ne', Int.emod_lt_of_pos _ hr0⟩
    refine ⟨c * L s, Set.mul_mem_mul hc ⟨s, hsS, rfl⟩, ?_⟩
    rw [QuotientGroup.eq]
    refine ⟨p, ?_⟩
    rw [hL2L, hks, map_mul]
    group
  · ext y
    simp only [Set.mem_inter_iff, SetLike.mem_coe, Set.mem_singleton_iff]
    constructor
    · rintro ⟨hyV, k, rfl⟩
      have hkT : k ^ r ∈ T := by
        show L (k ^ r) ∈ V
        rw [← hL2L]
        exact hyV
      have hk1 : k = 1 := by
        apply Multiplicative.toAdd.injective
        funext i
        have h1 := hBi _ hkT i
        simp only [toAdd_pow, Pi.smul_apply, nsmul_eq_mul, Int.natAbs_mul, Int.natAbs_natCast]
          at h1
        simp only [toAdd_one, Pi.zero_apply]
        by_contra hne
        have : 1 ≤ (Multiplicative.toAdd k i).natAbs := Int.natAbs_pos.2 hne
        have : r ≤ r * (Multiplicative.toAdd k i).natAbs := Nat.le_mul_of_pos_right r this
        omega
      rw [hk1, map_one]
    · rintro rfl
      exact ⟨mem_of_mem_nhds hVn, one_mem _⟩

end Book

end LCA

end UndergradKB.Topology
