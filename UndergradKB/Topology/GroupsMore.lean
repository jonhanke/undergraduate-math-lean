/-!
# More on topological groups (Morris, Topology Without Tears, Appendix 5)

Group topologies, subgroup topologies, `ω`-narrow groups, locally isomorphic groups, the
canonical map to the double dual, torsion in the dual, inverse limits, and open compactly generated
subgroups. Results which need the Pontryagin duality theorem are not included.
-/

open Set Filter Topology Pointwise

universe u v

namespace UndergradKB.Topology

/-! ### TP-511: group topologies, subgroup topologies, `ω`-narrow groups -/

section GroupTopology

/-- Morris, Topology Without Tears, Remark A5.1.3 (TP-511). A topology on a group is a group
topology if it makes the group a topological group. -/
def IsGroupTopology {G : Type*} [Group G] (τ : TopologicalSpace G) : Prop :=
  @IsTopologicalGroup G τ _

set_option warn.classDefReducibility false in
/-- The topology on a group `G` generated by the cosets `g N` (`g ∈ G`, `N` in a family `𝒩` of
subgroups): the book's "subgroup topology". -/
def subgroupTopology {G : Type*} [Group G] (𝒩 : Set (Subgroup G)) : TopologicalSpace G :=
  TopologicalSpace.generateFrom {s | ∃ (g : G) (N : Subgroup G), N ∈ 𝒩 ∧ s = g • (N : Set G)}

variable {G : Type*} [Group G]

/-- Morris, Topology Without Tears, Exercises A5.1 #2 (i) (TP-511). The subgroup topology
generated by a family of normal subgroups is a group topology. -/
@[kb "morris2024" "Exercises A5.1, p. 518"]
theorem isGroupTopology_subgroupTopology (𝒩 : Set (Subgroup G)) (h : ∀ N ∈ 𝒩, N.Normal) :
    IsGroupTopology (subgroupTopology 𝒩) := by
  let _ : TopologicalSpace G := subgroupTopology 𝒩
  have hopen : ∀ (g : G) (N : Subgroup G), N ∈ 𝒩 → IsOpen (g • (N : Set G)) := fun g N hN =>
    TopologicalSpace.isOpen_generateFrom_of_mem ⟨g, N, hN, rfl⟩
  have hmem : ∀ (x g : G) (N : Subgroup G), x ∈ g • (N : Set G) → g • (N : Set G) = x • (N : Set G) := by
    intro x g N hx
    obtain ⟨n, hn, rfl⟩ := hx
    ext y
    simp only [mem_smul_set, SetLike.mem_coe, smul_eq_mul]
    constructor
    · rintro ⟨m, hm, rfl⟩
      exact ⟨n⁻¹ * m, N.mul_mem (N.inv_mem hn) hm, by group⟩
    · rintro ⟨m, hm, rfl⟩
      exact ⟨n * m, N.mul_mem hn hm, by group⟩
  have hcoset : ∀ (g x : G) (N : Subgroup G), x ∈ g • (N : Set G) ↔ g⁻¹ * x ∈ N := by
    intro g x N
    simp only [mem_smul_set, SetLike.mem_coe, smul_eq_mul]
    constructor
    · rintro ⟨n, hn, rfl⟩; simpa using hn
    · intro hx; exact ⟨g⁻¹ * x, hx, by group⟩
  have hinv : Continuous (fun x : G => x⁻¹) := by
    refine continuous_generateFrom_iff.2 ?_
    rintro s ⟨g, N, hN, rfl⟩
    have : (fun x : G => x⁻¹) ⁻¹' (g • (N : Set G)) = g⁻¹ • (N : Set G) := by
      ext x
      simp only [mem_preimage, hcoset]
      have hn := h N hN
      constructor
      · intro hx
        have h1 : x * g ∈ N := by simpa [mul_inv_rev] using N.inv_mem hx
        have := hn.conj_mem _ h1 g
        simpa [mul_assoc] using this
      · intro hx
        have h1 : x * g ∈ N := by
          have := hn.conj_mem _ hx g⁻¹
          simpa [mul_assoc] using this
        simpa [mul_inv_rev] using N.inv_mem h1
    rw [this]
    exact hopen _ N hN
  have hmul : Continuous (fun p : G × G => p.1 * p.2) := by
    refine continuous_generateFrom_iff.2 ?_
    rintro s ⟨g, N, hN, rfl⟩
    refine isOpen_prod_iff.2 fun a b hab => ?_
    have hab' : a * b ∈ g • (N : Set G) := hab
    refine ⟨a • (N : Set G), b • (N : Set G), hopen a N hN, hopen b N hN,
      ⟨1, N.one_mem, by simp⟩, ⟨1, N.one_mem, by simp⟩, ?_⟩
    rintro ⟨x, y⟩ ⟨hx, hy⟩
    show x * y ∈ g • (N : Set G)
    rw [hmem _ _ N hab', hcoset]
    rw [hcoset] at hx hy
    have hn := h N hN
    have := N.mul_mem (hn.conj_mem _ hx b⁻¹ |> fun t => by simpa [mul_assoc] using t) hy
    simpa [mul_assoc] using this
  exact { continuous_mul := hmul, continuous_inv := hinv }

/-- An `ω`-narrow group (Morris, Exercises A5.1 #6, TP-511): for every neighbourhood `U` of `1`
there is a countable set `S` with `G = ⋃ x ∈ S, U x`. -/
def IsOmegaNarrow (G : Type*) [Group G] [TopologicalSpace G] : Prop :=
  ∀ U ∈ 𝓝 (1 : G), ∃ S : Set G, S.Countable ∧ (⋃ x ∈ S, U * {x}) = Set.univ

variable [TopologicalSpace G]

/-- Morris, Topology Without Tears, Exercises A5.1 #6 (i) (TP-511). Every countable topological
group is `ω`-narrow. -/
@[kb "morris2024" "Exercises A5.1, p. 518"]
theorem isOmegaNarrow_of_countable [Countable G] : IsOmegaNarrow G := fun U hU =>
  ⟨Set.univ, Set.countable_univ, Set.eq_univ_of_forall fun y =>
    Set.mem_iUnion₂.2 ⟨y, trivial, ⟨1, mem_of_mem_nhds hU, y, rfl, by simp⟩⟩⟩

/-- Morris, Topology Without Tears, Exercises A5.1 #6 (iv), (v) (TP-511). Every topological group
which is a Lindelöf space (for instance a compact or a second countable group) is `ω`-narrow. -/
@[kb "morris2024" "Exercises A5.1, p. 518"]
theorem isOmegaNarrow_of_lindelofSpace [IsTopologicalGroup G] [LindelofSpace G] :
    IsOmegaNarrow G := by
  intro U hU
  have hV : interior U ∈ 𝓝 (1 : G) := interior_mem_nhds.2 hU
  obtain ⟨S, hS, hcov⟩ := isLindelof_univ.elim_countable_subcover
    (fun x : G => interior U * {x}) (fun x => isOpen_interior.mul_right)
    (fun y _ => Set.mem_iUnion.2 ⟨y, ⟨1, mem_of_mem_nhds hV, y, rfl, by simp⟩⟩)
  refine ⟨S, hS, Set.eq_univ_of_forall fun y => ?_⟩
  obtain ⟨x, hx, hy⟩ := Set.mem_iUnion₂.1 (hcov (Set.mem_univ y))
  obtain ⟨a, ha, b, hb, rfl⟩ := hy
  refine Set.mem_iUnion₂.2 ⟨x, hx, a, interior_subset ha, b, hb, rfl⟩

/-- Morris, Topology Without Tears, Exercises A5.1 #6 (iii) (TP-511). An uncountable discrete
group is not `ω`-narrow. -/
@[kb "morris2024" "Exercises A5.1, p. 518"]
theorem not_isOmegaNarrow_of_uncountable [DiscreteTopology G] [Uncountable G] :
    ¬ IsOmegaNarrow G := by
  intro h
  obtain ⟨S, hS, hcov⟩ := h {1} (isOpen_discrete _ |>.mem_nhds rfl)
  have hsub : (Set.univ : Set G) ⊆ S := by
    intro y _
    have hy : y ∈ ⋃ x ∈ S, ({1} : Set G) * {x} := by rw [hcov]; trivial
    obtain ⟨x, hx, hyx⟩ := Set.mem_iUnion₂.1 hy
    obtain ⟨a, ha, b, hb, rfl⟩ := hyx
    rw [Set.mem_singleton_iff] at ha hb
    subst ha hb
    simpa using hx
  exact Set.not_countable_univ (hS.mono hsub)

end GroupTopology

/-! ### TP-551, TP-552: locally isomorphic groups -/

section LocalIso

/-- Morris, Topology Without Tears, Definition A5.5.21 (TP-551). Topological groups `G`, `H` are
locally isomorphic if there are neighbourhoods `V` of `1` in `G`, `U` of `1` in `H` and a
homeomorphism `V ≃ U` which is multiplicative whenever `x, y, x y` all lie in `V`. -/
def LocallyIsomorphic (G H : Type*) [Group G] [TopologicalSpace G] [Group H]
    [TopologicalSpace H] : Prop :=
  ∃ (V : Set G) (U : Set H) (f : V ≃ₜ U), V ∈ 𝓝 (1 : G) ∧ U ∈ 𝓝 (1 : H) ∧
    ∀ (x y : V) (hxy : (x : G) * y ∈ V), ((f ⟨x * y, hxy⟩ : U) : H) = (f x : H) * (f y : H)

/-- Morris, Topology Without Tears, Definition A5.5.21 (TP-551). Local isomorphism is reflexive. -/
@[kb "morris2024" "Definition A5.5.21, p. 548"]
theorem locallyIsomorphic_refl (G : Type*) [Group G] [TopologicalSpace G] : LocallyIsomorphic G G :=
  ⟨Set.univ, Set.univ, Homeomorph.refl _, univ_mem, univ_mem, fun _ _ _ => rfl⟩

/-- Morris, Topology Without Tears, Proposition A5.5.23 (TP-552). If `D` is a discrete normal
subgroup of a topological group `G`, then `G` and `G ⧸ D` are locally isomorphic. -/
@[kb "morris2024" "Proposition A5.5.23, p. 548"]
theorem locallyIsomorphic_quotient_of_discrete {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (D : Subgroup G) [D.Normal] [DiscreteTopology D] :
    LocallyIsomorphic G (G ⧸ D) := by
  obtain ⟨W, hWo, hW⟩ := isOpen_induced_iff.1 (isOpen_discrete ({1} : Set D))
  have h1W : (1 : G) ∈ W := by
    have : (1 : D) ∈ Subtype.val ⁻¹' W := by rw [hW]; rfl
    exact this
  have hWD : ∀ d : G, d ∈ D → d ∈ W → d = 1 := by
    intro d hd hdW
    have : (⟨d, hd⟩ : D) ∈ Subtype.val ⁻¹' W := hdW
    rw [hW] at this
    exact congrArg Subtype.val (Set.mem_singleton_iff.1 this)
  obtain ⟨V, hVo, hV1, hVs, hVV⟩ := exists_isOpen_symm_mul_subset (hWo.mem_nhds h1W)
  let g : V → G ⧸ D := fun x => QuotientGroup.mk (x : G)
  have gc : Continuous g := QuotientGroup.continuous_mk.comp continuous_subtype_val
  have ginj : Function.Injective g := by
    intro x y hxy
    have hd : (x : G)⁻¹ * y ∈ D := QuotientGroup.eq.1 hxy
    have hxinv : (x : G)⁻¹ ∈ V := by
      have : (x : G)⁻¹ ∈ V⁻¹ := by simpa using x.2
      rwa [hVs] at this
    have hW' : (x : G)⁻¹ * y ∈ W := hVV (Set.mul_mem_mul hxinv y.2)
    have := hWD _ hd hW'
    exact Subtype.ext (inv_mul_eq_one.1 this)
  have gopen : IsOpenMap g := QuotientGroup.isOpenMap_coe.comp hVo.isOpenMap_subtype_val
  have he : IsOpenEmbedding g := IsOpenEmbedding.of_continuous_injective_isOpenMap gc ginj gopen
  refine ⟨V, Set.range g, he.isEmbedding.toHomeomorph, hVo.mem_nhds hV1, ?_, ?_⟩
  · refine he.isOpen_range.mem_nhds ⟨⟨1, hV1⟩, ?_⟩
    simp [g]
  · intro x y hxy
    show QuotientGroup.mk ((x : G) * y) = QuotientGroup.mk (x : G) * QuotientGroup.mk (y : G)
    exact map_mul (QuotientGroup.mk' D) (x : G) (y : G)

end LocalIso

/-! ### TP-576, TP-578: the dual map and the canonical map into the double dual -/

section Dual

/-- Morris, Topology Without Tears, Proposition A5.9.5 (TP-576), duality-free part. The induced
map `f* : B* → A*`, `f* γ = γ ∘ f`, is injective whenever `f` is surjective. (That it is a
continuous homomorphism is `PontryaginDual.map`; surjectivity of `f*` for an open injective `f`
needs the extension of characters, which is not proved here.) -/
@[kb "morris2024" "Proposition A5.9.5, p. 568"]
theorem PontryaginDual_map_injective_of_surjective {A B : Type*} [Monoid A] [Monoid B]
    [TopologicalSpace A] [TopologicalSpace B] (f : A →ₜ* B) (hf : Function.Surjective f) :
    Function.Injective (PontryaginDual.map f) := by
  intro γ δ h
  apply PontryaginDual.ext
  intro b
  obtain ⟨a, rfl⟩ := hf b
  have := DFunLike.congr_fun h a
  simpa using this

/-- Morris, Topology Without Tears, Lemma A5.9.9 (TP-578). The canonical map `a ↦ (γ ↦ γ a)`
into the double dual is injective iff the characters separate points. -/
@[kb "morris2024" "Lemma A5.9.9, p. 569"]
theorem injective_evalAtPoint_iff (A : Type*) [CommGroup A] [TopologicalSpace A] :
    Function.Injective (evalAtPoint A) ↔
      ∀ g h : A, g ≠ h → ∃ γ : PontryaginDual A, γ g ≠ γ h := by
  constructor
  · intro hinj g h hgh
    by_contra hc
    push Not at hc
    exact hgh (hinj (ContinuousMonoidHom.ext fun γ => hc γ))
  · intro hsep g h he
    by_contra hne
    obtain ⟨γ, hγ⟩ := hsep g h hne
    exact hγ (DFunLike.congr_fun he γ)

/-- Morris, Topology Without Tears, Lemma A5.9.9 (TP-578), for the canonical map `toDualDual` of a
locally compact abelian group. -/
@[kb "morris2024" "Lemma A5.9.9, p. 569"]
theorem injective_toDualDual_iff (A : Type*) [CommGroup A] [TopologicalSpace A]
    [LocallyCompactSpace A] :
    Function.Injective (toDualDual A) ↔
      ∀ g h : A, g ≠ h → ∃ γ : PontryaginDual A, γ g ≠ γ h :=
  (Iff.rfl : Function.Injective (toDualDual A) ↔ Function.Injective (evalAtPoint A)).trans
    (injective_evalAtPoint_iff A)

end Dual

/-! ### TP-634, TP-635: multiples and torsion -/

section Torsion

variable (A : Type*) [CommGroup A] [TopologicalSpace A]

theorem dual_pow_apply (γ : PontryaginDual A) (n : ℕ) (a : A) : (γ ^ n) a = γ a ^ n :=
  ContinuousMonoidHom.pow_apply (E := Circle) γ n a

/-- The subgroup `G⁽ⁿ⁾` of `n`-th multiples (here `n`-th powers) of an abelian group. -/
def nthPowers (n : ℕ) : Subgroup A := (powMonoidHom n : A →* A).range

/-- The `n`-torsion subgroup of an abelian group. -/
def nTorsion (Γ : Type*) [CommGroup Γ] (n : ℕ) : Subgroup Γ := (powMonoidHom n : Γ →* Γ).ker

/-- Morris, Topology Without Tears, Proposition A5.15.13 (i) (TP-634). The annihilator of the
subgroup of `n`-th multiples of `G` is the `n`-torsion of the dual group. -/
@[kb "morris2024" "Proposition A5.15.13, p. 612"]
theorem characterAnnihilator_nthPowers (n : ℕ) :
    characterAnnihilator A (nthPowers A n) = nTorsion (PontryaginDual A) n := by
  ext γ
  constructor
  · intro h
    show γ ^ n = 1
    apply PontryaginDual.ext
    intro a
    show (γ ^ n) a = 1
    rw [dual_pow_apply, ← map_pow]
    exact h _ ⟨a, rfl⟩
  · intro h
    rintro _ ⟨a, rfl⟩
    have : (γ ^ n) a = 1 := by
      have := congrArg (fun χ : PontryaginDual A => χ a) (show γ ^ n = 1 from h)
      exact this
    rw [dual_pow_apply, ← map_pow] at this
    exact this

variable {A}

/-- Morris, Topology Without Tears, Proposition A5.15.13 (ii) (TP-634). The same holds for the
closure of the subgroup of `n`-th multiples. -/
@[kb "morris2024" "Proposition A5.15.13, p. 612"]
theorem characterAnnihilator_closure_nthPowers [IsTopologicalGroup A] (n : ℕ) :
    characterAnnihilator A (nthPowers A n).topologicalClosure =
      nTorsion (PontryaginDual A) n := by
  rw [← characterAnnihilator_nthPowers A n]
  apply le_antisymm
  · exact characterAnnihilator_antitone (Subgroup.le_topologicalClosure _)
  · intro γ hγ x hx
    have hker : (nthPowers A n).topologicalClosure ≤ (γ : A →* Circle).ker := by
      refine Subgroup.topologicalClosure_minimal _ ?_ ?_
      · intro y hy
        exact hγ y hy
      · exact isClosed_singleton.preimage γ.continuous
    exact hker hx

/-- Morris, Topology Without Tears, Theorem A5.15.14 (TP-635), first part. If `G` is divisible, its
dual group is torsion free. -/
@[kb "morris2024" "Theorem A5.15.14, p. 613"]
theorem dual_torsionFree_of_divisible (hG : IsDivisibleMulGroup A) (n : ℕ) (hn : 0 < n)
    (γ : PontryaginDual A) (h : γ ^ n = 1) : γ = 1 := by
  apply PontryaginDual.ext
  intro a
  obtain ⟨y, rfl⟩ := hG n hn a
  have h1 : (γ ^ n) y = 1 := by
    have := congrArg (fun χ : PontryaginDual A => χ y) (show γ ^ n = 1 from h)
    exact this
  rw [dual_pow_apply] at h1
  show γ (y ^ n) = 1
  rw [map_pow]
  exact h1

end Torsion

/-! ### TP-590: restricted direct product -/

section Restricted

variable {ι : Type*} (X : ι → Type*) [∀ i, Group (X i)] [∀ i, TopologicalSpace (X i)]

/-- Morris, Topology Without Tears, Definition A5.11.7 (TP-590). Membership in the restricted
direct product: all but finitely many coordinates are the identity. -/
@[kb "morris2024" "Definition A5.11.7, p. 577"]
theorem mem_restrictedDirectProduct_iff (g : ∀ i, X i) :
    g ∈ restrictedDirectProduct X ↔ {i | g i ≠ 1}.Finite := Iff.rfl

/-- Morris, Topology Without Tears, Definition A5.11.7 (TP-590). For a finite index set the
restricted direct product is the whole product. -/
@[kb "morris2024" "Definition A5.11.7, p. 577"]
theorem restrictedDirectProduct_eq_top_of_finite [Finite ι] :
    restrictedDirectProduct X = ⊤ := by
  rw [eq_top_iff]
  intro g _
  exact Set.toFinite _

end Restricted

end UndergradKB.Topology
