import UndergradKB.Topology.DualityExtension
import UndergradKB.Topology.DualityWave2b
import UndergradKB.Common.Attr

/-!
# Duality extends from an open subgroup (Morris, Proposition A5.13.3 and Theorem A5.13.6)

For an open subgroup `A` of a locally compact Hausdorff abelian group `G`:

* restriction of characters `G^ → A^` is onto and open (Proposition A5.13.3, TP-605; openness by the
  open mapping theorem on the σ-compact open subgroup of `G^` generated by a compact neighbourhood);
* if `A` satisfies the duality theorem, so does `G` (the step of Theorem A5.13.6).
-/

open Topology Set Pointwise

set_option linter.unusedSectionVars false

namespace UndergradKB.Topology

namespace LCA

universe u

/-- The subgroup generated by a compact symmetric set is σ-compact. -/
theorem isSigmaCompact_closure_of_isCompact {X : Type*} [Group X] [TopologicalSpace X]
    [IsTopologicalGroup X] {S : Set X} (hS : IsCompact S) (hinv : S⁻¹ ⊆ S) :
    IsSigmaCompact (Subgroup.closure S : Set X) := by
  have hpow : ∀ n : ℕ, IsCompact (S ^ n) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih => rw [pow_succ]; exact ih.mul hS
  have hsub : ∀ n : ℕ, S ^ n ⊆ Subgroup.closure S := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ]
      rintro _ ⟨a, ha, b, hb, rfl⟩
      exact mul_mem (ih ha) (Subgroup.subset_closure hb)
  have heq : (Subgroup.closure S : Set X) = ⋃ n : ℕ, S ^ n := by
    refine Set.Subset.antisymm (fun x hx => ?_) (Set.iUnion_subset hsub)
    induction hx using Subgroup.closure_induction with
    | mem x hx => exact Set.mem_iUnion.2 ⟨1, by simpa using hx⟩
    | one => exact Set.mem_iUnion.2 ⟨0, by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨m, hm⟩ := Set.mem_iUnion.1 hx
      obtain ⟨n, hn⟩ := Set.mem_iUnion.1 hy
      exact Set.mem_iUnion.2 ⟨m + n, by rw [pow_add]; exact Set.mul_mem_mul hm hn⟩
    | inv x _ hx =>
      obtain ⟨m, hm⟩ := Set.mem_iUnion.1 hx
      refine Set.mem_iUnion.2 ⟨m, ?_⟩
      have h2 : (S ^ m)⁻¹ ⊆ S ^ m := by
        rw [← inv_pow]
        exact Set.pow_subset_pow_left hinv
      exact h2 (Set.inv_mem_inv.2 hm)
  rw [heq]
  exact isSigmaCompact_iUnion_of_isCompact _ hpow

variable {G : Type u} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G] [T2Space G]
  [LocallyCompactSpace G]

/-- The inclusion of a subgroup as a continuous homomorphism. -/
def inclHom (A : Subgroup G) : A →ₜ* G := ⟨A.subtype, continuous_subtype_val⟩

/-- Restriction of characters to an open subgroup is onto. -/
theorem restrict_surjective_of_isOpen (A : Subgroup G) (hA : IsOpen (A : Set G)) :
    Function.Surjective (PontryaginDual.map (inclHom A)) :=
  PontryaginDual_map_surjective_of_isOpenMap_of_injective (inclHom A) Subtype.val_injective
    hA.isOpenMap_subtype_val

/-- A homomorphism of topological groups which is open near `1` (images of neighbourhoods of `1`
are neighbourhoods of `1`) is an open map. -/
theorem isOpenMap_of_nhds_one {X Y : Type*} [Group X] [Group Y] [TopologicalSpace X]
    [TopologicalSpace Y] [IsTopologicalGroup X] [IsTopologicalGroup Y] (f : X →* Y)
    (h : ∀ U ∈ 𝓝 (1 : X), (f '' U) ∈ 𝓝 (1 : Y)) : IsOpenMap f := by
  intro U hU
  rw [isOpen_iff_mem_nhds]
  rintro _ ⟨x, hx, rfl⟩
  have hU' : (fun z => x * z) ⁻¹' U ∈ 𝓝 (1 : X) :=
    (continuous_const.mul continuous_id).continuousAt.preimage_mem_nhds
      (by simpa using hU.mem_nhds hx)
  have h1 := h _ hU'
  have h2 : (fun y => (f x)⁻¹ * y) ⁻¹' (f '' ((fun z => x * z) ⁻¹' U)) ∈ 𝓝 (f x) :=
    (continuous_const.mul continuous_id).continuousAt.preimage_mem_nhds (by simpa using h1)
  refine Filter.mem_of_superset h2 ?_
  rintro y ⟨z, hz, hzy⟩
  refine ⟨x * z, hz, ?_⟩
  rw [map_mul, hzy, mul_inv_cancel_left]

/-- Morris, Topology Without Tears, Proposition A5.13.3 (TP-605), openness: restriction of
characters to an open subgroup is an open map `G^ → A^`. -/
theorem restrict_isOpenMap_of_isOpen (A : Subgroup G) (hA : IsOpen (A : Set G)) :
    IsOpenMap (PontryaginDual.map (inclHom A)) := by
  have hAcl : IsClosed (A : Set G) := Subgroup.isClosed_of_isOpen A hA
  have : LocallyCompactSpace A := hA.isOpenEmbedding_subtypeVal.locallyCompactSpace
  obtain ⟨W, hWc, hW1⟩ := exists_compact_mem_nhds (1 : G)
  set K : Set G := W ∩ (A : Set G)
  have hKc : IsCompact K := hWc.inter_right hAcl
  have hKn : K ∈ 𝓝 (1 : G) := Filter.inter_mem hW1 (hA.mem_nhds A.one_mem)
  obtain ⟨hPn, hPc⟩ := compact_nhds_charsMapping K hKc hKn (a := 1 / 8) (by norm_num) (by norm_num)
  set P := charsMapping K (arcVa (1 / 8))
  set KA : Set A := (↑) ⁻¹' K
  have hKAc : IsCompact KA := hAcl.isClosedEmbedding_subtypeVal.isCompact_preimage hKc
  have hKAn : KA ∈ 𝓝 (1 : A) := continuous_subtype_val.continuousAt.preimage_mem_nhds hKn
  obtain ⟨hPAn, -⟩ :=
    compact_nhds_charsMapping KA hKAc hKAn (a := 1 / 8) (by norm_num) (by norm_num)
  set r := PontryaginDual.map (inclHom A)
  have hrP : charsMapping KA (arcVa (1 / 8)) ⊆ r '' P := by
    intro η hη
    obtain ⟨χ, rfl⟩ := restrict_surjective_of_isOpen A hA η
    refine ⟨χ, fun y hy => ?_, rfl⟩
    exact hη (show (⟨y, hy.2⟩ : A) ∈ KA from hy)
  set S := closure P ∪ (closure P)⁻¹
  have hSc : IsCompact S := hPc.union hPc.inv
  have hSinv : S⁻¹ ⊆ S := by
    rw [Set.union_inv, inv_inv, Set.union_comm]
  set B := Subgroup.closure S
  have hPB : P ⊆ B := subset_closure.trans (Set.subset_union_left.trans Subgroup.subset_closure)
  have hBs : IsSigmaCompact (B : Set (PontryaginDual G)) :=
    isSigmaCompact_closure_of_isCompact hSc hSinv
  have : SigmaCompactSpace B := isSigmaCompact_iff_sigmaCompactSpace.1 hBs
  set H := B.map (r : PontryaginDual G →* PontryaginDual A)
  have hHo : IsOpen (H : Set (PontryaginDual A)) := by
    refine Subgroup.isOpen_of_mem_nhds H (g := 1) (Filter.mem_of_superset hPAn (hrP.trans ?_))
    rintro _ ⟨χ, hχ, rfl⟩
    exact ⟨χ, hPB hχ, rfl⟩
  have : LocallyCompactSpace H := hHo.isOpenEmbedding_subtypeVal.locallyCompactSpace
  let rB : B →* H := ((r : PontryaginDual G →* PontryaginDual A).comp B.subtype).codRestrict H
    fun b => ⟨b, b.2, rfl⟩
  have hrBc : Continuous rB :=
    continuous_induced_rng.2 (r.continuous.comp continuous_subtype_val)
  have hrBs : Function.Surjective rB := by
    rintro ⟨_, b, hb, rfl⟩
    exact ⟨⟨b, hb⟩, rfl⟩
  have hrBo : IsOpenMap rB := MonoidHom.isOpenMap_of_sigmaCompact rB hrBs hrBc
  refine isOpenMap_of_nhds_one (r : PontryaginDual G →* PontryaginDual A) fun U hU => ?_
  -- the image of `U ∩ B` is open in `H`, hence in `A^`, and contains `1`
  have hUB : ((↑) : B → PontryaginDual G) ⁻¹' interior U ∈ 𝓝 (1 : B) :=
    continuous_subtype_val.continuousAt.preimage_mem_nhds (interior_mem_nhds.2 hU)
  have h1 : IsOpen (rB '' ((↑) : B → PontryaginDual G) ⁻¹' interior U) :=
    hrBo _ (isOpen_interior.preimage continuous_subtype_val)
  have h2 : IsOpen (((↑) : H → PontryaginDual A) '' (rB '' ((↑) : B → PontryaginDual G) ⁻¹'
      interior U)) := hHo.isOpenMap_subtype_val _ h1
  refine Filter.mem_of_superset (h2.mem_nhds ⟨1, ⟨1, mem_of_mem_nhds hUB, map_one rB⟩, rfl⟩) ?_
  rintro _ ⟨_, ⟨b, hb, rfl⟩, rfl⟩
  exact ⟨b, interior_subset hb, rfl⟩

section OpenSubgroup

variable (A : Subgroup G) (hA : IsOpen (A : Set G))

/-- The annihilator of a subgroup in the dual group. -/
def annih : Subgroup (PontryaginDual G) where
  carrier := {χ | ∀ y ∈ A, χ y = 1}
  mul_mem' := fun {a b} ha hb y hy => by
    have : (a * b) y = a y * b y := rfl
    rw [this, ha y hy, hb y hy, one_mul]
  one_mem' := fun y _ => rfl
  inv_mem' := fun {a} ha y hy => by
    have : a⁻¹ y = (a y)⁻¹ := rfl
    rw [this, ha y hy, inv_one]

/-- The double annihilator: characters of the dual group trivial on the annihilator of `A`. -/
def annihAnnih : Subgroup (PontryaginDual (PontryaginDual G)) where
  carrier := {Φ | ∀ χ ∈ annih A, Φ χ = 1}
  mul_mem' := fun {a b} ha hb χ hχ => by
    have : (a * b) χ = a χ * b χ := rfl
    rw [this, ha χ hχ, hb χ hχ, one_mul]
  one_mem' := fun _ _ => rfl
  inv_mem' := fun {a} ha χ hχ => by
    have : a⁻¹ χ = (a χ)⁻¹ := rfl
    rw [this, ha χ hχ, inv_one]

include hA in
/-- The core of the duality step for an open subgroup `A` satisfying duality: every character of
`G^` is evaluation at a point `a * g` (`a ∈ A`), where `g` represents the induced character of the
dual of the discrete group `G / A`. -/
theorem exists_eval_of_open_subgroup (hdual : DualityHolds A)
    (Φ : PontryaginDual (PontryaginDual G)) :
    ∃ g : G, (∀ ψ : PontryaginDual (G ⧸ A),
      Φ (PontryaginDual.map ⟨QuotientGroup.mk' A, QuotientGroup.continuous_mk⟩ ψ) =
        ψ (g : G ⧸ A)) ∧ ∃ a : A, Φ = toDualDual G (a * g) := by
  classical
  have : DiscreteTopology (G ⧸ A) := QuotientGroup.discreteTopology hA
  let q : G →ₜ* G ⧸ A := ⟨QuotientGroup.mk' A, QuotientGroup.continuous_mk⟩
  obtain ⟨x, hx⟩ := toDualDual_surjective (G ⧸ A) (Φ.comp (PontryaginDual.map q))
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
  have hΦq : ∀ ψ : PontryaginDual (G ⧸ A), Φ (PontryaginDual.map q ψ) = ψ (g : G ⧸ A) := by
    intro ψ
    have h1 := congrArg (fun z : PontryaginDual (PontryaginDual (G ⧸ A)) => z ψ) hx
    exact h1.symm
  refine ⟨g, hΦq, ?_⟩
  let Ψ : PontryaginDual (PontryaginDual G) := Φ * (toDualDual G g)⁻¹
  have hΨapp : ∀ χ, Ψ χ = Φ χ * (χ g)⁻¹ := fun χ => rfl
  have hΨ : ∀ χ : PontryaginDual G, (∀ k ∈ A, χ k = 1) → Ψ χ = 1 := by
    intro χ hχ
    obtain ⟨ψ, hψ⟩ := exists_char_quotient_of_trivial A χ hχ
    have hχψ : PontryaginDual.map q ψ = χ := PontryaginDual.ext fun y => hψ y
    have h1 := hΦq ψ
    rw [hχψ, hψ] at h1
    rw [hΨapp, h1, mul_inv_cancel]
  set r := PontryaginDual.map (inclHom A)
  have hrs := restrict_surjective_of_isOpen A hA
  choose ext hext using hrs
  have hext' : ∀ η, r (ext η) = η := hext
  have hkey : ∀ χ : PontryaginDual G, Ψ χ = Ψ (ext (r χ)) := by
    intro χ
    have htriv : ∀ k ∈ A, (χ * (ext (r χ))⁻¹) k = 1 := by
      intro k hk
      have h2 := DFunLike.congr_fun (hext' (r χ)) ⟨k, hk⟩
      show χ k * (ext (r χ) k)⁻¹ = 1
      have h3 : ext (r χ) k = χ k := h2
      rw [h3, mul_inv_cancel]
    have h1 := hΨ _ htriv
    rw [map_mul, map_inv, mul_inv_eq_one] at h1
    exact h1
  let ψA0 : PontryaginDual A →* Circle :=
    { toFun := fun η => Ψ (ext η)
      map_one' := by
        have := hkey 1
        simp only [map_one] at this
        exact this.symm
      map_mul' := fun η η' => by
        have h1 := hkey (ext η * ext η')
        rw [map_mul r, hext', hext'] at h1
        show Ψ (ext (η * η')) = Ψ (ext η) * Ψ (ext η')
        rw [← h1, map_mul] }
  have hψA0 : ∀ χ, ψA0 (r χ) = Ψ χ := fun χ => (hkey χ).symm
  have hcont : Continuous ψA0 := by
    have hq := (restrict_isOpenMap_of_isOpen A hA).isQuotientMap r.continuous
      (restrict_surjective_of_isOpen A hA)
    refine hq.continuous_iff.2 ?_
    have : (ψA0 ∘ r) = fun χ => Ψ χ := funext hψA0
    rw [this]
    exact Ψ.continuous
  let ψA : PontryaginDual (PontryaginDual A) := ⟨ψA0, hcont⟩
  obtain ⟨e, he⟩ := hdual
  obtain ⟨a, ha⟩ := e.surjective ψA
  refine ⟨a, PontryaginDual.ext fun χ => ?_⟩
  show Φ χ = χ ((a : G) * g)
  have h1 : Ψ χ = χ a := by
    have h3 : ψA (r χ) = (r χ) a := by rw [← ha, he]
    rw [← hψA0]
    exact h3
  have h2 : Φ χ = Ψ χ * χ g := by rw [hΨapp, inv_mul_cancel_right]
  rw [h2, h1, map_mul]

include hA in
/-- The annihilator of an open subgroup is compact (it is the dual of the discrete quotient). -/
theorem isCompact_annih : IsCompact (annih A : Set (PontryaginDual G)) := by
  have : DiscreteTopology (G ⧸ A) := QuotientGroup.discreteTopology hA
  let q : G →ₜ* G ⧸ A := ⟨QuotientGroup.mk' A, QuotientGroup.continuous_mk⟩
  have : (annih A : Set (PontryaginDual G)) = Set.range (PontryaginDual.map q) := by
    ext χ
    constructor
    · intro hχ
      obtain ⟨ψ, hψ⟩ := exists_char_quotient_of_trivial A χ hχ
      exact ⟨ψ, PontryaginDual.ext fun y => hψ y⟩
    · rintro ⟨ψ, rfl⟩ y hy
      show ψ (y : G ⧸ A) = 1
      rw [(QuotientGroup.eq_one_iff y).2 hy, map_one]
  rw [this]
  exact isCompact_range (PontryaginDual.map q).continuous

include hA in
/-- The double annihilator of an open subgroup is open. -/
theorem isOpen_annihAnnih : IsOpen (annihAnnih A : Set (PontryaginDual (PontryaginDual G))) := by
  let V : Set (PontryaginDual (PontryaginDual G)) :=
    {Φ | Set.MapsTo Φ (annih A : Set (PontryaginDual G)) (Circle.centeredArc (Real.pi / 2))}
  have hVo : IsOpen V := isOpen_induced (ContinuousMap.isOpen_setOfPred_mapsTo
    (isCompact_annih A hA) (Circle.isOpen_centeredArc (Real.pi / 2)))
  have hV1 : (1 : PontryaginDual (PontryaginDual G)) ∈ V := by
    intro χ _
    show (1 : Circle) ∈ _
    rw [Circle.mem_centeredArc (by linarith [Real.pi_pos])]
    simp [Real.pi_pos]
  have hVM : V ⊆ annihAnnih A := by
    intro Φ hΦ χ hχ
    refine Circle.eq_one_of_forall_pow_mem_centeredArc_pi_div_two fun n hn => ?_
    rw [← map_pow]
    exact hΦ (pow_mem hχ n)
  exact Subgroup.isOpen_of_mem_nhds _ (g := 1) (Filter.mem_of_superset (hVo.mem_nhds hV1) hVM)

include hA in
/-- Morris, Topology Without Tears, Theorem A5.13.6 (TP-572), reduction step: if an open σ-compact
subgroup `A` of a locally compact Hausdorff abelian group `G` satisfies the duality theorem, so
does `G`. -/
theorem dualityHolds_of_open_subgroup [SigmaCompactSpace A] (hdual : DualityHolds A) :
    DualityHolds G := by
  classical
  have : LocallyCompactSpace A := hA.isOpenEmbedding_subtypeVal.locallyCompactSpace
  have hsurj : Function.Surjective (toDualDual G) := fun Φ => by
    obtain ⟨g, -, a, ha⟩ := exists_eval_of_open_subgroup A hA hdual Φ
    exact ⟨_, ha.symm⟩
  have hbij : Function.Bijective (toDualDual G) := ⟨toDualDual_injective_LCA, hsurj⟩
  -- the image of `A` is the open double annihilator
  set M := annihAnnih A
  have hMo : IsOpen (M : Set (PontryaginDual (PontryaginDual G))) := isOpen_annihAnnih A hA
  have : LocallyCompactSpace M := hMo.isOpenEmbedding_subtypeVal.locallyCompactSpace
  have hAM : ∀ a : A, toDualDual G a ∈ M := fun a χ hχ => hχ a a.2
  let f : A →* M := ((toDualDual G : G →* PontryaginDual (PontryaginDual G)).comp A.subtype).codRestrict
    M hAM
  have hfc : Continuous f :=
    continuous_induced_rng.2 ((toDualDual G).continuous.comp continuous_subtype_val)
  have hfs : Function.Surjective f := by
    rintro ⟨Φ, hΦ⟩
    obtain ⟨g, hg, a, ha⟩ := exists_eval_of_open_subgroup A hA hdual Φ
    have hgA : g ∈ A := by
      have : DiscreteTopology (G ⧸ A) := QuotientGroup.discreteTopology hA
      have h1 : toDualDual (G ⧸ A) (g : G ⧸ A) = 1 := by
        refine PontryaginDual.ext fun ψ => ?_
        show ψ (g : G ⧸ A) = 1
        rw [← hg ψ]
        refine hΦ _ fun y hy => ?_
        show ψ (y : G ⧸ A) = 1
        rw [(QuotientGroup.eq_one_iff y).2 hy, map_one]
      have h2 := toDualDual_injective (G ⧸ A) (h1.trans (map_one _).symm)
      exact (QuotientGroup.eq_one_iff g).1 h2
    refine ⟨a * ⟨g, hgA⟩, Subtype.ext ?_⟩
    show toDualDual G ((a : G) * g) = Φ
    exact ha.symm
  have hfo : IsOpenMap f := MonoidHom.isOpenMap_of_sigmaCompact f hfs hfc
  have hopen : IsOpenMap (toDualDual G) := by
    refine isOpenMap_of_nhds_one (toDualDual G : G →* PontryaginDual (PontryaginDual G))
      fun U hU => ?_
    have hUA : ((↑) : A → G) ⁻¹' interior U ∈ 𝓝 (1 : A) :=
      continuous_subtype_val.continuousAt.preimage_mem_nhds (interior_mem_nhds.2 hU)
    have h1 : IsOpen (f '' (((↑) : A → G) ⁻¹' interior U)) :=
      hfo _ (isOpen_interior.preimage continuous_subtype_val)
    have h2 := hMo.isOpenMap_subtype_val _ h1
    refine Filter.mem_of_superset (h2.mem_nhds ⟨1, ⟨1, mem_of_mem_nhds hUA, map_one f⟩, ?_⟩) ?_
    · rfl
    · rintro _ ⟨_, ⟨a, ha, rfl⟩, rfl⟩
      exact ⟨a, interior_subset ha, rfl⟩
  let e0 : G ≃* PontryaginDual (PontryaginDual G) := MulEquiv.ofBijective _ hbij
  let h0 : G ≃ₜ PontryaginDual (PontryaginDual G) :=
    e0.toEquiv.toHomeomorphOfContinuousOpen (toDualDual G).continuous hopen
  exact ⟨{ toMulEquiv := e0
           continuous_toFun := h0.continuous
           continuous_invFun := h0.symm.continuous }, fun g χ => rfl⟩

end OpenSubgroup

end LCA

end UndergradKB.Topology
