import UndergradKB.Topology.GroupsWave2
import UndergradKB.Topology.DualityCompact
import UndergradKB.Topology.DualityDiscrete3
import Mathlib.Topology.Algebra.Group.Quotient
import UndergradKB.Common.Attr

/-!
# Every locally compact abelian group has enough characters (TP-599, TP-532, TP-600)

Morris, *Topology Without Tears*, Proposition A5.12.5 and Theorem A5.12.6.  We follow the book's
strategy in an inductive form: if a locally compact Hausdorff abelian group `G` is `V · ⟨g₁, …, g_m⟩`
for a compact set `V`, then for every `x ≠ 1` there is a closed discrete subgroup `A` with `x ∉ A`
and `G = C · A` for a compact set `C` (so `G / A` is compact).  The induction step uses Weil's lemma
(`compactSpace_or_continuousAddEquiv_int`, Theorem A5.12.3): the closure of `⟨g_{m+1}⟩` is either
compact (absorb it into `V`) or `⟨g_{m+1}⟩` is closed, discrete and infinite (pass to the quotient by
a subgroup `⟨g_{m+1}^k⟩` avoiding `x`).  A character of the compact quotient `H / A` of an open
compactly generated subgroup `H` (Corollary A5.10.2) extends to `G` because `H` is open.
-/

open Topology Set Pointwise

set_option linter.unusedSectionVars false

namespace UndergradKB.Topology

namespace LCA

universe u

variable {G : Type u} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G] [T2Space G]
  [LocallyCompactSpace G]

/-- Weil's lemma in multiplicative form: the closure of a cyclic subgroup of a locally compact
Hausdorff abelian group is compact, or the cyclic subgroup is closed and discrete. -/
theorem weil_mul (h : G) :
    IsCompact (closure (Subgroup.zpowers h : Set G)) ∨
      (IsClosed (Subgroup.zpowers h : Set G) ∧ DiscreteTopology (Subgroup.zpowers h)) := by
  set S := (Subgroup.zpowers h).topologicalClosure
  have hSc : IsClosed (S : Set G) := Subgroup.isClosed_topologicalClosure _
  have hScl : (S : Set G) = closure (Subgroup.zpowers h : Set G) :=
    Subgroup.topologicalClosure_coe
  have : LocallyCompactSpace S := hSc.isClosedEmbedding_subtypeVal.locallyCompactSpace
  let s : S := ⟨h, Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers h)⟩
  -- the cyclic subgroup generated by `s` is dense in `S`
  have hmem : ∀ y : S, y ∈ Subgroup.zpowers s ↔ (y : G) ∈ Subgroup.zpowers h := by
    intro y
    constructor
    · rintro ⟨n, rfl⟩
      exact ⟨n, by simp [s]⟩
    · rintro ⟨n, hn⟩
      exact ⟨n, Subtype.ext (by simp [s, hn])⟩
  have hdense : Dense (Subgroup.zpowers s : Set S) := by
    rw [dense_iff_closure_eq, Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
    have : ((↑) : S → G) '' (Subgroup.zpowers s : Set S) = Subgroup.zpowers h := by
      ext y
      constructor
      · rintro ⟨z, hz, rfl⟩; exact (hmem z).1 hz
      · intro hy
        exact ⟨⟨y, Subgroup.le_topologicalClosure _ hy⟩, (hmem _).2 hy, rfl⟩
    erw [this]
    rw [← hScl]
    ext y
    simp
  have hdenseA : ∃ x : Additive S, Dense (AddSubgroup.zmultiples x : Set (Additive S)) := by
    refine ⟨Additive.ofMul s, ?_⟩
    have : (AddSubgroup.zmultiples (Additive.ofMul s) : Set (Additive S)) =
        Additive.toMul ⁻¹' (Subgroup.zpowers s : Set S) := by
      ext y
      simp only [SetLike.mem_coe, AddSubgroup.mem_zmultiples_iff, Set.mem_preimage,
        Subgroup.mem_zpowers_iff]
      constructor
      · rintro ⟨n, rfl⟩; exact ⟨n, by simp⟩
      · rintro ⟨n, hn⟩; exact ⟨n, by rw [← ofMul_zpow, hn]; rfl⟩
    rw [this]
    exact hdense
  have : T2Space (Additive S) := inferInstanceAs (T2Space S)
  have : LocallyCompactSpace (Additive S) := inferInstanceAs (LocallyCompactSpace S)
  rcases compactSpace_or_continuousAddEquiv_int hdenseA with hcpt | ⟨⟨e⟩⟩
  · left
    rw [← hScl]
    have : CompactSpace S := hcpt
    exact isCompact_iff_compactSpace.2 this
  · right
    have hdisc : DiscreteTopology (Additive S) := e.toHomeomorph.symm.discreteTopology
    have hdS : DiscreteTopology S := hdisc
    have hall : ∀ y : S, y ∈ Subgroup.zpowers s := by
      intro y
      have := hdense.closure_eq
      rw [(isClosed_discrete (Subgroup.zpowers s : Set S)).closure_eq] at this
      have hy : y ∈ (Subgroup.zpowers s : Set S) := this ▸ Set.mem_univ y
      exact hy
    have heq : (Subgroup.zpowers h : Set G) = S := by
      refine Set.Subset.antisymm (Subgroup.le_topologicalClosure _) fun y hy => ?_
      exact (hmem ⟨y, hy⟩).1 (hall _)
    refine ⟨heq ▸ hSc, ?_⟩
    have e2 : (Subgroup.zpowers h) ≃ₜ S := Homeomorph.setCongr heq
    exact e2.symm.discreteTopology

/-- A subgroup containing a discrete subgroup `Z`, whose image modulo `Z` is discrete, is discrete. -/
theorem discreteTopology_comap {Z : Subgroup G} [DiscreteTopology Z] (A' : Subgroup (G ⧸ Z))
    [DiscreteTopology A'] : DiscreteTopology (A'.comap (QuotientGroup.mk' Z)) := by
  obtain ⟨U₁, hU₁o, hU₁⟩ := isOpen_induced_iff.1 (isOpen_discrete ({1} : Set Z))
  obtain ⟨U₂, hU₂o, hU₂⟩ := isOpen_induced_iff.1 (isOpen_discrete ({1} : Set A'))
  apply discreteTopology_of_isOpen_singleton_one
  refine isOpen_induced_iff.2 ⟨U₁ ∩ QuotientGroup.mk ⁻¹' U₂,
    hU₁o.inter (hU₂o.preimage QuotientGroup.continuous_mk), ?_⟩
  ext ⟨b, hb⟩
  simp only [Set.mem_preimage, Set.mem_inter_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨h1, h2⟩
    have hb' : (QuotientGroup.mk b : G ⧸ Z) ∈ A' := hb
    have : (⟨QuotientGroup.mk b, hb'⟩ : A') ∈ ((↑) : A' → G ⧸ Z) ⁻¹' U₂ := h2
    rw [hU₂, Set.mem_singleton_iff] at this
    have hbZ : b ∈ Z := (QuotientGroup.eq_one_iff b).1 (congrArg Subtype.val this)
    have : (⟨b, hbZ⟩ : Z) ∈ ((↑) : Z → G) ⁻¹' U₁ := h1
    rw [hU₁, Set.mem_singleton_iff] at this
    exact Subtype.ext (show b = 1 from congrArg Subtype.val this)
  · intro h1
    have hb1 : b = 1 := congrArg Subtype.val h1
    subst hb1
    refine ⟨?_, ?_⟩
    · have : ((1 : Z) : G) ∈ U₁ := by
        have : (1 : Z) ∈ ((↑) : Z → G) ⁻¹' U₁ := by rw [hU₁]; rfl
        exact this
      exact this
    · have : ((1 : A') : G ⧸ Z) ∈ U₂ := by
        have : (1 : A') ∈ ((↑) : A' → G ⧸ Z) ⁻¹' U₂ := by rw [hU₂]; rfl
        exact this
      simpa using this

/-- Compact sets of a quotient of a locally compact group lift to compact sets. -/
theorem exists_isCompact_lift (N : Subgroup G) {C' : Set (G ⧸ N)} (hC' : IsCompact C') :
    ∃ C : Set G, IsCompact C ∧ C' ⊆ QuotientGroup.mk '' C := by
  have hcov : ∀ y ∈ C', ∃ W : Set G, IsCompact W ∧ y ∈ QuotientGroup.mk '' interior W := by
    intro y _
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
    obtain ⟨W, hWc, hWn⟩ := exists_compact_mem_nhds x
    exact ⟨W, hWc, x, mem_interior_iff_mem_nhds.2 hWn, rfl⟩
  choose! W hWc hWy using hcov
  obtain ⟨t, hcover⟩ := hC'.elim_nhds_subcover' (fun y hy => QuotientGroup.mk '' interior (W y))
    (fun y hy => (QuotientGroup.isOpenMap_coe _ isOpen_interior).mem_nhds (hWy y hy))
  refine ⟨⋃ y ∈ t, W (y : G ⧸ N), t.isCompact_biUnion fun y _ => hWc y y.2, fun z hz => ?_⟩
  obtain ⟨y, hyt, hzy⟩ := Set.mem_iUnion₂.1 (hcover hz)
  obtain ⟨x, hx, rfl⟩ := hzy
  exact ⟨x, Set.mem_iUnion₂.2 ⟨y, hyt, interior_subset hx⟩, rfl⟩

/-- Morris, Topology Without Tears, Proposition A5.12.5 (TP-598), in the inductive form used for
Theorem A5.12.6: if `G = V · ⟨g₁, …, g_m⟩` with `V` compact, then for every `x ≠ 1` there is a discrete
subgroup `A` not containing `x` with `G = C · A` for a compact set `C`. -/
theorem exists_discrete_cocompact : ∀ (m : ℕ) (G : Type u) [CommGroup G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] [LocallyCompactSpace G] (V : Set G), IsCompact V →
    ∀ g : Fin m → G, (∀ y : G, ∃ v ∈ V, ∃ w ∈ Subgroup.closure (Set.range g), y = v * w) →
    ∀ x : G, x ≠ 1 → ∃ A : Subgroup G, DiscreteTopology A ∧ x ∉ A ∧
      ∃ C : Set G, IsCompact C ∧ ∀ y, ∃ c ∈ C, ∃ a ∈ A, y = c * a := by
  intro m
  induction m with
  | zero =>
    intro G _ _ _ _ _ V hV g hg x hx
    refine ⟨⊥, inferInstance, by simpa using hx, V, hV, fun y => ?_⟩
    obtain ⟨v, hv, w, hw, rfl⟩ := hg y
    have hw1 : w = 1 := by
      rw [Set.range_eq_empty g, Subgroup.closure_empty, Subgroup.mem_bot] at hw
      exact hw
    exact ⟨v, hv, 1, one_mem _, by simp [hw1]⟩
  | succ m ih =>
    intro G _ _ _ _ _ V hV g hg x hx
    set h := g (Fin.last m)
    set g' : Fin m → G := fun i => g i.castSucc
    have hcl : ∀ w ∈ Subgroup.closure (Set.range g),
        ∃ w' ∈ Subgroup.closure (Set.range g'), ∃ n : ℤ, w = w' * h ^ n := by
      intro w hw
      have hle : Subgroup.closure (Set.range g) ≤
          Subgroup.closure (Set.range g') ⊔ Subgroup.zpowers h := by
        rw [Subgroup.closure_le]
        rintro _ ⟨i, rfl⟩
        induction i using Fin.lastCases with
        | last => exact Subgroup.mem_sup_right (Subgroup.mem_zpowers h)
        | cast j => exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨j, rfl⟩)
      obtain ⟨w', hw', z, hz, rfl⟩ := Subgroup.mem_sup.1 (hle hw)
      obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hz
      exact ⟨w', hw', n, rfl⟩
    have hcompact_case : IsCompact (closure (Subgroup.zpowers h : Set G)) →
        ∃ A : Subgroup G, DiscreteTopology A ∧ x ∉ A ∧
          ∃ C : Set G, IsCompact C ∧ ∀ y, ∃ c ∈ C, ∃ a ∈ A, y = c * a := by
      intro hS
      refine ih G (V * closure (Subgroup.zpowers h : Set G)) (hV.mul hS) g' (fun y => ?_) x hx
      obtain ⟨v, hv, w, hw, rfl⟩ := hg y
      obtain ⟨w', hw', n, rfl⟩ := hcl w hw
      refine ⟨v * h ^ n, Set.mul_mem_mul hv (subset_closure (Subgroup.zpow_mem_zpowers h n)),
        w', hw', ?_⟩
      rw [mul_comm w', mul_assoc]
    rcases weil_mul h with hS | ⟨hZc, hZd⟩
    · exact hcompact_case hS
    by_cases hfin : IsOfFinOrder h
    · apply hcompact_case
      have hfinite : (Subgroup.zpowers h : Set G).Finite := by
        have : Finite (Subgroup.zpowers h) := hfin.finite_zpowers
        exact Set.toFinite _
      rw [hfinite.isClosed.closure_eq]
      exact hfinite.isCompact
    have hinj : Function.Injective (fun n : ℤ => h ^ n) := injective_zpow_iff_not_isOfFinOrder.2 hfin
    obtain ⟨k, hk1, hxk⟩ : ∃ k : ℕ, 1 ≤ k ∧ x ∉ Subgroup.zpowers (h ^ (k : ℤ)) := by
      by_cases hxZ : x ∈ Subgroup.zpowers h
      · obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.1 hxZ
        refine ⟨j.natAbs + 1, by omega, ?_⟩
        intro hmem
        obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.1 hmem
        rw [← zpow_mul, ← hj] at hn
        have hjn : ((j.natAbs + 1 : ℕ) : ℤ) * n = j := hinj hn
        have hj0 : j ≠ 0 := by rintro rfl; exact hx (by rw [← hj, zpow_zero])
        have hdvd : ((j.natAbs + 1 : ℕ) : ℤ) ∣ j := ⟨n, hjn.symm⟩
        have h2 := Int.natAbs_dvd_natAbs.2 hdvd
        have h3 := Nat.le_of_dvd (Int.natAbs_pos.2 hj0) h2
        have h4 : (((j.natAbs + 1 : ℕ) : ℤ)).natAbs = j.natAbs + 1 := rfl
        rw [h4] at h3
        omega
      · exact ⟨1, le_rfl, by simpa using hxZ⟩
    set Z := Subgroup.zpowers (h ^ (k : ℤ))
    have hZle : (Z : Set G) ⊆ Subgroup.zpowers h :=
      Subgroup.zpowers_le.2 (Subgroup.zpow_mem_zpowers h k)
    have : DiscreteTopology Z := DiscreteTopology.of_subset hZd hZle
    have : IsClosed (Z : Set G) := Subgroup.isClosed_of_discreteTopology
    have hhk : ((h ^ (k : ℤ) : G) : G ⧸ Z) = 1 :=
      (QuotientGroup.eq_one_iff _).2 (Subgroup.mem_zpowers _)
    let F : Set G := Set.range fun i : Fin k => h ^ (i : ℤ)
    have hF : IsCompact F := (Set.finite_range _).isCompact
    have hV'' : IsCompact (QuotientGroup.mk '' (V * F) : Set (G ⧸ Z)) :=
      (hV.mul hF).image QuotientGroup.continuous_mk
    have hcover : ∀ y' : G ⧸ Z, ∃ v ∈ (QuotientGroup.mk '' (V * F) : Set (G ⧸ Z)),
        ∃ w ∈ Subgroup.closure (Set.range fun i => (g' i : G ⧸ Z)), y' = v * w := by
      intro y'
      obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective y'
      obtain ⟨v, hv, w, hw, rfl⟩ := hg y
      obtain ⟨w', hw', n, rfl⟩ := hcl w hw
      have hk0 : (0 : ℤ) < k := by exact_mod_cast hk1
      have hr0 : 0 ≤ n % (k : ℤ) := Int.emod_nonneg _ hk0.ne'
      have hrk : n % (k : ℤ) < k := Int.emod_lt_of_pos _ hk0
      have hn : n = n % (k : ℤ) + (k : ℤ) * (n / (k : ℤ)) := by rw [Int.emod_def]; ring
      refine ⟨QuotientGroup.mk (v * h ^ (n % (k : ℤ))), ⟨v * h ^ (n % (k : ℤ)),
        Set.mul_mem_mul hv ⟨⟨(n % (k : ℤ)).toNat, by omega⟩, by simp [Int.toNat_of_nonneg hr0]⟩, rfl⟩,
        QuotientGroup.mk w', ?_, ?_⟩
      · have : (Subgroup.closure (Set.range g')).map (QuotientGroup.mk' Z) =
            Subgroup.closure (Set.range fun i => (g' i : G ⧸ Z)) := by
          rw [MonoidHom.map_closure, ← Set.range_comp]
          rfl
        rw [← this]
        exact ⟨w', hw', rfl⟩
      · have hpow : ((h : G ⧸ Z)) ^ n = (h : G ⧸ Z) ^ (n % (k : ℤ)) := by
          conv_lhs => rw [hn]
          have hk' : (h : G ⧸ Z) ^ (k : ℤ) = 1 := by rw [← QuotientGroup.mk_zpow]; exact hhk
          rw [zpow_add, zpow_mul, hk', one_zpow, mul_one]
        simp only [QuotientGroup.mk_mul, QuotientGroup.mk_zpow, hpow]
        ac_rfl
    have hxq : (x : G ⧸ Z) ≠ 1 := by rwa [Ne, QuotientGroup.eq_one_iff]
    obtain ⟨A', hA'd, hxA', C', hC'c, hC'⟩ :=
      ih (G ⧸ Z) _ hV'' (fun i => (g' i : G ⧸ Z)) hcover (x : G ⧸ Z) hxq
    obtain ⟨C, hCc, hCC'⟩ := exists_isCompact_lift Z hC'c
    refine ⟨A'.comap (QuotientGroup.mk' Z), discreteTopology_comap A', hxA', C, hCc, fun y => ?_⟩
    obtain ⟨c', hc', a', ha', hy⟩ := hC' (y : G ⧸ Z)
    obtain ⟨c, hc, hcc'⟩ := hCC' hc'
    refine ⟨c, hc, c⁻¹ * y, ?_, by group⟩
    show ((c⁻¹ * y : G) : G ⧸ Z) ∈ A'
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, hy, hcc', inv_mul_cancel_left]
    exact ha'

/-- A nontrivial element of a locally compact Hausdorff abelian group is moved by some character
(the main step of Theorem A5.12.6). -/
theorem exists_char_ne_one_of_LCA {x : G} (hx : x ≠ 1) : ∃ χ : PontryaginDual G, χ x ≠ 1 := by
  classical
  obtain ⟨W, hWc, hW1⟩ := exists_compact_mem_nhds (1 : G)
  set V : Set G := W ∪ W⁻¹ ∪ {x, x⁻¹} with hVdef
  have hVc : IsCompact V := (hWc.union hWc.inv).union (Set.toFinite _).isCompact
  have hVn : V ∈ 𝓝 (1 : G) := Filter.mem_of_superset hW1 fun y hy => Or.inl (Or.inl hy)
  have hV1 : (1 : G) ∈ V := mem_of_mem_nhds hVn
  have hVinv : ∀ y ∈ V, y⁻¹ ∈ V := by
    rintro y ((hy | hy) | hy | hy)
    · exact Or.inl (Or.inr (by simpa using hy))
    · exact Or.inl (Or.inl hy)
    · rw [hy]; exact Or.inr (Or.inr rfl)
    · rw [Set.mem_singleton_iff] at hy; rw [hy, inv_inv]; exact Or.inr (Or.inl rfl)
  have hxV : x ∈ V := Or.inr (Or.inl rfl)
  -- `V * V` is covered by finitely many translates of `V`
  obtain ⟨t, ht⟩ := (hVc.mul hVc).elim_nhds_subcover' (fun y _ => (fun z => y⁻¹ * z) ⁻¹' V)
    (fun y _ => (continuous_const.mul continuous_id).continuousAt.preimage_mem_nhds
      (by simpa using hVn))
  let F : Finset G := t.image (↑)
  have hFV : ∀ y ∈ V * V, ∃ f ∈ (F : Set G), ∃ v ∈ V, y = f * v := by
    intro y hy
    obtain ⟨f, hft, hyf⟩ := Set.mem_iUnion₂.1 (ht hy)
    exact ⟨f, Finset.mem_coe.2 (Finset.mem_image_of_mem _ hft), (f : G)⁻¹ * y, hyf,
      (mul_inv_cancel_left _ _).symm⟩
  set H := Subgroup.closure V
  have hgen : ∀ z ∈ H, ∃ v ∈ V, ∃ w ∈ Subgroup.closure (F : Set G), z = v * w := by
    intro z hz
    induction hz using Subgroup.closure_induction with
    | mem z hz => exact ⟨z, hz, 1, one_mem _, (mul_one z).symm⟩
    | one => exact ⟨1, hV1, 1, one_mem _, (mul_one 1).symm⟩
    | mul a b _ _ ha hb =>
      obtain ⟨v1, hv1, w1, hw1, rfl⟩ := ha
      obtain ⟨v2, hv2, w2, hw2, rfl⟩ := hb
      obtain ⟨f, hf, v3, hv3, h3⟩ := hFV (v1 * v2) (Set.mul_mem_mul hv1 hv2)
      refine ⟨v3, hv3, f * (w1 * w2), mul_mem (Subgroup.subset_closure hf) (mul_mem hw1 hw2), ?_⟩
      calc v1 * w1 * (v2 * w2) = (v1 * v2) * (w1 * w2) := by ac_rfl
        _ = v3 * (f * (w1 * w2)) := by rw [h3]; ac_rfl
    | inv a _ ha =>
      obtain ⟨v, hv, w, hw, rfl⟩ := ha
      exact ⟨v⁻¹, hVinv v hv, w⁻¹, inv_mem hw, by rw [mul_inv]⟩
  have hHo : IsOpen (H : Set G) :=
    Subgroup.isOpen_of_mem_nhds H (g := 1) (Filter.mem_of_superset hVn Subgroup.subset_closure)
  have hHcl : IsClosed (H : Set G) := Subgroup.isClosed_of_isOpen H hHo
  have : LocallyCompactSpace H := hHo.isOpenEmbedding_subtypeVal.locallyCompactSpace
  have hFH : ∀ f ∈ (F : Set G), f ∈ H := by
    intro f hf
    obtain ⟨y, -, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hf)
    obtain ⟨a, ha, b, hb, hab⟩ := y.2
    rw [← hab]
    exact mul_mem (Subgroup.subset_closure ha) (Subgroup.subset_closure hb)
  set m := F.card
  let e : Fin m → G := fun i => (F.equivFin.symm i : G)
  let gH : Fin m → H := fun i => ⟨e i, hFH _ (F.equivFin.symm i).2⟩
  have hmap : (Subgroup.closure (Set.range gH)).map H.subtype = Subgroup.closure (F : Set G) := by
    rw [MonoidHom.map_closure]
    congr 1
    ext y
    constructor
    · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
      exact (F.equivFin.symm i).2
    · intro hy
      refine ⟨gH (F.equivFin ⟨y, hy⟩), ⟨_, rfl⟩, ?_⟩
      simp [gH, e]
  let VH : Set H := (↑) ⁻¹' V
  have hVHc : IsCompact VH := hHcl.isClosedEmbedding_subtypeVal.isCompact_preimage hVc
  have hcoverH : ∀ y : H, ∃ v ∈ VH, ∃ w ∈ Subgroup.closure (Set.range gH), y = v * w := by
    intro y
    obtain ⟨v, hv, w, hw, hy⟩ := hgen y y.2
    have hwH : w ∈ (Subgroup.closure (Set.range gH)).map H.subtype := hmap ▸ hw
    obtain ⟨wH, hwH', hwHeq⟩ := hwH
    refine ⟨⟨v, Subgroup.subset_closure hv⟩, hv, wH, hwH', Subtype.ext ?_⟩
    simp only [Subgroup.coe_mul]
    rw [hy]
    congr 1
    exact hwHeq.symm
  let xH : H := ⟨x, Subgroup.subset_closure hxV⟩
  have hxH : xH ≠ 1 := fun h => hx (congrArg Subtype.val h)
  obtain ⟨A, hAd, hxA, C, hCc, hC⟩ := exists_discrete_cocompact m H VH hVHc gH hcoverH xH hxH
  have : IsClosed (A : Set H) := Subgroup.isClosed_of_discreteTopology
  have : CompactSpace (H ⧸ A) := by
    refine isCompact_univ_iff.1 ((hCc.image QuotientGroup.continuous_mk).of_isClosed_subset
      isClosed_univ fun q _ => ?_)
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective q
    obtain ⟨c, hc, a, ha, rfl⟩ := hC y
    refine ⟨c, hc, ?_⟩
    rw [QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff a).2 ha, mul_one]
  have hxq : (xH : H ⧸ A) ≠ 1 := by rwa [Ne, QuotientGroup.eq_one_iff]
  obtain ⟨ψ, hψ⟩ := exists_char_ne_one_of_compact hxq
  let q : H →ₜ* H ⧸ A := ⟨QuotientGroup.mk' A, QuotientGroup.continuous_mk⟩
  let incl : H →ₜ* G := ⟨H.subtype, continuous_subtype_val⟩
  obtain ⟨χ, hχ⟩ := PontryaginDual_map_surjective_of_isOpenMap_of_injective incl
    Subtype.val_injective hHo.isOpenMap_subtype_val (ψ.comp q)
  refine ⟨χ, fun h1 => hψ ?_⟩
  have := congrArg (fun φ : PontryaginDual H => φ xH) hχ
  rw [PontryaginDual.map_apply] at this
  calc ψ (xH : H ⧸ A) = (ψ.comp q) xH := rfl
    _ = χ (incl xH) := this.symm
    _ = 1 := h1

/-- Morris, Topology Without Tears, Theorem A5.12.6 (TP-599). Every locally compact Hausdorff
abelian group has enough continuous characters to separate its points. -/
@[kb "morris2024" "Theorem A5.12.6, p. 585"]
theorem characters_separate_points_of_LCA {x y : G} (hxy : x ≠ y) :
    ∃ χ : PontryaginDual G, χ x ≠ χ y := by
  obtain ⟨χ, hχ⟩ := exists_char_ne_one_of_LCA (x := x * y⁻¹) (fun h => hxy (mul_inv_eq_one.1 h))
  refine ⟨χ, fun h => hχ ?_⟩
  rw [map_mul, map_inv, h, mul_inv_cancel]

/-- Morris, Topology Without Tears, Theorem A5.3.11 (TP-532). In a locally compact Hausdorff abelian
group, distinct elements are separated by a continuous homomorphism into the circle. -/
@[kb "morris2024" "Theorem A5.3.11, p. 533"]
theorem exists_continuousMonoidHom_circle_ne {x y : G} (hxy : x ≠ y) :
    ∃ χ : G →ₜ* Circle, χ x ≠ χ y :=
  characters_separate_points_of_LCA hxy

/-- Morris, Topology Without Tears, Corollary A5.12.7 (TP-600). For a closed subgroup `H` of a locally
compact Hausdorff abelian group and `g ∉ H` there is a character trivial on `H` and nontrivial at `g`. -/
@[kb "morris2024" "Corollary A5.12.7, p. 585"]
theorem exists_char_trivial_on_ne_of_LCA (H : Subgroup G) (hH : IsClosed (H : Set G)) {g : G}
    (hg : g ∉ H) : ∃ χ : PontryaginDual G, (∀ h ∈ H, χ h = 1) ∧ χ g ≠ 1 := by
  have : IsClosed (H : Set G) := hH
  have hmk : (QuotientGroup.mk g : G ⧸ H) ≠ 1 := by rwa [Ne, QuotientGroup.eq_one_iff]
  obtain ⟨ψ, hψ⟩ := exists_char_ne_one_of_LCA hmk
  let q : G →ₜ* G ⧸ H := ⟨QuotientGroup.mk' H, QuotientGroup.continuous_mk⟩
  refine ⟨ψ.comp q, fun h hh => ?_, hψ⟩
  show ψ (QuotientGroup.mk h) = 1
  rw [(QuotientGroup.eq_one_iff h).2 hh, map_one]

end LCA

