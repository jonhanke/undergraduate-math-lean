import UndergradKB.Common.Attr
import UndergradKB.Probability.ExamplesSchoolB

/-! # Probability: the bridge point count of a hand (Grinstead–Snell, Example 7.2)

The book regards a hand of `13` cards as `13` independent trials with the one-card point-count law
`(36, 4, 4, 4, 4)/52` on `0, ..., 4` and finds `P(C ≥ 13) = .2845` for the hand's point count `C`.
Here the number of `13`-tuples of cards with each point total is computed by the convolution
recursion (the coefficients of `(36 + 4x + 4x² + 4x³ + 4x⁴)^13`, evaluated by the kernel), which
gives the exact value `P(C ≥ 13) = 5782330171546220363776 / 52^13 = .28449 ...`. -/

open MeasureTheory ProbabilityTheory Finset
open scoped ENNReal

namespace UndergradKB.Probability

/-- The number of `n`-tuples of cards whose point counts add up to `s`. -/
def handSumCount (n s : ℕ) : ℕ :=
  ∑ x : Fin n → Fin 52, if ∑ j, bridgeValue (x j) = s then 1 else 0

/-- One convolution step on the counts of the totals `0, ..., 52`. -/
def convStep (c : List ℕ) : List ℕ :=
  (List.range 53).map fun s =>
    ∑ i : Fin 52, if bridgeValue i ≤ s then c.getD (s - bridgeValue i) 0 else 0

/-- The convolution recursion for `handSumCount n s`, `s ≤ 52`, as a list of length `53`. -/
def handCounts : ℕ → List ℕ
  | 0 => (List.range 53).map fun s => if s = 0 then 1 else 0
  | n + 1 => convStep (handCounts n)

lemma handCounts_succ (n : ℕ) : handCounts (n + 1) = convStep (handCounts n) := rfl

lemma handSumCount_zero (s : ℕ) : handSumCount 0 s = if s = 0 then 1 else 0 := by
  simp [handSumCount, eq_comm]

lemma handSumCount_succ (n s : ℕ) :
    handSumCount (n + 1) s =
      ∑ i : Fin 52, if bridgeValue i ≤ s then handSumCount n (s - bridgeValue i) else 0 := by
  unfold handSumCount
  rw [← (Fin.consEquiv fun _ : Fin (n + 1) => Fin 52).sum_comp, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [Fin.consEquiv, Equiv.coe_fn_mk, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ]
  split_ifs with h
  · refine Finset.sum_congr rfl fun y _ => ?_
    congr 1
    apply propext
    omega
  · refine Finset.sum_eq_zero fun y _ => ?_
    rw [ite_eq_right_iff]
    intro h2
    omega

lemma getD_map_range {f : ℕ → ℕ} {s N : ℕ} (hs : s < N) :
    ((List.range N).map f).getD s 0 = f s := by
  simp [List.getD_eq_getElem?_getD, hs]

lemma handCounts_getD (n : ℕ) : ∀ s < 53, (handCounts n).getD s 0 = handSumCount n s := by
  induction n with
  | zero => intro s hs; rw [handCounts, getD_map_range hs, handSumCount_zero]
  | succ n ih =>
    intro s hs
    rw [handCounts, convStep, getD_map_range hs, handSumCount_succ]
    refine Finset.sum_congr rfl fun i _ => ?_
    split_ifs with h
    · exact ih _ (by omega)
    · rfl

lemma bridgeValue_le_four (i : Fin 52) : bridgeValue i ≤ 4 := by
  unfold bridgeValue; split_ifs <;> omega

