/-- The vertices of `K_{3,3}` in the numbering of `k33_points`. -/
def k33Vertex : Fin 6 → Fin 3 ⊕ Fin 3 :=
  ![Sum.inl 0, Sum.inl 1, Sum.inl 2, Sum.inr 0, Sum.inr 1, Sum.inr 2]

/-- Points on the parabola `y = x²` with distinct abscissae are never collinear. -/
theorem orient_parabola (s t u : ℝ) :
    orient (s, s ^ 2) (t, t ^ 2) (u, u ^ 2) = (t - s) * (u - s) * (u - t) := by
  unfold orient; ring

/-- FO-340 (straight-line drawings). **`K_{3,3}` is not planar**: the complete bipartite graph
`K_{3,3}` has no drawing in the plane with straight edges and no crossings. -/
@[kb "levin2025" "Thm 2.3.4, p. 154"]
theorem not_straightLineDrawing_K33
    (D : StraightLineDrawing (completeBipartiteGraph (Fin 3) (Fin 3))) : False := by
  let t : Fin 3 ⊕ Fin 3 → ℝ :=
    Sum.elim (fun i : Fin 3 => ((i : ℕ) : ℝ)) (fun j : Fin 3 => ((j : ℕ) : ℝ) + 3)
  have ht : Function.Injective t := by
    intro v w h
    rcases v with i | i <;> rcases w with j | j <;> simp only [t, Sum.elim_inl, Sum.elim_inr] at h
    · exact congrArg Sum.inl (Fin.ext (by exact_mod_cast h))
    · have : ((i : ℕ) : ℝ) < 3 := by exact_mod_cast i.isLt
      have : (0 : ℝ) ≤ (j : ℕ) := Nat.cast_nonneg _
      linarith
    · have : ((j : ℕ) : ℝ) < 3 := by exact_mod_cast j.isLt
      have : (0 : ℝ) ≤ (i : ℕ) := Nat.cast_nonneg _
      linarith
    · exact congrArg Sum.inr (Fin.ext (by exact_mod_cast (add_right_cancel h)))
  obtain ⟨D', hD'⟩ := D.exists_generic (fun v => (t v, t v ^ 2)) (by
    intro u v x huv hvx hux
    rw [orient_parabola]
    exact mul_ne_zero (mul_ne_zero (sub_ne_zero.2 (ht.ne huv).symm)
      (sub_ne_zero.2 (ht.ne hux).symm)) (sub_ne_zero.2 (ht.ne hvx).symm))
  have hinj : ∀ i j : Fin 6, i ≠ j → k33Vertex i ≠ k33Vertex j := by decide
  have hadj : ∀ i j : Fin 6, i < 3 → 3 ≤ j →
      (completeBipartiteGraph (Fin 3) (Fin 3)).Adj (k33Vertex i) (k33Vertex j) := by decide
  apply k33_points (fun i => D'.pos (k33Vertex i))
  · intro i j k hij hjk
    exact hD' _ _ _ (hinj i j hij.ne) (hinj j k hjk.ne) (hinj i k (hij.trans hjk).ne)
  · intro i k j l hi hk hj hl hik hjl
    exact D'.disjoint _ _ _ _ (hadj i j hi hj) (hadj k l hk hl) (hinj i k hik)
      (hinj i l (by omega)) (hinj j k (by omega)) (hinj j l hjl)

