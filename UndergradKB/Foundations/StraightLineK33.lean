/-- No assignment of signs to the twenty triples of six points `a₀, a₁, a₂, b₀, b₁, b₂` (numbered
`0, …, 5`) satisfies the four-point identities, the Grassmann–Plücker relations and the absence of
crossings between the edges `aᵢ bⱼ` and `aₖ bₗ` (`i ≠ k`, `j ≠ l`). Variable `bijk` is the sign
of the orientation of the triple `i j k`. -/
theorem k33_signs :
    ∀ b012 : Bool,
    ∀ b013 : Bool,
    ∀ b014 : Bool,
    ∀ b015 : Bool,
    ∀ b023 : Bool,
    ∀ b123 : Bool,
    quadOk b123 b023 b013 b012 = true →
    ∀ b024 : Bool,
    ∀ b034 : Bool,
    gpOk true false true b012 b034 b013 b024 b014 b023 = true →
    ∀ b134 : Bool,
    quadOk b134 b034 b014 b013 = true →
    (b013 == b034 && b014 == b134) = false →
    (b014 != b034 && b013 != b134) = false →
    ∀ b234 : Bool,
    quadOk b234 b034 b024 b023 = true →
    (b023 == b034 && b024 == b234) = false →
    (b024 != b034 && b023 != b234) = false →
    gpOk false true false b013 b234 b023 b134 b034 b123 = true →
    ∀ b124 : Bool,
    quadOk b124 b024 b014 b012 = true →
    quadOk b234 b134 b124 b123 = true →
    (b123 == b134 && b124 == b234) = false →
    (b124 != b134 && b123 != b234) = false →
    gpOk false true false b012 b134 b013 b124 b014 b123 = true →
    gpOk true false true b012 b234 b023 b124 b024 b123 = true →
    gpOk true false true b014 b234 b024 b134 b034 b124 = true →
    ∀ b025 : Bool,
    ∀ b035 : Bool,
    gpOk true false true b012 b035 b013 b025 b015 b023 = true →
    ∀ b045 : Bool,
    gpOk true false true b012 b045 b014 b025 b015 b024 = true →
    gpOk true false true b013 b045 b014 b035 b015 b034 = true →
    gpOk true false true b023 b045 b024 b035 b025 b034 = true →
    ∀ b135 : Bool,
    quadOk b135 b035 b015 b013 = true →
    (b013 == b035 && b015 == b135) = false →
    (b015 != b035 && b013 != b135) = false →
    ∀ b145 : Bool,
    quadOk b145 b045 b015 b014 = true →
    (b014 == b045 && b015 == b145) = false →
    (b015 != b045 && b014 != b145) = false →
    gpOk false true false b013 b145 b014 b135 b015 b134 = true →
    ∀ b345 : Bool,
    quadOk b345 b045 b035 b034 = true →
    quadOk b345 b145 b135 b134 = true →
    gpOk true false true b013 b345 b034 b135 b035 b134 = true →
    gpOk false true false b014 b345 b034 b145 b045 b134 = true →
    gpOk true false true b015 b345 b035 b145 b045 b135 = true →
    ∀ b235 : Bool,
    quadOk b235 b035 b025 b023 = true →
    (b023 == b035 && b025 == b235) = false →
    (b025 != b035 && b023 != b235) = false →
    gpOk false true false b013 b235 b023 b135 b035 b123 = true →
    gpOk true false true b023 b345 b034 b235 b035 b234 = true →
    gpOk true false true b123 b345 b134 b235 b135 b234 = true →
    ∀ b125 : Bool,
    quadOk b125 b025 b015 b012 = true →
    quadOk b235 b135 b125 b123 = true →
    (b123 == b135 && b125 == b235) = false →
    (b125 != b135 && b123 != b235) = false →
    gpOk false true false b012 b135 b013 b125 b015 b123 = true →
    gpOk true false true b012 b235 b023 b125 b025 b123 = true →
    gpOk true false true b015 b235 b025 b135 b035 b125 = true →
    gpOk false true false b012 b145 b014 b125 b015 b124 = true →
    gpOk true false true b123 b145 b124 b135 b125 b134 = true →
    ∀ b245 : Bool,
    quadOk b245 b045 b025 b024 = true →
    (b024 == b045 && b025 == b245) = false →
    (b025 != b045 && b024 != b245) = false →
    quadOk b245 b145 b125 b124 = true →
    (b124 == b145 && b125 == b245) = false →
    (b125 != b145 && b124 != b245) = false →
    quadOk b345 b245 b235 b234 = true →
    gpOk true false true b012 b245 b024 b125 b025 b124 = true →
    gpOk false true false b014 b245 b024 b145 b045 b124 = true →
    gpOk true false true b015 b245 b025 b145 b045 b125 = true →
    gpOk false true false b023 b245 b024 b235 b025 b234 = true →
    gpOk false true false b024 b345 b034 b245 b045 b234 = true →
    gpOk true false true b025 b345 b035 b245 b045 b235 = true →
    gpOk false true false b123 b245 b124 b235 b125 b234 = true →
    gpOk false true false b124 b345 b134 b245 b145 b234 = true →
    gpOk true false true b125 b345 b135 b245 b145 b235 = true →
    False := by decide

