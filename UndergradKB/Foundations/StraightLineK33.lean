/-!
# Foundations: `K_{3,3}` has no straight-line plane drawing

Levin, Theorem 2.3.4 (pdf p. 154): `K_{3,3}` is not planar (the houses and utilities puzzle).
Levin's proof uses Euler's formula and the count `4 f ≤ 2 e`; both need the topology of plane
drawings by curves, which Mathlib lacks (`PlaneFaceData` in `EulerFormula.lean` records them as
inputs). Here the statement is proved unconditionally for drawings with straight edges
(`StraightLineDrawing`):

* a straight-line drawing can be moved so that no three vertices are collinear
  (`StraightLineDrawing.exists_generic`); in `K_{3,3}` three vertices may well be collinear, so
  this step is needed;
* the orientations of the twenty triples of the six vertices then satisfy the four-point identity
  (`orient_four`) on every four vertices and the Grassmann–Plücker relation (`orient_plucker`) on
  every five, and the absence of crossings excludes two sign patterns on each four vertices
  `a_i, a_k, b_j, b_l`;
* no assignment of signs to the twenty triples satisfies all these constraints (`k33_signs`,
  checked by `decide`; the constraints are placed right after their last variable, so the search
  is pruned: about 7500 nodes instead of `2^20`).

Restriction: straight edges instead of curves (Fáry's theorem, not in Mathlib, says that every
planar simple graph has a straight-line drawing). The search statement and its application are
generated by a Python script (not included; Lean checks the result).
-/

namespace UndergradKB.Foundations

/-- `1` or `-1`. -/
def sg (e : Bool) : ℝ := cond e 1 (-1)

/-- The sign constraint of a vanishing sum `sg e₁ o₁ o₂ + sg e₂ o₃ o₄ + sg e₃ o₅ o₆ = 0` of three
nonzero terms, in terms of the signs `sᵢ` of the six factors: the three terms are neither all
positive nor all negative. -/
def gpOk (e1 e2 e3 s1 s2 s3 s4 s5 s6 : Bool) : Bool :=
  !((e1 == (s1 == s2)) && (e2 == (s3 == s4)) && (e3 == (s5 == s6))) &&
    !(!(e1 == (s1 == s2)) && !(e2 == (s3 == s4)) && !(e3 == (s5 == s6)))

theorem decide_sg_mul_pos (e : Bool) {x y : ℝ} (hx : x ≠ 0) (hy : y ≠ 0) :
    decide (0 < sg e * (x * y)) = (e == (decide (0 < x) == decide (0 < y))) := by
  cases e
  · simp only [sg, Bool.cond_false, neg_mul, one_mul]
    rw [decide_neg_pos (mul_ne_zero hx hy), decide_mul_pos hx hy]
    cases decide (0 < x) <;> cases decide (0 < y) <;> rfl
  · simp only [sg, Bool.cond_true, one_mul]
    rw [decide_mul_pos hx hy]
    cases decide (0 < x) <;> cases decide (0 < y) <;> rfl

theorem sg_ne_zero (e : Bool) : sg e ≠ 0 := by
  cases e <;> simp [sg]

theorem gpOk_of (o1 o2 o3 o4 o5 o6 : ℝ) (e1 e2 e3 : Bool) (h1 : o1 ≠ 0) (h2 : o2 ≠ 0)
    (h3 : o3 ≠ 0) (h4 : o4 ≠ 0) (h5 : o5 ≠ 0) (h6 : o6 ≠ 0)
    (h : sg e1 * (o1 * o2) + sg e2 * (o3 * o4) + sg e3 * (o5 * o6) = 0) :
    gpOk e1 e2 e3 (decide (0 < o1)) (decide (0 < o2)) (decide (0 < o3)) (decide (0 < o4))
      (decide (0 < o5)) (decide (0 < o6)) = true := by
  have a := triOk_of h
  have b := triOk_of_neg h (mul_ne_zero (sg_ne_zero e1) (mul_ne_zero h1 h2))
    (mul_ne_zero (sg_ne_zero e2) (mul_ne_zero h3 h4))
    (mul_ne_zero (sg_ne_zero e3) (mul_ne_zero h5 h6))
  rw [decide_sg_mul_pos e1 h1 h2, decide_sg_mul_pos e2 h3 h4, decide_sg_mul_pos e3 h5 h6] at a b
  unfold gpOk
  unfold triOk at a b
  rw [a, b]
  rfl

